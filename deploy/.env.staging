# ============ Staging (test.fizzdragon.com) ============
COMPOSE_PROJECT_NAME=staging
WEB_IMAGE=ghcr.io/fizzdragon-pte-ltd-2/studio-web:staging
SERVER_IMAGE=ghcr.io/fizzdragon-pte-ltd-2/studio-server:staging
AGENT_IMAGE=ghcr.io/fizzdragon-pte-ltd-2/studio-agent:staging
WEB_PORT=3000
SERVER_PORT=3001

# Server env
JAVA_STUDIO_URL=https://test.fizzdragon.com/test2
JAVA_CONTENT_URL=https://test.fizzdragon.com/test1
# --- Alibaba (commented out) ---
# ALIBABA_API_KEY=sk-0484a407126d4f50adaed6a6762b30ca
# ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen3-max
# --- DeepSeek (active) ---
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-1abd1c91f73347d0be88f93ea7d079fa
AI_MODEL=deepseek-chat
# Agent-side provider selection (strict — no implicit fallback)
STORYOS_ROUTER_PROVIDER=deepseek
STORYOS_PERSONA_PROVIDER=deepseek
REDIS_IMAGE=ghcr.io/fizzdragon-pte-ltd-2/redis:7-alpine
DISABLE_CONTENT_MODERATION=true
AUTH_DISABLED=true
