# ⚠️ Do not put infrastructure secrets here (DB / OSS-write / JWT / cloud SDK keys) — use 1Password/Vault for those.
# ============ Production CN (fizzstudio.fizzspace.cn) ============
COMPOSE_PROJECT_NAME=production-cn
WEB_IMAGE=ghcr.io/fizzdragon-pte-ltd-2/studio-web:production-cn
SERVER_IMAGE=ghcr.io/fizzdragon-pte-ltd-2/studio-server:production-cn
AGENT_IMAGE=ghcr.io/fizzdragon-pte-ltd-2/studio-agent:production-cn
WEB_PORT=3002
SERVER_PORT=3003

# Server env
JAVA_STUDIO_URL=https://fizzdragon.fizzspace.cn/studio
JAVA_CONTENT_URL=https://fizzdragon.fizzspace.cn/content
# --- DeepSeek (active — same config as staging, proven end-to-end) ---
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-1abd1c91f73347d0be88f93ea7d079fa
AI_MODEL=deepseek-chat
STORYOS_ROUTER_PROVIDER=deepseek
STORYOS_PERSONA_PROVIDER=deepseek
# --- Alibaba ---
# StoryOS router/persona stay on DeepSeek via STORYOS_*_PROVIDER above;
# this key powers Spark (/aurora/spark/analyze) and video-prompt.ts.
ALIBABA_API_KEY=sk-d6aa754edec14c21828507fa25062f2f
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Worker parallelism — bumped to 8 (see .env.production.com notes).
WORKER_CONCURRENCY=8
STORYBOARD_GENERATE_CONCURRENCY=6
IMAGE_WORKER_CONCURRENCY=1

REDIS_IMAGE=ghcr.io/fizzdragon-pte-ltd-2/redis:7-alpine
DISABLE_CONTENT_MODERATION=true
