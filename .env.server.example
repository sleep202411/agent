# ============ Java Backend ============
JAVA_STUDIO_URL=http://120.26.152.164:8090
JAVA_CONTENT_URL=http://120.26.152.164:8091

# ============ AI ============
ALIBABA_API_KEY=sk-xxx
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ Legacy Java MySQL bridge ============
# Dormant unless LEGACY_MYSQL_ENABLED=true. When enabled, HOST/USER/
# PASSWORD/DATABASE are required and the pool is pinged at boot — a bad
# address fails startup rather than the first admin op.
LEGACY_MYSQL_ENABLED=false
LEGACY_MYSQL_HOST=
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=
# Optional tuning (sane defaults applied if omitted):
# LEGACY_MYSQL_POOL_SIZE=5
# LEGACY_MYSQL_CONNECT_TIMEOUT_MS=10000
# LEGACY_MYSQL_TIMEZONE=Z

# ============ Server ============
PORT=3001

# Dev-only: fulfill billing top-up/recharge orders internally without a payment provider
# (local end-to-end testing of the recharge loop). Ignored when NODE_ENV=production.
# BILLING_DEV_SKIP_PAYMENT=true
