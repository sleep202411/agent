{
  "$id": "https://contracts.fizzdragon.com/experience-runtime/v2/release-request.schema.json",
  "title": "FizzDragon Experience Runtime v2 ReleaseRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gameId": { "$ref": "#/$defs/__schema0" },
    "contentVersion": { "$ref": "#/$defs/__schema0" },
    "title": { "$ref": "#/$defs/__schema1" },
    "subtitle": { "$ref": "#/$defs/__schema1" },
    "coverUrl": { "type": "string", "format": "uri" },
    "manifest": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "$ref": "#/$defs/__schema2" }
    },
    "status": { "type": "string", "enum": ["published", "draft"] },
    "setCurrent": { "type": "boolean", "default": true }
  },
  "required": ["gameId", "contentVersion", "manifest", "status"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "__schema1": { "type": "string", "minLength": 1, "maxLength": 240 },
    "__schema2": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema2" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema2" }
        }
      ]
    }
  }
}
