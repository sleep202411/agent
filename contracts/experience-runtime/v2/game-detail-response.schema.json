{
  "$id": "https://contracts.fizzdragon.com/experience-runtime/v2/game-detail-response.schema.json",
  "title": "FizzDragon Experience Runtime v2 GameDetailResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gameId": { "$ref": "#/$defs/__schema0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "coverUrl": {},
    "currentVersion": { "$ref": "#/$defs/__schema0" },
    "manifestUrl": { "type": "string", "format": "uri" }
  },
  "required": ["gameId", "title", "currentVersion", "manifestUrl"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    }
  }
}
