{
  "$id": "https://contracts.fizzdragon.com/experience-runtime/v2/checkpoint-write.draft.schema.json",
  "title": "FizzDragon Experience Runtime v2 CheckpointWriteDraft",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": { "type": "number", "const": 1 },
    "clientWriteId": { "$ref": "#/$defs/__schema0" },
    "expectedSessionVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expectedPlayerStateVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "checkpointId": { "$ref": "#/$defs/__schema0" },
    "currentSceneId": { "$ref": "#/$defs/__schema0" },
    "lifecycle": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/$defs/__schema1" },
        "completedEndingId": { "$ref": "#/$defs/__schema2" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "deterministicRuntime": {
      "type": "object",
      "properties": {
        "randomSeed": { "$ref": "#/$defs/__schema0" },
        "audioCuePlayCounts": {
          "default": {},
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/__schema0" },
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      },
      "required": ["audioCuePlayCounts"],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "session": { "$ref": "#/$defs/__schema3" },
        "player": { "$ref": "#/$defs/__schema3" },
        "scene": { "$ref": "#/$defs/__schema3" }
      },
      "required": ["session", "player", "scene"],
      "additionalProperties": false
    },
    "watchedAssetIds": { "default": [], "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
    "unlockedEndingIds": {
      "default": [],
      "type": "array",
      "items": { "$ref": "#/$defs/__schema0" }
    },
    "completedEndingIds": {
      "default": [],
      "type": "array",
      "items": { "$ref": "#/$defs/__schema0" }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
        "masterMuted": { "default": false, "type": "boolean" },
        "audioBusGains": {
          "default": {},
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/__schema0" },
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 4 }
        },
        "reducedMotion": { "default": false, "type": "boolean" },
        "captionsEnabled": { "default": false, "type": "boolean" }
      },
      "required": ["locale", "masterMuted", "audioBusGains", "reducedMotion", "captionsEnabled"],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "clientWriteId",
    "expectedSessionVersion",
    "expectedPlayerStateVersion",
    "checkpointId",
    "currentSceneId",
    "lifecycle",
    "deterministicRuntime",
    "state",
    "watchedAssetIds",
    "unlockedEndingIds",
    "completedEndingIds",
    "preferences"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "__schema1": { "type": "string", "enum": ["active", "completed"] },
    "__schema2": { "$ref": "#/$defs/__schema0" },
    "__schema3": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
      },
      "additionalProperties": { "$ref": "#/$defs/__schema4" }
    },
    "__schema4": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema4" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema4" }
        }
      ]
    }
  }
}
