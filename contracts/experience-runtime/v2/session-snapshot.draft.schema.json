{
  "$id": "https://contracts.fizzdragon.com/experience-runtime/v2/session-snapshot.draft.schema.json",
  "title": "FizzDragon Experience Runtime v2 SessionSnapshotDraft",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": { "type": "number", "const": 1 },
    "sessionId": { "$ref": "#/$defs/__schema0" },
    "clientSessionId": { "$ref": "#/$defs/__schema0" },
    "gameId": { "$ref": "#/$defs/__schema0" },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "buildId": { "$ref": "#/$defs/__schema0" },
    "contentVersion": { "$ref": "#/$defs/__schema0" },
    "sessionVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "playerStateId": { "$ref": "#/$defs/__schema0" },
    "playerStateVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "currentSceneId": { "$ref": "#/$defs/__schema0" },
    "lifecycle": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/$defs/__schema1" },
        "completedEndingId": { "$ref": "#/$defs/__schema2" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "deterministicRuntime": {
      "type": "object",
      "properties": {
        "randomSeed": { "$ref": "#/$defs/__schema0" },
        "audioCuePlayCounts": {
          "default": {},
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/__schema0" },
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      },
      "required": ["audioCuePlayCounts"],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "session": { "$ref": "#/$defs/__schema3" },
        "player": { "$ref": "#/$defs/__schema3" },
        "scene": { "$ref": "#/$defs/__schema3" }
      },
      "required": ["session", "player", "scene"],
      "additionalProperties": false
    },
    "watchedAssetIds": { "default": [], "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
    "unlockedEndingIds": {
      "default": [],
      "type": "array",
      "items": { "$ref": "#/$defs/__schema0" }
    },
    "completedEndingIds": {
      "default": [],
      "type": "array",
      "items": { "$ref": "#/$defs/__schema0" }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
        "masterMuted": { "default": false, "type": "boolean" },
        "audioBusGains": {
          "default": {},
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/__schema0" },
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 4 }
        },
        "reducedMotion": { "default": false, "type": "boolean" },
        "captionsEnabled": { "default": false, "type": "boolean" }
      },
      "required": ["locale", "masterMuted", "audioBusGains", "reducedMotion", "captionsEnabled"],
      "additionalProperties": false
    },
    "createdAt": { "$ref": "#/$defs/__schema5" },
    "updatedAt": { "$ref": "#/$defs/__schema5" }
  },
  "required": [
    "protocolVersion",
    "sessionId",
    "clientSessionId",
    "gameId",
    "manifestHash",
    "buildId",
    "contentVersion",
    "sessionVersion",
    "playerStateId",
    "playerStateVersion",
    "currentSceneId",
    "lifecycle",
    "deterministicRuntime",
    "state",
    "watchedAssetIds",
    "unlockedEndingIds",
    "completedEndingIds",
    "preferences",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "__schema1": { "type": "string", "enum": ["active", "completed"] },
    "__schema2": { "$ref": "#/$defs/__schema0" },
    "__schema3": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
      },
      "additionalProperties": { "$ref": "#/$defs/__schema4" }
    },
    "__schema4": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema4" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema4" }
        }
      ]
    },
    "__schema5": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
