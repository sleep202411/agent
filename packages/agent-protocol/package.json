{
  "name": "@repo/agent-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "FizzDragon Agent OS wire protocol (fizz.agent.v1).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
