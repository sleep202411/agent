# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Experimental
apps/web-tanstack

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.*
!.env.*.example
!.env.example
# Tracked env files — never commit infrastructure secrets here
# (DB / OSS-write / JWT / cloud SDK keys go to 1Password/Vault, not git).
!apps/web/.env.local
!apps/web/.env.staging
!apps/web/.env.production.cn
!apps/web/.env.production.com
!apps/server/.env.staging
!apps/server/.env.production.cn
!apps/server/.env.production.com
!deploy/.env.local
!deploy/.env.staging
!deploy/.env.production.cn
!deploy/.env.production.com

# Testing
coverage
__pycache__/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
# Next.js build/trace output — also catches the stray root .next/ left by
# running next from the repo root.
.next/
.output
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Docker exports
*.tar.gz

# Claude Code
.claude/
.agents/
skills-lock.json

# Docker
*.tar

# TypeScript
*.tsbuildinfo

# Playwright / E2E
test-results/
playwright-report/

# Throwaway dev artifacts at repo root (screenshots / preview HTML).
# These accumulate from manual browser work and should never enter
# the repo. Put intentional docs under docs/ instead.
/outputs/
/image.png
/image*.png
/image*.jpg
/*-preview.html
tmp/
apps/server/outputs/

# Jinling production renders are immutable Azure Blob release assets. Keep
# scripts, manifests, prompts and review images in Git; never commit binaries.
/apps/web/public/jinling-rumeng/**/*.mp4
/apps/web/public/jinling-rumeng/**/*.wav

# Interactive-film production working assets (hu-bao-villa etc.): raw video
# candidates and reference frames stay out of Git; finals live in cloud
# storage. Keep JSON manifests, prompts and docs in Git.
/docs/interactive-films/assets/**/*.mp4
/docs/interactive-films/assets/**/*.mov
/docs/interactive-films/assets/**/*.wav
/docs/interactive-films/assets/**/*.png
/docs/interactive-films/assets/**/*.jpg
/docs/interactive-films/assets/**/*.jpeg
/docs/interactive-films/assets/**/*.webp

# Local registry authentication tokens
/.npmrc

# Reproducible local TV fixture media (npm run seed:tv-local -w server).
/apps/web/public/_dev/tv/

# ZCode client local state
.zcode/
