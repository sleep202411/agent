# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Experimental
apps/web-tanstack

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.*
!.env.*.example
!.env.example
# Tracked env files — never commit infrastructure secrets here
# (DB / OSS-write / JWT / cloud SDK keys go to 1Password/Vault, not git).
!apps/web/.env.local
!apps/web/.env.staging
!apps/web/.env.production.cn
!apps/web/.env.production.com
!apps/server/.env.staging
!apps/server/.env.production.cn
!apps/server/.env.production.com
!deploy/.env.local
!deploy/.env.staging
!deploy/.env.production.cn
!deploy/.env.production.com

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
# Next.js build/trace output — also catches the stray root .next/ left by
# running next from the repo root.
.next/
.output
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Docker exports
*.tar.gz

# Claude Code
.claude/
.agents/
skills-lock.json

# Docker
*.tar

# TypeScript
*.tsbuildinfo

# Playwright / E2E
test-results/
playwright-report/

# Throwaway dev artifacts at repo root (screenshots / preview HTML).
# These accumulate from manual browser work and should never enter
# the repo. Put intentional docs under docs/ instead.
/outputs/
/image.png
/image*.png
/image*.jpg
/*-preview.html
tmp/
