{
  "name": "fizzdragon-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=16",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "husky",
    "test:build-cache": "node scripts/verify-build-cache.mjs",
    "test:orchestration": "node scripts/verify-test-orchestration.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.18.1",
    "npm": ">=11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/admin-ui",
    "apps/agent",
    "apps/agent-os",
    "apps/app-story-agent",
    "apps/game-agent",
    "apps/mobile",
    "apps/server",
    "apps/studio",
    "apps/web",
    "packages/*"
  ],
  "dependencies": {
    "@ai-sdk/alibaba": "^1.0.14",
    "@xyflow/react": "^12.11.0"
  }
}
