{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "ADMIN_SITE",
        "ADMIN_API_BASE_URL",
        "AURORA_PROXY_TARGET",
        "JAVA_CONTENT_URL",
        "JAVA_STUDIO_URL",
        "AURORA_STRIP_PREFIX"
      ],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "TEST_REDIS_URL",
        "TASK01_TEST_DATABASE_URL",
        "AI_ACTOR_TEST_DATABASE_URL",
        "IP_FEEDBACK_POSTGRES_TEST",
        "IP_ORIGIN_POSTGRES_TEST",
        "IP_COMMENTS_POSTGRES_TEST",
        "IP_RELEASE_LINKS_POSTGRES_TEST",
        "IP_GAME_POSTGRES_TEST",
        "STORY_COMMERCE_POSTGRES_TEST",
        "CREATOR_EARNINGS_POSTGRES_TEST",
        "DATABASE_URL",
        "VITEST_MAX_WORKERS",
        "AGENT_OS_CHECKPOINT_POSTGRES_INTEGRATION",
        "LEGACY_AGENT_TEST_DATABASE_URL",
        "DATABASE_POSTGRES_INTEGRATION",
        "CREW_WORKSPACE_TEST_DATABASE_URL",
        "EPISODE_UPLOAD_INTEGRATION",
        "STORY_AGENT_POSTGRES_INTEGRATION",
        "STORY_PRODUCTION_GENERATION_POSTGRES_INTEGRATION",
        "AGENT_OS_START_POSTGRES_INTEGRATION",
        "AGENT_OS_TOOL_RECEIPT_POSTGRES_INTEGRATION",
        "COPILOT_POSTGRES_INTEGRATION",
        "CONVERSATIONS_POSTGRES_INTEGRATION",
        "CREW_ACCOUNTABILITY_POSTGRES_INTEGRATION",
        "NOTIFICATION_POSTGRES_INTEGRATION",
        "CREW_LEGACY_TEST_DATABASE_URL",
        "CREW_QUOTA_TEST_DATABASE_URL",
        "NOTIFICATION_TEST_DATABASE_URL",
        "REDIS_RATE_LIMIT_INTEGRATION_URL",
        "CONTENT_GPS_TEST_DATABASE_URL",
        "FD_TEMPLATE_TEST_DATABASE_URL",
        "IP_FEEDBACK_SQL_TEST",
        "CONTRACT_RETENTION_TEST_DATABASE_URL",
        "DISPUTE_LIST_TEST_DATABASE_URL",
        "MEDIA_RETENTION_SCALE",
        "PROJECT_SECTIONS_TEST_DATABASE_URL",
        "PROJECT_SKILLS_TEST_DATABASE_URL",
        "REPORT_PURCHASE_TEST_DATABASE_URL",
        "S3_LOCAL_INTEGRATION",
        "STORYBOARD_EXPORT_TEST_DATABASE_URL",
        "STORYBOARD_RENDER_INTEGRATION",
        "TASK_CONTRACTS_TEST_DATABASE_URL",
        "TASK_DELIVERY_FOLDER_TEST_DATABASE_URL",
        "TASK_FEEDBACK_TEST_DATABASE_URL",
        "WITHDRAWAL_TEST_DATABASE_URL",
        "WITHDRAWAL_SCALE_TEST",
        "LOCAL_AUDIT_DATABASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": ["NODE_OPTIONS"]
}
