{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "ADMIN_SITE",
        "ADMIN_API_BASE_URL",
        "AURORA_PROXY_TARGET",
        "JAVA_CONTENT_URL",
        "JAVA_STUDIO_URL"
      ],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "TEST_REDIS_URL",
        "TASK01_TEST_DATABASE_URL",
        "DATABASE_URL",
        "VITEST_MAX_WORKERS",
        "AGENT_OS_CHECKPOINT_POSTGRES_INTEGRATION",
        "LEGACY_AGENT_TEST_DATABASE_URL",
        "DATABASE_POSTGRES_INTEGRATION",
        "CREW_WORKSPACE_TEST_DATABASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": ["NODE_OPTIONS"]
}
