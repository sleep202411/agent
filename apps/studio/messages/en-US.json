    "faq": {
      "heading": "Your questions,<br></br>answered",
      "computeCredits": {
        "question": "What are compute credits?",
        "answer": "Compute credits are the currency for AI generation in FizzStudio. Every image, video, and audio job deducts credits based on the model, resolution, and output count — the exact cost is shown next to Generate before you submit."
      },
      "generationFails": {
        "question": "What happens if my generation fails?",
        "answer": "Compute credits are refunded automatically when a generation fails for good. You only pay for jobs that produce output."
      },
      "rollover": {
        "question": "Do unused compute credits roll over?",
        "answer": "Compute credits included with your plan refresh each billing cycle and follow the plan rules shown at checkout. Top-up compute credits stay in your wallet until you spend them."
      },
      "freeTier": {
        "question": "Can I use FizzStudio for free?",
        "answer": "Yes. Free accounts include daily generation quotas so you can try the studio. Upgrade when you need more volume, private generations, or faster queues."
      },
      "subscriptionVsTopups": {
        "question": "What is the difference between a subscription and compute credit top-ups?",
        "answer": "A subscription grants a recurring compute credit allowance plus plan perks like queue priority, higher concurrency, and support. Top-ups are one-time compute credit purchases — and paid plans get a discount on them."
      },
      "teamShareCredits": {
        "question": "How do team plans share compute credits?",
        "answer": "Team plans pool compute credits in a shared workspace wallet that every seat draws from, so the whole team works against one balance."
      },
      "cancelOrChange": {
        "question": "How do I cancel or change my plan?",
        "answer": "Manage your subscription from the account menu under Billing & Subscription. Plan changes take effect at the end of the current billing cycle."
      },
      "commercialUse": {
        "question": "Can I use my generations commercially?",
        "answer": "Paid plans include commercial use of your generated outputs, subject to the Terms of Service."
      }
    }
  },
