  "endings": [
    {
      "endingId": "E01",
      "title": {
        "en-US": "The Name Returned",
        "zh-CN": "名字归还",
        "zh-HK": "名字歸還"
      },
      "summary": {
        "en-US": "At the morning entrance, the oral-history exhibit credits “Salmah Binte Yusof and the original voices of the 1994 night-shift staff”; Lim Guo Sheng is listed as an interviewee, not a hero. Cheng and Maya listen together to the end.",
        "zh-CN": "清晨入口。口述史展的音频页面标题为“Salmah Binte Yusof 与 1994 夜班员工原声记录”；林国声列为受访者而非英雄。陈澄和 Maya 并肩听完。",
        "zh-HK": "清晨入口。口述史展的音頻頁面標題為「Salmah Binte Yusof 與 1994 夜班員工原聲記錄」；林國聲列為受訪者而非英雄。陳澄和 Maya 並肩聽完。"
      },
      "kind": "truth"
    },
    {
      "endingId": "E02",
      "title": {
        "en-US": "The Last Opening",
        "zh-CN": "最后开园",
        "zh-HK": "最後開園"
      },
      "summary": {
        "en-US": "The exhibit plays the restored, magnificent opening song while visitors smile for photos. In a corner of the original waveform, a short female voice is marked “irreparable noise”. Cheng stands alone behind the crowd.",
        "zh-CN": "展览播放修复后的华丽开园曲，观众微笑拍照。屏幕角落的原始波形里，一小段女声被标红为“不可修复噪声”。陈澄独自站在人群后。",
        "zh-HK": "展覽播放修復後的華麗開園曲，觀眾微笑拍照。屏幕角落的原始波形裡，一小段女聲被標紅為「不可修復噪聲」。陳澄獨自站在人群後。"
      },
      "kind": "echo"
    },
    {
      "endingId": "E03",
      "title": {
        "en-US": "Leaving Together",
        "zh-CN": "两人出园",
        "zh-HK": "兩人出園"
      },
      "summary": {
        "en-US": "The two sit in a morning MRT station with the uncut tape sealed in a clear evidence bag. Maya switches off the DV camera while Cheng writes both names on the bag.",
        "zh-CN": "两人坐在清晨地铁站，未剪母带封在透明证物袋中。Maya 关掉 DV，陈澄在袋上写下两个人名。",
        "zh-HK": "兩人坐在清晨地鐵站，未剪母帶封在透明證物袋中。Maya 關掉 DV，陳澄在袋上寫下兩個人的名字。"
      },
      "kind": "bond"
    },
    {
      "endingId": "E04",
      "title": {
        "en-US": "The Seventh Gong",
        "zh-CN": "第七声锣",
        "zh-HK": "第七聲鑼"
      },
      "summary": {
        "en-US": "Time jumps back to the S00 camera position. The entrance is empty as Cheng presses play alone; on the DV screen, Maya has become the afterimage of a 1994 visitor. The seventh gong falls.",
        "zh-CN": "时间跳回 S00 的机位。入口空无一人，陈澄独自按下播放；DV 屏幕里 Maya 成了 1994 年的游客残影。 第七声锣落下。",
        "zh-HK": "時間跳回 S00 的機位。入口空無一人，陳澄獨自按下播放；DV 屏幕裡 Maya 成了 1994 年的遊客殘影。第七聲鑼落下。"
      },
      "kind": "failure"
    }
  ],
