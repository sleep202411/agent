# ============ Model providers ============
# Mastra's alibaba-cn provider reads DASHSCOPE_API_KEY; ALIBABA_API_KEY is aliased at startup
ALIBABA_API_KEY=sk-xxx
DASHSCOPE_API_KEY=sk-xxx
DEEPSEEK_API_KEY=sk-xxx
OPENAI_API_KEY=sk-xxx

# ---- Azure OpenAI / AI Foundry (optional) ----
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxx
# AZURE_OPENAI_RESOURCE_NAME=my-foundry-resource
# AZURE_OPENAI_API_VERSION=2024-10-21          # optional override
# AZURE_OPENAI_BASE_URL=https://custom.endpoint  # optional full override

# ---- Per-role provider routing ----
# Supervisor (router): deepseek (default) | alibaba | azure
# STORYOS_ROUTER_PROVIDER=azure
# STORYOS_ROUTER_MODEL=gpt-4o                   # azure: deployment name
#
# Personas: deepseek (default) | alibaba | azure
# STORYOS_PERSONA_PROVIDER=azure
# STORYOS_PERSONA_MODEL=gpt-4o

# ============ Asset image generation ============
# No Replicate/OSS credentials needed — we call Java's existing
# /api/ai/image/generate/basic endpoint. Java owns the model backend
# (Tongyi/DALL-E/etc.) and OSS upload.
# Image-worker concurrency (default 16):
# IMAGE_WORKER_CONCURRENCY=16

# ============ Java backend ============
JAVA_STUDIO_URL=http://120.26.152.164:8090
JAVA_CONTENT_URL=http://120.26.152.164:8091

# ============ Mastra server ============
PORT=4111
MASTRA_HOST=0.0.0.0
