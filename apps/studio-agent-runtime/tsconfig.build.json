{
  "extends": "./tsconfig.json",
  // The published image contains dist only, so the local dev launcher under
  // scripts/ is type-checked but never emitted (it also lives outside rootDir).
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["dist", "node_modules", "src/**/*.spec.ts"]
}
