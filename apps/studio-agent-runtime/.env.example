# Copy to .env. Both worker roles load apps/studio-agent-runtime/.env themselves,
# so `npm run dev -w studio-agent-runtime` and `node dist/worker-control.js` work
# without an --env-file flag. A variable already present in the process
# environment (shell, container, Helm) always wins over this file.

# Exact image / git revision. Required and emitted in health diagnostics.
STUDIO_AGENT_RELEASE=git-0123456789abcdef

# Temporal connection. Production uses mtls and requires all three PEM values.
TEMPORAL_ADDRESS=your-temporal-endpoint.example.com:7233
TEMPORAL_NAMESPACE=fizzdragon
TEMPORAL_TLS_MODE=mtls
TEMPORAL_SERVER_NAME=your-temporal-endpoint.example.com
TEMPORAL_TLS_CA=-----BEGIN CERTIFICATE-----...
TEMPORAL_TLS_CERT=-----BEGIN CERTIFICATE-----...
TEMPORAL_TLS_KEY=-----BEGIN PRIVATE KEY-----...

# A deliberate local plaintext Temporal server must opt out explicitly:
# TEMPORAL_TLS_MODE=disabled
# Remove TEMPORAL_SERVER_NAME and all TEMPORAL_TLS_* values when doing so.

# Canonical Nest control plane. The token must match the server and contain
# at least 32 characters.
STUDIO_AGENT_INTERNAL_BASE_URL=http://localhost:4399
STUDIO_AGENT_RUNTIME_TOKEN=replace-with-a-long-random-service-token

# Studio Agent DELIVERY. This worker is the ONLY publisher: it opens an
# `@ably/ai-transport` AgentSession on the thread's channel and streams the turn
# onto it. Required, with no default and no "disabled" mode — a worker that came
# up without it would run turns nobody can see. Must be a COMPLETE key
# ("<appId>.<keyId>:<secret>"); the same key the Nest server holds.
#
# LOCALLY YOU DO NOT NEED IT HERE. `npm run dev -w studio-agent-runtime` borrows
# ABLY_API_KEY from apps/server/.env when this file does not set it, because the
# two processes must present the same credential and the server already refuses
# to boot without it. Set it here only to point this runtime at a DIFFERENT Ably
# app than the server — which is a broken configuration for a shared channel.
#
# DEPLOY PREREQUISITE, not code: the Ably namespace "studio-agent" must have
# `mutableMessages: true` in every environment, or token streaming dies on the
# first append with error 93002.
# ABLY_API_KEY=replace-with-a-complete-ably-api-key

# Qwen via DashScope. No token fallback exists.
ALIBABA_API_KEY=replace-with-dashscope-api-key
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
STUDIO_AGENT_MODEL=qwen3-max
STUDIO_AGENT_VISION_MODEL=qwen3-vl-plus

# Process endpoints. Both roles read one file locally, so leave these unset and
# let each role use its own default — control 3010 / 0.0.0.0:9464, activities
# 3011 / 0.0.0.0:9465. Pinning them here makes the second worker fail to bind,
# and the local launcher refuses to start such a stack.
# Deployments (Helm) set them explicitly per pod.
STUDIO_AGENT_HEALTH_HOST=0.0.0.0

# Operational tuning only; defaults are validated in src/config.ts.
STUDIO_AGENT_CONTROL_MAX_CONCURRENT_WORKFLOW_TASKS=64
STUDIO_AGENT_CONTROL_MAX_CONCURRENT_WORKFLOW_POLLS=16
STUDIO_AGENT_ACTIVITY_MAX_CONCURRENT_TASKS=16
STUDIO_AGENT_ACTIVITY_MAX_CONCURRENT_POLLS=8
STUDIO_AGENT_WORKER_SHUTDOWN_GRACE_MS=30000
STUDIO_AGENT_WORKER_SHUTDOWN_FORCE_MS=120000
STUDIO_AGENT_INTERNAL_TIMEOUT_MS=30000
# Total timeout on one streaming model call (not time-to-first-token).
# Default 600000, ceiling 720000 — see src/config.ts for the arithmetic against
# the model activity's 16-minute Temporal envelope. 120000 aborted a live reply
# mid-sentence at 4802 characters.
STUDIO_AGENT_MODEL_TIMEOUT_MS=600000
# qwen3-max's own per-response output ceiling. No longer a transport limit: a
# long reply rolls onto a fresh Ably message (src/append-ceiling.ts).
STUDIO_AGENT_MODEL_MAX_OUTPUT_TOKENS=8192
