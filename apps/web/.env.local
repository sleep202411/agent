JAVA_CONTENT_URL=https://fizzdragon.com/content
JAVA_STUDIO_URL=https://fizzdragon.com/studio

# ============ NestJS Server ============
# Local dev: point at locally-running Nest (npm run start:dev in apps/server → PORT=4399)
# To use prod data temporarily: https://fizzdragon.com/aurora (read-only, no writes)
SERVER_URL=http://localhost:4399

# ============ Site Region ============
NEXT_PUBLIC_SITE_REGION=global

# ============ OSS ============
