# ⚠️ Do not put infrastructure secrets here (DB / OSS-write / JWT / cloud SDK keys) — use 1Password/Vault for those.
# ============ 生产环境 - CN ============
# fizzstudio.fizzspace.cn

# ============ Java Backend ============
JAVA_CONTENT_URL=https://fizzdragon.fizzspace.cn/content
JAVA_STUDIO_URL=https://fizzdragon.fizzspace.cn/studio

# ============ NestJS Server ============
SERVER_URL=http://localhost:3001

# ============ Site Region ============
NEXT_PUBLIC_SITE_REGION=cn

# ============ OSS ============
NEXT_PUBLIC_OSS_BASE_URL=https://shotive.oss-cn-hangzhou.aliyuncs.com
NEXT_PUBLIC_USER_BASE_URL=https://avatar.fizzspace.cn
# NEXT_PUBLIC_BANNER_BASE_URL=https://fizzdragon-banner-sg.oss-ap-southeast-1.aliyuncs.com
