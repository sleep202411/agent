# ============ Java Backend ============
JAVA_CONTENT_URL=http://120.26.152.164:8091
JAVA_STUDIO_URL=http://120.26.152.164:8090

# ============ NestJS Server ============
SERVER_URL=http://localhost:3001

# ============ Site Region ============
# "cn" for .cn site (CNY + WeChat Pay), "global" for .com site (USD + Airwallex)
NEXT_PUBLIC_SITE_REGION=global

# ============ OSS ============
NEXT_PUBLIC_OSS_BASE_URL=https://fizzspace-test.oss-cn-hangzhou.aliyuncs.com
NEXT_PUBLIC_BANNER_BASE_URL=https://fizzdragon-banner-sg.oss-ap-southeast-1.aliyuncs.com
NEXT_PUBLIC_USER_BASE_URL=https://user-aratar-sg.oss-ap-southeast-1.aliyuncs.com
NEXT_PUBLIC_PARENT_ORIGIN=

# Override WS host when the page is served from a CDN-fronted domain that
# doesn't pass WebSocket upgrades. Empty → same-origin (default).
# Example: NEXT_PUBLIC_WS_HOST=fizzstudio.fizzdragon.com
NEXT_PUBLIC_WS_HOST=
