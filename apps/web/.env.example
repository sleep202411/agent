# ============ Java Backend ============
JAVA_CONTENT_URL=http://120.26.152.164:8091
JAVA_STUDIO_URL=http://120.26.152.164:8090

# ============ NestJS Server ============
SERVER_URL=http://localhost:4399

# ============ Site Region ============
# "cn" for .cn site (CNY + WeChat Pay), "global" for .com site (USD + Airwallex)
NEXT_PUBLIC_SITE_REGION=global
# Required Studio host (no scheme): studio.fizzdragon.com / studio.fizzspace.cn.
# Local Studio runs on port 9540; localhost links use HTTP.
NEXT_PUBLIC_STUDIO_HOST=localhost:9540

# ============ OSS ============
NEXT_PUBLIC_OSS_BASE_URL=https://fizzspace-test.oss-cn-hangzhou.aliyuncs.com
NEXT_PUBLIC_BANNER_BASE_URL=https://fizzdragon-banner-sg.oss-ap-southeast-1.aliyuncs.com
NEXT_PUBLIC_USER_BASE_URL=https://user-aratar-sg.oss-ap-southeast-1.aliyuncs.com
NEXT_PUBLIC_PARENT_ORIGIN=

# ============ PostHog (analytics) ============
# Public Project API Key (starts with `phc_`) — safe to embed in
# client JS; write-only access to your PostHog project. Get one at
# posthog.com → Project Settings → Project API Key. Leave both empty
# to disable analytics; the init call no-ops on a missing token.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AppLovin AXON web pixel key (ad-conversion tracking). Empty → pixel no-ops.
# .com only; CN is region-gated off in src/lib/axon.ts.
NEXT_PUBLIC_AXON_PIXEL_KEY=

# ============ Seed Audio 1.0 / BytePlus Voice (影游配音) ============
# Server-only — never NEXT_PUBLIC_*. Used by offline generation scripts.
# Docs: https://docs.byteplus.com/en/docs/byteplusvoice/seedaudio-01
# Create task: POST {SEED_AUDIO_BASE_URL}/api/v3/tts/create
# Put the real key only in .env.local — never commit secrets.
SEED_AUDIO_API_KEY=
# Host only (no trailing slash). SE Asia endpoint from BytePlus docs:
SEED_AUDIO_BASE_URL=https://voice.ap-southeast-1.bytepluses.com
# Optional legacy auth (if console still issues App-Id + Access-Key):
# SEED_AUDIO_APP_ID=
# SEED_AUDIO_ACCESS_KEY=

# ============ Seedream 5 Pro + Seedance 2.0 / BytePlus ModelArk ============
# Docs: https://docs.byteplus.com/en/docs/ModelArk/1520757
#        https://docs.byteplus.com/en/docs/ModelArk/2291680
# Create: POST {SEEDANCE_BASE_URL}/api/v3/contents/generations/tasks
# Multimodal: images(0-9) + videos(0-3) + audio(0-3) + text; not audio-only.
# Seedream Pro endpoint `dola-seedream-5-0-pro-260628` is version-locked in the
# reviewed asset manifest; never source a billed image model from a mutable env.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com
# App-level Seedance default only. Production tasks lock their model in manifest.
SEEDANCE_MODEL=dreamina-seedance-2-0-260128

# Content GPS map display (optional until regional provider acceptance).
# Browser-restricted Maps JavaScript keys only; never server geocoding credentials.
NEXT_PUBLIC_CONTENT_GPS_MAP_ENABLED=false
NEXT_PUBLIC_CONTENT_GPS_GOOGLE_KEY=
# Own Google Map ID required for Advanced Markers; no demo fallback.
NEXT_PUBLIC_CONTENT_GPS_GOOGLE_MAP_ID=
NEXT_PUBLIC_CONTENT_GPS_GAODE_KEY=
# Same-origin proxy path, e.g. /_AMapService. Isaac/Yuanzheng configure the
# provider security code on that proxy; do not expose it as NEXT_PUBLIC_*.
NEXT_PUBLIC_CONTENT_GPS_GAODE_PROXY_PATH=
