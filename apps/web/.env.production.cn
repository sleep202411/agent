# ⚠️ Do not put infrastructure secrets here (DB / OSS-write / JWT / cloud SDK keys) — use 1Password/Vault for those.
# ============ 生产环境 - CN ============
# fizzstudio.fizzspace.cn

# ============ Java Backend ============
JAVA_CONTENT_URL=https://java.fizzspace.cn/content
JAVA_STUDIO_URL=https://java.fizzspace.cn/studio

# ============ NestJS Server ============
SERVER_URL=http://localhost:3001

# ============ Site Region ============
NEXT_PUBLIC_SITE_REGION=cn

# ============ Standalone FizzStudio subdomain ============
# Navigation, project and notification links use this standalone Studio host.
NEXT_PUBLIC_STUDIO_HOST=studio.fizzspace.cn

# ============ OSS ============
NEXT_PUBLIC_OSS_BASE_URL=https://shotive.oss-cn-hangzhou.aliyuncs.com
NEXT_PUBLIC_USER_BASE_URL=https://avatar.fizzspace.cn
NEXT_PUBLIC_BANNER_BASE_URL=https://banner.fizzspace.cn
NEXT_PUBLIC_PARENT_ORIGIN=https://fizzdragon.fizzspace.cn
NEXT_PUBLIC_API_CONTENT_PREFIX=/content
NEXT_PUBLIC_API_STUDIO_PREFIX=/studio

# ============ PostHog (analytics — inlined at build time) ============
# Token is the public Project API Key (`phc_…`) — safe to embed in
# client JS; it can only write events, never read. Browser sends events
# to `/ingest/*` which nginx rewrites to PostHog. Note for prod-cn:
# the rewrite target `us.i.posthog.com` must remain reachable from
# our CN-region nginx; if connectivity becomes flaky, switch to an EU
# PostHog project (`eu.i.posthog.com`) or set up a Cloudflare proxy.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_uLyf9JuzSEg9iu4aMtFQDBHYfQB5LZDU5wjP5JoivfBQ
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
