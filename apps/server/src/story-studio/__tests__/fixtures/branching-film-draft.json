  "storyBible": {
    "logline": "闭园后的测试园区里，一盘失真的旧磁带唤醒早已消失的巨龙入口；少女必须在六声开园锣结束前，决定应当保存一段不光彩的真实，还是留下一个更动听的传说。",
    "synopsis": "S00 龙口重现：手持 DV 的红色 REC 点亮，陈澄按下卡带机。第一声锣，巨龙入口显影。\n随后六个选择依次展开——开园曲或原声、回应外公或告诉 Maya、抢救同伴或母带、承担或洗白、保留谁的声轨、以及如何结束回放——每个选择推进一声开园锣。\n第六声锣后，四条路线分别收束于“名字归还 / 最后开园 / 两人出园 / 第七声锣”对应的终止镜头。",
    "characters": [
      {
        "id": "cheng",
        "name": {
          "zh-CN": "陈澄"
        },
        "summary": "数字化外公遗留母带，把最后开园曲交给口述史展。\n从替外公证明无错，走向决定真实应由谁承担、如何被听见。"
      },
      {
        "id": "maya",
        "name": {
          "zh-CN": "Maya Rahman"
        },
        "summary": "拍下毕业短片并确保两人安全离园。\n已经听过未剪母带，知道林国声漏报设备故障。"
      },
      {
        "id": "lin",
        "name": {
          "zh-CN": "林国声"
        },
        "summary": "让外孙女记住自己让乐园活过，而不是差点害了人。\n好听的故事，才有人肯记。"
      },
      {
        "id": "salmah",
        "name": {
          "zh-CN": "Salmah Binte Yusof"
        },
        "summary": "通过原始录音和事故日志取回被剪掉的名字。\n国声，音乐可以停，人要先出去。"
      }
    ]
  },
  "productionNotes": [
    "纪念一个人，是替他修饰过去，还是允许真实连同羞耻一起被记住？"
  ]
}
