{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run start:dev",
    "build": "prisma generate && nest build && tsc -p tsconfig.catalog-update.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env PORT=4399 nest start",
    "prestart:dev": "npm run build -w @repo/shared && npm run build -w @repo/agent-policy && npm run build -w @repo/agent-tools && npm run build -w @repo/agent-capabilities && npm run build -w @repo/agent-protocol && npm run build -w @repo/agent-skills",
    "start:dev": "cross-env PORT=4399 nest start --watch",
    "start:debug": "cross-env PORT=4399 nest start --debug --watch",
    "start:prod": "cross-env PORT=4399 node dist/main",
    "admin:create-user": "tsx scripts/admin-create-user.ts",
    "media:backfill-original-placements": "tsx scripts/backfill-media-original-placements.ts",
    "storyboard:repair-identities": "tsx scripts/repair-storyboard-node-identities.ts",
    "story:repair-chapter-graphs": "tsx scripts/repair-story-chapter-graphs.ts",
    "seed:ai-image": "tsx prisma/seed/seed.ts",
    "seed:membership": "tsx prisma/seed/seed-membership.ts",
    "lint": "eslint \"{src,scripts,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "check-types": "node scripts/check-types.mjs",
    "typecheck:spec": "npm run check-types",
    "test:integration:story-agent": "cross-env STORY_AGENT_POSTGRES_INTEGRATION=1 jest --runInBand --runTestsByPath src/story-studio/story-agent-run.postgres.integration.spec.ts",
    "test:integration:story-generation": "cross-env STORY_PRODUCTION_GENERATION_POSTGRES_INTEGRATION=1 jest --runInBand --runTestsByPath src/story-studio/story-production-generation.postgres.integration.spec.ts",
    "test:integration:agent-os-start": "cross-env AGENT_OS_START_POSTGRES_INTEGRATION=1 jest --runInBand --runTestsByPath src/agent-os-journal/agent-os-run-journal.postgres.integration.spec.ts",
    "test:integration:agent-os-receipts": "cross-env AGENT_OS_TOOL_RECEIPT_POSTGRES_INTEGRATION=1 jest --runInBand --runTestsByPath src/agent-os-gateway/agent-os-tool-execution-receipt.postgres.integration.spec.ts",
    "test:integration:copilot": "cross-env COPILOT_POSTGRES_INTEGRATION=1 jest --runInBand --runTestsByPath src/copilot/copilot.store.postgres.integration.spec.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.cjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/ensure-local-database.mjs prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "node scripts/ensure-local-database.mjs prisma studio",
    "seed:tv-local": "tsx scripts/seed-tv-local.ts",
    "test:crew-migrations": "node scripts/verify-crew-migrations.mjs",
    "test:workspace-migration": "node scripts/verify-workspace-migration.mjs",
    "test:story-project-move": "cross-env TSX_TSCONFIG_PATH=tsconfig.json node --import tsx --import ./test/unit-env.ts scripts/verify-story-project-move.ts",
    "test:workspace-permissions": "cross-env TSX_TSCONFIG_PATH=tsconfig.json node --import tsx scripts/verify-workspace-permissions.ts",
    "media:inspect": "tsx scripts/inspect-media.ts",
    "test:integration:audit": "node scripts/test-audit-integration.mjs",
    "test:integration:gps": "node scripts/test-gps.mjs",
    "test:typecheck-runner": "node --test scripts/check-types.test.mjs",
    "test:integration:platform": "node scripts/test-platform-integration.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^1.0.17",
    "@alicloud/pop-core": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@azure/storage-blob": "^12.31.0",
    "@dicebear/collection": "9.4.2",
    "@dicebear/core": "9.4.2",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.17.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-ws": "^11.1.19",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/agent-capabilities": "*",
    "@repo/agent-protocol": "*",
    "@repo/agent-skills": "*",
    "@repo/agent-tools": "*",
    "@repo/shared": "*",
    "ably": "^2.26.0",
    "ai": "^6.0.146",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "ali-oss": "^6.23.0",
    "bullmq": "^5.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "google-auth-library": "^10.9.1",
    "ioredis": "^5.10.1",
    "mammoth": "^1.12.0",
    "mysql2": "^3.15.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^7.25.0",
    "ws": "^8.20.0",
    "y-protocols": "^1.0.6",
    "yaml": "^2.9.0",
    "yjs": "^13.6.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1",
    "@electric-sql/pglite-socket": "0.1.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "setupFiles": [
      "<rootDir>/../test/unit-env.ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node10",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@repo/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
      "^@repo/shared/(.*)$": "<rootDir>/../../../packages/shared/src/$1.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@repo/agent-skills$": "<rootDir>/../../../packages/agent-skills/src/index.ts",
      "^@repo/agent-capabilities$": "<rootDir>/../../../packages/agent-capabilities/src/index.ts",
      "^@repo/agent-tools$": "<rootDir>/../../../packages/agent-tools/src/index.ts",
      "^@repo/agent-policy$": "<rootDir>/../../../packages/agent-policy/src/index.ts",
      "^@repo/agent-protocol$": "<rootDir>/../../../packages/agent-protocol/src/index.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>",
      "<rootDir>/../prisma/seed"
    ],
    "maxWorkers": 2,
    "testTimeout": 30000,
    "workerIdleMemoryLimit": "512MB"
  }
}
