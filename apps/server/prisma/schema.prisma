/// Workspace-scoped mutation replay ledger. A repeated key with a different
/// request hash is rejected; an identical retry returns the recorded response.
model ProjectSkillMutation {
  id             String   @id @default(uuid(7)) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(240)
  operation      String   @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  actorUserId    String   @map("actor_user_id") @db.VarChar(64)
  response       Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey], map: "project_skill_mutations_workspace_key_unique")
  @@index([createdAt], map: "project_skill_mutations_created_idx")
  @@map("project_skill_mutations")
}

/// User-uploaded files for Agent OS (scripts, notes, refs). Tools read by attachmentId.
