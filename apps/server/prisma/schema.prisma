enum BillingRefundStatus {
  /// Internal refund row was created and benefit reversal was reserved.
  requested
  /// Refund request was submitted to the payment provider and is waiting for
  /// provider acceptance, settlement, or failure webhooks.
  provider_pending
  /// Provider accepted/settled the refund and internal financial ledger was posted.
  succeeded
  /// Provider rejected the refund or internal safety checks failed; any reserved
  /// wallet or entitlement reversal must be restored before entering this state.
  failed
  /// Refund was canceled before provider submission. Submitted provider refunds
  /// are not canceled internally; they must follow provider state.
  canceled
}

