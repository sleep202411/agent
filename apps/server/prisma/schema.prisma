/// image generation without silently affecting video or Agent behavior.
model ProjectSkillInstallation {
  id                String                         @id @default(uuid(7)) @db.Uuid
  workspaceId       String                         @map("workspace_id") @db.Uuid
  platformProjectId String?                        @map("platform_project_id") @db.Uuid
  storyProjectId    String?                        @map("story_project_id") @db.Uuid
  skillId           String                         @map("skill_id") @db.Uuid
  pinnedVersionId   String                         @map("pinned_version_id") @db.Uuid
  config            Json                           @default("{}") @db.JsonB
  status            ProjectSkillInstallationStatus @default(active)
  revision          Int                            @default(0)
  installedByUserId String                         @map("installed_by_user_id") @db.VarChar(64)
  updatedByUserId   String                         @map("updated_by_user_id") @db.VarChar(64)
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  platformProject PlatformProject?         @relation(fields: [platformProjectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  storyProject    StoryProject?            @relation(fields: [storyProjectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  skill           SkillCatalogItem         @relation(fields: [skillId], references: [id], onDelete: Restrict)
