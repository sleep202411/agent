  generationId       String?   @map("generation_id") @db.Uuid
  aiJobId            String?   @map("ai_job_id") @db.Uuid
  aiJobOutputId      String?   @unique(map: "story_asset_media_versions_ai_output_unique") @map("ai_job_output_id")
