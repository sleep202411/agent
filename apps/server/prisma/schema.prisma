model Workspace {
  id               String               @id @default(uuid(7)) @db.Uuid
  type             WorkspaceType
  status           WorkspaceStatus      @default(active)
  billingMode      WorkspaceBillingMode @default(member_pays) @map("billing_mode")
  name             String               @db.VarChar(120)
  slug             String?              @db.VarChar(80)
  avatarUrl        String?              @map("avatar_url") @db.VarChar(512)
  description      String?              @db.VarChar(500)
  /// External authenticated user id. For personal workspaces this is
  /// the owning user; for team workspaces this is the creator/admin who
  /// initialized the team. No FK to external user tables.
  ownerUserId      String               @map("owner_user_id") @db.VarChar(64)
  createdById      String               @map("created_by_id") @db.VarChar(64)
  defaultProjectId String?              @map("default_project_id") @db.Uuid
  version          Int                  @default(0)
  suspendedAt      DateTime?            @map("suspended_at") @db.Timestamptz(6)
  archivedAt       DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)

  members       WorkspaceMember[]
  invites       WorkspaceInvite[]
  projects      PlatformProject[]
  auditLogs     PlatformAuditLog[]
  projectAssets ProjectAsset[]
  aiJobs        AiJob[]
  mediaAssets   MediaAsset[]
  documents     PlatformDocument[]
  billingOrders BillingOrder[]
  subscriptions BillingSubscription[]

  /// Active personal uniqueness is enforced by partial unique SQL:
  /// (owner_user_id) WHERE type='personal' AND deleted_at IS NULL.
  @@index([ownerUserId, type, deletedAt], map: "workspaces_owner_type_idx")
  @@index([status, updatedAt(sort: Desc)], map: "workspaces_status_recent_idx")
  @@map("workspaces")
}

model WorkspaceMember {
  id           String                @id @default(uuid(7)) @db.Uuid
  workspaceId  String                @map("workspace_id") @db.Uuid
  userId       String                @map("user_id") @db.VarChar(64)
  role         WorkspaceMemberRole
  status       WorkspaceMemberStatus @default(active)
  seatAssigned Boolean               @default(true) @map("seat_assigned")
  invitedById  String?               @map("invited_by_id") @db.VarChar(64)
  joinedAt     DateTime?             @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt    DateTime?             @map("removed_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Active uniqueness is enforced by partial unique SQL:
  /// (workspace_id, user_id) WHERE removed_at IS NULL.
  @@index([userId, status], map: "workspace_members_by_user_idx")
  @@index([workspaceId, status, role], map: "workspace_members_by_workspace_idx")
  @@map("workspace_members")
}

model WorkspaceInvite {
  id            String                @id @default(uuid(7)) @db.Uuid
  workspaceId   String                @map("workspace_id") @db.Uuid
  inviteeUserId String?               @map("invitee_user_id") @db.VarChar(64)
  inviteeEmail  String?               @map("invitee_email") @db.VarChar(320)
  role          WorkspaceMemberRole
  tokenHash     String                @map("token_hash") @db.VarChar(128)
  status        WorkspaceInviteStatus @default(pending)
  invitedById   String                @map("invited_by_id") @db.VarChar(64)
  acceptedAt    DateTime?             @map("accepted_at") @db.Timestamptz(6)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "workspace_invites_token_hash_unique")
  @@index([workspaceId, status, createdAt(sort: Desc)], map: "workspace_invites_by_workspace_idx")
  @@index([inviteeUserId, status], map: "workspace_invites_by_user_idx")
  @@index([inviteeEmail, status], map: "workspace_invites_by_email_idx")
  @@map("workspace_invites")
}

model PlatformProject {
  id           String                @id @default(uuid(7)) @db.Uuid
  workspaceId  String                @map("workspace_id") @db.Uuid
  name         String                @db.VarChar(160)
  slug         String?               @db.VarChar(100)
  projectType  String                @default("general") @map("project_type") @db.VarChar(64)
  status       PlatformProjectStatus @default(active)
  visibility   ProjectVisibility     @default(private)
  description  String?               @db.Text
  coverAssetId String?               @map("cover_asset_id") @db.Uuid
  createdById  String                @map("created_by_id") @db.VarChar(64)
  updatedById  String?               @map("updated_by_id") @db.VarChar(64)
  version      Int                   @default(0)
  archivedAt   DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?             @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  assets    ProjectAsset[]
  auditLogs PlatformAuditLog[]
  aiJobs    AiJob[]
  documents PlatformDocument[]

  /// Active slug uniqueness is enforced by partial unique SQL:
  /// (workspace_id, slug) WHERE slug IS NOT NULL AND deleted_at IS NULL.
  @@unique([id, workspaceId], name: "uniq_platform_project_id_workspace", map: "platform_projects_id_workspace_unique")
  @@index([workspaceId, status, updatedAt(sort: Desc)], map: "platform_projects_workspace_recent_idx")
  @@index([createdById, createdAt(sort: Desc)], map: "platform_projects_creator_idx")
  @@index([projectType, status, updatedAt(sort: Desc)], map: "platform_projects_type_recent_idx")
  @@map("platform_projects")
}

model PlatformDocument {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  workspaceId          String                 @map("workspace_id") @db.Uuid
  projectId            String                 @map("project_id") @db.Uuid
  type                 PlatformDocumentType
  status               PlatformDocumentStatus @default(active)
  title                String                 @db.VarChar(160)
  slug                 String?                @db.VarChar(100)
  schemaVersion        String                 @default("2026-05-27") @map("schema_version") @db.VarChar(32)
  collaborationDialect String                 @default("fizzdragon.document.v1") @map("collaboration_dialect") @db.VarChar(64)
  collaborationRoomId  String                 @default(uuid(7)) @map("collaboration_room_id") @db.Uuid
  contentSnapshot      Json                   @default("{}") @map("content_snapshot") @db.JsonB
  crdtState            Bytes?                 @map("crdt_state")
  currentSequence      Int                    @default(0) @map("current_sequence")
  currentVersionId     String?                @map("current_version_id") @db.Uuid
  createdById          String                 @map("created_by_id") @db.VarChar(64)
  updatedById          String?                @map("updated_by_id") @db.VarChar(64)
  version              Int                    @default(0)
  archivedAt           DateTime?              @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?              @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   PlatformProject @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  versions       PlatformDocumentVersion[]
  operations     PlatformDocumentOperation[]
  presences      PlatformDocumentPresence[]
  commentThreads PlatformDocumentCommentThread[]
  assets         ProjectAsset[]
  aiJobs         AiJob[]

  /// Active slug uniqueness is enforced by partial unique SQL:
  /// (project_id, slug) WHERE slug IS NOT NULL AND deleted_at IS NULL.
  @@unique([id, workspaceId], name: "uniq_platform_document_id_workspace", map: "platform_documents_id_workspace_unique")
  @@unique([collaborationRoomId], map: "platform_documents_room_unique")
  @@index([projectId, type, updatedAt(sort: Desc)], map: "platform_documents_project_type_recent_idx")
  @@index([workspaceId, updatedAt(sort: Desc)], map: "platform_documents_workspace_recent_idx")
  @@index([status, updatedAt(sort: Desc)], map: "platform_documents_status_recent_idx")
  @@map("platform_documents")
}

model PlatformDocumentVersion {
  id            String                        @id @default(uuid(7)) @db.Uuid
  documentId    String                        @map("document_id") @db.Uuid
  versionNumber Int                           @map("version_number")
  schemaVersion String                        @map("schema_version") @db.VarChar(32)
  sequence      Int
  title         String?                       @db.VarChar(160)
  label         String?                       @db.VarChar(120)
  source        PlatformDocumentVersionSource @default(autosave)
  sourceId      String?                       @map("source_id") @db.VarChar(128)
  snapshot      Json                          @db.JsonB
  crdtState     Bytes?                        @map("crdt_state")
  metadata      Json                          @default("{}") @db.JsonB
  createdById   String                        @map("created_by_id") @db.VarChar(64)
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  document PlatformDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber], map: "platform_document_versions_doc_number_unique")
  @@index([documentId, createdAt(sort: Desc)], map: "platform_document_versions_doc_recent_idx")
  @@map("platform_document_versions")
}

model PlatformDocumentOperation {
  id               String                        @id @default(uuid(7)) @db.Uuid
  documentId       String                        @map("document_id") @db.Uuid
  sequence         Int
  operationType    PlatformDocumentOperationType @map("operation_type")
  actorUserId      String                        @map("actor_user_id") @db.VarChar(64)
  clientMutationId String?                       @map("client_mutation_id") @db.VarChar(128)
  idempotencyKey   String?                       @map("idempotency_key") @db.VarChar(160)
  baseSequence     Int?                          @map("base_sequence")
  patch            Json?                         @db.JsonB
  yjsUpdate        Bytes?                        @map("yjs_update")
  snapshot         Json?                         @db.JsonB
  metadata         Json                          @default("{}") @db.JsonB
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  document PlatformDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sequence], map: "platform_document_operations_doc_sequence_unique")
  @@index([documentId, createdAt(sort: Desc)], map: "platform_document_operations_doc_recent_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "platform_document_operations_actor_recent_idx")
  @@map("platform_document_operations")
}

model PlatformDocumentPresence {
  id           String   @id @default(uuid(7)) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  userId       String   @map("user_id") @db.VarChar(64)
  connectionId String   @map("connection_id") @db.VarChar(128)
  cursor       Json?    @db.JsonB
  selection    Json?    @db.JsonB
  metadata     Json     @default("{}") @db.JsonB
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document PlatformDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId, connectionId], map: "platform_document_presence_connection_unique")
  @@index([documentId, expiresAt], map: "platform_document_presence_active_idx")
  @@map("platform_document_presence")
}

model PlatformDocumentCommentThread {
  id           String                        @id @default(uuid(7)) @db.Uuid
  documentId   String                        @map("document_id") @db.Uuid
  blockId      String?                       @map("block_id") @db.VarChar(128)
  anchor       Json?                         @db.JsonB
