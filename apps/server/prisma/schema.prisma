/// Curated fictional performers. Unlock is free and workspace-scoped.
model AiActor {
  id           String          @id @default(uuid(7)) @db.Uuid
  name         String          @db.VarChar(64)
  photoAssetId String          @map("photo_asset_id") @db.Uuid
  active       Boolean         @default(false)
  category     String          @default("ai_actor") @db.VarChar(32)
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  photo        MediaAsset      @relation(fields: [photoAssetId], references: [id], onDelete: Restrict)
  unlocks      AiActorUnlock[]
  uses         AiActorUse[]

  @@index([category, archivedAt, active, createdAt, id])
  @@index([active, archivedAt, createdAt, id])
  @@index([active, createdAt, id])
  @@map("ai_actors")
}

model AiActorUnlock {
