  purchaseOrder IpPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ip_content_reports_purchase_order_fk")
  @@index([purchaseOrderId], map: "ip_content_reports_purchase_order_idx")
  id              String         @id @default(uuid(7)) @db.Uuid
  targetType      IpTargetType   @map("target_type")
  targetId        String         @map("target_id") @db.VarChar(64)
  ipId            String?        @map("ip_id") @db.Uuid
  episodeId       String?        @map("episode_id") @db.Uuid
  reporterUserId  String?        @map("reporter_user_id") @db.VarChar(64)
  reason          IpReportReason
  status          IpReportStatus @default(submitted)
  description     String?        @db.Text
  evidenceAssetId String?        @map("evidence_asset_id") @db.Uuid
  metadata        Json           @default("{}") @db.JsonB
  resolvedById    String?        @map("resolved_by_id") @db.VarChar(64)
  resolutionNote  String?        @map("resolution_note") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(6)

  ip            Ip?         @relation(fields: [ipId], references: [id], onDelete: SetNull)
  episode       IpEpisode?  @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  evidenceAsset MediaAsset? @relation("IpReportEvidenceAsset", fields: [evidenceAssetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Asc)], map: "ip_content_reports_queue_idx")
  @@index([targetType, targetId, createdAt(sort: Desc)], map: "ip_content_reports_target_idx")
  @@index([reporterUserId, createdAt(sort: Desc)], map: "ip_content_reports_reporter_idx")
  @@map("ip_content_reports")
}

model IpModerationAction {
  id          String                 @id @default(uuid(7)) @db.Uuid
  targetType  IpModerationTargetType @map("target_type")
  targetId    String                 @map("target_id") @db.VarChar(64)
  actionType  IpModerationActionType @map("action_type")
  actorUserId String                 @map("actor_user_id") @db.VarChar(64)
  reason      String                 @db.Text
  before      Json?                  @db.JsonB
  after       Json?                  @db.JsonB
  startsAt    DateTime?              @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?              @map("ends_at") @db.Timestamptz(6)
  metadata    Json                   @default("{}") @db.JsonB
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt(sort: Desc)], map: "ip_moderation_actions_target_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "ip_moderation_actions_actor_idx")
  @@map("ip_moderation_actions")
}

model IpUserContentBlock {
  id          String                @id @default(uuid(7)) @db.Uuid
  userId      String                @map("user_id") @db.VarChar(64)
  targetType  IpUserBlockTargetType @map("target_type")
  targetId    String                @map("target_id") @db.VarChar(64)
  ipId        String?               @map("ip_id") @db.Uuid
  reason      String?               @db.VarChar(160)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  unblockedAt DateTime?             @map("unblocked_at") @db.Timestamptz(6)

  ip Ip? @relation(fields: [ipId], references: [id], onDelete: SetNull)

  /// Active uniqueness is enforced by partial unique SQL:
  /// (user_id, target_type, target_id) WHERE unblocked_at IS NULL.
  @@index([userId, targetType, targetId], map: "ip_user_content_blocks_lookup_idx")
  @@map("ip_user_content_blocks")
}

// ─────────────────────────────────────────────────────────────
// Crew domain (src/crews/)
// ─────────────────────────────────────────────────────────────
//
// Server-owned crew module (剧组). End-to-end ownership: every table
// here is Prisma + Nest. `userId` columns reference the external auth
// user id space (string), but no FK crosses the boundary; orphaned rows
// just render as "Unknown user" client-side.
//
// Soft delete: `deletedAt` on Crew + CrewPosition (audit trail).
//   CrewMember uses `removedAt`; CrewApplication transitions through
//   status enum. Partial-unique indexes are defined in the migration
//   SQL (Prisma DSL can't express WHERE clauses on @@unique).
//
// Optimistic locking: Crew carries `version` (incremented on every
// update). The CrewsService.update path requires callers to supply
// expectedVersion so concurrent edits don't silently lose-update.
//
// Data integrity: CHECK constraints (recruitedCount / targetCount /
// revenue) are appended in the migration SQL — see comments below.

enum CrewPositionStatus {
  open
  frozen
  full
}

enum CrewListingStatus {
  unlisted
  listed
}

/// Platform moderation state, set by admins (post-hoc review), independent of
/// the owner-controlled `listingStatus`. A `taken_down` crew is removed from
/// every public surface (hall, detail, recruitment) regardless of listing.
enum CrewModerationStatus {
  ok
  taken_down
}

enum WorkMode {
  remote
  hybrid
  onsite
}

enum EmploymentType {
