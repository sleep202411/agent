/// Durable, idempotently-reconcilable BoldSign dispatch. Every send carries a
/// stable agreement label and metadata. A retry first searches BoldSign by
/// that label, so an HTTP response lost after provider acceptance does not
/// create a duplicate signature request.
model CrewAgreementSendJob {
  id            String                     @id @default(uuid(7)) @db.Uuid
  agreementId   String                     @unique(map: "crew_agreement_send_jobs_agreement_unique") @map("agreement_id") @db.Uuid
  status        CrewAgreementSendJobStatus @default(pending)
  attempt       Int                        @default(0)
  nextAttemptAt DateTime?                  @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt      DateTime?                  @map("locked_at") @db.Timestamptz(6)
  lockedBy      String?                    @map("locked_by") @db.VarChar(128)
  lastError     String?                    @map("last_error") @db.Text
  completedAt   DateTime?                  @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agreement CrewAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt], map: "crew_agreement_send_jobs_dispatch_idx")
  @@index([status, lockedAt], map: "crew_agreement_send_jobs_stale_lock_idx")
  @@map("crew_agreement_send_jobs")
}

/// Durable BoldSign artifact archival. The verified webhook only enqueues this
/// row; a leased worker downloads the signed PDF + audit trail and stores both
/// as restricted crew assets. This keeps provider/network IO outside webhook
/// transactions while preserving at-least-once recovery.
model CrewAgreementArchiveJob {
  id            String                        @id @default(uuid(7)) @db.Uuid
  agreementId   String                        @unique(map: "crew_agreement_archive_jobs_agreement_unique") @map("agreement_id") @db.Uuid
  status        CrewAgreementArchiveJobStatus @default(pending)
  attempt       Int                           @default(0)
  nextAttemptAt DateTime?                     @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt      DateTime?                     @map("locked_at") @db.Timestamptz(6)
  lockedBy      String?                       @map("locked_by") @db.VarChar(128)
  lastError     String?                       @map("last_error") @db.Text
  completedAt   DateTime?                     @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agreement CrewAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt], map: "crew_agreement_archive_jobs_dispatch_idx")
  @@index([status, lockedAt], map: "crew_agreement_archive_jobs_stale_lock_idx")
  @@map("crew_agreement_archive_jobs")
}

model CrewApplication {
  interviewEvents CrewApplicationInterviewEvent[]
  positionInvitations CrewPositionInvitation[]
  id          String  @id
  crewId      String  @map("crew_id")
  positionId  String  @map("position_id")
  applicantId String  @map("applicant_id")
  /// Cover letter / "why I'm a good fit". 1-1000 chars enforced at controller.
  message     String? @db.Text

  /// ─── Applicant self-report ───────────────────────────
  /// Optional external portfolio URL (LinkedIn / Behance / personal
  /// site). Even when NULL, owner sees the applicant's internal
  /// profile + published works via deeplinks derived from applicantId.
  portfolioUrl                 String?   @map("portfolio_url") @db.Text
  /// Applicant expected compensation, stored in the same smallest-unit
  /// convention as CrewPosition.salary* (CNY fen / USD cents / JPY yen).
  expectedCompensationAmount   BigInt?   @map("expected_compensation_amount")
  expectedCompensationCurrency String?   @map("expected_compensation_currency") @db.VarChar(3)
  expectedCompensationPeriod   String?   @map("expected_compensation_period") @db.VarChar(16)
  /// Earliest date the applicant can start.
  availableStartDate           DateTime? @map("available_start_date") @db.Date
  /// Years of relevant experience. CHECK >= 0.
  yearsExperience              Int?      @map("years_experience")

  termsVersion Int @default(0) @map("terms_version")
  terms CrewApplicationTerms[]

  status     CrewApplicationStatus @default(pending)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt DateTime?             @map("reviewed_at") @db.Timestamptz(6)
