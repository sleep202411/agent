}

enum BillingRefundStatus {
  /// Internal refund row was created and benefit reversal was reserved.
  requested
  /// Refund request was submitted to the payment provider and is waiting for
  /// provider acceptance, settlement, or failure webhooks.
  provider_pending
  /// Provider accepted/settled the refund and internal financial ledger was posted.
  succeeded
  /// Provider rejected the refund or internal safety checks failed; any reserved
  /// wallet or entitlement reversal must be restored before entering this state.
  failed
  /// Refund was canceled before provider submission. Submitted provider refunds
  /// are not canceled internally; they must follow provider state.
  canceled
}

enum BillingSubscriptionStatus {
  incomplete
  active
  past_due
  canceled
  expired
}

enum BillingLedgerAllocationTarget {
  /// Allocate fulfilled customer funds to wallet liability because the user
  /// received consumable platform balance.
  wallet_credit_liability
  /// Allocate fulfilled customer funds to deferred membership revenue until the
  /// membership service period is recognized.
  subscription_deferred_revenue
  /// Allocate fulfilled customer funds directly to earned revenue.
  immediate_revenue
}

enum BillingLedgerAccountType {
  asset
  liability
  revenue
  expense
  equity
  clearing
}

enum BillingLedgerNormalBalance {
  debit
  credit
}

enum BillingLedgerAccountStatus {
  active
  archived
}

enum BillingLedgerJournalType {
  /// Provider confirmed money capture: debit provider receivable, credit customer
  /// funds clearing.
  payment_capture
  /// Order fulfillment allocation: debit customer funds clearing, credit wallet
  /// liability / deferred revenue / immediate revenue according to price policy.
  fulfillment_allocation
  /// Provider settlement or payout batch. Used to reconcile money received and
  /// provider-side payout references.
  settlement
  /// Customer refund against a paid order.
  refund
  /// Provider dispute / chargeback. Kept separate from normal refunds.
  chargeback
  /// Recognition of previously deferred membership revenue.
  revenue_recognition
  /// Payment provider fees, usually imported from settlement data.
  provider_fee
  /// Finance correction journal. It is not a regular way to grant credits and
  /// must carry admin audit context.
  manual_adjustment
  /// Reversal of an already posted journal; original journal remains immutable.
  reversal
}

enum BillingLedgerJournalStatus {
  posted
  reversed
  voided
}

enum BillingLedgerEntryDirection {
