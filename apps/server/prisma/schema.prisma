// ─────────────────────────────────────────────────────────────
// IP Commerce domain (src/ip-commerce/)
// ─────────────────────────────────────────────────────────────
//
// New source of truth for public IP titles, episode commerce,
// community-point purchases, presale campaigns, creator revenue,
// referral attribution, review, rights declarations, reports, and
// moderation. This deliberately does not mirror Java's project /
// episode tables. A PlatformProject is the internal production
// workspace; an IpTitle is the public commercial object users buy.
//
// Money movement invariant:
//   IpPurchaseOrder -> WalletTransaction -> IpContentEntitlement
//
// No service is allowed to unlock content by directly mutating an IP
// row. Unlock state is always derived from entitlements and wallet
// ledger history.

model IpTitle {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  sourceProjectId   String?             @map("source_project_id") @db.Uuid
  slug              String?             @db.VarChar(120)
  contentType       IpContentType       @default(series) @map("content_type")
  status            IpPublicationStatus @default(draft)
  listingVisibility IpListingVisibility @default(private) @map("listing_visibility")
  ageRating         IpAgeRating         @default(general) @map("age_rating")
  title             String              @db.VarChar(160)
  subtitle          String?             @db.VarChar(160)
  summary           String              @db.VarChar(500)
  description       String?             @db.Text
  language          String              @default("zh-CN") @db.VarChar(16)
  genres            String[]            @default([])
  tags              String[]            @default([])
  copyrightOwner    String?             @map("copyright_owner") @db.VarChar(160)
  rightsSummary     Json                @default("{}") @map("rights_summary") @db.JsonB
  aiDisclosure      Json                @default("{}") @map("ai_disclosure") @db.JsonB
  coverAssetId      String?             @map("cover_asset_id") @db.Uuid
  heroAssetId       String?             @map("hero_asset_id") @db.Uuid
  trailerAssetId    String?             @map("trailer_asset_id") @db.Uuid
  createdById       String              @map("created_by_id") @db.VarChar(64)
  updatedById       String?             @map("updated_by_id") @db.VarChar(64)
  version           Int                 @default(0)
  scheduledAt       DateTime?           @map("scheduled_at") @db.Timestamptz(6)
  publishedAt       DateTime?           @map("published_at") @db.Timestamptz(6)
  suspendedAt       DateTime?           @map("suspended_at") @db.Timestamptz(6)
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceProject PlatformProject? @relation("IpTitleSourceProject", fields: [sourceProjectId], references: [id], onDelete: SetNull)
  coverAsset    MediaAsset?      @relation("IpTitleCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  heroAsset     MediaAsset?      @relation("IpTitleHeroAsset", fields: [heroAssetId], references: [id], onDelete: SetNull)
  trailerAsset  MediaAsset?      @relation("IpTitleTrailerAsset", fields: [trailerAssetId], references: [id], onDelete: SetNull)

  episodes             IpEpisode[]
  campaigns            IpCampaign[]
  priceRules           IpPriceRule[]
  purchaseOrders       IpPurchaseOrder[]
  entitlements         IpContentEntitlement[]
  collectionItems      IpCollectionItem[]
  contributors         IpContributor[]
  revenueRules         IpRevenueRule[]
  revenueEntries       IpRevenueLedgerEntry[]
  referralLinks        IpReferralLink[]
  referralAttributions IpReferralAttribution[]
  reviewSubmissions    IpReviewSubmission[]
  rightsDeclarations   IpRightsDeclaration[]
  reports              IpContentReport[]
  userBlocks           IpUserContentBlock[]
  importMaps           IpImportMap[]

  /// Active public slug uniqueness is enforced by partial unique SQL:
  /// (slug) WHERE slug IS NOT NULL AND deleted_at IS NULL.
  @@unique([id, workspaceId], name: "uniq_ip_title_id_workspace", map: "ip_titles_id_workspace_unique")
  @@index([workspaceId, status, updatedAt(sort: Desc)], map: "ip_titles_workspace_recent_idx")
  @@index([status, listingVisibility, publishedAt(sort: Desc)], map: "ip_titles_public_feed_idx")
  @@index([contentType, status, publishedAt(sort: Desc)], map: "ip_titles_type_feed_idx")
  @@map("ip_titles")
}

