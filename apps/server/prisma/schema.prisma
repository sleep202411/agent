enum IpRevenueLedgerEntryType {
  /// Creator/contributor earned a share of a sale.
  revenue_share
  /// Reserved for a future refund clawback (negative amount). Not written yet.
  refund_reversal
  /// Reserved for a future manual ops adjustment. Not written yet.
  manual_adjustment
}

enum IpRevenueLedgerStatus {
  pending
  posted
  voided
}

/// System-of-record for creator-side revenue from IP sales. One row per
/// beneficiary per order, linked to the wallet credit that minted the
/// withdrawable community points. Earning-only: no fiat payout. Forward-compat
/// for refunds (refund_reversal + voided) and multi-contributor splits.
model IpRevenueLedgerEntry {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  /// Beneficiary platform user id (creator/contributor). VarChar to match the
  /// Java numeric user id stored as string across the IP schema.
  userId              String                   @map("user_id") @db.VarChar(64)
  ipId                String                   @map("ip_id") @db.Uuid
  episodeId           String?                  @map("episode_id") @db.Uuid
  /// Nullable: ip_sale rows are order-scoped; member_pool/licensing rows are not.
  orderId             String?                  @map("order_id") @db.Uuid
  walletTransactionId String?                  @map("wallet_transaction_id") @db.Uuid
  entryType           IpRevenueLedgerEntryType @default(revenue_share) @map("entry_type")
  status              IpRevenueLedgerStatus    @default(posted)
  /// Where this earning came from. ip_sale = per-sale revenue share (existing);
  /// member_pool = monthly community-membership pool; licensing = FUTURE deal.
  sourceType          IpRevenueSourceType      @default(ip_sale) @map("source_type")
  /// Set for member_pool rows (the settlement batch id); NULL for sales.
  settlementBatchId   String?                  @map("settlement_batch_id") @db.Uuid
  currency            WalletCurrencyType       @default(community_point)
  balanceKind         WalletBalanceKind        @default(withdrawable) @map("balance_kind")
  /// Credited amount in community-point minor units. Positive for revenue_share.
  amount              BigInt
  /// The order total this share was computed from (context for audit/stats).
  sourceAmount        BigInt?                  @map("source_amount")
  /// Effective share this beneficiary received, in basis points of the creator
  /// pool (0..10000). For display/audit only.
  shareBps            Int?                     @map("share_bps")
  metadata            Json                     @default("{}") @db.JsonB
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt            DateTime?                @default(now()) @map("posted_at") @db.Timestamptz(6)
  voidedAt            DateTime?                @map("voided_at") @db.Timestamptz(6)

  ip                Ip                 @relation(fields: [ipId], references: [id], onDelete: Cascade)
  order             IpPurchaseOrder?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  /// One credit row per beneficiary per order per entry type — durable
  /// double-pay backstop on top of the per-beneficiary wallet idempotency key.
  @@unique([orderId, userId, entryType], map: "ip_revenue_ledger_order_user_type_unique")
  @@index([userId, status, createdAt(sort: Desc)], map: "ip_revenue_ledger_user_recent_idx")
  @@index([ipId, status, createdAt(sort: Desc)], map: "ip_revenue_ledger_ip_recent_idx")
  @@index([orderId], map: "ip_revenue_ledger_order_idx")
  @@index([sourceType, status, createdAt(sort: Desc)], map: "ip_revenue_ledger_source_idx")
  @@index([settlementBatchId], map: "ip_revenue_ledger_settlement_batch_idx")
  @@map("ip_revenue_ledger_entries")
}

