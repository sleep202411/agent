  installation    ProjectSkillInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  skill           SkillCatalogItem          @relation(fields: [skillId], references: [id], onDelete: Restrict)
  version         SkillVersion?             @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([platformProjectId, createdAt(sort: Desc)], map: "project_skill_audits_platform_recent_idx")
  @@index([storyProjectId, createdAt(sort: Desc)], map: "project_skill_audits_story_recent_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "project_skill_audits_actor_recent_idx")
  @@map("project_skill_audits")
