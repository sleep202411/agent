/// Interactive-film play save (存档): one "current run" save slot per user,
/// per game, per chapter. Chapters are independent runtime manifests, so a
/// serial work keeps one slot each; the (userId, gameId, updatedAt desc)
/// index backs the "continue where you last played" lookup. The save is
/// never wiped by a republish — the player validates it against the live
/// manifest on restore. Clearing retains a revisioned tombstone, so a late
/// request cannot restore an earlier run or clear a newer save.
model StoryPlaySave {
  userId         String                @map("user_id") @db.VarChar(64)
  gameId         String                @map("game_id") @db.VarChar(128)
  /// Empty string for single-chapter works (no chapter identity exists).
  chapterId      String                @map("chapter_id") @db.VarChar(128)
  /// Diagnostics only — restore gates on the live manifest, not this value.
  contentVersion String                @map("content_version") @db.VarChar(128)
  /// ExperienceRuntimeState snapshot, stored verbatim.
  state          Json
  /// Pending event batch parked at a paid gate; normally [].
  events         Json
  /// Media cursor and watched bounds, validated by the player on restore.
  playback       Json?
  /// Small journey metadata; rewind checkpoints live in normalized child rows.
  journey        Json?
  journeyAnchors StoryPlaySaveAnchor[]
  /// Every successful write or clear advances the slot's revision.
  revision       Int                   @default(0)
  cleared        Boolean               @default(false)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, gameId, chapterId])
  @@index([userId, gameId, updatedAt(sort: Desc)], map: "story_play_saves_latest_idx")
  @@map("story_play_saves")
}

/// A single current rewind checkpoint for each visited scene in a save slot.
model StoryPlaySaveAnchor {
  userId    String        @map("user_id") @db.VarChar(64)
  gameId    String        @map("game_id") @db.VarChar(128)
  chapterId String        @map("chapter_id") @db.VarChar(128)
  sceneId   String        @map("scene_id") @db.VarChar(160)
  anchor    Json
  sizeBytes Int           @map("size_bytes")
  save      StoryPlaySave @relation(fields: [userId, gameId, chapterId], references: [userId, gameId, chapterId], onDelete: Cascade)

  @@id([userId, gameId, chapterId, sceneId])
  @@map("story_play_save_anchors")
}

