model Workspace {
  crewComputeBudget CrewProjectComputeBudget?
  actorUnlocks     AiActorUnlock[]
  actorUses        AiActorUse[]
  id               String          @id @default(uuid(7)) @db.Uuid
  /// Stable destination for this user's account credits and initial selection.
  defaultForUserId String?         @unique @map("default_for_user_id") @db.VarChar(64)
  status           WorkspaceStatus @default(active)
  name             String          @db.VarChar(120)
  slug             String?         @db.VarChar(80)
  avatarUrl        String?         @map("avatar_url") @db.VarChar(512)
  description      String?         @db.VarChar(500)
  /// External authenticated owner id; no FK to external user tables.
  ownerUserId      String          @map("owner_user_id") @db.VarChar(64)
  createdById      String          @map("created_by_id") @db.VarChar(64)
  defaultProjectId String?         @map("default_project_id") @db.Uuid
  version          Int             @default(0)
  suspendedAt      DateTime?       @map("suspended_at") @db.Timestamptz(6)
  archivedAt       DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)

  members                   WorkspaceMember[]
  invites                   WorkspaceInvite[]
  projects                  PlatformProject[]
  auditLogs                 PlatformAuditLog[]
  projectAssets             ProjectAsset[]
  aiJobs                    AiJob[]
  mediaAssets               MediaAsset[]
  storyProjects             StoryProject[]
  studioCharacters          StudioCharacter[]
  mediaAssetUsages          MediaAssetUsage[]
  documents                 StudioDocument[]
  projectSkillStates        ProjectSkillState[]
  projectSkillInstallations ProjectSkillInstallation[]
  projectSkillAudits        ProjectSkillAudit[]
  projectSkillMutations     ProjectSkillMutation[]
  skillCatalogItems         SkillCatalogItem[]         @relation("SkillCatalogWorkspace")
  worldModelWorlds          WorldModelWorld[]
  worldModelSessions        WorldModelSession[]
  worldModelTravels         WorldModelTravel[]
  billingOrders             BillingOrder[]
  subscriptions             BillingSubscription[]
  crew                      Crew?                      @relation("CrewWorkspace")
  studioCrew                Crew?                      @relation("CrewStudioWorkspace")
  contentReviewRecords      ContentReviewRecord[]

  @@index([ownerUserId, deletedAt], map: "workspaces_owner_idx")
  @@index([status, updatedAt(sort: Desc)], map: "workspaces_status_recent_idx")
  @@map("workspaces")
}

model WorkspaceMember {
  id          String                     @id @default(uuid(7)) @db.Uuid
  workspaceId String                     @map("workspace_id") @db.Uuid
  userId      String                     @map("user_id") @db.VarChar(64)
  role        WorkspaceMemberRole
  status      WorkspaceMemberStatus      @default(active)
  accessScope WorkspaceMemberAccessScope @default(workspace) @map("access_scope")
  invitedById String?                    @map("invited_by_id") @db.VarChar(64)
  joinedAt    DateTime?                  @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt   DateTime?                  @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Active uniqueness is enforced by partial unique SQL:
  /// (workspace_id, user_id) WHERE removed_at IS NULL.
  @@index([userId, status], map: "workspace_members_by_user_idx")
  @@index([workspaceId, status, role], map: "workspace_members_by_workspace_idx")
  @@index([workspaceId, accessScope, status], map: "workspace_members_scope_idx")
  @@map("workspace_members")
}

model WorkspaceInvite {
  id            String                @id @default(uuid(7)) @db.Uuid
  workspaceId   String                @map("workspace_id") @db.Uuid
  inviteeUserId String?               @map("invitee_user_id") @db.VarChar(64)
  inviteeEmail  String?               @map("invitee_email") @db.VarChar(320)
  role          WorkspaceMemberRole
  tokenHash     String                @map("token_hash") @db.VarChar(128)
  status        WorkspaceInviteStatus @default(pending)
  invitedById   String                @map("invited_by_id") @db.VarChar(64)
  acceptedAt    DateTime?             @map("accepted_at") @db.Timestamptz(6)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  expiresAt     DateTime?             @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "workspace_invites_token_hash_unique")
  @@index([workspaceId, status, createdAt(sort: Desc)], map: "workspace_invites_by_workspace_idx")
  @@index([inviteeUserId, status], map: "workspace_invites_by_user_idx")
  @@index([inviteeEmail, status], map: "workspace_invites_by_email_idx")
  @@map("workspace_invites")
}

model PlatformProject {
  actorUses AiActorUse[]
  crewAssetFolders CrewAssetNode[] @relation("CrewCanvasAssetFolder")
  linkedCrewAssetNodes CrewAssetNode[] @relation("CrewAssetLinkedStudioProject")
  id           String                @id @default(uuid(7)) @db.Uuid
  workspaceId  String                @map("workspace_id") @db.Uuid
  name         String                @db.VarChar(160)
  slug         String?               @db.VarChar(100)
  projectType  String                @default("general") @map("project_type") @db.VarChar(64)
  status       PlatformProjectStatus @default(active)
  visibility   ProjectVisibility     @default(private)
  description  String?               @db.Text
  coverAssetId String?               @map("cover_asset_id") @db.Uuid
  createdById  String                @map("created_by_id") @db.VarChar(64)
  updatedById  String?               @map("updated_by_id") @db.VarChar(64)
  version      Int                   @default(0)
  archivedAt   DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?             @map("deleted_at") @db.Timestamptz(6)

  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members            ProjectMember[]
  invites            ProjectInvite[]
  sections           PlatformProjectSection[]
  assets             ProjectAsset[]
  auditLogs          PlatformAuditLog[]
  aiJobs             AiJob[]
  mediaAssetUsages   MediaAssetUsage[]
  documents          StudioDocument[]
  characterCast      CharacterProjectCast[]
  characterGrants    CharacterProjectGrant[]
  castingInvites     CharacterCastingInvite[]
  productionCrew     Crew?                      @relation("CrewProductionProject")
  studioCrew         Crew?                      @relation("CrewStudioProject")
  crewTaskCanvas     CrewTask?                  @relation("CrewTaskCanvasProject")
  agentOsState       AgentOsProjectState?
  agentOsAttachments AgentOsAttachment[]
  skillState         ProjectSkillState?
  skillInstallations ProjectSkillInstallation[]
  skillAudits        ProjectSkillAudit[]
  skillCatalogItems  SkillCatalogItem[]         @relation("SkillCatalogPlatformProject")

  /// Active slug uniqueness is enforced by partial unique SQL:
  /// (workspace_id, slug) WHERE slug IS NOT NULL AND deleted_at IS NULL.
  @@unique([id, workspaceId], name: "uniq_platform_project_id_workspace", map: "platform_projects_id_workspace_unique")
  @@index([workspaceId, status, updatedAt(sort: Desc)], map: "platform_projects_workspace_recent_idx")
  @@index([createdById, createdAt(sort: Desc)], map: "platform_projects_creator_idx")
  @@index([projectType, status, updatedAt(sort: Desc)], map: "platform_projects_type_recent_idx")
  @@map("platform_projects")
}

/// A project-owned narrative/content partition. The product may label this as
/// a chapter, episode, scene, or page, but the persistence boundary stays
/// neutral. Each section owns its own mode documents; today canvas is required.
model PlatformProjectSection {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String    @db.VarChar(160)
  rank        Int
  version     Int       @default(0)
  createdById String    @map("created_by_id") @db.VarChar(64)
  updatedById String?   @map("updated_by_id") @db.VarChar(64)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project   PlatformProject  @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  documents StudioDocument[]

  @@unique([id, projectId], name: "uniq_platform_project_section_id_project", map: "platform_project_sections_id_project_unique")
  @@index([projectId, archivedAt, rank], map: "platform_project_sections_project_rank_idx")
  @@index([workspaceId, updatedAt(sort: Desc)], map: "platform_project_sections_workspace_recent_idx")
  @@map("platform_project_sections")
}

/// Agent OS durable project state for Platform (studio) projects.
/// Characters and script sections are product facts; LangGraph checkpoints
/// stay separate.
model AgentOsProjectState {
  projectId       String   @id @map("project_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  revision        Int      @default(0)
  characters      Json     @default("[]") @db.JsonB
  scriptSections  Json     @default("[]") @map("script_sections") @db.JsonB
  updatedByUserId String?  @map("updated_by_user_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project PlatformProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt(sort: Desc)], map: "agent_os_project_states_workspace_recent_idx")
  @@map("agent_os_project_states")
}

/// Marketplace identity. Published behavior lives in immutable SkillVersion
/// rows; catalog metadata can evolve without changing a project installation.
model SkillCatalogItem {
  id                       String                 @id @default(uuid(7)) @db.Uuid
  workspaceId              String?                @map("workspace_id") @db.Uuid
  platformProjectId        String?                @map("platform_project_id") @db.Uuid
  storyProjectId           String?                @map("story_project_id") @db.Uuid
  createdByUserId          String?                @map("created_by_user_id") @db.VarChar(64)
  slug                     String                 @unique @db.VarChar(128)
  name                     String                 @db.VarChar(160)
  description              String                 @db.Text
  localizedMetadata        Json                   @default("{}") @map("localized_metadata") @db.JsonB
  publisherName            String                 @map("publisher_name") @db.VarChar(160)
  category                 String                 @db.VarChar(64)
  kind                     SkillKind
  visibility               SkillCatalogVisibility @default(public)
  status                   SkillCatalogStatus     @default(draft)
  previewUrl               String?                @map("preview_url") @db.VarChar(1024)
  previewVideoUrl          String?                @map("preview_video_url") @db.VarChar(1024)
  latestPublishedVersionId String?                @unique @map("latest_published_version_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions               SkillVersion[]             @relation("SkillVersions")
  latestPublishedVersion SkillVersion?              @relation("SkillLatestPublishedVersion", fields: [latestPublishedVersionId], references: [id], onDelete: Restrict)
  workspace              Workspace?                 @relation("SkillCatalogWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  platformProject        PlatformProject?           @relation("SkillCatalogPlatformProject", fields: [platformProjectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  storyProject           StoryProject?              @relation("SkillCatalogStoryProject", fields: [storyProjectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  installations          ProjectSkillInstallation[]
  audits                 ProjectSkillAudit[]

  @@index([status, visibility, category, updatedAt(sort: Desc)], map: "skill_catalog_discovery_idx")
  @@index([kind, status, updatedAt(sort: Desc)], map: "skill_catalog_kind_idx")
  @@index([workspaceId, visibility, status, updatedAt(sort: Desc)], map: "skill_catalog_workspace_scope_idx")
  @@index([platformProjectId, status, updatedAt(sort: Desc)], map: "skill_catalog_platform_scope_idx")
  @@index([storyProjectId, status, updatedAt(sort: Desc)], map: "skill_catalog_story_scope_idx")
  @@map("skill_catalog_items")
}

/// A published version is immutable. The migration installs a database trigger
/// that rejects UPDATE/DELETE for published rows, so an old job/run can always
/// reproduce the exact instructions and policy it originally mounted.
model SkillVersion {
  id                    String             @id @default(uuid(7)) @db.Uuid
  skillId               String             @map("skill_id") @db.Uuid
  version               String             @db.VarChar(32)
  status                SkillVersionStatus @default(draft)
  manifestSchemaVersion String             @map("manifest_schema_version") @db.VarChar(32)
  instructions          String             @db.Text
  generationPolicy      Json               @default("{}") @map("generation_policy") @db.JsonB
  configSchema          Json               @default("{}") @map("config_schema") @db.JsonB
  capabilities          Json               @default("[]") @db.JsonB
  projectKinds          Json               @default("[]") @map("project_kinds") @db.JsonB
  workbenchModes        Json               @default("[]") @map("workbench_modes") @db.JsonB
  toolIds               Json               @default("[]") @map("tool_ids") @db.JsonB
  riskPolicy            Json               @default("{}") @map("risk_policy") @db.JsonB
  evalSuite             String?            @map("eval_suite") @db.VarChar(240)
  checksum              String             @db.VarChar(64)
  publishedAt           DateTime?          @map("published_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  skill                 SkillCatalogItem           @relation("SkillVersions", fields: [skillId], references: [id], onDelete: Restrict)
  latestForCatalogItems SkillCatalogItem[]         @relation("SkillLatestPublishedVersion")
  pinnedInstallations   ProjectSkillInstallation[]
  audits                ProjectSkillAudit[]

  @@unique([skillId, version], map: "skill_versions_skill_version_unique")
  @@unique([id, skillId], map: "skill_versions_id_skill_unique")
  @@index([skillId, status, publishedAt(sort: Desc)], map: "skill_versions_published_idx")
  @@map("skill_versions")
}

/// Monotonic project-level revision and serialization row for Skill mutations.
/// Exactly one project owner is enforced by SQL, matching StudioDocument.
model ProjectSkillState {
  id                String   @id @default(uuid(7)) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
