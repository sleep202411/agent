  activations     ProjectSkillActivation[]
  audits          ProjectSkillAudit[]

  @@index([platformProjectId, status, updatedAt(sort: Desc)], map: "project_skill_installations_platform_recent_idx")
  @@index([storyProjectId, status, updatedAt(sort: Desc)], map: "project_skill_installations_story_recent_idx")
  @@index([skillId, pinnedVersionId], map: "project_skill_installations_version_idx")
  @@map("project_skill_installations")
}

model ProjectSkillActivation {
  id             String            @id @default(uuid(7)) @db.Uuid
  installationId String            @map("installation_id") @db.Uuid
  scope          ProjectSkillScope
  workbenchMode  String            @default("") @map("workbench_mode") @db.VarChar(64)
