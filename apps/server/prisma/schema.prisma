  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@id([actorId, workspaceId])
  @@map("ai_actor_unlocks")
}

/// A reference issued for a Canvas insertion; not a generation or credit charge.
