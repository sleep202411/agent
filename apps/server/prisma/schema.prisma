  @@index([provider, providerCheckoutId], map: "billing_payment_intents_provider_checkout_idx")
  @@index([provider, providerPaymentIntentId], map: "billing_payment_intents_provider_pi_idx")
  @@index([status, updatedAt(sort: Desc)], map: "billing_payment_intents_status_idx")
  @@map("billing_payment_intents")
}

model BillingPaymentProviderEvent {
  id              String                     @id @default(uuid(7)) @db.Uuid
  provider        PaymentProvider
  /// Stable provider webhook/event id. This is the idempotency key for ingestion.
  providerEventId String                     @map("provider_event_id") @db.VarChar(160)
  /// Provider-native event type, for example billing_checkout.completed or refund.settled.
  eventType       String                     @map("event_type") @db.VarChar(120)
  /// Operational processing state. Failed/ignored events remain queryable and auditable.
  status          PaymentProviderEventStatus @default(received)
  /// Matched internal order, if this event can be tied to one.
  orderId         String?                    @map("order_id") @db.Uuid
  /// Matched internal payment intent, if this event affects payment state.
  paymentIntentId String?                    @map("payment_intent_id") @db.Uuid
  /// Matched internal refund, if this event affects refund state.
  refundId        String?                    @map("refund_id") @db.Uuid
  /// Raw provider payload for replay, support escalation, and audit evidence.
  payload         Json                       @db.JsonB
  /// Last processing error or manual ignore reason.
  error           String?                    @db.Text
  receivedAt      DateTime                   @default(now()) @map("received_at") @db.Timestamptz(6)
  /// Set once processing reached a terminal processed/ignored/failed state.
  processedAt     DateTime?                  @map("processed_at") @db.Timestamptz(6)

  paymentIntent  BillingPaymentIntent?  @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  refund         BillingRefund?         @relation(fields: [refundId], references: [id], onDelete: SetNull)
  ledgerJournals BillingLedgerJournal[]

  @@unique([provider, providerEventId], map: "billing_provider_events_provider_event_unique")
  @@index([status, receivedAt(sort: Desc)], map: "billing_provider_events_status_recent_idx")
  @@index([orderId, receivedAt(sort: Desc)], map: "billing_provider_events_order_recent_idx")
  @@index([paymentIntentId, receivedAt(sort: Desc)], map: "billing_provider_events_intent_recent_idx")
  @@index([refundId, receivedAt(sort: Desc)], map: "billing_provider_events_refund_recent_idx")
  @@map("billing_payment_provider_events")
}

model BillingRefund {
  id                      String              @id @default(uuid(7)) @db.Uuid
  refundNo                String              @map("refund_no") @db.VarChar(64)
  orderId                 String              @map("order_id") @db.Uuid
  paymentIntentId         String?             @map("payment_intent_id") @db.Uuid
  provider                PaymentProvider
  status                  BillingRefundStatus @default(requested)
  /// Admin/API idempotency key. Retrying the same refund action must return the
  /// same refund instead of creating a second provider refund.
  idempotencyKey          String              @map("idempotency_key") @db.VarChar(180)
  /// Provider request id used for Airwallex request_id and future providers'
  /// idempotency/request identifiers.
  requestId               String              @map("request_id") @db.VarChar(64)
  providerRefundId        String?             @map("provider_refund_id") @db.VarChar(128)
  providerPaymentIntentId String?             @map("provider_payment_intent_id") @db.VarChar(128)
  providerStatus          String?             @map("provider_status") @db.VarChar(64)
  currency                String              @db.Char(3)
  amountMinor             BigInt              @map("amount_minor")
  reasonCode              String              @map("reason_code") @db.VarChar(64)
  operatorNote            String?             @map("operator_note") @db.Text
  /// Virtual wallet amount reserved/reversed before provider submission, if the
  /// refunded order had already granted consumable credits.
  walletReversalCurrency  WalletCurrencyType? @map("wallet_reversal_currency")
  walletReversalAmount    BigInt?             @map("wallet_reversal_amount")
  walletTransactionId     String?             @map("wallet_transaction_id") @db.Uuid
  /// Entitlement revoked before provider submission for admin-approved membership refunds.
  /// The refund amount is capped by policy/unused service time; the remaining
  /// entitlement is revoked before sending the provider refund request.
  entitlementGrantId      String?             @map("entitlement_grant_id") @db.Uuid
  failureCode             String?             @map("failure_code") @db.VarChar(80)
  failureMessage          String?             @map("failure_message") @db.Text
  providerPayload         Json                @default("{}") @map("provider_payload") @db.JsonB
  metadata                Json                @default("{}") @db.JsonB
  requestedById           String              @map("requested_by_id") @db.VarChar(64)
  submittedAt             DateTime?           @map("submitted_at") @db.Timestamptz(6)
  succeededAt             DateTime?           @map("succeeded_at") @db.Timestamptz(6)
  failedAt                DateTime?           @map("failed_at") @db.Timestamptz(6)
  canceledAt              DateTime?           @map("canceled_at") @db.Timestamptz(6)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order             BillingOrder                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentIntent     BillingPaymentIntent?         @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  walletTransaction WalletTransaction?            @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  entitlementGrant  EntitlementGrant?             @relation(fields: [entitlementGrantId], references: [id], onDelete: SetNull)
  events            BillingPaymentProviderEvent[]
  refundEvents      BillingRefundEvent[]
  ledgerJournals    BillingLedgerJournal[]

  @@unique([refundNo], map: "billing_refunds_no_unique")
  @@unique([idempotencyKey], map: "billing_refunds_idempotency_unique")
  @@unique([requestId], map: "billing_refunds_request_id_unique")
  @@index([orderId, createdAt(sort: Desc)], map: "billing_refunds_order_recent_idx")
  @@index([paymentIntentId, createdAt(sort: Desc)], map: "billing_refunds_intent_recent_idx")
  @@index([walletTransactionId], map: "billing_refunds_wallet_transaction_idx")
  @@index([entitlementGrantId], map: "billing_refunds_entitlement_grant_idx")
  @@index([provider, providerRefundId], map: "billing_refunds_provider_refund_idx")
  @@index([status, updatedAt(sort: Desc)], map: "billing_refunds_status_recent_idx")
  @@map("billing_refunds")
}

