// Prisma schema — DATABASE_URL configured in `prisma.config.ts`.
//
// Migrations live under `prisma/migrations/` and are applied via
// `npm run db:migrate`. Models live alongside the module that owns
// them in src/<module>/.
//
// ID convention:
// - Legacy/product modules that expose compact URL ids use app-generated
//   short ids from src/common/id.ts.
// - Platform Core modules use UUID primary keys so workspace/project/wallet
//   records stay globally unique across future regional cells and admin tools.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Platform Core domain (src/workspaces/)
// ─────────────────────────────────────────────────────────────
//
// New-platform source of truth. This domain deliberately does not
// mirror Java's project / point tables. Java may still provide the
// authenticated external user id, but ownership, permissions, wallet
// accounting, project assets, and audit records below are all Nest +
// Postgres owned.
//
// Invariant:
//   Workspace → Project → ProjectAsset
//
// Assets belong to projects. Projects belong to workspaces. A personal
// project and a team project therefore use the same asset schema; the
// difference is the workspace owner, governance, wallet, and audit
// policy around that project.

