  preferredVariant MediaAssetVariant?                @relation("StoryAssetSpecPreferredRendition", fields: [preferredVariantId, mediaAssetId], references: [id, assetId], onDelete: Restrict)
  selectedForSpec  StoryAssetSpec[]                  @relation("StoryAssetSpecSelectedMediaVersion")
  pinnedByBindings StoryStoryboardClipAssetBinding[]
