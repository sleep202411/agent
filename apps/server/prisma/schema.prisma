/// Append-only adjudication; original submission/entry evidence is preserved.
model CrewTrustCorrection {
  revision     BigInt             @default(autoincrement())
  submission   CrewTaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  appeals      CrewTrustAppeal[]
  id           String             @id @db.Uuid
  submissionId String             @map("submission_id") @db.Uuid
  points       Int
  reviewerId   String             @map("reviewer_id") @db.VarChar(64)
  reason       String             @db.Text
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([submissionId, revision(sort: Desc)], map: "crew_trust_corrections_submission")
  @@map("crew_trust_corrections")
}

model CrewTrustAppeal {
  entry        CrewCreatorTrustEntry @relation(fields: [taskId, userId], references: [taskId, userId], onDelete: Restrict, onUpdate: NoAction)
  correction   CrewTrustCorrection?  @relation(fields: [correctionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  id           String                @id @db.Uuid
  taskId       String                @map("task_id") @db.Uuid
  userId       String                @map("user_id") @db.VarChar(64)
  reason       String                @db.Text
  status       String                @default("pending") @db.VarChar(16)
  reviewerId   String?               @map("reviewer_id") @db.VarChar(64)
  reviewReason String?               @map("review_reason") @db.Text
  correctionId String?               @map("correction_id") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt   DateTime?             @map("reviewed_at") @db.Timestamptz(6)

  @@index([taskId, userId, createdAt(sort: Desc), id(sort: Desc)], map: "crew_trust_appeal_history")
  @@map("crew_trust_appeals")
}

/// Explicit ownership-verified associations; sourceIpId is never imported.
model IpGameAssociationRevision {
  gameId        String                     @map("game_id") @db.Uuid
  version       Int
  ipId          String                     @map("ip_id") @db.Uuid
  releaseId     String                     @map("release_id") @db.Uuid
