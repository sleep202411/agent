/// Durable publication lifecycle for one exact immutable Build. The row and
/// its media authorization are persisted before contacting Java. Java remains
/// the current-version authority and owns the CDN Manifest; reconciliation
/// records what Java most recently reported without rewriting release identity.
model StoryExperiencePublication {
  id                  String                           @id @default(uuid(7)) @db.Uuid
  buildId             String                           @unique @map("build_id") @db.Uuid
  storyProjectId      String                           @map("story_project_id") @db.Uuid
  gameId              String                           @map("game_id") @db.VarChar(160)
  contentVersion      String                           @map("content_version") @db.VarChar(160)
  status              StoryExperiencePublicationStatus @default(pending)
  requestedSetCurrent Boolean                          @default(true) @map("requested_set_current")
  requestedByUserId   String                           @map("requested_by_user_id") @db.VarChar(64)

  /// An explicit grant for anonymous exchange of this Build's frozen stable
  /// media URIs. The grant timestamp is immutable and created before Java can
  /// fetch the Manifest. Only a definitive `rejected` result may append a
  /// revocation; pending, uncertain, and confirmed rows remain authorized.
  mediaAuthorizedAt           DateTime  @default(now()) @map("media_authorized_at") @db.Timestamptz(6)
  mediaAuthorizationRevokedAt DateTime? @map("media_authorization_revoked_at") @db.Timestamptz(6)

  /// Java response fields are unknown while pending/uncertain and become
  /// immutable once a matching acknowledgement has been confirmed.
  manifestUrl String?   @map("manifest_url") @db.Text
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(6)

  attemptCount          Int       @default(0) @map("attempt_count")
  firstAttemptAt        DateTime? @map("first_attempt_at") @db.Timestamptz(6)
  lastAttemptAt         DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  nextAttemptAt         DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptedByUserId String?   @map("last_attempted_by_user_id") @db.VarChar(64)
  leaseOwner            String?   @map("lease_owner") @db.VarChar(160)
  leaseAcquiredAt       DateTime? @map("lease_acquired_at") @db.Timestamptz(6)
  leaseExpiresAt        DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode         String?   @map("last_error_code") @db.VarChar(128)
  lastErrorDetail       String?   @map("last_error_detail") @db.Text
  lastErrorAt           DateTime? @map("last_error_at") @db.Timestamptz(6)

  /// Snapshot from Java's current-version query. A confirmed publication may
  /// later become non-current without losing its media authorization.
  authorityIsCurrent      Boolean?  @map("authority_is_current")
  authorityGameExists     Boolean?  @map("authority_game_exists")
  authorityCurrentVersion String?   @map("authority_current_version") @db.VarChar(160)
  authorityManifestUrl    String?   @map("authority_manifest_url") @db.Text
  authorityCheckedAt      DateTime? @map("authority_checked_at") @db.Timestamptz(6)

  reconciliationAttemptCount    Int       @default(0) @map("reconciliation_attempt_count")
  lastReconciliationAttemptAt   DateTime? @map("last_reconciliation_attempt_at") @db.Timestamptz(6)
  nextReconciliationAt          DateTime? @map("next_reconciliation_at") @db.Timestamptz(6)
  reconciliationLeaseOwner      String?   @map("reconciliation_lease_owner") @db.VarChar(160)
  reconciliationLeaseAcquiredAt DateTime? @map("reconciliation_lease_acquired_at") @db.Timestamptz(6)
  reconciliationLeaseExpiresAt  DateTime? @map("reconciliation_lease_expires_at") @db.Timestamptz(6)
  lastReconciliationErrorCode   String?   @map("last_reconciliation_error_code") @db.VarChar(128)
  lastReconciliationErrorDetail String?   @map("last_reconciliation_error_detail") @db.Text
  lastReconciliationErrorAt     DateTime? @map("last_reconciliation_error_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  build   StoryBuild   @relation(fields: [buildId, storyProjectId], references: [id, storyProjectId], onDelete: Restrict)
  project StoryProject @relation(fields: [storyProjectId], references: [id], onDelete: Restrict)

  @@unique([buildId, storyProjectId], map: "story_experience_publications_build_scope_unique")
  @@unique([gameId, contentVersion], map: "story_experience_publications_game_version_unique")
  @@index([storyProjectId, status, createdAt(sort: Desc)], map: "story_experience_publications_project_recent_idx")
  @@index([storyProjectId, status, leaseExpiresAt], map: "story_experience_publications_project_lease_idx")
  @@index([status, nextAttemptAt, leaseExpiresAt], map: "story_experience_publications_publish_retry_idx")
  @@index([status, nextReconciliationAt, reconciliationLeaseExpiresAt], map: "story_experience_publications_reconcile_retry_idx")
  @@index([gameId, authorityIsCurrent, authorityCheckedAt(sort: Desc)], map: "story_experience_publications_authority_current_idx")
  @@map("story_experience_publications")
}

/// Legacy draft-release receipt, reused only to authorize the immutable media
