  @@index([crewId, updatedAt(sort: Desc), id(sort: Desc)], map: "crew_agreements_crew_updated_idx")
  @@index([memberUserId, crewId, status, updatedAt(sort: Desc), id(sort: Desc)], map: "crew_agreements_member_status_updated_idx")
  @@index([memberUserId, crewId, updatedAt(sort: Desc), id(sort: Desc)], map: "crew_agreements_member_updated_idx")
  @@index([lastProviderEventAt], map: "crew_agreements_provider_event_idx")
  @@map("crew_agreements")
