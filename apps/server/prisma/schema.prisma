  installation ProjectSkillInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, scope, workbenchMode, sourceSurface], map: "project_skill_activations_scope_unique")
  @@index([scope, workbenchMode, sourceSurface, defaultEnabled], map: "project_skill_activations_resolve_idx")
  @@map("project_skill_activations")
}

model ProjectSkillAudit {
  id                String                  @id @default(uuid(7)) @db.Uuid
  workspaceId       String                  @map("workspace_id") @db.Uuid
  platformProjectId String?                 @map("platform_project_id") @db.Uuid
  storyProjectId    String?                 @map("story_project_id") @db.Uuid
  installationId    String?                 @map("installation_id") @db.Uuid
  skillId           String                  @map("skill_id") @db.Uuid
  versionId         String?                 @map("version_id") @db.Uuid
  action            ProjectSkillAuditAction
  actorUserId       String                  @map("actor_user_id") @db.VarChar(64)
  requestId         String?                 @map("request_id") @db.VarChar(128)
  before            Json?                   @db.JsonB
  after             Json?                   @db.JsonB
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace       Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
