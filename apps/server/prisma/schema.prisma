  sortOrder          Int                             @default(0) @map("sort_order")
  startsAt           DateTime?                       @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime?                       @map("ends_at") @db.Timestamptz(6)
  imageAssetId       String?                         @map("image_asset_id") @db.Uuid
  mobileImageAssetId String?                         @map("mobile_image_asset_id") @db.Uuid
  trailerAssetId     String?                         @map("trailer_asset_id") @db.Uuid
  createdById        String                          @map("created_by_id") @db.VarChar(64)
