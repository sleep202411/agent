// ─────────────────────────────────────────────────────────────
// Agent User domain (src/agent-users/)
// ─────────────────────────────────────────────────────────────
//
// AI Agent Users are platform-controlled synthetic users that can simulate
// real engagement patterns inside strict policy boundaries. The root identity
// is Nest-owned even before Java creates a real user row:
//
//   AgentUser.id          -> stable agent actor id used by Nest domains
//   AgentUser.platformUserId -> optional Java user id once bound
//
// This keeps SHADOW agents useful for Nest-owned features (IP views/likes,
// recommendations, future community signals) while preserving a clean upgrade
// path to BOUND platform users.

enum AgentUserStatus {
  active
  paused
  disabled
}

enum AgentUserIdentityStatus {
  shadow
  bound
}

enum AgentRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum AgentActionStatus {
  planned
  running
  succeeded
  failed
  skipped
}

enum AgentMemoryType {
  preference
  content_affinity
  negative_signal
  relationship
  summary
  fact
}

enum AgentMemoryStatus {
  active
  archived
}

model AgentUser {
  id               String                  @id @default(uuid(7)) @db.Uuid
  handle           String                  @unique @db.VarChar(80)
  displayName      String                  @map("display_name") @db.VarChar(120)
  avatarUrl        String?                 @map("avatar_url") @db.VarChar(512)
  status           AgentUserStatus         @default(active)
  identityStatus   AgentUserIdentityStatus @default(shadow) @map("identity_status")
  platformUserId   String?                 @unique @map("platform_user_id") @db.VarChar(64)
  simulatedEmail   String?                 @unique @map("simulated_email") @db.VarChar(320)
  locale           String                  @default("zh-CN") @db.VarChar(16)
  region           String?                 @db.VarChar(16)
  timezone         String                  @default("Asia/Shanghai") @db.VarChar(64)
  persona          Json                    @default("{}") @db.JsonB
  schedule         Json                    @default("{}") @db.JsonB
  policy           Json                    @default("{}") @db.JsonB
  notes            String?                 @db.Text
  createdByAdminId String?                 @map("created_by_admin_id") @db.Uuid
  updatedByAdminId String?                 @map("updated_by_admin_id") @db.Uuid
  lastRunAt        DateTime?               @map("last_run_at") @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt       DateTime?               @map("disabled_at") @db.Timestamptz(6)

  runs     AgentRun[]
  actions  AgentAction[]
  memories AgentMemory[]

  @@index([status, updatedAt(sort: Desc)], map: "agent_users_status_recent_idx")
  @@index([identityStatus, status], map: "agent_users_identity_status_idx")
  @@index([locale, region], map: "agent_users_locale_region_idx")
  @@index([lastRunAt(sort: Desc)], map: "agent_users_last_run_idx")
  @@map("agent_users")
}

model AgentRun {
  id           String         @id @default(uuid(7)) @db.Uuid
  agentUserId  String         @map("agent_user_id") @db.Uuid
  status       AgentRunStatus @default(queued)
  trigger      String         @default("scheduler") @db.VarChar(64)
  objective    String?        @db.VarChar(500)
  summary      String?        @db.Text
  errorCode    String?        @map("error_code") @db.VarChar(80)
  errorMessage String?        @map("error_message") @db.Text
  metrics      Json           @default("{}") @db.JsonB
  metadata     Json           @default("{}") @db.JsonB
  queuedAt     DateTime       @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt    DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agentUser AgentUser     @relation(fields: [agentUserId], references: [id], onDelete: Cascade)
  actions   AgentAction[]

  @@index([agentUserId, createdAt(sort: Desc)], map: "agent_runs_agent_recent_idx")
  @@index([status, queuedAt], map: "agent_runs_status_queue_idx")
  @@map("agent_runs")
}

model AgentAction {
  id             String            @id @default(uuid(7)) @db.Uuid
  agentUserId    String            @map("agent_user_id") @db.Uuid
  runId          String?           @map("run_id") @db.Uuid
  actionType     String            @map("action_type") @db.VarChar(80)
  targetType     String?           @map("target_type") @db.VarChar(80)
  targetId       String?           @map("target_id") @db.VarChar(128)
  status         AgentActionStatus @default(planned)
  idempotencyKey String?           @unique @map("idempotency_key") @db.VarChar(180)
  decision       Json              @default("{}") @db.JsonB
  input          Json              @default("{}") @db.JsonB
  result         Json              @default("{}") @db.JsonB
  metadata       Json              @default("{}") @db.JsonB
  errorCode      String?           @map("error_code") @db.VarChar(80)
  errorMessage   String?           @map("error_message") @db.Text
  plannedAt      DateTime          @default(now()) @map("planned_at") @db.Timestamptz(6)
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agentUser AgentUser @relation(fields: [agentUserId], references: [id], onDelete: Cascade)
  run       AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([agentUserId, createdAt(sort: Desc)], map: "agent_actions_agent_recent_idx")
  @@index([runId, createdAt(sort: Asc)], map: "agent_actions_run_order_idx")
  @@index([actionType, status, createdAt(sort: Desc)], map: "agent_actions_type_status_idx")
  @@index([targetType, targetId, createdAt(sort: Desc)], map: "agent_actions_target_recent_idx")
  @@map("agent_actions")
}

model AgentMemory {
  id               String            @id @default(uuid(7)) @db.Uuid
  agentUserId      String            @map("agent_user_id") @db.Uuid
  memoryKey        String?           @map("memory_key") @db.VarChar(180)
  type             AgentMemoryType
  status           AgentMemoryStatus @default(active)
  scopeType        String?           @map("scope_type") @db.VarChar(64)
  scopeId          String?           @map("scope_id") @db.VarChar(128)
  summary          String            @db.VarChar(500)
  content          Json              @default("{}") @db.JsonB
  confidence       Int               @default(50)
  weight           Int               @default(100)
  sourceActionIds  String[]          @default([]) @map("source_action_ids")
  lastReinforcedAt DateTime?         @map("last_reinforced_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(6)

  agentUser AgentUser @relation(fields: [agentUserId], references: [id], onDelete: Cascade)

  @@unique([agentUserId, memoryKey], name: "agentUserMemoryKey", map: "agent_memories_agent_key_unique")
  @@index([agentUserId, status, type, updatedAt(sort: Desc)], map: "agent_memories_agent_status_type_idx")
  @@index([agentUserId, scopeType, scopeId], map: "agent_memories_agent_scope_idx")
  @@index([type, status, updatedAt(sort: Desc)], map: "agent_memories_type_status_recent_idx")
  @@map("agent_memories")
}

// ─────────────────────────────────────────────────────────────
// IP Commerce domain (src/ip-commerce/)
// ─────────────────────────────────────────────────────────────
//
// New source of truth for IP as a creator-owned production nucleus:
// profile, localization, media assets, episode commerce, community-point
// purchases, presale campaigns, referral attribution, review, rights
// declarations, reports, and moderation. It is deliberately not tied to
// workspace, project, crew, gig, or legacy Java tables. Future studio
// projects, crews, and gigs should attach through explicit integration/link
// tables rather than polluting the IP root.
//
// Money movement invariant:
//   IpPurchaseOrder -> WalletTransaction -> IpContentEntitlement
//
// No service is allowed to unlock content by directly mutating an IP
// row. Unlock state is always derived from entitlements and wallet
// ledger history.

model SupportedLocale {
  code         String                @id @db.VarChar(16)
  status       SupportedLocaleStatus @default(active)
  displayName  String                @map("display_name") @db.VarChar(80)
  nativeName   String                @map("native_name") @db.VarChar(80)
  displayOrder Int                   @default(0) @map("display_order")
  metadata     Json                  @default("{}") @db.JsonB
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ipsAsSource                          Ip[]                                    @relation("IpSourceLocale")
  taxonomyTermLocalizations            IpTaxonomyTermLocalization[]            @relation("IpTaxonomyTermLocalizationLocale")
  ipLocalizations                      IpLocalization[]                        @relation("IpLocalizationLocale")
  ipLocalizationsTranslatedFrom        IpLocalization[]                        @relation("IpLocalizationTranslatedFromLocale")
  episodeLocalizations                 IpEpisodeLocalization[]                 @relation("IpEpisodeLocalizationLocale")
  episodeLocalizationsTranslatedFrom   IpEpisodeLocalization[]                 @relation("IpEpisodeLocalizationTranslatedFromLocale")
  campaignLocalizations                IpCampaignLocalization[]                @relation("IpCampaignLocalizationLocale")
  campaignLocalizationsTranslatedFrom  IpCampaignLocalization[]                @relation("IpCampaignLocalizationTranslatedFromLocale")
  discoveryRecommendationLocalizations IpDiscoveryRecommendationLocalization[] @relation("IpDiscoveryRecommendationLocalizationLocale")
  translationJobsAsSource              IpTranslationJob[]                      @relation("IpTranslationJobSourceLocale")
  translationJobsAsTarget              IpTranslationJob[]                      @relation("IpTranslationJobTargetLocale")

  @@index([status, displayOrder], map: "supported_locales_status_order_idx")
  @@map("supported_locales")
}

/// Creator-chosen access policy for an IP's paid content.
enum IpAccessMode {
  /// Default: unlock by paying the price rule in community points.
  points_priced
  /// Active community members unlock free; non-members still pay the price rule.
  member_free
}

/// Where a creator-revenue ledger entry came from. Makes new payout sources
/// (e.g. licensing) purely additive — add a value + a service that reuses the
/// same generalized credit path; no other schema change.
enum IpRevenueSourceType {
  /// Per-sale revenue share at point of purchase (existing behavior).
  ip_sale
  /// Monthly community-membership subscription-pool distribution.
  member_pool
  /// FUTURE: Netflix-style licensing/featuring deal.
  licensing
}

enum MemberPoolBatchStatus {
  computing
  posted
  voided
}

enum IpChannelType {
  ip
  community
}

model Ip {
  videoSubmissions IpChannelVideoSubmission[]
  contentGpsAnalysisRequests IpContentGpsAnalysisRequest[]
  contentGpsDispatches IpContentGpsDispatch[]
  contentGpsAnalyses IpContentGpsAnalysis[]
  contentGpsLocationRevisions IpContentGpsLocationRevision[]
  creationKey String? @map("creation_key") @db.VarChar(128)
  creationFingerprint String? @map("creation_fingerprint") @db.VarChar(64)
  submissionSettings IpChannelSubmissionSettings?
  incomingWorks IpChannelSubmission[] @relation("ChannelWorks")
  submittedToChannels IpChannelSubmission[] @relation("SubmittedWorks")
  channelType IpChannelType @default(ip) @map("channel_type")
  gameAssociations       IpGameAssociationRevision[]
  stageApplications      IpStageApplication[]
  productionStage        IpProductionStage?
  crewOrigin             IpCrewOrigin?
  releaseLinks           Json                        @default("[]") @map("release_links") @db.JsonB
  publicComments         IpPublicComment[]
  id                     String                      @id @default(uuid(7)) @db.Uuid
  /// Stable public room number, allocated by PostgreSQL for every IP.
  roomNumber             String                      @unique(map: "ips_room_number_key") @default(dbgenerated("(nextval('ip_room_number_seq'::regclass))::text")) @map("room_number") @db.VarChar(19)
  status                 IpPublicationStatus         @default(draft)
  listingVisibility      IpListingVisibility         @default(private) @map("listing_visibility")
  ageRating              IpAgeRating                 @default(general) @map("age_rating")
  sourceLocale           String                      @default("zh-CN") @map("source_locale") @db.VarChar(16)
  region                 String?                     @map("region") @db.VarChar(16)
  copyrightOwner         String?                     @map("copyright_owner") @db.VarChar(160)
  rightsSummary          Json                        @default("{}") @map("rights_summary") @db.JsonB
  aiDisclosure           Json                        @default("{}") @map("ai_disclosure") @db.JsonB
  coverAssetId           String?                     @map("cover_asset_id") @db.Uuid
  trailerAssetId         String?                     @map("trailer_asset_id") @db.Uuid
  createdById            String                      @map("created_by_id") @db.VarChar(64)
  updatedById            String?                     @map("updated_by_id") @db.VarChar(64)
  /// Per-IP override of the platform-vs-creator revenue split, in basis points
  /// (0..10000) of each sale that goes to the creator pool. NULL inherits the
  /// global default (ip_commerce_settings key `ip.creator_revenue_share_bps`).
  creatorRevenueShareBps Int?                        @map("creator_revenue_share_bps")
  /// Creator-chosen access policy. `member_free` lets active community members
  /// unlock this IP's content for free; non-members still pay the price rule.
  accessMode             IpAccessMode                @default(points_priced) @map("access_mode")
  /// Per-IP override (basis points, 0..10000) of the creator earn-share counted
  /// for this IP when distributing the monthly member pool. NULL inherits the
  /// global default (ip_commerce_settings key `ip.member_free_bps`).
  memberFreeBps          Int?                        @map("member_free_bps")
  version                Int                         @default(0)
  scheduledAt            DateTime?                   @map("scheduled_at") @db.Timestamptz(6)
  publishedAt            DateTime?                   @map("published_at") @db.Timestamptz(6)
  suspendedAt            DateTime?                   @map("suspended_at") @db.Timestamptz(6)
  archivedAt             DateTime?                   @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?                   @map("deleted_at") @db.Timestamptz(6)

  coverAsset      MediaAsset?     @relation("IpCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  trailerAsset    MediaAsset?     @relation("IpTrailerAsset", fields: [trailerAssetId], references: [id], onDelete: SetNull)
  sourceLocaleRef SupportedLocale @relation("IpSourceLocale", fields: [sourceLocale], references: [code], onDelete: Restrict)

  localizations            IpLocalization[]
  taxonomyAssignments      IpTaxonomyAssignment[]
  episodes                 IpEpisode[]
  assets                   IpAsset[]
  discoveryRecommendations IpDiscoveryRecommendation[]
  campaigns                IpCampaign[]
  priceRules               IpPriceRule[]
  purchaseOrders           IpPurchaseOrder[]
  entitlements             IpContentEntitlement[]
  collectionItems          IpCollectionItem[]
  contributors             IpContributor[]
  aclGrants                IpAclGrant[]
  referralLinks            IpReferralLink[]
  referralAttributions     IpReferralAttribution[]
  revenueLedgerEntries     IpRevenueLedgerEntry[]
  reviewSubmissions        IpReviewSubmission[]
  rightsDeclarations       IpRightsDeclaration[]
  reports                  IpContentReport[]
  userBlocks               IpUserContentBlock[]
  engagementAggregate      IpEngagementAggregate?
  viewEvents               IpViewEvent[]
  likes                    IpLike[]
  publisherAssignments     IpPublisherAssignment[]

  @@unique([createdById, creationKey], map: "ips_creator_creation_key_unique")
  /// Public slug uniqueness is locale-aware and enforced on
  /// IpLocalization by partial unique SQL.
  @@index([createdById, status, updatedAt(sort: Desc)], map: "ips_creator_recent_idx")
  @@index([status, listingVisibility, publishedAt(sort: Desc)], map: "ips_public_feed_idx")
  @@index([channelType, status, listingVisibility], map: "ips_channel_public_idx")
  @@map("ips")
}

/// Curated distribution partner catalog. FizzDragon binds these to IPs after
/// a deal is confirmed — not free-text creator fields.
model IpPublisher {
  id           String            @id @default(uuid(7)) @db.Uuid
  /// Stable machine key (e.g. mango, youku, netflix).
  code         String            @unique @map("code") @db.VarChar(64)
  status       IpPublisherStatus @default(active)
  displayOrder Int               @default(0) @map("display_order")
  /// Locale map: { "en-US": "Netflix", "zh-CN": "奈飞", "zh-HK": "Netflix" }.
  names        Json              @default("{}") @db.JsonB
  /// Absolute HTTPS URL or OSS key resolved via BANNER_BASE_URL.
  logoUrl      String            @map("logo_url") @db.VarChar(1024)
  websiteUrl   String?           @map("website_url") @db.VarChar(1024)
  notes        String?           @db.VarChar(500)
  createdById  String?           @map("created_by_id") @db.VarChar(64)
  updatedById  String?           @map("updated_by_id") @db.VarChar(64)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments IpPublisherAssignment[]

  @@index([status, displayOrder], map: "ip_publishers_status_order_idx")
  @@map("ip_publishers")
}

model IpPublisherAssignment {
  id           String   @id @default(uuid(7)) @db.Uuid
  ipId         String   @map("ip_id") @db.Uuid
  publisherId  String   @map("publisher_id") @db.Uuid
