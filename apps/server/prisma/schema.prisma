  campaignId        String?            @map("campaign_id") @db.Uuid
  targetType        IpTargetType       @map("target_type")
  status            IpPriceRuleStatus  @default(draft)
  /// IP content purchases are always priced in community points. Compute
  /// points are reserved for AI generation workloads and are blocked by a DB
  /// check constraint in the matching migration.
  currency          WalletCurrencyType @default(community_point)
  amount            BigInt
  originalAmount    BigInt?            @map("original_amount")
