/// Agent OS run event journal (reconnect / audit). Sequence is per-run monotonic.
model AgentOsRun {
  id                                       String    @id @db.Uuid
  projectId                                String    @map("project_id") @db.Uuid
  conversationId                           String    @map("conversation_id") @db.Uuid
  actorId                                  String    @map("actor_id") @db.VarChar(64)
  modelProfileId                           String    @map("model_profile_id") @db.VarChar(64)
  /// Frozen creator-selected tool permission policy for every recovery path,
  /// including Server-origin external-result continuations after a long job.
  permissionMode                           String    @default("smart") @map("permission_mode") @db.VarChar(16)
  status                                   String    @db.VarChar(32)
  lastSequence                             Int       @default(0) @map("last_sequence")
  pendingApproval                          Json?     @map("pending_approval") @db.JsonB
  pendingExternal                          Json?     @map("pending_external") @db.JsonB
  /// Short-lived, row-locked claim for one structured-input response. The
  /// durable UserInputResolved event remains the final idempotency authority;
  /// this lease only prevents two Gateway pods dispatching it concurrently.
  inputResponseId                          String?   @map("input_response_id") @db.Uuid
  inputRequestId                           String?   @map("input_request_id") @db.Uuid
  inputAnswersFingerprint                  String?   @map("input_answers_fingerprint") @db.VarChar(64)
  inputResponseLeaseId                     String?   @map("input_response_lease_id") @db.Uuid
  inputResponseLeaseExpiresAt              DateTime? @map("input_response_lease_expires_at") @db.Timestamptz(6)
  /// Short-lived, row-locked claim for one generic tool-approval response.
  /// The append-only ApprovalResolved/UserMessage pair remains authoritative;
  /// this lease fences concurrent Gateway/Worker pods before graph resume.
  approvalResponseId                       String?   @map("approval_response_id") @db.Uuid
  approvalId                               String?   @map("approval_id") @db.Uuid
  approvalFingerprint                      String?   @map("approval_fingerprint") @db.VarChar(64)
  approvalResponseLeaseId                  String?   @map("approval_response_lease_id") @db.Uuid
  approvalResponseLeaseExpiresAt           DateTime? @map("approval_response_lease_expires_at") @db.Timestamptz(6)
  /// Durable start command/outbox. Admission commits this row before any
  /// Worker HTTP call, so a Gateway crash cannot strand an unstarted run.
  startCommand                             Json?     @map("start_command") @db.JsonB
  /// Version 2 reserves the exact first user event before Worker dispatch.
  /// Version 1 identifies historical rows created before durable admission.
  startAdmissionVersion                    Int       @default(1) @map("start_admission_version")
  clientSubmissionId                       String?   @map("client_submission_id") @db.Uuid
  startTurnId                              String?   @map("start_turn_id") @db.Uuid
  startUserMessageId                       String?   @map("start_user_message_id") @db.Uuid
  submissionFingerprint                    String?   @map("submission_fingerprint") @db.VarChar(64)
  /// Stable semantic token plus a monotonically fenced execution attempt.
  /// The command remains recoverable until the initial graph reaches a
  /// checkpoint-backed pause or terminal outcome.
  startExecutionToken                      String?   @map("start_execution_token") @db.Uuid
  startExecutionAttemptId                  String?   @map("start_execution_attempt_id") @db.Uuid
  startExecutionEpoch                      Int       @default(0) @map("start_execution_epoch")
  startExecutionOwnerId                    String?   @map("start_execution_owner_id") @db.Uuid
  startExecutionLeaseExpiresAt             DateTime? @map("start_execution_lease_expires_at") @db.Timestamptz(6)
  startExecutionHeartbeatAt                DateTime? @map("start_execution_heartbeat_at") @db.Timestamptz(6)
  startExecutionCheckpointId               String?   @map("start_execution_checkpoint_id") @db.VarChar(160)
  startExecutionCheckpointNamespace        String?   @map("start_execution_checkpoint_namespace") @db.VarChar(200)
  startExecutionCheckpointThreadId         String?   @map("start_execution_checkpoint_thread_id") @db.Uuid
  startExecutionCheckpointMessageId        String?   @map("start_execution_checkpoint_message_id") @db.Uuid
  startExecutionCheckpointedAt             DateTime? @map("start_execution_checkpointed_at") @db.Timestamptz(6)
  startExecutionFinishedAt                 DateTime? @map("start_execution_finished_at") @db.Timestamptz(6)
  startDispatchNextAttemptAt               DateTime? @map("start_dispatch_next_attempt_at") @db.Timestamptz(6)
  startDispatchLastError                   String?   @map("start_dispatch_last_error") @db.Text
  startDispatchedAt                        DateTime? @map("start_dispatched_at") @db.Timestamptz(6)
  /// Durable continuation outbox. A resolved HITL response or authoritative
  /// external-job result commits with this command; execution is leased
  /// independently from initial start and remains recoverable until a newer
  /// graph checkpoint proves the resumed node reached a pause or terminal.
  continuationCommand                      Json?     @map("continuation_command") @db.JsonB
  continuationExecutionToken               String?   @map("continuation_execution_token") @db.Uuid
  continuationExecutionAttemptId           String?   @map("continuation_execution_attempt_id") @db.Uuid
  continuationExecutionEpoch               Int       @default(0) @map("continuation_execution_epoch")
  continuationExecutionOwnerId             String?   @map("continuation_execution_owner_id") @db.Uuid
  continuationExecutionLeaseExpiresAt      DateTime? @map("continuation_execution_lease_expires_at") @db.Timestamptz(6)
  continuationExecutionHeartbeatAt         DateTime? @map("continuation_execution_heartbeat_at") @db.Timestamptz(6)
  continuationExecutionCheckpointId        String?   @map("continuation_execution_checkpoint_id") @db.VarChar(160)
  continuationExecutionCheckpointNamespace String?   @map("continuation_execution_checkpoint_namespace") @db.VarChar(200)
  continuationExecutionCheckpointThreadId  String?   @map("continuation_execution_checkpoint_thread_id") @db.Uuid
  continuationExecutionCheckpointedAt      DateTime? @map("continuation_execution_checkpointed_at") @db.Timestamptz(6)
  continuationExecutionFinishedAt          DateTime? @map("continuation_execution_finished_at") @db.Timestamptz(6)
  continuationDispatchNextAttemptAt        DateTime? @map("continuation_dispatch_next_attempt_at") @db.Timestamptz(6)
  continuationDispatchLastError            String?   @map("continuation_dispatch_last_error") @db.Text
  continuationDispatchedAt                 DateTime? @map("continuation_dispatched_at") @db.Timestamptz(6)
  assistantText                            String?   @map("assistant_text") @db.Text
  projectKind                              String?   @map("project_kind") @db.VarChar(32)
  workbenchMode                            String?   @map("workbench_mode") @db.VarChar(64)
  workbenchContext                         Json?     @map("workbench_context") @db.JsonB
  skillSnapshot                            Json?     @map("skill_snapshot") @db.JsonB
  /// Cross-pod lease for draining this run's committed events to realtime.
  /// PostgreSQL remains authoritative; duplicate publishes are harmless
  /// because every event has a stable Ably message id.
  realtimePublishLeaseId                   String?   @map("realtime_publish_lease_id") @db.Uuid
  realtimePublishLeaseExpiresAt            DateTime? @map("realtime_publish_lease_expires_at") @db.Timestamptz(6)
  realtimeSnapshotSequence                 Int       @default(0) @map("realtime_snapshot_sequence")
  createdAt                                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  events                       AgentOsRunEvent[]
  externalHandoffRegistrations AgentOsExternalHandoffRegistration[]
  toolExecutionReceipts        AgentOsToolExecutionReceipt[]

  @@unique([actorId, projectId, clientSubmissionId], map: "agent_os_runs_actor_project_submission_unique")
  @@index([projectId, createdAt(sort: Desc)], map: "agent_os_runs_project_recent_idx")
  @@index([actorId, createdAt(sort: Desc)], map: "agent_os_runs_actor_recent_idx")
  @@index([projectId, conversationId, createdAt], map: "agent_os_runs_project_conversation_idx")
  @@index([continuationDispatchNextAttemptAt, createdAt], map: "agent_os_runs_continuation_dispatch_idx")
  @@map("agent_os_runs")
}

/// Durable, exactly-once receipt for an Agent OS command tool invocation.
///
/// The receipt is claimed before execution and completed in the same database
/// transaction as the product mutation. Completed receipts are the response-
/// loss replay authority; the expiring lease only serializes live executors.
model AgentOsToolExecutionReceipt {
  id                             String    @id @default(uuid(7)) @db.Uuid
  runId                          String    @map("run_id") @db.Uuid
  conversationId                 String    @map("conversation_id") @db.Uuid
  turnId                         String    @map("turn_id") @db.Uuid
  toolCallId                     String    @map("tool_call_id") @db.VarChar(256)
  toolId                         String    @map("tool_id") @db.VarChar(128)
  projectId                      String    @map("project_id") @db.Uuid
  actorId                        String    @map("actor_id") @db.VarChar(128)
  idempotencyKey                 String    @map("idempotency_key") @db.VarChar(512)
  requestFingerprint             String    @map("request_fingerprint") @db.VarChar(64)
  /// executing | completed
  status                         String    @db.VarChar(16)
  leaseId                        String?   @map("lease_id") @db.Uuid
  leaseExpiresAt                 DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  response                       Json?     @db.JsonB
  startExecutionToken            String?   @map("start_execution_token") @db.Uuid
  startExecutionAttemptId        String?   @map("start_execution_attempt_id") @db.Uuid
  startExecutionEpoch            Int?      @map("start_execution_epoch")
  startExecutionOwnerId          String?   @map("start_execution_owner_id") @db.Uuid
  continuationExecutionToken     String?   @map("continuation_execution_token") @db.Uuid
  continuationExecutionAttemptId String?   @map("continuation_execution_attempt_id") @db.Uuid
  continuationExecutionEpoch     Int?      @map("continuation_execution_epoch")
  continuationExecutionOwnerId   String?   @map("continuation_execution_owner_id") @db.Uuid
  completedAt                    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  run AgentOsRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, toolCallId], map: "agent_os_tool_receipts_run_call_unique")
  @@unique([runId, idempotencyKey], map: "agent_os_tool_receipts_run_key_unique")
  @@index([runId, status, createdAt], map: "agent_os_tool_receipts_run_status_idx")
  @@map("agent_os_tool_execution_receipts")
}

/// Append-only Agent OS event journal. `AgentOsRun` stores the current run
/// projection; this table is the durable transcript/orchestration source.
/// Events are immutable and ordered by the per-run sequence allocated by the
/// Agent OS runtime or by an external-job continuation under a row lock.
model AgentOsRunEvent {
  id                       String    @id @db.VarChar(128)
  runId                    String    @map("run_id") @db.Uuid
  conversationId           String    @map("conversation_id") @db.Uuid
  sequence                 Int
  protocolVersion          String    @map("protocol_version") @db.VarChar(32)
  sessionId                String    @map("session_id") @db.VarChar(180)
  type                     String    @db.VarChar(64)
  data                     Json      @db.JsonB
  occurredAt               DateTime  @map("occurred_at") @db.Timestamptz(6)
  recordedAt               DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  realtimePublishedAt      DateTime? @map("realtime_published_at") @db.Timestamptz(6)
  realtimePublishAttempts  Int       @default(0) @map("realtime_publish_attempts")
  realtimePublishLastError String?   @map("realtime_publish_last_error") @db.Text

  run AgentOsRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence], map: "agent_os_run_events_run_sequence_unique")
  @@index([conversationId, occurredAt, id], map: "agent_os_run_events_conversation_timeline_idx")
  // The realtime pending index is partial (`WHERE realtime_published_at IS NULL`)
  // and therefore lives in SQL migration only; Prisma cannot represent that
  // predicate without incorrectly modelling it as a full index.
  @@map("agent_os_run_events")
}

/// Immutable receipt that a privileged domain tool accepted a long-running
/// external job. It is written in the same transaction as the domain job, so a
/// worker crash before `RunPaused` can be reconciled from PostgreSQL instead of
/// stranding the originating conversation.
model AgentOsExternalHandoffRegistration {
  id                      String   @id @default(uuid(7)) @db.Uuid
  externalJobId           String   @unique(map: "agent_os_external_handoffs_job_unique") @map("external_job_id") @db.Uuid
  sourceAgentRunId        String   @map("source_agent_run_id") @db.Uuid
  sourceAgentTurnId       String   @map("source_agent_turn_id") @db.Uuid
  sourceAgentToolCallId   String   @map("source_agent_tool_call_id") @db.VarChar(256)
  sourceConversationId    String   @map("source_conversation_id") @db.Uuid
  sourceToolId            String   @map("source_tool_id") @db.VarChar(128)
  decisionContractVersion Int      @default(2) @map("decision_contract_version")
  startedMessage          String   @map("started_message") @db.Text
  completionMessage       String   @map("completion_message") @db.Text
  /// Creator-authorized terminal specification plus the immutable source brief.
  /// Null is reserved for pre-scope-contract handoffs.
  continuationPlan        Json?    @map("continuation_plan") @db.JsonB
  storyAgentRunId         String?  @unique(map: "agent_os_external_handoffs_story_run_unique") @map("story_agent_run_id") @db.Uuid
  generationBatchId       String?  @unique(map: "agent_os_external_handoffs_generation_batch_unique") @map("generation_batch_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  storyAgentRun   StoryAgentRun?        @relation(fields: [storyAgentRunId], references: [id], onDelete: Restrict)
  generationBatch StoryGenerationBatch? @relation(fields: [generationBatchId], references: [id], onDelete: Restrict)
  sourceAgentRun  AgentOsRun            @relation(fields: [sourceAgentRunId], references: [id], onDelete: Restrict)

  @@unique([sourceAgentRunId, sourceAgentToolCallId], map: "agent_os_external_handoffs_source_tool_unique")
  @@index([sourceAgentRunId, createdAt], map: "agent_os_external_handoffs_source_run_idx")
  @@map("agent_os_external_handoff_registrations")
}

model StudioDocument {
  storyboardExports StoryboardExportJob[]
  id                   String               @id @default(uuid(7)) @db.Uuid
