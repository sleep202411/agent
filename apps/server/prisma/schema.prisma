  /// Event matched an internal object and all business side effects finished.
  processed
  /// Event was deliberately closed because it is duplicate, test-only, or cannot map to an internal order/refund.
  ignored
  /// Event processing threw after persistence; operators can inspect and replay it from admin-ui.
  failed
}

