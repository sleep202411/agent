/// Character library entry (角色) — a reusable generation subject owned by
/// its home WORKSPACE (never a project; never a user directly — attribution
/// only). See docs/character-library-real-person-portraits-design-v1.md.
/// kind=virtual lives in the creating workspace (team or personal);
/// kind=real_person is enforced at create to live in the subject's PERSONAL
/// workspace (v1) and is additionally bounded by the consent ledger.
model StudioCharacter {
  id              String          @id @default(uuid(7)) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  kind            CharacterKind
  /// Prompt-facing label (@mention). Unique per workspace among live rows
  /// via partial unique SQL: (workspace_id, name)
  /// WHERE deleted_at IS NULL AND status <> 'revoked' (a revoked likeness is
  /// retained but frees its name for re-enrollment).
  name            String          @db.VarChar(64)
  description     String?         @db.VarChar(200)
  /// Cover preview — one of the character's media assets.
  coverAssetId    String?         @map("cover_asset_id") @db.Uuid
  status          CharacterStatus @default(draft)
  /// Attribution ONLY (audit) — never ownership (MediaAsset posture).
  createdByUserId String          @map("created_by_user_id") @db.VarChar(64)
  /// real_person only: the depicted person. v1: === createdByUserId.
  subjectUserId   String?         @map("subject_user_id") @db.VarChar(64)
  version         Int             @default(0)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)

  workspace          Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cover              MediaAsset?                  @relation("CharacterCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  media              CharacterMedia[]
  castRows           CharacterProjectCast[]
  consents           CharacterConsentRecord[]
  projectGrants      CharacterProjectGrant[]
  assetGroups        AiProviderAssetGroup[]
  enrollmentSessions CharacterEnrollmentSession[]

  @@index([workspaceId, status, deletedAt], map: "studio_characters_workspace_idx")
  @@index([createdByUserId], map: "studio_characters_created_by_idx")
  @@map("studio_characters")
}

/// Ordered reference media of a character. MediaAsset stays the storage
/// source of truth (Restrict — a referenced asset is never hard-deleted
/// from under a character).
model CharacterMedia {
  id           String               @id @default(uuid(7)) @db.Uuid
  characterId  String               @map("character_id") @db.Uuid
  mediaAssetId String               @map("media_asset_id") @db.Uuid
  mediaKind    MediaAssetKind       @map("media_kind")
  sortOrder    Int                  @default(0) @map("sort_order")
  status       CharacterMediaStatus @default(active)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  character      StudioCharacter           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset                @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  externalAssets AiProviderExternalAsset[]

  @@unique([characterId, mediaAssetId], map: "character_media_unique")
  @@index([characterId, status, sortOrder], map: "character_media_by_character_idx")
  @@index([mediaAssetId], map: "character_media_by_asset_idx")
  @@map("character_media")
}

/// Per-project cast (演员表) — pure VISIBILITY: which characters this
/// project has "cast" from its workspace library. Intent (casting),
/// distinct from MediaAssetUsage (facts of use). Never crosses workspaces.
model CharacterProjectCast {
  id            String   @id @default(uuid(7)) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  characterId   String   @map("character_id") @db.Uuid
  addedByUserId String   @map("added_by_user_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project   PlatformProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character StudioCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterId], map: "character_project_cast_unique")
  @@index([characterId], map: "character_project_cast_by_character_idx")
  @@map("character_project_cast")
}

/// APPEND-ONLY consent evidence ledger for real_person characters. Stores
/// hashes/metadata only — never face bytes, never signed URLs. No deletedAt:
/// retention survives character revocation (statute-of-limitations evidence).
model CharacterConsentRecord {
  id             String                     @id @default(uuid(7)) @db.Uuid
  characterId    String                     @map("character_id") @db.Uuid
  type           CharacterConsentRecordType
  provider       String?                    @db.VarChar(64)
  evidence       Json                       @default("{}") @db.JsonB
  consentVersion String                     @map("consent_version") @db.VarChar(32)
  /// v2 per-project grant scope (design §2 ⟦V⟧). A BARE denormalized project
  /// id with NO foreign key — the same posture as MediaAsset.createdByUserId /
  /// Workspace.ownerUserId. The append-only, Restrict-on-character ledger is
  /// legal evidence and must survive project deletion; a real FK would force
  /// Cascade (destroys evidence) or Restrict (undeletable projects). Null for
  /// account-level (self-use) enrollment consent.
  scopeProjectId String?                    @map("scope_project_id") @db.Uuid
  occurredAt     DateTime                   @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  character StudioCharacter         @relation(fields: [characterId], references: [id], onDelete: Restrict)
  grants    CharacterProjectGrant[]

  @@index([characterId, occurredAt(sort: Desc)], map: "character_consents_by_character_idx")
  @@map("character_consent_records")
}

/// v2: a real_person likeness authorized for use inside ONE project (design
/// §2/§4). The grant — NOT character/group status — is the per-project
/// enforcement source of truth: the submit readiness check, both authz gates,
/// and the worker seam all key on an ACTIVE grant for (characterId, job
/// projectId). A per-project revoke flips only this row (the shared
/// LivenessFace group stays active for other grants + self-use). Uniqueness is
/// a PARTIAL index on active rows (see migration) so re-granting after revoke
/// is a NEW row with its own consent record; revoked rows accumulate as history.
model CharacterProjectGrant {
  id              String                      @id @default(uuid(7)) @db.Uuid
  characterId     String                      @map("character_id") @db.Uuid
  projectId       String                      @map("project_id") @db.Uuid
  /// The subject who authorized (must equal StudioCharacter.subjectUserId).
  grantedByUserId String                      @map("granted_by_user_id") @db.VarChar(64)
  status          CharacterProjectGrantStatus @default(active)
  /// The scoped consent_granted record that authorized THIS grant (§6).
  consentRecordId String                      @map("consent_record_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt       DateTime?                   @map("revoked_at") @db.Timestamptz(6)

  character     StudioCharacter        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: project deletion runs an AUDITED grant teardown
  // (append scoped revocation, cancel jobs) instead of silently dropping the
  // consent state (design §7).
  project       PlatformProject        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  consentRecord CharacterConsentRecord @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)

  @@index([projectId, status], map: "character_project_grants_by_project_idx")
  @@index([characterId, status], map: "character_project_grants_by_character_idx")
  @@map("character_project_grants")
}

/// v2 §D-B: a director invites a person to LEND their likeness to a project.
/// Distinct from ProjectMember/ProjectInvite — the actor never becomes a
/// project collaborator and never sees project content; acceptance leads into
/// enrollment (if needed) + the per-project grant consent + an active grant.
model CharacterCastingInvite {
  id              String                       @id @default(uuid(7)) @db.Uuid
  projectId       String                       @map("project_id") @db.Uuid
  /// The director; asserted to be a ProjectMember editor+ at create time.
  invitedByUserId String                       @map("invited_by_user_id") @db.VarChar(64)
  /// Resolved recipient when a known user; else contact for an off-platform actor.
  inviteeUserId   String?                      @map("invitee_user_id") @db.VarChar(64)
  inviteeContact  String?                      @map("invitee_contact") @db.VarChar(256)
  /// SHA-256 of the single-use accept token (never the token itself).
  tokenHash       String                       @map("token_hash") @db.VarChar(128)
  status          CharacterCastingInviteStatus @default(pending)
  expiresAt       DateTime                     @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt     DateTime?                    @map("responded_at") @db.Timestamptz(6)

  project PlatformProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "character_casting_invites_token_unique")
  @@index([projectId, status], map: "character_casting_invites_by_project_idx")
  @@index([inviteeUserId, status], map: "character_casting_invites_by_invitee_idx")
  @@map("character_casting_invites")
}

/// Provider-side asset group MIRROR for a character (design §1). Everything
/// provider-side is rebuildable from MediaAsset — the provider store is a
/// cache, never a source of truth (ACR expiry+15d wipes it). One group per
/// (character, provider); real_person characters get exactly one
/// liveness_face group minted by the hosted liveness verification.
model AiProviderAssetGroup {
  id              String                     @id @default(uuid(7)) @db.Uuid
  characterId     String                     @map("character_id") @db.Uuid
  /// Provider key, e.g. 'byteplus-modelark'.
  provider        String                     @db.VarChar(64)
  externalGroupId String                     @map("external_group_id") @db.VarChar(128)
  groupType       AiProviderAssetGroupType   @map("group_type")
  /// ModelArk ProjectName the group lives under (IAM/quota scope).
  projectName     String                     @map("project_name") @db.VarChar(64)
  status          AiProviderAssetGroupStatus @default(active)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  character      StudioCharacter           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  externalAssets AiProviderExternalAsset[]

  @@unique([characterId, provider], map: "ai_provider_asset_groups_character_provider_unique")
  @@index([provider, externalGroupId], map: "ai_provider_asset_groups_external_idx")
  @@map("ai_provider_asset_groups")
}

/// Per-media provider mirror row (design §1). `providerResponse` is REDACTED
/// before persist: status/ids/timings/error codes only — provider signed URLs
/// (12h TTL, face imagery) are stripped, never stored, never shown in admin.
model AiProviderExternalAsset {
  id                   String                        @id @default(uuid(7)) @db.Uuid
  /// Nullable so a mirror SURVIVES its CharacterMedia deletion (onDelete:
  /// SetNull) as a durable upstream-teardown ledger: removeMedia flips the
  /// row to `disabled` then deletes the media, leaving a detached
  /// (characterMediaId=null, status=disabled) row the critical lane / the
  /// reconciliation sweep drives to `deleted` once the provider asset is gone.
  characterMediaId     String?                       @map("character_media_id") @db.Uuid
  providerAssetGroupId String                        @map("provider_asset_group_id") @db.Uuid
  externalAssetId      String?                       @map("external_asset_id") @db.VarChar(128)
  status               AiProviderExternalAssetStatus @default(pending)
  /// Typed upstream verdicts surfaced verbatim to the UI:
  /// face_mismatch | multi_face | moderation | stale | ...
  statusReason         String?                       @map("status_reason") @db.VarChar(64)
  providerResponse     Json?                         @map("provider_response") @db.JsonB
  lastSyncedAt         DateTime?                     @map("last_synced_at") @db.Timestamptz(6)
  /// Staleness rule (design §2.2): processing past this deadline flips the
  /// row to failed(statusReason=stale) with a visible retry affordance.
  processingDeadline   DateTime?                     @map("processing_deadline") @db.Timestamptz(6)
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  characterMedia CharacterMedia?      @relation(fields: [characterMediaId], references: [id], onDelete: SetNull)
  assetGroup     AiProviderAssetGroup @relation(fields: [providerAssetGroupId], references: [id], onDelete: Cascade)

  @@unique([characterMediaId, providerAssetGroupId], map: "ai_provider_external_assets_media_group_unique")
  @@index([providerAssetGroupId, status], map: "ai_provider_external_assets_by_group_idx")
  @@index([status, processingDeadline], map: "ai_provider_external_assets_staleness_idx")
  @@map("ai_provider_external_assets")
}

/// Provider-side AIGC asset group for generic MediaAsset registration.
/// This is the canvas-default path: image assets are registered for Seedance
/// provider checks without first inventing a product "character" wrapper.
model AiProviderMediaAssetGroup {
  id              String                     @id @default(uuid(7)) @db.Uuid
  /// Provider key, e.g. 'byteplus-modelark'.
  provider        String                     @db.VarChar(64)
  externalGroupId String                     @map("external_group_id") @db.VarChar(128)
  groupType       AiProviderAssetGroupType   @map("group_type")
  projectName     String                     @map("project_name") @db.VarChar(64)
  status          AiProviderAssetGroupStatus @default(active)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalAssets AiProviderMediaAssetMirror[]

  @@unique([provider, groupType, projectName], map: "ai_provider_media_asset_groups_provider_type_project_unique")
  @@index([provider, externalGroupId], map: "ai_provider_media_asset_groups_external_idx")
  @@map("ai_provider_media_asset_groups")
}

/// Provider mirror for a plain MediaAsset. `providerResponse` is REDACTED
/// before persist: status/ids/timings/error codes only — provider signed URLs
/// are stripped, never stored, never shown in admin.
model AiProviderMediaAssetMirror {
  id                   String                        @id @default(uuid(7)) @db.Uuid
  mediaAssetId         String                        @map("media_asset_id") @db.Uuid
  providerAssetGroupId String                        @map("provider_asset_group_id") @db.Uuid
  externalAssetId      String?                       @map("external_asset_id") @db.VarChar(128)
  status               AiProviderExternalAssetStatus @default(pending)
  statusReason         String?                       @map("status_reason") @db.VarChar(64)
  providerResponse     Json?                         @map("provider_response") @db.JsonB
  lastSyncedAt         DateTime?                     @map("last_synced_at") @db.Timestamptz(6)
  processingDeadline   DateTime?                     @map("processing_deadline") @db.Timestamptz(6)
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaAsset MediaAsset                @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  assetGroup AiProviderMediaAssetGroup @relation(fields: [providerAssetGroupId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, providerAssetGroupId], map: "ai_provider_media_asset_mirrors_media_group_unique")
  @@index([mediaAssetId, status], map: "ai_provider_media_asset_mirrors_media_status_idx")
  @@index([providerAssetGroupId, status], map: "ai_provider_media_asset_mirrors_by_group_idx")
  @@index([status, processingDeadline], map: "ai_provider_media_asset_mirrors_staleness_idx")
  @@map("ai_provider_media_asset_mirrors")
}

/// Real-person liveness enrollment session (design §2.1). The vendor token is
/// envelope-encrypted, single-use, and HARD-DELETED (nulled) on completion or
/// expiry; completion authority is exclusively the server→provider result
/// pull — inbound callback parameters never mutate state.
model CharacterEnrollmentSession {
  id            String                           @id @default(uuid(7)) @db.Uuid
  characterId   String                           @map("character_id") @db.Uuid
  /// Denormalized owner: complete() asserts caller === ownerUserId.
  ownerUserId   String                           @map("owner_user_id") @db.VarChar(64)
  bytedTokenEnc String?                          @map("byted_token_enc") @db.Text
  status        CharacterEnrollmentSessionStatus @default(pending)
  /// Typed failure for failed sessions (provider verdict or expiry sweep).
  statusReason  String?                          @map("status_reason") @db.VarChar(64)
  /// createdAt + 30min.
  expiresAt     DateTime                         @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  character StudioCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, status], map: "character_enrollment_sessions_by_character_idx")
  @@index([status, expiresAt], map: "character_enrollment_sessions_expiry_idx")
  @@map("character_enrollment_sessions")
}

model WalletAccount {
  id               String              @id @default(uuid(7)) @db.Uuid
  ownerType        WalletOwnerType     @map("owner_type")
  ownerId          String              @map("owner_id") @db.VarChar(64)
  currency         WalletCurrencyType
  /// Balance class is separate from currency. `availableBalance` and
  /// `heldBalance` are lifecycle states inside this class; they do not
  /// decide whether funds can be consumed or withdrawn.
  balanceKind      WalletBalanceKind   @default(consumable) @map("balance_kind")
  status           WalletAccountStatus @default(active)
  availableBalance BigInt              @default(0) @map("available_balance")
  heldBalance      BigInt              @default(0) @map("held_balance")
  version          Int                 @default(0)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz(6)

  ledgerEntries WalletLedgerEntry[]
  creditGrants  WalletCreditGrant[]

  @@unique([ownerType, ownerId, currency, balanceKind], map: "wallet_accounts_owner_currency_kind_unique")
  @@index([ownerType, ownerId, status, balanceKind], map: "wallet_accounts_owner_status_idx")
  @@map("wallet_accounts")
}

model WalletTransaction {
  id             String                  @id @default(uuid(7)) @db.Uuid
  status         WalletTransactionStatus @default(posted)
  sourceType     String                  @map("source_type") @db.VarChar(64)
  /// Fits the Java bridge's raw caller key (≤180) — see internal-points.dto.ts.
  sourceId       String?                 @map("source_id") @db.VarChar(200)
  /// Fits the longest prefixed bridge key: `community_grant:<userId≤18>:<key≤180>` = 215.
  idempotencyKey String                  @map("idempotency_key") @db.VarChar(240)
  actorUserId    String?                 @map("actor_user_id") @db.VarChar(64)
  workspaceId    String?                 @map("workspace_id") @db.Uuid
  projectId      String?                 @map("project_id") @db.Uuid
  description    String?                 @db.VarChar(500)
  metadata       Json                    @default("{}") @db.JsonB
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt       DateTime?               @default(now()) @map("posted_at") @db.Timestamptz(6)
  voidedAt       DateTime?               @map("voided_at") @db.Timestamptz(6)

  entries                   WalletLedgerEntry[]
  creditGrants              WalletCreditGrant[]
  creditAllocations         WalletCreditAllocation[]
  billingSubscriptionCycles BillingSubscriptionCycle[]
  ipPurchaseOrders          IpPurchaseOrder[]
  billingRefunds            BillingRefund[]
  ipRevenueLedgerEntries    IpRevenueLedgerEntry[]

  @@unique([idempotencyKey], map: "wallet_transactions_idempotency_key_unique")
  @@index([sourceType, sourceId], map: "wallet_transactions_source_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "wallet_transactions_actor_recent_idx")
  @@index([workspaceId, createdAt(sort: Desc)], map: "wallet_transactions_workspace_recent_idx")
  @@map("wallet_transactions")
}

model WalletLedgerEntry {
  id                    String                @id @default(uuid(7)) @db.Uuid
  transactionId         String                @map("transaction_id") @db.Uuid
  accountId             String                @map("account_id") @db.Uuid
  entryType             WalletLedgerEntryType @map("entry_type")
  currency              WalletCurrencyType
  balanceKind           WalletBalanceKind     @map("balance_kind")
  amount                BigInt
  availableDelta        BigInt                @map("available_delta")
  heldDelta             BigInt                @map("held_delta")
  availableBalanceAfter BigInt                @map("available_balance_after")
  heldBalanceAfter      BigInt                @map("held_balance_after")
  reason                String                @db.VarChar(80)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     WalletAccount     @relation(fields: [accountId], references: [id])

  creditAllocations WalletCreditAllocation[]

  @@index([accountId, createdAt(sort: Desc)], map: "wallet_ledger_entries_account_recent_idx")
  @@index([transactionId], map: "wallet_ledger_entries_transaction_idx")
  @@map("wallet_ledger_entries")
}

model WalletCreditGrant {
  id              String                  @id @default(uuid(7)) @db.Uuid
  accountId       String                  @map("account_id") @db.Uuid
  transactionId   String?                 @map("transaction_id") @db.Uuid
  grantType       WalletCreditGrantType   @map("grant_type")
  status          WalletCreditGrantStatus @default(active)
  totalAmount     BigInt                  @map("total_amount")
  availableAmount BigInt                  @default(0) @map("available_amount")
  heldAmount      BigInt                  @default(0) @map("held_amount")
  consumedAmount  BigInt                  @default(0) @map("consumed_amount")
  expiredAmount   BigInt                  @default(0) @map("expired_amount")
  reversedAmount  BigInt                  @default(0) @map("reversed_amount")
  priority        Int                     @default(100)
  validFrom       DateTime                @default(now()) @map("valid_from") @db.Timestamptz(6)
  expiresAt       DateTime?               @map("expires_at") @db.Timestamptz(6)
  sourceType      String                  @map("source_type") @db.VarChar(64)
  /// Widened with wallet_transactions.source_id — holds the same raw bridge key.
  sourceId        String?                 @map("source_id") @db.VarChar(200)
  metadata        Json                    @default("{}") @db.JsonB
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account     WalletAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction WalletTransaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  allocations WalletCreditAllocation[]

  @@index([accountId, status, expiresAt, priority, createdAt], map: "wallet_credit_grants_account_spend_idx")
  @@index([sourceType, sourceId], map: "wallet_credit_grants_source_idx")
  @@index([transactionId], map: "wallet_credit_grants_transaction_idx")
  @@map("wallet_credit_grants")
}

model WalletCreditAllocation {
  id             String   @id @default(uuid(7)) @db.Uuid
  grantId        String   @map("grant_id") @db.Uuid
  transactionId  String   @map("transaction_id") @db.Uuid
  ledgerEntryId  String   @map("ledger_entry_id") @db.Uuid
  amount         BigInt
  availableDelta BigInt   @default(0) @map("available_delta")
  heldDelta      BigInt   @default(0) @map("held_delta")
  consumedDelta  BigInt   @default(0) @map("consumed_delta")
  expiredDelta   BigInt   @default(0) @map("expired_delta")
  reversedDelta  BigInt   @default(0) @map("reversed_delta")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  grant       WalletCreditGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  transaction WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ledgerEntry WalletLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  @@index([grantId, createdAt(sort: Desc)], map: "wallet_credit_allocations_grant_recent_idx")
  @@index([transactionId], map: "wallet_credit_allocations_transaction_idx")
  @@index([ledgerEntryId], map: "wallet_credit_allocations_ledger_entry_idx")
  @@map("wallet_credit_allocations")
}

model BillingMembershipPlan {
  id                     String                      @id @default(uuid(7)) @db.Uuid
  planKey                String                      @map("plan_key") @db.VarChar(64)
  productType            BillingProductType          @map("product_type")
  subjectType            BillingSubjectType          @map("subject_type")
  status                 BillingMembershipPlanStatus @default(draft)
  rank                   Int
  name                   String                      @db.VarChar(160)
  description            String?                     @db.Text
  includedComputeCredits BigInt                      @default(0) @map("included_compute_credits")
  includedSeats          Int                         @default(1) @map("included_seats")
  maxSeats               Int?                        @map("max_seats")
  seatOverageAllowed     Boolean                     @default(false) @map("seat_overage_allowed")
  billingIntervalDefault BillingPriceInterval?       @map("billing_interval_default")
  /// Validated membership benefits (MembershipBenefitsSchema) — the single
  /// source of truth for quota limits and queue priority. NO column
  /// default on purpose: every new plan row must state its benefits.
  benefits               Json                        @db.JsonB
  marketing              Json                        @default("{}") @db.JsonB
  metadata               Json                        @default("{}") @db.JsonB
  createdById            String?                     @map("created_by_id") @db.VarChar(64)
  updatedById            String?                     @map("updated_by_id") @db.VarChar(64)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt             DateTime?                   @map("archived_at") @db.Timestamptz(6)

  @@unique([planKey], map: "billing_membership_plans_plan_key_unique")
  @@index([productType, status, rank], map: "billing_membership_plans_product_status_rank_idx")
  @@index([subjectType, status, rank], map: "billing_membership_plans_subject_status_rank_idx")
  @@map("billing_membership_plans")
}

model BillingCatalogItem {
  id          String             @id @default(uuid(7)) @db.Uuid
  /// Internal product category. This decides fulfillment shape and default
  /// ledger allocation; it is independent from provider-side product objects.
  productType BillingProductType @map("product_type")
  /// Stable internal SKU-like code used by admin, reporting, provider sync, and
  /// reconciliation. Do not overload it with provider IDs.
  code        String             @db.VarChar(96)
  name        String             @db.VarChar(160)
  description String?            @db.Text
  isActive    Boolean            @default(true) @map("is_active")
  metadata    Json               @default("{}") @db.JsonB
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz(6)

  prices     BillingPrice[]
  orders     BillingOrder[]
  promotions BillingPromotion[]

  @@unique([code], map: "billing_catalog_items_code_unique")
  @@index([productType, isActive], map: "billing_catalog_items_type_idx")
  @@map("billing_catalog_items")
}

model BillingPrice {
  id                      String               @id @default(uuid(7)) @db.Uuid
  itemId                  String               @map("item_id") @db.Uuid
  /// Fiat order currency, not wallet currency. Use ISO 4217 such as USD or CNY.
  currency                String               @db.Char(3)
  /// Fiat minor units. USD 9900 means 99.00 USD.
  amountMinor             BigInt               @map("amount_minor")
  interval                BillingPriceInterval @default(one_time)
  subjectType             BillingSubjectType   @default(user) @map("subject_type")
  /// Paid catalog and promotion grants are consumable wallet balances.
  /// Withdrawable community points originate from creator revenue / payout
  /// workflows, not checkout products or coupons. Enforced by migration SQL.
  grantsWalletCurrency    WalletCurrencyType?  @map("grants_wallet_currency")
  grantsWalletBalanceKind WalletBalanceKind?   @map("grants_wallet_balance_kind")
  grantsWalletAmount      BigInt?              @map("grants_wallet_amount")
  grantsPlanKey           String?              @map("grants_plan_key") @db.VarChar(64)
  grantDurationDays       Int?                 @map("grant_duration_days")
  isActive                Boolean              @default(true) @map("is_active")
  metadata                Json                 @default("{}") @db.JsonB
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt              DateTime?            @map("archived_at") @db.Timestamptz(6)

  item              BillingCatalogItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orders            BillingOrder[]
  subscriptions     BillingSubscription[]
  providerBindings  BillingProviderPriceBinding[]
  ledgerAllocations BillingPriceLedgerAllocation[]
  promotions        BillingPromotion[]

  @@index([itemId, isActive], map: "billing_prices_item_active_idx")
  @@index([currency, amountMinor], map: "billing_prices_currency_amount_idx")
  @@map("billing_prices")
}

model BillingPriceLedgerAllocation {
  id                String                        @id @default(uuid(7)) @db.Uuid
  priceId           String                        @map("price_id") @db.Uuid
  /// Fulfillment accounting target. It determines which ledger account receives
  /// customer funds after payment is fulfilled.
  target            BillingLedgerAllocationTarget
  /// Percentage allocation in basis points. 10000 means 100%.
  allocationBps     Int?                          @map("allocation_bps")
  /// Fixed fiat minor-unit allocation, multiplied by order quantity when used.
  amountMinor       BigInt?                       @map("amount_minor")
  /// Wallet currency granted by this allocation. Only consumable wallet balances
  /// may be sold or coupon-granted; withdrawable community points come from
  /// creator revenue workflows.
  walletCurrency    WalletCurrencyType?           @map("wallet_currency")
  walletBalanceKind WalletBalanceKind?            @map("wallet_balance_kind")
  /// Membership plan key for deferred revenue allocation.
  planKey           String?                       @map("plan_key") @db.VarChar(64)
  /// Revenue category for immediate revenue allocation.
  revenueCategory   String?                       @map("revenue_category") @db.VarChar(80)
  priority          Int                           @default(100)
  metadata          Json                          @default("{}") @db.JsonB
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime?                     @map("archived_at") @db.Timestamptz(6)

  price BillingPrice @relation(fields: [priceId], references: [id], onDelete: Cascade)

  @@index([priceId, archivedAt, priority], map: "billing_price_ledger_allocations_price_idx")
  @@map("billing_price_ledger_allocations")
}

model BillingProviderPriceBinding {
  id                String                       @id @default(uuid(7)) @db.Uuid
  priceId           String                       @map("price_id") @db.Uuid
  /// Provider used for checkout or fulfillment source. `manual` means offline
  /// payment confirmed by an operator; `internal` means platform-funded
  /// fulfillment. Neither one is a coupon/redeem-code concept.
  provider          PaymentProvider
  /// Provider-side product identifier when the provider has a catalog product.
  providerProductId String?                      @map("provider_product_id") @db.VarChar(128)
  /// Provider-side price identifier used for checkout/subscription creation.
  providerPriceId   String?                      @map("provider_price_id") @db.VarChar(128)
  providerMode      String?                      @map("provider_mode") @db.VarChar(32)
  status            BillingProviderBindingStatus @default(active)
  syncError         String?                      @map("sync_error") @db.Text
  providerPayload   Json                         @default("{}") @map("provider_payload") @db.JsonB
  metadata          Json                         @default("{}") @db.JsonB
  lastSyncedAt      DateTime?                    @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime?                    @map("archived_at") @db.Timestamptz(6)

  price  BillingPrice   @relation(fields: [priceId], references: [id], onDelete: Cascade)
  orders BillingOrder[]

  /// Active binding uniqueness is enforced by partial unique SQL:
  /// (price_id, provider) WHERE archived_at IS NULL.
  /// Provider catalog id uniqueness is enforced by partial unique SQL:
  /// (provider, provider_price_id) WHERE provider_price_id IS NOT NULL AND archived_at IS NULL.
  @@index([priceId, status], map: "billing_provider_bindings_price_status_idx")
  @@index([provider, status], map: "billing_provider_bindings_provider_status_idx")
  @@index([provider, providerProductId], map: "billing_provider_bindings_provider_product_idx")
  @@index([provider, providerPriceId], map: "billing_provider_bindings_provider_price_idx")
  @@map("billing_provider_price_bindings")
}

model BillingPromotion {
  id                    String                       @id @default(uuid(7)) @db.Uuid
  /// How the promotion is applied — a user-entered `code`, or `automatic`
  /// (a no-code sale auto-applied to a scoped price).
  applyMode             BillingPromotionApplyMode    @default(code) @map("apply_mode")
  /// User-entered promotion or redemption code. This is separate from
  /// PaymentProvider; a free code still creates an order and fulfillment record.
  /// NULL for `automatic` promotions. The unique index is partial by virtue of
  /// Postgres NULLS DISTINCT — many automatic rows (code NULL) coexist while
  /// every non-null code stays unique. Mode/code coupling is a DB CHECK
  /// (see migration): code-mode ⇒ code NOT NULL, automatic ⇒ code NULL.
  code                  String?                      @db.VarChar(64)
  name                  String                       @db.VarChar(160)
  description           String?                      @db.Text
  status                BillingPromotionStatus       @default(draft)
  /// Percentage discount in basis points. 10000 means 100% off and can power
  /// free redemption codes while preserving order + fulfillment + ledger traceability.
  /// Exactly one of percentOffBps / amountOffMinor is set (DB CHECK + DTO refine).
  percentOffBps         Int?                         @map("percent_off_bps")
  /// Fixed-amount discount in minor units (e.g. cents). Requires amountOffCurrency;
  /// only applies to orders in that currency. Mutually exclusive with percentOffBps.
  amountOffMinor        Int?                         @map("amount_off_minor")
  amountOffCurrency     String?                      @map("amount_off_currency") @db.VarChar(3)
  durationType          BillingPromotionDurationType @default(once) @map("duration_type")
  durationCount         Int?                         @map("duration_count")
  durationUnit          String?                      @map("duration_unit") @db.VarChar(16)
  appliesProductType    BillingProductType?          @map("applies_product_type")
  appliesItemId         String?                      @map("applies_item_id") @db.Uuid
  appliesPriceId        String?                      @map("applies_price_id") @db.Uuid
  startsAt              DateTime?                    @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime?                    @map("ends_at") @db.Timestamptz(6)
  maxRedemptions        Int?                         @map("max_redemptions")
  maxRedemptionsPerUser Int?                         @map("max_redemptions_per_user")
  redemptionCount       Int                          @default(0) @map("redemption_count")
  metadata              Json                         @default("{}") @db.JsonB
  createdById           String                       @map("created_by_id") @db.VarChar(64)
  updatedById           String?                      @map("updated_by_id") @db.VarChar(64)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime?                    @map("archived_at") @db.Timestamptz(6)

  appliesItem      BillingCatalogItem?               @relation(fields: [appliesItemId], references: [id], onDelete: SetNull)
  appliesPrice     BillingPrice?                     @relation(fields: [appliesPriceId], references: [id], onDelete: SetNull)
  providerBindings BillingPromotionProviderBinding[]
  redemptions      BillingPromotionRedemption[]

  @@unique([code], map: "billing_promotions_code_unique")
  @@index([status, startsAt, endsAt], map: "billing_promotions_effective_idx")
  @@index([applyMode, status, startsAt, endsAt], map: "billing_promotions_automatic_idx")
  @@index([appliesProductType, status], map: "billing_promotions_product_type_idx")
  @@index([appliesItemId, status], map: "billing_promotions_item_idx")
  @@index([appliesPriceId, status], map: "billing_promotions_price_idx")
  @@map("billing_promotions")
}

enum VoucherStatus {
  active
  redeemed
  void
  expired
}

enum VoucherGrantType {
  /// Grants compute_point credits to the redeemer's personal-workspace wallet.
  compute_credits
  // membership — future: grant an EntitlementGrant for a plan (additive).
}

/// Redemption voucher (兑换券 / gift code / 卡密). DISTINCT from BillingPromotion:
/// a voucher is redeemed for a DIRECT grant (credits/membership), it does not
/// discount an order. Redeem is atomic + idempotent: the active->redeemed flip is
/// a row-locked conditional update (no double-redeem) and the wallet credit is
/// keyed by voucher id (no double-credit; same-user re-redeem recovers a crash).
model Voucher {
  id                  String           @id @default(uuid(7)) @db.Uuid
  /// The redemption code the user enters. Stored uppercased; globally unique.
  code                String           @unique(map: "vouchers_code_unique") @db.VarChar(40)
  /// Groups codes minted together (one admin generate call).
  batchId             String?          @map("batch_id") @db.Uuid
  grantType           VoucherGrantType @default(compute_credits) @map("grant_type")
  /// compute_credits: number of compute_point to grant (1 credit = 1¢). Required
  /// for grantType=compute_credits (DB CHECK).
  computeCreditAmount Int?             @map("compute_credit_amount")
  status              VoucherStatus    @default(active)
  expiresAt           DateTime?        @map("expires_at") @db.Timestamptz(6)
  redeemedByUserId    String?          @map("redeemed_by_user_id") @db.VarChar(64)
  redeemedWorkspaceId String?          @map("redeemed_workspace_id") @db.Uuid
  redeemedAt          DateTime?        @map("redeemed_at") @db.Timestamptz(6)
  note                String?          @db.Text
  createdById         String           @map("created_by_id") @db.VarChar(64)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([batchId], map: "vouchers_batch_idx")
  @@index([status, expiresAt], map: "vouchers_status_idx")
  @@index([redeemedByUserId], map: "vouchers_redeemer_idx")
  @@map("vouchers")
}

enum CreditCampaignStatus {
  draft
  active
  paused
  ended
}

/// A claimable free-credits campaign (date-windowed giveaway). Distinct from a
/// Voucher (a single code → one grant): here ANY eligible user can claim once
/// during the window. Claim is financial-grade: one claim per user is enforced by
/// the CreditCampaignClaim unique index, the budget cap by an atomic conditional
/// increment, and the wallet credit is idempotent (keyed by the claim id).
model CreditCampaign {
  id                  String               @id @default(uuid(7)) @db.Uuid
  name                String               @db.VarChar(160)
  description         String?              @db.Text
  /// compute_point credits granted per claim (1 credit = 1¢).
  computeCreditAmount Int                  @map("compute_credit_amount")
  status              CreditCampaignStatus @default(draft)
  startsAt            DateTime?            @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?            @map("ends_at") @db.Timestamptz(6)
  /// Total budget: max claims across all users (null = unlimited).
  maxClaims           Int?                 @map("max_claims")
  claimCount          Int                  @default(0) @map("claim_count")
  note                String?              @db.Text
  createdById         String               @map("created_by_id") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  claims CreditCampaignClaim[]

  @@index([status, startsAt, endsAt], map: "credit_campaigns_effective_idx")
  @@map("credit_campaigns")
}

model CreditCampaignClaim {
  id          String   @id @default(uuid(7)) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  userId      String   @map("user_id") @db.VarChar(64)
  workspaceId String   @map("workspace_id") @db.Uuid
  amount      Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign CreditCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId], map: "credit_campaign_claims_user_unique")
  @@index([userId], map: "credit_campaign_claims_user_idx")
  @@map("credit_campaign_claims")
}

/// Daily check-in (每日签到) config — a single admin-editable row (key="default").
/// `rewards` is the streak reward cycle by day: day N of a streak grants
/// rewards[(N-1) % rewards.length]. A flat reward is just a 1-length cycle.
model CheckInConfig {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @default("default")
  enabled     Boolean  @default(false)
  rewards     Int[]
  updatedById String?  @map("updated_by_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("check_in_configs")
}

/// One row per user per day. The unique index makes a day's check-in atomic
/// (a double check-in hits it). streakDay = consecutive-day count; amount = the
/// compute_point credited (idempotent, keyed by this row id).
model DailyCheckIn {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.VarChar(64)
  checkInDate DateTime @map("check_in_date") @db.Date
  streakDay   Int      @map("streak_day")
  amount      Int
  workspaceId String   @map("workspace_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, checkInDate], map: "daily_check_ins_user_date_unique")
  @@index([userId], map: "daily_check_ins_user_idx")
  @@map("daily_check_ins")
}

/// Marks a Java legacy-points user as migrated to the PG compute_point wallet.
/// Lazy + per-user: Java calls /internal/points/migrate (e.g. on login) with the
/// user's current Java balance; we ingest it once (unique userId + idempotent
/// credit) and Java flips its own routing flag so that user's future deduct/grant
/// go to PG. `migratedBalance` records the ingested amount for audit.
model PointsMigration {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @unique @map("user_id") @db.VarChar(64)
  migratedBalance Int      @map("migrated_balance")
  workspaceId     String   @map("workspace_id") @db.Uuid
  migratedAt      DateTime @default(now()) @map("migrated_at") @db.Timestamptz(6)

  @@map("points_migrations")
}

model BillingPromotionProviderBinding {
  id               String                       @id @default(uuid(7)) @db.Uuid
  promotionId      String                       @map("promotion_id") @db.Uuid
  /// Provider-side coupon binding. Free internal redemption codes may have no
  /// provider binding and should be fulfilled through internal zero-amount orders.
  provider         PaymentProvider
  providerCouponId String?                      @map("provider_coupon_id") @db.VarChar(128)
  status           BillingProviderBindingStatus @default(active)
  syncError        String?                      @map("sync_error") @db.Text
  providerPayload  Json                         @default("{}") @map("provider_payload") @db.JsonB
  metadata         Json                         @default("{}") @db.JsonB
  lastSyncedAt     DateTime?                    @map("last_synced_at") @db.Timestamptz(6)
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime?                    @map("archived_at") @db.Timestamptz(6)

  promotion BillingPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, status], map: "billing_promotion_bindings_promotion_idx")
  @@index([provider, status], map: "billing_promotion_bindings_provider_idx")
  @@index([provider, providerCouponId], map: "billing_promotion_bindings_provider_coupon_idx")
  @@map("billing_promotion_provider_bindings")
}

model BillingOrder {
  id                      String              @id @default(uuid(7)) @db.Uuid
  orderNo                 String              @map("order_no") @db.VarChar(64)
  /// Client or server idempotency key. Retrying checkout must not create another
  /// payable order for the same logical request.
  idempotencyKey          String              @map("idempotency_key") @db.VarChar(160)
  userId                  String              @map("user_id") @db.VarChar(64)
  workspaceId             String?             @map("workspace_id") @db.Uuid
  subjectType             BillingSubjectType  @map("subject_type")
  subjectId               String              @map("subject_id") @db.VarChar(64)
  orderType               BillingOrderType    @map("order_type")
  status                  BillingOrderStatus  @default(draft)
  itemId                  String              @map("item_id") @db.Uuid
  priceId                 String              @map("price_id") @db.Uuid
  providerBindingId       String?             @map("provider_binding_id") @db.Uuid
  provider                PaymentProvider
  currency                String              @db.Char(3)
  /// Amount before promotion discount.
  subtotalAmountMinor     BigInt              @default(0) @map("subtotal_amount_minor")
  /// Promotion discount applied to this order.
  discountAmountMinor     BigInt              @default(0) @map("discount_amount_minor")
  /// Final payable fiat amount after discount.
  amountMinor             BigInt              @map("amount_minor")
  /// Provider-accepted refunded fiat amount. Pending refund requests are tracked
  /// in BillingRefund and are not counted here until provider acceptance.
  refundedAmountMinor     BigInt              @default(0) @map("refunded_amount_minor")
  quantity                Int                 @default(1)
  /// Per-unit wallet grant frozen at checkout (a snapshot of price.grantsWalletAmount,
  /// or dollars*ratio for an ad-hoc custom recharge). Fulfillment + refund prefer this
  /// over the live price so the grant can never drift after the order is placed. NULL on
  /// legacy orders → falls back to the price grant. Total credited = this * quantity.
  grantsWalletAmount      BigInt?             @map("grants_wallet_amount")
  grantsWalletCurrency    WalletCurrencyType? @map("grants_wallet_currency")
  grantsWalletBalanceKind WalletBalanceKind?  @map("grants_wallet_balance_kind")
  description             String?             @db.VarChar(255)
  metadata                Json                @default("{}") @db.JsonB
  version                 Int                 @default(0)
  expiresAt               DateTime?           @map("expires_at") @db.Timestamptz(6)
  paidAt                  DateTime?           @map("paid_at") @db.Timestamptz(6)
  fulfilledAt             DateTime?           @map("fulfilled_at") @db.Timestamptz(6)
  canceledAt              DateTime?           @map("canceled_at") @db.Timestamptz(6)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace            Workspace?                   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  item                 BillingCatalogItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  price                BillingPrice                 @relation(fields: [priceId], references: [id], onDelete: Restrict)
  providerBinding      BillingProviderPriceBinding? @relation(fields: [providerBindingId], references: [id], onDelete: SetNull)
  paymentIntents       BillingPaymentIntent[]
  refunds              BillingRefund[]
  ledgerJournals       BillingLedgerJournal[]
  promotionRedemptions BillingPromotionRedemption[]
  subscriptionCycles   BillingSubscriptionCycle[]

  @@unique([orderNo], map: "billing_orders_order_no_unique")
  @@unique([userId, idempotencyKey], map: "billing_orders_user_idempotency_unique")
  @@index([userId, createdAt(sort: Desc)], map: "billing_orders_user_recent_idx")
  @@index([workspaceId, createdAt(sort: Desc)], map: "billing_orders_workspace_recent_idx")
  @@index([status, updatedAt(sort: Desc)], map: "billing_orders_status_recent_idx")
  @@index([subjectType, subjectId, createdAt(sort: Desc)], map: "billing_orders_subject_recent_idx")
  @@index([providerBindingId, createdAt(sort: Desc)], map: "billing_orders_provider_binding_recent_idx")
  @@map("billing_orders")
}

model BillingPromotionRedemption {
  id                  String                           @id @default(uuid(7)) @db.Uuid
  promotionId         String                           @map("promotion_id") @db.Uuid
  orderId             String?                          @map("order_id") @db.Uuid
  userId              String                           @map("user_id") @db.VarChar(64)
  /// Snapshot of BillingPromotion.code at reservation time for auditability.
