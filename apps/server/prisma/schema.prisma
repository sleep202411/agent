// ─────────────────────────────────────────────────────────────
// Notification domain (src/notification/)
// ─────────────────────────────────────────────────────────────
//
// Server-owned in-app message inbox. Two-table design mirrors
// AiJob/AiEventOutbox split:
//
//   Notification        — authoritative row, what UI shows
//   NotificationOutbox  — durable Ably-publish queue (retry + DLQ)
//
// Producers write BOTH rows in the same tx. The dispatcher polls
// outbox, publishes a notification.created frame to the authenticated
// per-user Ably channel, then marks it dispatched. The DB row is the source
// of truth; missed pushes recover on channel attach by REST refetch.
//
// Idempotency: every send carries an `idempotencyKey` derived from the
// triggering business event (e.g. "crew.application.approved:<appId>").
// A unique constraint on (userId, idempotencyKey) means the same event
// fired twice (retry, double-click, etc) creates exactly one row.

model Notification {
  id             String    @id
  userId         String    @map("user_id")
  type           String
  title          String
  body           String    @db.Text
  meta           Json      @default("{}")
  /// Deterministic key the producer derives from the source event
  /// (e.g. "crew.application.approved:<applicationId>"). Together with
  /// userId it's the dedup boundary — same event → at most one row.
  idempotencyKey String    @map("idempotency_key")
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  outbox NotificationOutbox[]

  @@unique([userId, idempotencyKey], name: "uniq_user_idempotency", map: "notifications_idempotency_unique")
  /// Unread badge query.
  @@index([userId, readAt], map: "notifications_unread_idx")
  /// Inbox feed.
  @@index([userId, createdAt(sort: Desc)], map: "notifications_feed_idx")
  @@map("notifications")
}

model NotificationOutbox {
  id             String    @id
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  /// JSON-serialized NotificationDTO payload. Snapshot at enqueue time
  /// so deliveries don't depend on the Notification row staying intact.
  payload        Json
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempt        Int       @default(0)
  /// When to retry next. NULL = ready immediately.
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.Text
  /// Pessimistic lock for multi-pod dispatcher safety.
  /// `lockedBy` = pod hostname / pid; `lockedAt` = timestamp.
  /// Stale locks (lockedAt > LOCK_TTL ago) are reclaimable.
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by")
  /// DLQ tombstone. Set when retries exhausted; dispatcher skips. Ops
  /// can inspect / requeue from here.
  deadAt         DateTime? @map("dead_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  /// Pending-events scan: dispatched_at NULL AND dead_at NULL AND
  /// (nextAttemptAt NULL OR nextAttemptAt <= now()) AND lock free.
  @@index([dispatchedAt, deadAt, nextAttemptAt], map: "notification_outbox_pending_idx")
  /// Per-notification timeline (debug / ops).
  @@index([notificationId, createdAt(sort: Desc)], map: "notification_outbox_per_notif_idx")
  /// Find stuck locks (for reclamation).
  @@index([lockedAt], map: "notification_outbox_locked_idx")
  /// DLQ inspection.
  @@index([deadAt], map: "notification_outbox_dead_idx")
  @@map("notification_outbox")
}

// ─────────────────────────────────────────────────────────────
// AI Generation domain (src/ai-generation/)
// ─────────────────────────────────────────────────────────────
//
// Enums get enforced at the DB level — typos can't write garbage
// statuses. Adding a value still requires a migration (one ALTER TYPE),
// which is the right amount of friction for a state machine.

enum AiJobType {
  image
  video
  audio
}

enum AiJobStatus {
  created
  in_queue
  in_progress
  completed
  failed
  cancelled
  expired
}

enum AiJobStage {
  created
  queued
  validating
  calling_provider
  provider_queued
  generating
  fetching_output
  uploading_to_oss
  completed
  failed
  cancelled
  expired
}

enum AiAttemptStatus {
  submitted
  running
  succeeded
  failed
  aborted
}

enum AiProviderEventType {
  queue_update
  started
  completed
  failed
  unknown
}

enum AiOutboxEventType {
  /// Job lifecycle change (status/stage/queuePosition update). The
  /// payload mirrors the Web PubSub `ai_job_update` shape.
  job_update
  /// Media asset moderation changed. Payload is a
  /// `media_asset_moderation_changed` asset event.
  media_asset_moderation_changed
  /// Compute/community wallet balance changed (top-up / spend / refund / expiry).
  wallet_changed
  /// Compute credit landed and previously insufficient-points-blocked Story
  /// generation batches are now resumable (notify-only; never auto-resumes).
  story_generation_batches_resumable
  /// Plan / entitlement changed (upgrade, seat change, refund-revoke).
  entitlement_changed
  /// Workspace membership changed (member added / removed / role changed).
  team_member_changed
  /// Project changed (created / updated / archived / shared).
  project_changed
  /// Character media provider-mirror state changed (pending/processing/
  /// active/failed). Payload is a `character_media_updated` asset event,
  /// published on `assets-user:{ownerUserId}` (design §2.2 leave-and-notify).
  character_media_updated
  /// Plain MediaAsset provider-mirror state changed. Payload is a
  /// `media_provider_asset_updated` asset event.
  media_provider_asset_updated
  /// A Story Canvas Agent run changed lifecycle state. Payload is a
  /// `story_agent_run_changed` project-scoped realtime event.
  story_agent_run_changed
}

enum AiControlPlaneStatus {
  draft
  active
  disabled
  degraded
  archived
}

enum AiProviderHealthStatus {
  unknown
  healthy
  degraded
  outage
}

enum AiCostLedgerEntryType {
  reservation
  charge
  refund
  provider_cost
  adjustment
}

// AiProviderAccount — operational provider account, region cell, SLO policy,
// and alert routing. Secrets are stored in AiProviderCredential with envelope
// encryption; this row only owns provider routing and operational policy.
model AiProviderAccount {
  id               String               @id @default(uuid(7)) @db.Uuid
  provider         String               @db.VarChar(64)
  status           AiControlPlaneStatus @default(active)
  /// key-wide outbound throttle (maxConcurrentRequests / refillPerMinute) — consumed by provider-aware queue dispatch.
  rateLimitPolicy  Json                 @default("{}") @map("rate_limit_policy") @db.JsonB
  /// key-wide spend cap (monthlyHardLimitUsd, …).
  quotaPolicy      Json                 @default("{}") @map("quota_policy") @db.JsonB
  createdByAdminId String?              @map("created_by_admin_id") @db.Uuid
  updatedByAdminId String?              @map("updated_by_admin_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime?            @map("archived_at") @db.Timestamptz(6)

  endpoints AiProviderEndpoint[]
  bindings  AiProviderModelBinding[]

  @@unique([provider], map: "ai_provider_accounts_provider_unique")
  @@index([status, updatedAt(sort: Desc)], map: "ai_provider_accounts_status_updated_idx")
  @@map("ai_provider_accounts")
}

// AiProviderEndpoint — provider-side inventory. Provider catalog sync writes
// only here, so upstream endpoint churn never pollutes the user-facing model
// catalog. Operators explicitly bind verified endpoints to canonical models.
model AiProviderEndpoint {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  providerAccountId     String                 @map("provider_account_id") @db.Uuid
  provider              String                 @db.VarChar(64)
  endpointId            String                 @map("endpoint_id") @db.VarChar(180)
  displayName           String?                @map("display_name") @db.VarChar(160)
  modality              AiJobType
  status                AiControlPlaneStatus   @default(draft)
  healthStatus          AiProviderHealthStatus @default(unknown) @map("health_status")
  supportedModes        Json                   @default("[]") @map("supported_modes") @db.JsonB
  providerInputSchema   Json                   @default("{}") @map("provider_input_schema") @db.JsonB
  providerOutputSchema  Json                   @default("{}") @map("provider_output_schema") @db.JsonB
  maxConcurrentRequests Int?                   @map("max_concurrent_requests")
  maxRequestsPerMinute  Int?                   @map("max_requests_per_minute")
  requestTimeoutSeconds Int?                   @map("request_timeout_seconds")
  cooldownSeconds       Int?                   @map("cooldown_seconds")
  failureThreshold      Int?                   @map("failure_threshold")
  catalogSnapshot       Json                   @default("{}") @map("catalog_snapshot") @db.JsonB
  disabledReason        String?                @map("disabled_reason") @db.Text
  createdByAdminId      String?                @map("created_by_admin_id") @db.Uuid
  updatedByAdminId      String?                @map("updated_by_admin_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime?              @map("archived_at") @db.Timestamptz(6)

  providerAccount AiProviderAccount        @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  bindings        AiProviderModelBinding[]

  @@unique([providerAccountId, endpointId], map: "ai_provider_endpoints_account_endpoint_unique")
  @@index([provider, endpointId], map: "ai_provider_endpoints_provider_endpoint_idx")
  @@index([modality, status, healthStatus], map: "ai_provider_endpoints_catalog_idx")
  @@map("ai_provider_endpoints")
}

// AiCanonicalModel — user-facing model identity. It owns product policy:
// user-facing parameters, billing, queue limits, UI metadata, and observability
// defaults. Multiple providers may back the same canonical model; routing
// selects an active binding per request and freezes the decision on AiJob.
model AiCanonicalModel {
  id                  String               @id @default(uuid(7)) @db.Uuid
  slug                String               @db.VarChar(120)
  displayName         String               @map("display_name") @db.VarChar(160)
  modality            AiJobType
  family              String               @db.VarChar(80)
  vendor              String?              @db.VarChar(64)
  generationModes     Json                 @default("[]") @map("generation_modes") @db.JsonB
  status              AiControlPlaneStatus @default(draft)
  description         String?              @db.Text
  parameterPolicy     Json                 @default("{}") @map("parameter_policy") @db.JsonB
  outputPolicy        Json                 @default("{}") @map("output_policy") @db.JsonB
  entitlementPolicy   Json                 @default("{}") @map("entitlement_policy") @db.JsonB
  billingPolicy       Json                 @default("{}") @map("billing_policy") @db.JsonB
  queuePolicy         Json                 @default("{}") @map("queue_policy") @db.JsonB
  uiPolicy            Json                 @default("{}") @map("ui_policy") @db.JsonB
  observabilityPolicy Json                 @default("{}") @map("observability_policy") @db.JsonB
  metadata            Json                 @default("{}") @db.JsonB
  createdByAdminId    String?              @map("created_by_admin_id") @db.Uuid
  updatedByAdminId    String?              @map("updated_by_admin_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime?            @map("archived_at") @db.Timestamptz(6)

  bindings AiProviderModelBinding[]
  jobs     AiJob[]

  @@unique([slug], map: "ai_canonical_models_slug_unique")
  @@index([modality, status], map: "ai_canonical_models_catalog_idx")
  @@index([family, status], map: "ai_canonical_models_family_idx")
  @@map("ai_canonical_models")
}

// AiProviderModelBinding — the route from one user-facing canonical model to
// one verified provider endpoint. It owns only route controls
// (status/priority/weight) and immutable endpoint snapshots for audit. Product
// pricing, user-facing parameter policy, queue policy, and observability live
// on AiCanonicalModel; provider request mapping lives in adapter code; retries
// preserve the submit-time routing snapshot. Provider request cost is written
// only to AiCostLedgerEntry when the provider exposes actual usage/cost.
model AiProviderModelBinding {
  id                   String               @id @default(uuid(7)) @db.Uuid
  providerAccountId    String               @map("provider_account_id") @db.Uuid
  providerEndpointId   String               @map("provider_endpoint_id") @db.Uuid
  canonicalModelId     String               @map("canonical_model_id") @db.Uuid
  provider             String               @db.VarChar(64)
  endpointId           String               @map("endpoint_id") @db.VarChar(180)
  displayName          String?              @map("display_name") @db.VarChar(160)
  modality             AiJobType
  status               AiControlPlaneStatus @default(draft)
  priority             Int                  @default(100)
  weight               Int                  @default(100)
  supportedModes       Json                 @default("[]") @map("supported_modes") @db.JsonB
  inputSchema          Json                 @default("{}") @map("input_schema") @db.JsonB
  outputSchema         Json                 @default("{}") @map("output_schema") @db.JsonB
  providerInputSchema  Json                 @default("{}") @map("provider_input_schema") @db.JsonB
  providerOutputSchema Json                 @default("{}") @map("provider_output_schema") @db.JsonB
  catalogSnapshot      Json                 @default("{}") @map("catalog_snapshot") @db.JsonB
  disabledReason       String?              @map("disabled_reason") @db.Text
  createdByAdminId     String?              @map("created_by_admin_id") @db.Uuid
  updatedByAdminId     String?              @map("updated_by_admin_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt           DateTime?            @map("archived_at") @db.Timestamptz(6)

  providerAccount  AiProviderAccount   @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  providerEndpoint AiProviderEndpoint  @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict)
  canonicalModel   AiCanonicalModel    @relation(fields: [canonicalModelId], references: [id], onDelete: Restrict)
  jobs             AiJob[]
  costLedger       AiCostLedgerEntry[]

  @@unique([providerAccountId, endpointId], map: "ai_provider_bindings_account_endpoint_unique")
  @@index([providerEndpointId, status, priority], map: "ai_provider_bindings_endpoint_route_idx")
  @@index([canonicalModelId, status, priority], map: "ai_provider_bindings_model_route_idx")
  @@index([provider, endpointId], map: "ai_provider_bindings_provider_endpoint_idx")
  @@index([modality, status], map: "ai_provider_bindings_modality_status_idx")
  @@map("ai_provider_model_bindings")
}

model AiCostLedgerEntry {
  id                String                @id @default(uuid(7)) @db.Uuid
  jobId             String                @map("job_id") @db.Uuid
  attemptId         String?               @map("attempt_id")
  providerBindingId String?               @map("provider_binding_id") @db.Uuid
  userId            String                @map("user_id") @db.VarChar(64)
  workspaceId       String?               @map("workspace_id") @db.Uuid
  entryType         AiCostLedgerEntryType @map("entry_type")
  currency          String                @db.VarChar(16)
  amount            Decimal               @db.Decimal(18, 6)
  internalCredits   Int?                  @map("internal_credits")
  providerCostUsd   Decimal?              @map("provider_cost_usd") @db.Decimal(18, 6)
  listPriceCredits  Int?                  @map("list_price_credits")
  marginUsd         Decimal?              @map("margin_usd") @db.Decimal(18, 6)
  pricingSnapshot   Json                  @default("{}") @map("pricing_snapshot") @db.JsonB
  idempotencyKey    String                @map("idempotency_key") @db.VarChar(180)
  source            String                @db.VarChar(80)
  metadata          Json                  @default("{}") @db.JsonB
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  job             AiJob                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt         AiJobAttempt?           @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  providerBinding AiProviderModelBinding? @relation(fields: [providerBindingId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey], map: "ai_cost_ledger_idempotency_key_unique")
  @@index([jobId, createdAt(sort: Asc)], map: "ai_cost_ledger_job_idx")
  @@index([userId, createdAt(sort: Desc)], map: "ai_cost_ledger_user_recent_idx")
  @@index([providerBindingId, createdAt(sort: Desc)], map: "ai_cost_ledger_provider_binding_idx")
  @@map("ai_cost_ledger_entries")
}

// AiJob — one row per user submission to a generation provider.
// Production-grade conventions applied:
//   - Soft delete via `deletedAt` (preserve evidence for audit / billing)
//   - Optimistic locking via `version` — repository.update() enforces
//     when caller supplies `expectedVersion`; pure overwrite otherwise.
//   - `requestId` for cross-system trace correlation
//   - All timestamps Timestamptz(6) for sub-ms precision
//   - Prisma schema carries normal lookup indexes; migration SQL owns
//     partial uniques that Prisma DSL cannot express.
//
// TODO(billing): `cost` is a *display* field. A real money ledger
//   needs an immutable `ai_cost_ledger` table with idempotency_key,
//   amount, currency, source, reversal_of FK. This Json is a stopgap
//   until billing goes live.
model AiJob {
  id                    String                @id @db.Uuid
  userId                String                @map("user_id")
  /// Immutable product entitlement policy selected at submission time.
  /// This is the source for model access, queue priority, quota bridge,
  /// refunds, and audit; upstream profile claims are not part of this model.
  entitlementSnapshot   Json?                 @map("entitlement_snapshot")
  type                  AiJobType
  /// Adapter identifier (e.g. 'fal-ai', 'byteplus-modelark'). Free-form
  /// String so new providers don't need migrations; old rows may hold
  /// removed vendor strings as read-only history.
  provider              String
  modelId               String                @map("model_id")
  deployment            String
  canonicalModelId      String?               @map("canonical_model_id") @db.Uuid
  providerBindingId     String?               @map("provider_binding_id") @db.Uuid
  schemaVersion         String                @map("schema_version")
  /// Platform Core context. New Studio jobs always resolve a workspace
  /// at submit time; legacy rows may remain NULL. Project is optional
  /// because some jobs are workspace-level drafts before a project is
  /// selected.
  workspaceId           String?               @map("workspace_id") @db.Uuid
  projectId             String?               @map("project_id") @db.Uuid
  storyProjectId        String?               @map("story_project_id") @db.Uuid
  /// Immutable payer identity resolved at submission time. The workspace
  /// cutover backfills historical payers before retiring the old policy.
  /// Settlement and release follow the recorded wallet hold.
  billingSubjectType    BillingSubjectType?   @map("billing_subject_type")
  billingSubjectId      String?               @map("billing_subject_id") @db.VarChar(64)
  documentId            String?               @map("document_id") @db.Uuid
  documentBlockId       String?               @map("document_block_id") @db.VarChar(128)
  /// UI surface snapshot for ops analysis. Examples: 'art-studio' | 'timeline' | 'batch'.
  sourceSurface         String?               @map("source_surface") @db.VarChar(64)
  /// Selected cell storage provider, frozen on every new admission. Historical
  /// NULL rows use OutputStorageService. Retries retain their original provider
  /// so output objects cannot be orphaned by a later configuration change.
  /// A database CHECK excludes external_url from writable providers.
  outputStorageProvider MediaStorageProvider? @map("output_storage_provider")
  status                AiJobStatus
  stage                 AiJobStage
  queueName             String                @map("queue_name")
  prompt                String
  /// User-facing structured prompt AST captured at submission time.
  /// Provider adapters never parse UI tokens directly; they consume
  /// `normalizedInput.prompt`, which is compiled from this document.
  promptDocument        Json?                 @map("prompt_document")
  promptDisplayText     String?               @map("prompt_display_text") @db.Text
  promptSearchText      String?               @map("prompt_search_text") @db.Text
  compiledPrompt        String?               @map("compiled_prompt") @db.Text
  /// Ordered reference/style snapshots used by the prompt compiler.
  /// The order is immutable and matches the provider image payload order.
  referenceSnapshot     Json?                 @map("reference_snapshot")
  styleSnapshot         Json?                 @map("style_snapshot")
  /// Immutable effective project Skill resolution used to compile this job.
  /// Retries reuse it unless the caller explicitly requests a fresh resolve.
  skillSnapshot         Json?                 @map("skill_snapshot") @db.JsonB
  idempotencyKey        String                @map("idempotency_key")
  /// External trace id (X-Request-Id header), nullable until UI sends one.
  requestId             String?               @map("request_id")
  input                 Json
  normalizedInput       Json                  @map("normalized_input")
  /// Immutable routing/policy snapshot selected at submit time:
  /// route id, provider/model decision, quota/campaign policy, and
  /// queue limits. Workers and refunds read this instead of deriving
  /// policy from mutable runtime config.
  routingSnapshot       Json?                 @map("routing_snapshot")
  error                 Json?
  logs                  Json
  metrics               Json
  queuePosition         Int?                  @map("queue_position")
  progress              Float?
  estimatedWaitSeconds  Int?                  @map("estimated_wait_seconds")
  estimatedRunSeconds   Int?                  @map("estimated_run_seconds")
  estimatedTotalSeconds Int?                  @map("estimated_total_seconds")
  etaConfidence         String?               @map("eta_confidence")
  attempt               Int                   @default(1)
  retryOfJobId          String?               @map("retry_of_job_id") @db.Uuid
  /// Provider-side job id for async providers (fal.ai request_id,
  /// Replicate prediction id, Azure video job id). NULL for sync
  /// providers like Azure Foundry images. Indexed with `provider` for
  /// fast webhook reverse-lookup.
  providerJobId         String?               @map("provider_job_id")
  /// Aggregated cost across all attempts. See TODO(billing) above.
  cost                  Json?
  /// W3C distributed trace context (traceparent / tracestate) so logs
  /// from worker / DB / provider correlate in observability stack.
  trace                 Json?
  /// Client telemetry — abuse detection, UA-specific bug triage.
  clientIp              String?               @map("client_ip")
  userAgent             String?               @map("user_agent")
  /// Optimistic concurrency control. Increment on every update; readers
  /// supply the version they saw in the WHERE clause via
  /// repository.update(id, patch, expectedVersion).
  version               Int                   @default(0)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  queuedAt              DateTime?             @map("queued_at") @db.Timestamptz(6)
  startedAt             DateTime?             @map("started_at") @db.Timestamptz(6)
  providerSubmittedAt   DateTime?             @map("provider_submitted_at") @db.Timestamptz(6)
  providerStartedAt     DateTime?             @map("provider_started_at") @db.Timestamptz(6)
  providerCompletedAt   DateTime?             @map("provider_completed_at") @db.Timestamptz(6)
  outputFetchedAt       DateTime?             @map("output_fetched_at") @db.Timestamptz(6)
  ossUploadedAt         DateTime?             @map("oss_uploaded_at") @db.Timestamptz(6)
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete tombstone. Repository helpers filter `deletedAt: null`;
  /// raw Prisma callers must do the same.
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamptz(6)

  outputs                    AiJobOutput[]
  attempts                   AiJobAttempt[]
  events                     AiEventOutbox[]
  costLedger                 AiCostLedgerEntry[]
  traceEvents                AiProviderTraceEvent[]
  mediaAssetUsages           MediaAssetUsage[]
  storyReferenceVersions     StoryReferenceVersion[]
  storyProductionGenerations StoryProductionGeneration[]
  canonicalModel             AiCanonicalModel?           @relation(fields: [canonicalModelId], references: [id], onDelete: SetNull)
  providerBinding            AiProviderModelBinding?     @relation(fields: [providerBindingId], references: [id], onDelete: SetNull)
  workspace                  Workspace?                  @relation(fields: [workspaceId], references: [id])
  project                    PlatformProject?            @relation(fields: [projectId], references: [id])
  storyProject               StoryProject?               @relation(fields: [storyProjectId], references: [id])
  document                   StudioDocument?             @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ai_jobs_document_workspace_fk")

  /// Active-row idempotency is enforced by a partial unique index in
  /// migration SQL: (user_id, model_id, idempotency_key) WHERE deleted_at IS NULL.
  @@index([userId, modelId, idempotencyKey], map: "ai_jobs_idempotency_lookup_idx")
  @@index([userId, createdAt(sort: Desc)], map: "ai_jobs_user_created_idx")
  @@index([workspaceId, createdAt(sort: Desc)], map: "ai_jobs_workspace_created_idx")
  @@index([projectId, createdAt(sort: Desc)], map: "ai_jobs_project_created_idx")
  @@index([storyProjectId, createdAt(sort: Desc)], map: "ai_jobs_story_project_created_idx")
  @@index([billingSubjectType, billingSubjectId, createdAt(sort: Desc)], map: "ai_jobs_billing_subject_recent_idx")
  @@index([documentId, documentBlockId, createdAt(sort: Desc)], map: "ai_jobs_document_block_created_idx")
  @@index([canonicalModelId, createdAt(sort: Desc)], map: "ai_jobs_canonical_model_created_idx")
  @@index([providerBindingId, createdAt(sort: Desc)], map: "ai_jobs_provider_binding_created_idx")
  @@index([queueName, status, queuedAt], map: "ai_jobs_queue_claim_idx")
  /// Fast reverse-lookup from a webhook `(provider, providerJobId)`
  /// to the owning AiJob.
  @@index([provider, providerJobId], map: "ai_jobs_provider_job_id_idx")
  @@index([deletedAt], map: "ai_jobs_deleted_at_idx")
  @@map("ai_jobs")
}

// AiJobOutput — one row per generated artifact (OSS-backed).
model AiJobOutput {
  id              String    @id
  jobId           String    @map("job_id") @db.Uuid
  assetId         String?   @map("asset_id") @db.Uuid
  type            AiJobType
  url             String
  /// CDN thumbnail variant — gallery uses this; original `url` is the
  /// full asset. Optional; populated by a post-processing step.
  thumbnailUrl    String?   @map("thumbnail_url")
  storagePath     String    @map("storage_path")
  /// SHA-256 (truncated to 12 hex) of the bytes — queryable separately
  /// from the id for cross-user dedupe lookups.
  contentHash     String?   @map("content_hash")
  width           Int?
  height          Int?
  durationSeconds Int?      @map("duration_seconds")
  mimeType        String?   @map("mime_type")
  bytes           Int?
  outputIndex     Int       @map("output_index")
  /// Actual seed the provider used. BigInt — fal seeds can exceed Int32.
  seed            BigInt?
  /// Content-safety signals returned by provider
  /// (nsfw_score, violence, hate, …). Shape provider-specific.
  safetyFlags     Json?     @map("safety_flags")
  /// What model/version/checkpoint produced this output — used for
  /// reproducibility, copyright accountability, watermark provenance.
  provenance      Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Soft delete tombstone. Audit / billing wants to see what was
  /// generated even after the user hides a gallery item.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  job                          AiJob                             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset                        MediaAsset?                       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  mediaAssetUsages             MediaAssetUsage[]
  storyReferenceVersions       StoryReferenceVersion[]
  storyAssetMediaVersions      StoryAssetMediaVersion[]          @relation("StoryAssetMediaVersionAiOutput")
  storyStoryboardMediaVersions StoryStoryboardClipMediaVersion[] @relation("StoryStoryboardMediaVersionAiOutput")

  @@unique([jobId, outputIndex], name: "uniq_job_output_index", map: "ai_outputs_job_index_unique")
  @@unique([id, jobId], map: "ai_outputs_id_job_unique")
  @@index([jobId], map: "ai_outputs_job_idx")
  @@index([assetId], map: "ai_outputs_asset_idx")
  @@index([contentHash], map: "ai_outputs_content_hash_idx")
  @@index([deletedAt], map: "ai_outputs_deleted_at_idx")
  @@map("ai_outputs")
}

// AiJobAttempt — append-only log of each provider call (initial + retries).
// Stores the full request / response / headers / cost so any past
// generation can be replayed or audited.
model AiJobAttempt {
  id                      String          @id
  jobId                   String          @map("job_id") @db.Uuid
  attemptNumber           Int             @map("attempt_number")
  status                  AiAttemptStatus
  providerStatus          Int?            @map("provider_status")
  // Text, not VarChar: some providers (Agnes video) return a long, length-
  // unbounded provider request id (`video_id`, ~174 chars) we store verbatim.
  providerRequestId       String?         @map("provider_request_id") @db.Text
  providerEndpoint        String?         @map("provider_endpoint") @db.VarChar(180)
  queuePosition           Int?            @map("queue_position")
  /// Full request body sent to the provider (after adapter mapping).
  providerRequest         Json?           @map("provider_request")
  /// Outbound headers (auth redacted server-side before write).
  providerRequestHeaders  Json?           @map("provider_request_headers")
  /// Raw response body. Audit / debug / future re-parse.
  providerResponse        Json?           @map("provider_response")
  /// Response headers — Azure / fal often return rate limit / cost
  /// info here (x-ratelimit-*, x-fal-*).
  providerResponseHeaders Json?           @map("provider_response_headers")
  /// Provider-side logs (fal returns inference step logs; Azure returns
  /// content filter signals). Kept verbatim.
  providerLogs            Json?           @map("provider_logs")
  /// This-attempt cost breakdown. Aggregated into AiJob.cost on success.
  costAccounting          Json?           @map("cost_accounting")
  pricingSnapshot         Json?           @map("pricing_snapshot")
  profitAccounting        Json?           @map("profit_accounting")
  timing                  Json?
  rawStatus               Json?           @map("raw_status")
  error                   Json?
  runDurationMs           Int?            @map("run_duration_ms")
  submittedAt             DateTime?       @map("submitted_at") @db.Timestamptz(6)
  executionStartedAt      DateTime?       @map("execution_started_at") @db.Timestamptz(6)
  firstByteAt             DateTime?       @map("first_byte_at") @db.Timestamptz(6)
  startedAt               DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz(6)

  job         AiJob                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  costLedger  AiCostLedgerEntry[]
  traceEvents AiProviderTraceEvent[]

  @@unique([jobId, attemptNumber], map: "ai_attempts_job_attempt_unique")
  @@index([jobId], map: "ai_attempts_job_idx")
  @@index([providerRequestId], map: "ai_attempts_provider_request_id_idx")
  @@map("ai_attempts")
}

// AiProviderTraceEvent — append-only, request-level evidence timeline.
//
// This table is intentionally separate from AiJobAttempt JSON blobs:
// operators need a fast, stable timeline that can merge our internal
// lifecycle, provider queue status, provider platform analytics, billing
// headers, and future webhook callbacks without reparsing provider-specific
// payloads. `source` + `confidence` make inferred timings explicit.
model AiProviderTraceEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  jobId             String   @map("job_id") @db.Uuid
  attemptId         String?  @map("attempt_id")
  provider          String   @db.VarChar(64)
  endpointId        String?  @map("endpoint_id") @db.VarChar(180)
  // Text, not VarChar: mirrors AiJobAttempt.providerRequestId — a long,
  // length-unbounded provider request id (Agnes `video_id`) is stored verbatim.
  providerRequestId String?  @map("provider_request_id") @db.Text
  eventType         String   @map("event_type") @db.VarChar(64)
  source            String   @db.VarChar(64)
  confidence        String   @db.VarChar(24)
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(6)
  offsetMs          Int?     @map("offset_ms")
  durationMs        Int?     @map("duration_ms")
  title             String?  @db.VarChar(160)
  description       String?
  payload           Json     @default("{}") @db.JsonB
  idempotencyKey    String   @map("idempotency_key") @db.VarChar(220)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job     AiJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt AiJobAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey], map: "ai_provider_trace_events_idempotency_key_unique")
  @@index([jobId, occurredAt(sort: Asc)], map: "ai_provider_trace_events_job_timeline_idx")
  @@index([provider, providerRequestId], map: "ai_provider_trace_events_provider_request_idx")
  @@map("ai_provider_trace_events")
}

// AiProviderEvent — inbound webhook / async callback log.
//
// fal.ai (and any async provider) push completion via webhook. Recording
// the raw payload + signature verification result gives us:
//   - audit trail (proof of what the provider told us)
//   - replay capability (re-process if our handler crashed mid-handling)
//   - idempotency (drop duplicates via event_fingerprint unique)
//
// `jobId` is nullable because some events may arrive for jobs we don't
// recognize (already cleaned, wrong tenant, race against creation);
// store them anyway so we can investigate later.
model AiProviderEvent {
  id               String              @id
  jobId            String?             @map("job_id") @db.Uuid
  provider         String
  /// Provider's own ID for this event (fal: request_id; others may vary).
  providerEventId  String?             @map("provider_event_id")
  /// Stable dedupe key. Prefer providerEventId when present; otherwise
  /// use a canonical hash of provider + payload fields chosen by the
  /// webhook adapter. Non-null so Postgres uniqueness is real.
  eventFingerprint String              @map("event_fingerprint")
  eventType        AiProviderEventType @map("event_type")
  payload          Json
  headers          Json
  signatureValid   Boolean             @map("signature_valid")
  receivedAt       DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?           @map("processed_at") @db.Timestamptz(6)
  processingError  String?             @map("processing_error")

  @@unique([provider, eventFingerprint], name: "uniq_provider_event_fingerprint", map: "ai_provider_events_provider_fingerprint_unique")
  @@index([jobId, receivedAt(sort: Desc)], map: "ai_provider_events_job_recent_idx")
  @@index([processedAt], map: "ai_provider_events_pending_idx")
  @@map("ai_provider_events")
}

// AiEventOutbox — durable Web PubSub fan-out. Dispatcher polls
// `dispatched_at IS NULL` rows and publishes; success marks
// dispatched_at. Failures bump `attempt`, schedule `nextAttemptAt`
// (exponential backoff), record `lastError`; after a cap rows go to
// the DLQ via `deadAt`. Pod-level `lockedAt` / `lockedBy` let multiple
// dispatcher instances coexist without double-publishing.
model AiEventOutbox {
  id            String            @id
  jobId         String?           @map("job_id") @db.Uuid
  userId        String            @map("user_id")
  eventType     AiOutboxEventType @map("event_type")
  payload       Json
  dispatchedAt  DateTime?         @map("dispatched_at") @db.Timestamptz(6)
  attempt       Int               @default(0)
  /// When to retry next. NULL = ready immediately.
  nextAttemptAt DateTime?         @map("next_attempt_at") @db.Timestamptz(6)
  /// Last dispatch error, truncated. For ops triage.
  lastError     String?           @map("last_error")
  /// Pessimistic lock for multi-pod dispatcher safety.
  /// `lockedBy` = pod hostname / random id; `lockedAt` = timestamp.
  /// Stale locks (lockedAt > LOCK_TTL ago) are reclaimable.
  lockedAt      DateTime?         @map("locked_at") @db.Timestamptz(6)
  lockedBy      String?           @map("locked_by")
  /// DLQ tombstone. Set when retries exhausted; dispatcher skips. Ops
  /// can inspect / requeue from here.
  deadAt        DateTime?         @map("dead_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Realtime envelope (P3, docs/studio-realtime-architecture.md §3): the channel
  /// this event belongs to, a per-channel monotonic sequence (for client gap
  /// detection + /replay catch-up), and a globally-unique id (idempotency key).
  /// Nullable for backward-compat during rollout — the new emit path always sets
  /// them; old in-flight rows drain without.
  channel String?
  seq     BigInt?
  eventId String? @map("event_id")

  job AiJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Pending-events scan: dispatched_at NULL AND dead_at NULL AND
  /// (nextAttemptAt NULL OR nextAttemptAt <= now()) AND lock free.
  @@index([dispatchedAt, deadAt, nextAttemptAt], map: "ai_event_outbox_pending_idx")
  /// Per-job event timeline (debug / ops).
  @@index([jobId, createdAt(sort: Desc)], map: "ai_event_outbox_job_recent_idx")
  /// Find stuck locks (lockedAt < cutoff).
  @@index([lockedAt], map: "ai_event_outbox_locked_idx")
  /// DLQ inspection.
  @@index([deadAt], map: "ai_event_outbox_dead_idx")
  /// Replay catch-up: events for a channel after a given sequence.
  @@index([channel, seq], map: "ai_event_outbox_channel_seq_idx")
  @@map("ai_event_outbox")
}

/// Per-channel monotonic sequence allocator for the realtime event plane (P3,
/// docs/studio-realtime-architecture.md §3). `nextSeq` is advanced atomically
/// (a single PG `INSERT ... ON CONFLICT DO UPDATE` — gap-free under concurrent
/// writers) when an event is enqueued; see `enqueueRealtimeEvent`. One row per
/// channel; per-channel locking keeps unrelated channels contention-free.
model RealtimeSequenceCursor {
  channel String @id
  nextSeq BigInt @default(1) @map("next_seq")

  @@map("realtime_sequence_cursor")
}

// ─────────────────────────────────────────────────────────────
// Quota domain (src/quota/)
// ─────────────────────────────────────────────────────────────
//
// Per-user usage ledger. Phase 1 of the quota system is observation-
// only: every consumable user action (image generate, chat submit,
// workflow start, ...) writes one row. No enforcement, no Redis
// counters, no UI — the goal is one week of real data to calibrate
// tier thresholds before flipping on hard caps.
//
// Later phases add Redis-backed counters + idempotent consume/refund
// + per-tier limits; this table remains the durable audit source of
// truth (Redis is the hot cache).

enum QuotaDimension {
  image
  chat
  workflow
  upload
}

model QuotaUsageLog {
  id             String         @id
  userId         String         @map("user_id") @db.VarChar(64)
  dimension      QuotaDimension
  /// Signed cost. Positive = consume, negative = refund. Lets one
  /// query give net usage per user/dimension/window via SUM().
  cost           Int            @default(1)
  /// Free-form action label — `submit_message_to_agent`,
  /// `ai_job_create`, `workflow_start`, `upload_banner`, ...
  reason         String         @db.VarChar(64)
  /// Optional client-supplied dedup key. Multiple rows with the same
  /// key represent a consume followed by its refund — useful when
  /// reconciling. NULL means no dedup needed (best-effort logging).
  idempotencyKey String?        @map("idempotency_key") @db.VarChar(128)
  /// Loose metadata bag — `{jobType:'image', model:'gpt-image-2'}`,
  /// `{conversationId:'...'}`. Not indexed; for forensics.
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Per-user/dimension scans — `SELECT SUM(cost) FROM quota_usage_log
  /// WHERE user_id = ? AND dimension = ? AND created_at >= ?`.
  @@index([userId, dimension, createdAt(sort: Desc)], map: "quota_usage_log_user_dim_recent_idx")
  /// Cross-tier analytics over a day window.
  @@index([dimension, createdAt(sort: Desc)], map: "quota_usage_log_dim_recent_idx")
  @@map("quota_usage_log")
}

// ──────────────────────────────────────────────────────────────────
//  Creator services — marketplace layer over the talent pool.
//
//  CreatorService = one offering ("character design", "short-film
//  edit"). Each service carries 1-3 ServicePackages (basic /
//  standard / premium tiers).
//
//  Status state machine: draft → listed ⇄ paused → archived. Only
//  `listed` is publicly browseable. `listed` requires ≥ 1 package.
//
//  Money: prices stored in smallest currency unit (cents / 分 / yen),
//  same convention as CrewPosition.salary_min_amount.
// ──────────────────────────────────────────────────────────────────

enum CreatorServiceStatus {
  draft
  listed
  paused
  archived

  @@map("creator_service_status")
}

enum ServiceTier {
  basic
  standard
  premium

  @@map("service_tier")
}

model CreatorService {
  id        String @id
  creatorId String @map("creator_id")

  /// Optional first-save receipt. Scoped to the creator; never reused for edits.
  creationKey         String? @map("creation_key") @db.VarChar(64)
  creationFingerprint String? @map("creation_fingerprint") @db.VarChar(64)

  /// Buyer-facing headline ("Final cut · 30s vertical"). ≤ 120 chars.
  title     String @db.VarChar(120)
  /// One-paragraph pitch (≤ 1000 chars). Plain text, newline-allowed.
  summary   String @db.Text
  /// OSS-relative cover path. UI prefixes with BANNER_BASE_URL.
  coverPath String @default("") @map("cover_path") @db.VarChar(512)

  /// Service taxonomy. Free-form on the wire so we can rev categories
  /// without a migration; validated against SERVICE_CATEGORIES in
  /// `packages/shared/src/creator-service.ts` at the controller layer.
  category String @db.VarChar(64)

  /// Free-form skill / style tags. PG TEXT[], ≤ 10 entries enforced
  /// at the service layer.
  tags String[] @default([])

  status      CreatorServiceStatus @default(draft)
  /// First-time-listed timestamp — used as the "newest first" sort
  /// key in the marketplace plaza. Stays NULL while draft; set on the
  /// first publish; never cleared (pause/archive keep history).
  publishedAt DateTime?            @map("published_at") @db.Timestamptz(6)

  /// Optimistic concurrency token. Bumped on every owner-write so
  /// the edit dialog can detect "someone else (or another tab) saved
  /// after I loaded".
  version Int @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete — set on archive so referenced orders (Phase 1b)
  /// still resolve.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  packages             ServicePackage[]
  requirementQuestions ServiceRequirementQuestion[]
  orders               ServiceOrder[]

  @@unique([creatorId, creationKey], map: "creator_services_creation_key_unique")
  /// Owner-side query: "list my services in created-order".
  @@index([creatorId, deletedAt, createdAt(sort: Desc)], map: "creator_services_by_creator_idx")
  /// Plaza feed: "newest listed first" — only hits when status='listed'.
  @@index([status, publishedAt(sort: Desc)], map: "creator_services_feed_idx")
  /// Category browse: same feed predicate scoped to category.
  @@index([category, status, publishedAt(sort: Desc)], map: "creator_services_category_feed_idx")
  @@map("creator_services")
}

model ServicePackage {
  id        String      @id
  serviceId String      @map("service_id")
  tier      ServiceTier

  /// Tier label ("30-second cut · 1080p"). ≤ 80 chars.
  title       String @db.VarChar(80)
  /// What's included (long-form, newline-allowed). ≤ 2000 chars.
  description String @db.Text

  /// ISO 4217. Same per-cell whitelist as CrewPosition.
  /// CHECK enforced via cell-aware service layer + DB CHECK.
  currency    String @db.VarChar(3)
  /// Smallest currency unit (USD cents / CNY 分 / JPY yen).
  /// CHECK price_amount >= 0 in migration SQL.
  priceAmount BigInt @map("price_amount")

  /// Calendar-day turnaround. 1-365.
  deliveryDays Int @map("delivery_days")
  /// Included revision count. -1 = unlimited. CHECK in migration SQL.
  revisions    Int @default(0)

  /// Free-form bullet list shown under the tier card. PG TEXT[];
  /// ≤ 12 items enforced at service layer.
  scope String[] @default([])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service CreatorService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// One tier per service — a service can publish basic / standard /
  /// premium independently, but never two of the same tier.
  @@unique([serviceId, tier], map: "service_packages_service_tier_unique")
  /// Per-service tier scan (load packages when rendering a service).
  @@index([serviceId], map: "service_packages_by_service_idx")
  @@map("service_packages")
}

// ──────────────────────────────────────────────────────────────────
//  Service requirement questions
//
//  Free-form questions a creator pre-defines for buyers to answer
//  before submitting an order ("用途? 时长? 风格? 参考?"). Inspired
//  by Fiverr's "Requirements" step — these answers ride with every
//  order via the snapshot stored on ServiceOrder.questionnaire so
//  later edits don't rewrite history.
// ──────────────────────────────────────────────────────────────────

model ServiceRequirementQuestion {
  id        String @id
  serviceId String @map("service_id")

  /// Prompt rendered to the buyer. ≤ 240 chars.
  prompt       String  @db.VarChar(240)
  /// Optional helper text under the prompt. ≤ 240 chars.
  helpText     String? @map("help_text") @db.VarChar(240)
  /// When true, buyer cannot submit until a non-blank answer is
  /// provided. Server enforces.
  required     Boolean @default(false)
  /// Render order — lower first. We don't use array-of-jsonb on the
  /// service row because that complicates per-question edit /
  /// reorder and prevents future "answer template" reuse across
  /// orders.
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service CreatorService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// Render-time scan (single service, ordered).
  @@index([serviceId, displayOrder], map: "service_req_questions_by_service_idx")
  @@map("service_requirement_questions")
}

// ──────────────────────────────────────────────────────────────────
//  Service orders
//
//  Created in one of two paths:
//
//    1. Questionnaire-first: buyer fills `ServiceRequirementQuestion`s
//       and submits → order in `pending_creator`. Creator must accept.
//
//    2. Proposal-first: creator sends a `proposal` message in the
//       (existing) service-context conversation; buyer accepts →
//       order created directly in `in_progress`. The conversation
//       row is reused; `contextType` flips service→order.
//
//  Snapshots: package + questionnaire are frozen at submit time so
//  the creator can keep editing the source service without
//  rewriting order history.
//
//  Bindings: optional FK-shaped string columns linking the order to
//  an IP / episode / crew / crew-position. Stored as plain strings
//  (not Prisma relations) because some of these reference entities
//  outside the Nest schema. Server validates existence at write time.
// ──────────────────────────────────────────────────────────────────

enum ServiceOrderStatus {
  pending_creator
  in_progress
  delivered
  revision_requested
  completed
  cancelled

  @@map("service_order_status")
}

model ServiceOrder {
  id        String @id
  buyerId   String @map("buyer_id")
  creatorId String @map("creator_id")
  serviceId String @map("service_id")

  /// Frozen tier snapshot at submit time. JSON shape mirrors the
  /// OrderPackageSnapshot DTO in `packages/shared/src/order.ts`.
  packageSnapshot Json @map("package_snapshot")

  status ServiceOrderStatus @default(pending_creator)

  /// Frozen Array<{prompt, answer, required}> mirroring
  /// OrderQuestionnaireEntry. Pre-order chat-driven orders may
  /// arrive with an empty array.
  questionnaire Json @default("[]")

  /// 1:1 with Conversation. Set in the same transaction that
  /// creates the order (proposal-accept path) or right after the
  /// inquiry conversation upgrades on questionnaire-submit. Always
  /// non-null in steady state.
  conversationId String @unique @map("conversation_id")

  /// ─── FizzDragon entity bindings ─────────────────────
  /// All nullable. Validated at the service layer (existence + the
  /// buyer/creator's right to bind).
  ipId           String? @map("ip_id")
  episodeId      String? @map("episode_id")
  crewId         String? @map("crew_id")
  crewPositionId String? @map("crew_position_id")

  /// Optimistic concurrency.
  version Int @default(0)

  /// Client-supplied idempotency key. NULL on rows persisted before
  /// the key was introduced; for new submissions the client mints a
  /// UUID per intent and resends it on retries. Server returns the
  /// existing row when (buyerId, idempotencyKey) already maps to one.
  /// Nullable to allow legacy callers to continue creating orders
  /// without a key — at the cost of being open to dupes for those
  /// callers (acceptable until every UI surface has been updated).
  idempotencyKey String? @map("idempotency_key")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// {by, reason, at} JSON when cancelled; null otherwise.
  cancelInfo  Json?     @map("cancel_info")

  service      CreatorService @relation(fields: [serviceId], references: [id])
  conversation Conversation   @relation(fields: [conversationId], references: [id])

  /// Buyer inbox: "my orders, newest activity first".
  @@index([buyerId, createdAt(sort: Desc)], map: "service_orders_by_buyer_idx")
  /// Creator inbox: "incoming orders, newest first".
  @@index([creatorId, createdAt(sort: Desc)], map: "service_orders_by_creator_idx")
  /// State-machine filter for inbox tabs.
  @@index([creatorId, status, createdAt(sort: Desc)], map: "service_orders_by_creator_status_idx")
  @@index([buyerId, status, createdAt(sort: Desc)], map: "service_orders_by_buyer_status_idx")
  /// Per-service order list (creator stats / debugging).
  @@index([serviceId, createdAt(sort: Desc)], map: "service_orders_by_service_idx")
  /// FD-binding back-references (sparse — most orders bind nothing,
  /// but when bound the lookup is "all orders tied to this IP").
  @@index([ipId], map: "service_orders_by_ip_idx")
  @@index([episodeId], map: "service_orders_by_episode_idx")
  @@index([crewId], map: "service_orders_by_crew_idx")
  /// Per-buyer idempotency. Partial-unique semantically (we only
  /// care about non-NULL keys) but Prisma's `@@unique` doesn't
  /// support `where` clauses — so we add a NULLS DISTINCT unique
  /// index in the migration's raw SQL and skip declaring the
  /// constraint here. The runtime lookup uses a regular `findFirst`.
  @@index([buyerId, idempotencyKey], map: "service_orders_buyer_idem_idx")
  @@map("service_orders")
}

// ──────────────────────────────────────────────────────────────────
//  Conversations
//
//  Context-scoped — every conversation is rooted in a domain entity
//  (service inquiry, active order, or crew). NOT free-form DM.
//
//  Identity: a `service` inquiry is unique per (buyer, creator,
//  service) — same triple resumes the same thread. A `crew` chat is
//  unique per crew. Encoded via the denormalized `lookupKey` column
//  for an O(1) UNIQUE constraint. On proposal-accept, lookupKey
//  rewrites to `order:<orderId>` so uniqueness shifts cleanly.
//
//  Two-party contexts (`service` / `order`) pin their membership at
//  creation. A `crew` chat's membership is a projection of crew
//  membership: joins/leaves arrive through
//  `ConversationsService.syncCrewParticipant`, and every read/send
//  additionally re-checks live crew membership so a stale projection
//  can never leak the thread.
//
//  Realtime: each message broadcasts via Redis pub/sub on
//  `conversation:user:{userId}` (per participant). Missed-while-
//  offline windows recover by client refetch on reconnect.
// ──────────────────────────────────────────────────────────────────

enum ConversationContextType {
  service
  order
  /// One crew = one group chat. `contextId` is the crew id and the
  /// lookup key is `crew:<crewId>` (see `crewLookupKey`).
  crew

  @@map("conversation_context_type")
}

enum ConversationParticipantRole {
  buyer
  creator
  /// Every crew participant, founder included. Crew authorization is
  /// resolved live by CrewRoleService against `crews` / `crew_members`;
  /// this value exists only so the NOT NULL column has something to say
  /// about a group-chat participant. Do NOT mirror admin/finance here.
  member

  @@map("conversation_participant_role")
}

enum CrewConversationChannel {
  /// Private production collaboration for active crew members.
  team
  /// Public-facing community chat entered through a community invitation.
  community

  @@map("crew_conversation_channel")
}

enum MessageType {
  text
  image
  file
  proposal
  system

  @@map("message_type")
}

model Conversation {
  id String @id

  contextType ConversationContextType  @map("context_type")
  contextId   String                   @map("context_id")
  /// Set only for crew conversations. The context remains the crew while this
  /// field separates its private team channel from the public community channel.
  crewChannel CrewConversationChannel? @map("crew_channel")

  /// Stable lookup token used for "find or create" semantics.
  ///   service inquiry: `service:<serviceId>:<buyerId>:<creatorId>`
  ///   order          : `order:<orderId>`
  /// UNIQUE so the same triple can't accidentally fork into two threads.
  lookupKey String @unique @map("lookup_key")

  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  participants   ConversationParticipant[]
  messages       Message[]
  order          ServiceOrder?
  realtimeOutbox ConversationRealtimeOutbox[]

  /// Inbox sort: per-user feed ordered by activity. The user filter
  /// lives on `ConversationParticipant`; this index makes the
  /// joined query cheap.
  @@index([lastMessageAt(sort: Desc)], map: "conversations_recent_idx")
  /// Context fan-out (e.g. "all conversations about this service" —
  /// admin / analytics, not used in the hot path).
  @@index([contextType, contextId], map: "conversations_context_idx")
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String                      @map("conversation_id")
  userId         String                      @map("user_id")
  role           ConversationParticipantRole

  /// Cursor for unread-badge math: messages with createdAt >
  /// lastReadAt are unread to this participant.
  /// We use a message id (not timestamp) for read-receipt precision
  /// against rapid simultaneous sends.
  lastReadMessageId String?   @map("last_read_message_id")
  /// Mirror of the read message's createdAt for fast unread-count
  /// queries (avoids joining to messages for every inbox row).
  lastReadAt        DateTime? @map("last_read_at") @db.Timestamptz(6)

  /// Soft-mute switch (no notifications until then). NULL = not muted.
  mutedUntil DateTime? @map("muted_until") @db.Timestamptz(6)

  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  /// Inbox fan-out: every conversation this user is in.
  @@index([userId, leftAt], map: "conversation_participants_by_user_idx")
  @@map("conversation_participants")
}

model Message {
  id             String      @id
  conversationId String      @map("conversation_id")
  /// NULL for system messages — server-authored.
  authorId       String?     @map("author_id")
  type           MessageType

  /// Plain text body. text → entire message; proposal → leading
  /// note; system → empty (use payload.system).
  body String @db.Text

  /// Structured payload — null for plain text. Shape mirrors
  /// MessagePayload in `packages/shared/src/conversation.ts`.
  payload Json?

  /// Caller-supplied idempotency token for the authenticated send path
  /// (POST /conversations/:id/messages). A retried send collapses onto
  /// the row it already created instead of appending a duplicate the
  /// whole group then sees.
  ///
  /// Service-inquiry first messages also use a service-scoped token,
  /// admitted under a transaction lock. NULL on system messages, which
  /// are written from inside other modules' transactions where a
  /// unique-violation would poison the outer tx (25P02).
  clientKey String? @map("client_key") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  realtimeOutbox ConversationRealtimeOutbox?

  /// History / cursor pagination: per-conversation, newest first
  /// (we paginate backwards from the latest).
  @@index([conversationId, createdAt(sort: Desc)], map: "messages_by_conversation_idx")
  /// Partial unique enforced in migration SQL (Prisma has no syntax for a
  /// WHERE-clause index — same arrangement as `crew_members_active_unique`):
  /// CREATE UNIQUE INDEX messages_client_key_unique
  ///   ON messages (conversation_id, author_id, client_key)
  ///   WHERE client_key IS NOT NULL;
  /// Declaring it as @@unique here would emit a FULL unique index and
  /// collapse every NULL-keyed system message into one row per author.
  @@map("messages")
}

/// Transactional Ably delivery queue for authoritative conversation messages.
/// The message row and this row commit together; realtime is only acceleration,
/// while REST remains the recovery/source-of-truth path.
model ConversationRealtimeOutbox {
  id             String    @id @default(uuid(7)) @db.Uuid
  conversationId String    @map("conversation_id")
  messageId      String    @unique(map: "conversation_realtime_outbox_message_unique") @map("message_id")
  idempotencyKey String    @unique(map: "conversation_realtime_outbox_idempotency_unique") @map("idempotency_key") @db.VarChar(180)
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempt        Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.Text
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by") @db.VarChar(160)
  deadAt         DateTime? @map("dead_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([dispatchedAt, deadAt, nextAttemptAt], map: "conversation_realtime_outbox_pending_idx")
  @@index([lockedAt], map: "conversation_realtime_outbox_locked_idx")
  @@index([deadAt], map: "conversation_realtime_outbox_dead_idx")
  @@index([conversationId, createdAt(sort: Desc)], map: "conversation_realtime_outbox_conversation_idx")
  @@map("conversation_realtime_outbox")
}

// ─────────────────────────────────────────────────────────────
// Media asset domain (src/infra/storage/)
// ─────────────────────────────────────────────────────────────
//
// MediaAsset is the durable identity of a stored file. Business tables
// should reference assets instead of storing raw public URLs. URL
// materialization belongs in the server layer, so CDN/domain/provider
// changes do not require rewriting historical business rows.
//
// This table is intentionally broader than certificates, but only owns
// storage identity and intrinsic file metadata. Ownership, permissions,
// workspaces, and cross-domain usage should be added when those product
// modules have concrete closed-loop semantics.

enum MediaAssetKind {
  image
  video
  audio
  document
  other
}

enum MediaStorageProvider {
  azure_blob
  aliyun_oss
  s3_compatible
  external_url
}

enum MediaAssetVisibility {
  public
  private
}

enum MediaAssetStatus {
  uploading
  ready
  failed
  deleted
}

enum MediaAssetSource {
  user_upload
  ai_output
  imported
  system
}

enum MediaAssetModerationStatus {
  unreviewed
  approved
  flagged
  blocked
}

enum MediaAssetVariantKind {
  original
  thumbnail
  poster
  preview
  stream
  transcode
  waveform
  transcript
  other
}

enum MediaAssetVariantStatus {
  pending
  processing
  ready
  failed
  blocked
  deleted
}

enum MediaObjectPlacementRole {
  primary
  replica
  cache
  archive
}

enum MediaObjectPlacementStatus {
  active
  warming
  failed
  purging
  purged
  deleted
}

enum MediaModerationCaseStatus {
  open
  actioned
  dismissed
  escalated
  closed
}

enum MediaModerationSeverity {
  low
  medium
  high
  critical
}

enum MediaModerationActionType {
  approve
  flag
  block
  unblock
  takedown
  restore
  restrict_visibility
  purge_cdn
  delete_object
}

enum MediaModerationActionStatus {
  pending
  completed
  failed
  cancelled
}

enum MediaProcessingJobType {
  thumbnail
  poster
  transcode
  hls_stream
  waveform
  metadata_probe
  moderation_scan
  backfill_original_placement
}

enum MediaProcessingJobStatus {
  pending
  processing
  completed
  failed
  cancelled
  dead
}

enum MediaAssetUsageSurface {
  standalone_generation
  canvas
  project
  ip_library
  certificate
  admin
  system
}

enum MediaAssetUsageRole {
  output
  reference
  cover
  thumbnail
  trailer
  evidence
  avatar
  attachment
  other
}

/// Resumable episode uploads. Storage owns the part list; no per-part DB rows.
model EpisodeUpload {
  id          String               @id @db.Uuid
  userId      String               @map("user_id") @db.VarChar(64)
  workspaceId String?              @map("workspace_id") @db.Uuid
  fileName    String               @map("file_name") @db.VarChar(256)
  contentType String               @map("content_type") @db.VarChar(128)
  sizeBytes   BigInt               @map("size_bytes")
  partSize    Int                  @map("part_size")
  provider    MediaStorageProvider
  storageKey  String               @unique @map("storage_key") @db.VarChar(1024)
