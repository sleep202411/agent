  operations           StudioDocumentOperation[]
  presences            StudioDocumentPresence[]
  commentThreads       StudioDocumentCommentThread[]
  assets               ProjectAsset[]
  aiJobs               AiJob[]
  crewTaskCanvas       CrewTask?                     @relation("CrewTaskCanvasDocument")
  derivedStoryChapters StoryChapter[]                @relation("StoryChapterSourceScriptDocument")

  /// Exactly one project owner is enforced by SQL. Active singleton/slug
  /// uniqueness is likewise enforced by partial indexes per owner kind.
  @@unique([id, workspaceId], name: "uniq_studio_document_id_workspace", map: "studio_documents_id_workspace_unique")
  @@unique([collaborationRoomId], map: "studio_documents_room_unique")
  @@index([platformProjectId, type, updatedAt(sort: Desc)], map: "studio_documents_platform_project_type_recent_idx")
  @@index([storyProjectId, type, updatedAt(sort: Desc)], map: "studio_documents_story_project_type_recent_idx")
  @@index([storyChapterId, type, updatedAt(sort: Desc)], map: "studio_documents_story_chapter_type_recent_idx")
  @@index([sectionId, type, updatedAt(sort: Desc)], map: "studio_documents_section_type_recent_idx")
  @@index([workspaceId, updatedAt(sort: Desc)], map: "studio_documents_workspace_recent_idx")
  @@index([status, updatedAt(sort: Desc)], map: "studio_documents_status_recent_idx")
  @@map("studio_documents")
}

