  checksumSha256       String                      @map("checksum_sha256") @db.VarChar(64)
  error                Json?                       @db.JsonB
  reviewRevision       Int                         @default(0) @map("review_revision")
  createdByUserId      String                      @map("created_by_user_id") @db.VarChar(64)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt              DateTime?                   @map("ready_at") @db.Timestamptz(6)

  project         StoryProject            @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)
  referenceSlot   StoryReferenceSlot      @relation("StoryReferenceSlotVersions", fields: [referenceSlotId, storyProjectId], references: [id, storyProjectId], onDelete: Cascade)
  approvedForSlot StoryReferenceSlot?     @relation("StoryApprovedReferenceVersion")
  aiJob           AiJob?                  @relation(fields: [aiJobId], references: [id], onDelete: Restrict)
  aiJobOutput     AiJobOutput?            @relation(fields: [aiJobOutputId], references: [id], onDelete: Restrict)
  asset           MediaAsset              @relation("StoryReferenceAsset", fields: [assetId], references: [id], onDelete: Restrict)
  variant         MediaAssetVariant       @relation("StoryReferenceVariant", fields: [variantId, assetId], references: [id, assetId], onDelete: Restrict)
  reviews         StoryReferenceReview[]
  approval        StoryReferenceApproval?

  @@unique([referenceSlotId, versionNumber], map: "story_reference_versions_slot_number_unique")
  @@unique([id, storyProjectId], map: "story_reference_versions_scope_unique")
  @@unique([id, referenceSlotId], map: "story_reference_versions_id_slot_unique")
  @@unique([id, referenceSlotId, storyProjectId], map: "story_reference_versions_slot_scope_unique")
  @@index([storyProjectId, status, createdAt(sort: Desc)], map: "story_reference_versions_project_status_idx")
  @@index([aiJobId], map: "story_reference_versions_ai_job_idx")
  @@map("story_reference_versions")
}

model StoryReferenceReview {
