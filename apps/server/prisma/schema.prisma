  checkoutUrl             String?             @map("checkout_url") @db.VarChar(2048)
  clientSecret            String?             @map("client_secret") @db.VarChar(2048)
  currency                String              @db.Char(3)
  amountMinor             BigInt              @map("amount_minor")
  providerStatus          String?             @map("provider_status") @db.VarChar(64)
