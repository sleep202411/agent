  publicOnProfile Boolean @default(false) @map("public_on_profile")
  scoreMilli Int? @map("score_milli")
  timelinessScore Int? @map("timeliness_score")
  id            String @id @db.Uuid
  taskId        String @map("task_id") @db.Uuid
  submissionId  String @map("submission_id") @db.Uuid
  authorUserId  String @map("author_user_id") @db.VarChar(64)
  subjectUserId String @map("subject_user_id") @db.VarChar(64)
  direction     String @db.VarChar(16)
  ratings       Json @db.JsonB
  comment       String @db.Text
  response      String? @db.Text
