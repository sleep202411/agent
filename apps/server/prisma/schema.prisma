model Crew {
  pdfTaskImports CrewPdfTaskImport[]
  computeBudget CrewProjectComputeBudget?
  revenueDrafts CrewRevenueDraft[]
  revenueContracts CrewRevenueContract[]
  expenseDrafts       CrewExpenseDraftRevision[]
  originatingIps      IpCrewOrigin[]
  likes               CrewLike[]
  storageLimitBytes   BigInt                     @default(100000000000) @map("storage_limit_bytes")
  uploadReservations  CrewUploadReservation[]
  id                  String                     @id
  name                String                     @db.VarChar(128)
  description         String                     @db.Text
  /// Square logo (UI crops to circle). The durable brand asset —
  /// shows up in plaza cards, member chips, notifications, nav.
  /// Visitor-page hero visual comes from `showcaseWorks[0]`; the
  /// logo enlarges into a gradient empty-state when no showcase is
  /// set yet (no separate `cover` asset — by design).
  /// Empty for an automatically created IP Crew until its owner uploads a logo.
  logo                String                     @map("logo") @db.VarChar(512)
  /// Optional one-line hook shown under crew name in hero. ≤140
  /// chars. Owner-curated.
  tagline             String?                    @db.VarChar(140)
  /// Predefined genre tags from CREW_GENRES in @repo/shared/crew.
  /// E.g. ["animation", "shortform", "documentary"]. Max 5.
  genres              String[]                   @default([])
  /// Predefined style tags from CREW_STYLES in @repo/shared/crew.
  /// E.g. ["2d", "3d", "live_action", "ai_assisted"]. Max 5.
  styles              String[]                   @default([])
  /// External social channels. Shape:
  ///   [{ platform: "bilibili"|"weibo"|..., url: "https://..." }]
  /// Validated server-side against SOCIAL_PLATFORMS. Max 10 entries.
  socialLinks         Json?                      @map("social_links") @db.JsonB
  /// Curated work showcase. Shape:
  ///   [{ thumbnailUrl, title, externalUrl?, viewCount? }]
  /// First entry is featured as the visitor-page hero background.
  /// Max 10 entries.
  showcaseWorks       Json?                      @map("showcase_works") @db.JsonB
  /// Immutable creator identity for audit only. Current ownership lives in
  /// CrewOwnership and is never inferred from this field.
  createdByUserId     String                     @map("created_by_user_id")
  /// User-controlled discovery state. New crews start unlisted; only
  /// listed crews appear in the public Crew Hall.
  listingStatus       CrewListingStatus          @default(unlisted) @map("listing_status")
  /// First/most recent time the owner made the crew visible in the hall.
  listedAt            DateTime?                  @map("listed_at") @db.Timestamptz(6)
  /// Admin moderation state (post-hoc). `taken_down` hides the crew from every
  /// public surface. Stamped by the acting admin for the audit trail.
  moderationStatus    CrewModerationStatus       @default(ok) @map("moderation_status")
  moderatedAt         DateTime?                  @map("moderated_at") @db.Timestamptz(6)
  moderatedByAdminId  String?                    @map("moderated_by_admin_id") @db.Uuid
  moderationReason    String?                    @map("moderation_reason") @db.VarChar(500)
  /// Team collaboration home. A crew owns exactly one team workspace and
  /// one main production project; task projects branch from this context.
  workspaceId         String?                    @unique(map: "crews_workspace_unique") @map("workspace_id") @db.Uuid
  productionProjectId String?                    @unique(map: "crews_production_project_unique") @map("production_project_id") @db.Uuid
  /// Explicit external Studio workspace link; the internal Crew task workspace is unchanged.
  studioWorkspaceId   String?                    @unique(map: "crews_studio_workspace_unique") @map("studio_workspace_id") @db.Uuid
  studioWorkspace     Workspace?                 @relation("CrewStudioWorkspace", fields: [studioWorkspaceId], references: [id], onDelete: SetNull)
  /// Historical single-project link, cleared when a workspace is explicitly selected.
  studioProjectId     String?                    @unique(map: "crews_studio_project_unique") @map("studio_project_id") @db.Uuid
  /// Production template selected at create time. Existing crews default to series.
  productionKind      CrewProductionKind         @default(series) @map("production_kind")
  /// Optimistic concurrency control. Bumped on every update; readers
  /// supply the version they saw in the WHERE clause via
  /// crewsService.update(id, patch, expectedVersion).
  version             Int                        @default(0)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?                  @map("deleted_at") @db.Timestamptz(6)

  participationRecords CrewParticipationRecord[]
  peerFeedback         CrewPeerFeedback[]
  positions            CrewPosition[]
  members              CrewMember[]
  ownership            CrewOwnership?
  applications         CrewApplication[]
  assetNodes           CrewAssetNode[]
  invitations          CrewInvitation[]
  inviteLinks          CrewInviteLink[]
  tasks                CrewTask[]
  taskKindTemplates    CrewTaskKindTemplate[]
  taskViews            CrewTaskView[]
  taskCycles           CrewTaskCycle[]
  taskLabels           CrewTaskLabel[]
  taskFields           CrewTaskFieldDefinition[]
  taskWorkflowStates   CrewTaskWorkflowState[]
  productionPage       CrewProductionPage?
  productionResources  CrewProductionResource[]
  productionActivity   CrewProductionActivity[]
  episodes             CrewEpisode[]
  agreements           CrewAgreement[]
  earningEntries       CrewEarningEntry[]
  earningEvents        CrewEarningEvent[]
  payouts              CrewPayout[]
  payoutAllocations    CrewPayoutAllocation[]
  payoutEvents         CrewPayoutEvent[]
  workspace            Workspace?                @relation("CrewWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)
  productionProject    PlatformProject?          @relation("CrewProductionProject", fields: [productionProjectId], references: [id], onDelete: SetNull)
  studioProject        PlatformProject?          @relation("CrewStudioProject", fields: [studioProjectId], references: [id], onDelete: SetNull)

  @@index([createdByUserId, deletedAt], map: "crews_creator_idx")
  /// Public listing: WHERE listing_status='listed' AND deleted_at IS NULL
  /// ORDER BY listed_at DESC / created_at DESC.
  @@index([listingStatus, deletedAt, listedAt(sort: Desc), createdAt(sort: Desc)], map: "crews_feed_idx")
  @@index([moderationStatus, createdAt(sort: Desc)], map: "crews_moderation_idx")
  @@map("crews")
}

model CrewAssetNode {
  taskContracts CrewTaskContractFile[]
  id                String              @id @default(uuid(7)) @db.Uuid
  crewId            String              @map("crew_id")
  parentId          String?             @map("parent_id") @db.Uuid
  kind              CrewAssetNodeKind
  status            CrewAssetNodeStatus @default(active)
  /// `inherit` uses the closest ancestor policy (or the crew-member default);
  /// `restricted` starts a new explicit ACL boundary for this subtree.
  accessMode        CrewAssetAccessMode @default(inherit) @map("access_mode")
  /// Only explicit canvas saves grant Crew consumption of Studio-owned media.
  sharedFromStudio  Boolean             @default(false) @map("shared_from_studio")
  sourceCanvasProjectId String?         @map("source_canvas_project_id") @db.Uuid
  sourceCanvasProject PlatformProject?  @relation("CrewCanvasAssetFolder", fields: [sourceCanvasProjectId], references: [id], onDelete: SetNull)
  /// Stable seed key so renamed folders still map to production templates.
  folderKey         String?             @map("folder_key") @db.VarChar(64)
  /// Optional user-chosen Studio counterpart; does not replace mediaAssetId.
  linkedStudioMediaAssetId String?      @map("linked_studio_media_asset_id") @db.Uuid
  linkedProjectId   String?             @map("linked_project_id") @db.Uuid
  linkedStoryProjectId String?          @map("linked_story_project_id") @db.Uuid
  permissionVersion Int                 @default(1) @map("permission_version")
  name              String              @db.VarChar(256)
  mediaAssetId      String?             @map("media_asset_id") @db.Uuid
  createdByUserId   String              @map("created_by_user_id") @db.VarChar(64)
  updatedByUserId   String              @map("updated_by_user_id") @db.VarChar(64)
  trashedAt         DateTime?           @map("trashed_at") @db.Timestamptz(6)
  trashedByUserId   String?             @map("trashed_by_user_id") @db.VarChar(64)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew                 Crew                      @relation(fields: [crewId], references: [id], onDelete: Cascade)
  parent               CrewAssetNode?            @relation("CrewAssetHierarchy", fields: [parentId, crewId], references: [id, crewId], onDelete: Cascade)
  children             CrewAssetNode[]           @relation("CrewAssetHierarchy")
  mediaAsset           MediaAsset?               @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  linkedStudioMediaAsset MediaAsset?             @relation("CrewAssetLinkedStudioMedia", fields: [linkedStudioMediaAssetId], references: [id], onDelete: SetNull)
  linkedProject        PlatformProject?          @relation("CrewAssetLinkedStudioProject", fields: [linkedProjectId], references: [id], onDelete: SetNull)
  linkedStoryProject   StoryProject?             @relation("CrewAssetLinkedStoryProject", fields: [linkedStoryProjectId], references: [id], onDelete: SetNull)
  favorites            CrewAssetFavorite[]
  grants               CrewAssetGrant[]
  taskDeliveryAssets   CrewTaskDeliveryAsset[]
  taskDeliveryFolders  CrewTaskDeliveryFolder[]
  submissionLinks      CrewTaskSubmissionAsset[]
  taskTimelineLinks    CrewTaskTimelineAsset[]
  episodeDeliveries    CrewEpisodeDelivery[]
  productionResources  CrewProductionResource[]
  signedAgreements     CrewAgreement[]           @relation("CrewAgreementSignedAsset")
  agreementAuditTrails CrewAgreement[]           @relation("CrewAgreementAuditAsset")

  @@unique([crewId, sourceCanvasProjectId], map: "crew_asset_canvas_folder_unique")
  @@unique([crewId, folderKey], map: "crew_asset_nodes_folder_key_unique")
  @@unique([id, crewId], name: "uniq_crew_asset_node_id_crew", map: "crew_asset_nodes_id_crew_unique")
  @@index([linkedStudioMediaAssetId], map: "crew_asset_nodes_linked_studio_media_idx")
  @@index([crewId, parentId, status, updatedAt(sort: Desc)], map: "crew_asset_nodes_folder_listing_idx")
  @@index([crewId, status, updatedAt(sort: Desc)], map: "crew_asset_nodes_source_listing_idx")
  @@index([mediaAssetId], map: "crew_asset_nodes_media_asset_idx")
  @@map("crew_asset_nodes")
}

model CrewAssetGrant {
  id              String              @id @default(uuid(7)) @db.Uuid
  nodeId          String              @map("node_id") @db.Uuid
  userId          String              @map("user_id") @db.VarChar(64)
  permission      CrewAssetPermission
  grantedByUserId String              @map("granted_by_user_id") @db.VarChar(64)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  node CrewAssetNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, userId], map: "crew_asset_grants_node_user_unique")
  @@index([userId, permission], map: "crew_asset_grants_user_permission_idx")
  @@map("crew_asset_grants")
}

/// Append-only permission history. It intentionally keeps logical crew/node
/// identifiers without foreign keys so a permanent asset deletion cannot
/// erase the security audit trail.
model CrewAssetPermissionEvent {
  id              String              @id @default(uuid(7)) @db.Uuid
  crewId          String              @map("crew_id")
  nodeId          String              @map("node_id") @db.Uuid
  actorUserId     String              @map("actor_user_id") @db.VarChar(64)
  action          String              @db.VarChar(32)
  previousMode    CrewAssetAccessMode @map("previous_mode")
  nextMode        CrewAssetAccessMode @map("next_mode")
  previousVersion Int                 @map("previous_version")
  nextVersion     Int                 @map("next_version")
  previousGrants  Json                @map("previous_grants") @db.JsonB
  nextGrants      Json                @map("next_grants") @db.JsonB
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([crewId, nodeId, createdAt(sort: Desc)], map: "crew_asset_permission_events_node_idx")
  @@index([crewId, actorUserId, createdAt(sort: Desc)], map: "crew_asset_permission_events_actor_idx")
  @@map("crew_asset_permission_events")
}

model CrewAssetFavorite {
  id        String   @id @default(uuid(7)) @db.Uuid
  nodeId    String   @map("node_id") @db.Uuid
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  node CrewAssetNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, userId], map: "crew_asset_favorites_node_user_unique")
  @@index([userId, createdAt(sort: Desc)], map: "crew_asset_favorites_user_recent_idx")
  @@map("crew_asset_favorites")
}

model CrewPosition {
  savedBy CrewSavedPosition[]
  recruitmentVisibility String @default("public") @map("recruitment_visibility") @db.VarChar(16)
  invitations CrewPositionInvitation[]
  taskId String? @map("task_id") @db.Uuid
  task CrewTask? @relation(fields: [taskId, crewId], references: [id, crewId], onDelete: Restrict)
  id             String             @id
  crewId         String             @map("crew_id")
  /// Preset position key — validated against PRESET_POSITIONS in
  /// packages/shared/src/crew.ts. Stored as String so adding presets
  /// doesn't need migrations.
  positionType   String             @map("position_type") @db.VarChar(64)
  description    String             @db.Text
  /// 招聘人数 (target headcount). CHECK target_count > 0 in migration SQL.
  targetCount    Int                @map("target_count")
  /// Incremented inside the approval transaction; decremented when a
  /// member is removed. Reaches `targetCount` → status flips to `full`.
  /// CHECK recruited_count >= 0 AND recruited_count <= target_count.
  recruitedCount Int                @default(0) @map("recruited_count")
  status         CrewPositionStatus @default(open)

  /// ─── Employment ────────────────────────────────────────
  workMode        WorkMode        @default(remote) @map("work_mode")
  /// City / region — required at the controller layer when
  /// workMode != 'remote'. Free-form so we don't need a city dict.
  location        String?         @db.VarChar(128)
  employmentType  EmploymentType  @default(project_based) @map("employment_type")
  experienceLevel ExperienceLevel @default(any) @map("experience_level")

  /// ─── Skills ────────────────────────────────────────────
  /// Free-form tags (e.g. ["Final Draft", "分镜思维"]). PG TEXT[].
  /// Single list ("preferred" was dropped as separate field — the
  /// distinction was always fuzzy in practice and UX favored simplicity.
  requiredSkills String[] @default([]) @map("required_skills")

  /// ─── Compensation ──────────────────────────────────────
  /// Salary "shape" the recruiter is offering. NULL = not set.
  /// 'month' = monthly pay; 'episode' = per-episode rate;
  /// 'project' = single project fee (lump sum on completion).
  /// When `salaryNegotiable = true`, min/max are ignored and the UI
  /// shows "面议" (negotiable on application).
  paymentTerms     String? @map("payment_terms") @db.VarChar(32)
  salaryPeriod     String? @map("salary_period") @db.VarChar(16)
  /// ISO 4217 currency code. cn cell allows only CNY; com cell allows
  /// the whitelist defined in `apps/server/src/crews/currency.ts`.
  /// CHECK enforced at DB level (see migration SQL).
  salaryCurrency   String? @map("salary_currency") @db.VarChar(3)
  /// Smallest currency unit (CNY 分 / USD cents / JPY yen). Stored
  /// integer so we never lose precision. UI converts for display.
  /// CHECK salary_min_amount >= 0 in migration SQL.
  salaryMinAmount  BigInt? @map("salary_min_amount")
  /// CHECK salary_max_amount >= salary_min_amount when both set.
  salaryMaxAmount  BigInt? @map("salary_max_amount")
  salaryNegotiable Boolean @default(false) @map("salary_negotiable")

  /// ─── Tenure ────────────────────────────────────────────
  /// Expected length of the commitment in months. NULL = "long
  /// term / open-ended" (default for founding / core members).
  /// CHECK 1 <= duration_months <= 60 in migration SQL.
  durationMonths Int? @map("duration_months")

  /// Revenue share offered to the holder of this position, expressed
  /// in basis points (1 bp = 0.01 %). 250 = 2.50 %; 1500 = 15 %.
  /// Storing an integer keeps arithmetic exact across servers and
  /// avoids the Prisma.Decimal wrapper churn. UI multiplies/divides
  /// by 100 for display.
  /// NULL = no revenue share offered (pure salary or unpaid).
  /// CHECK 0 < revenue_share_bp <= 5000 in migration SQL — caps a
  /// single position at 50 %; multi-position sums aren't enforced.
  revenueShareBp Int? @map("revenue_share_bp")

  /// ─── Lifecycle ─────────────────────────────────────────
  /// Auto-archive at this date (cron flips status → frozen). Nullable.
  closeDate DateTime? @map("close_date") @db.Date

  /// Admin moderation state (post-hoc), independent of the recruiting `status`.
  /// `taken_down` hides the posting from every public surface. Reuses the crew
  /// moderation enum.
  moderationStatus   CrewModerationStatus @default(ok) @map("moderation_status")
  moderatedAt        DateTime?            @map("moderated_at") @db.Timestamptz(6)
  moderatedByAdminId String?              @map("moderated_by_admin_id") @db.Uuid
  moderationReason   String?              @map("moderation_reason") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  crew            Crew                 @relation(fields: [crewId], references: [id], onDelete: Cascade)
  applications    CrewApplication[]
  memberPositions CrewMemberPosition[]

  /// Composite FK target for CrewApplication.position: guarantees the
  /// application row's crew_id matches the position's crew_id.
  @@unique([id, crewId], name: "uniq_position_id_crew", map: "crew_positions_id_crew_unique")
  @@index([crewId, status, deletedAt], map: "crew_positions_listing_idx")
  @@index([crewId, deletedAt, createdAt, id], map: "crew_positions_page_idx")
  /// Public discovery filter: positions by work mode (Remote-only browse).
  @@index([workMode, status, deletedAt], map: "crew_positions_work_mode_idx")
  /// Auto-archive cron scan.
  @@index([closeDate, status], map: "crew_positions_close_date_idx")
  @@index([moderationStatus, createdAt(sort: Desc)], map: "crew_positions_moderation_idx")
  @@index([taskId, crewId])
  @@map("crew_positions")
}

model CrewMember {
  id          String               @id
  crewId      String               @map("crew_id")
  userId      String               @map("user_id")
  status      CrewMembershipStatus @default(active)
  joinedVia   CrewJoinSource       @map("joined_via")
  joinedAt    DateTime             @default(now()) @map("joined_at") @db.Timestamptz(6)
  suspendedAt DateTime?            @map("suspended_at") @db.Timestamptz(6)
  removedAt   DateTime?            @map("removed_at") @db.Timestamptz(6)
  version     Int                  @default(1)

  crew                     Crew                           @relation(fields: [crewId], references: [id], onDelete: Cascade)
  ownership                CrewOwnership?
  positions                CrewMemberPosition[]
  policies                 CrewMemberPolicy[]
  permissionOverrides      CrewMemberPermissionOverride[]
  authorizationEvents      CrewAuthorizationEvent[]       @relation("CrewAuthorizationSubject")
  actorAuthorizationEvents CrewAuthorizationEvent[]       @relation("CrewAuthorizationActor")
  taskAssignments          CrewTaskAssignee[]
  ledProductionPages       CrewProductionPage[]           @relation("CrewProductionLead")
  earningEntries           CrewEarningEntry[]
  payouts                  CrewPayout[]

  @@unique([id, crewId], name: "uniq_crew_member_id_crew", map: "crew_members_id_crew_unique")
  /// Composite identity target for historical rows that intentionally keep
  /// user_id for direct payee queries. The FK makes that snapshot incapable
  /// of drifting away from the referenced membership.
  @@unique([id, crewId, userId], name: "uniq_crew_member_identity", map: "crew_members_id_crew_user_unique")
  @@index([userId, status], map: "crew_members_by_user_idx")
  @@index([crewId, status], map: "crew_members_by_crew_idx")
  @@index([crewId, status, joinedAt, id], map: "crew_members_page_idx")
  @@map("crew_members")
}

/// Exactly one current owner per crew. Ownership is independent from
/// production positions and permission policies.
model CrewOwnership {
  crewId     String   @id @map("crew_id")
  memberId   String   @unique(map: "crew_ownership_member_unique") @map("member_id")
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)

  crew   Crew       @relation(fields: [crewId], references: [id], onDelete: Cascade)
  member CrewMember @relation(fields: [memberId, crewId], references: [id, crewId], onDelete: Restrict)

  @@unique([memberId, crewId], map: "crew_ownership_member_crew_unique")
  @@map("crew_ownership")
}

/// A member may hold multiple production positions. The standard category is
/// optional; custom titles cover real-world crew responsibilities without
/// turning job names into authorization roles.
model CrewMemberPosition {
  id               String   @id @default(uuid(7)) @db.Uuid
  crewId           String   @map("crew_id")
  memberId         String   @map("member_id")
  categoryKey      String?  @map("category_key") @db.VarChar(64)
  title            String?  @db.VarChar(128)
  isPrimary        Boolean  @default(false) @map("is_primary")
  sourcePositionId String?  @map("source_position_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  member         CrewMember    @relation(fields: [memberId, crewId], references: [id, crewId], onDelete: Cascade)
  sourcePosition CrewPosition? @relation(fields: [sourcePositionId, crewId], references: [id, crewId], onDelete: Restrict)

  @@index([crewId, categoryKey], map: "crew_member_positions_crew_category_idx")
  @@index([memberId, isPrimary], map: "crew_member_positions_member_primary_idx")
  @@map("crew_member_positions")
}

/// Additive policy bundles (currently admin / finance). Active membership
/// itself supplies the baseline member policy.
model CrewMemberPolicy {
  id               String   @id @default(uuid(7)) @db.Uuid
  memberId         String   @map("member_id")
  policyKey        String   @map("policy_key") @db.VarChar(64)
  assignedByUserId String   @map("assigned_by_user_id") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  member CrewMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, policyKey], map: "crew_member_policies_member_key_unique")
  @@index([policyKey, memberId], map: "crew_member_policies_key_member_idx")
  @@map("crew_member_policies")
}

/// Explicit member-level exceptions applied after baseline and policy bundles.
model CrewMemberPermissionOverride {
  id              String               @id @default(uuid(7)) @db.Uuid
  memberId        String               @map("member_id")
  permissionKey   String               @map("permission_key") @db.VarChar(96)
  effect          CrewPermissionEffect
  changedByUserId String               @map("changed_by_user_id") @db.VarChar(64)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  member CrewMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, permissionKey], map: "crew_member_permission_overrides_member_key_unique")
  @@index([permissionKey, effect], map: "crew_member_permission_overrides_permission_idx")
  @@map("crew_member_permission_overrides")
}

/// Append-only security audit trail for policy, permission and ownership
/// changes. Logical identifiers are intentionally retained after removal.
model CrewAuthorizationEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  crewId        String   @map("crew_id")
  memberId      String?  @map("member_id")
  actorMemberId String?  @map("actor_member_id")
  actorUserId   String   @map("actor_user_id") @db.VarChar(64)
  action        String   @db.VarChar(64)
  before        Json?    @db.JsonB
  after         Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  member      CrewMember? @relation("CrewAuthorizationSubject", fields: [memberId], references: [id], onDelete: SetNull)
  actorMember CrewMember? @relation("CrewAuthorizationActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([crewId, createdAt(sort: Desc)], map: "crew_authorization_events_crew_recent_idx")
  @@index([memberId, createdAt(sort: Desc)], map: "crew_authorization_events_member_recent_idx")
  @@map("crew_authorization_events")
}

/// Account-targeted invitation. Acceptance, not sending, creates membership,
/// chat participation, and workspace access.
model CrewInvitation {
  id                   String               @id @default(uuid(7)) @db.Uuid
  crewId               String               @map("crew_id")
  inviteeUserId        String               @map("invitee_user_id") @db.VarChar(64)
  invitedByUserId      String               @map("invited_by_user_id") @db.VarChar(64)
  policyKeys           String[]             @default([]) @map("policy_keys")
  positionCategory     String?              @map("position_category") @db.VarChar(64)
  status               CrewInvitationStatus @default(pending)
  expiresAt            DateTime             @map("expires_at") @db.Timestamptz(6)
  acceptedAt           DateTime?            @map("accepted_at") @db.Timestamptz(6)
  declinedAt           DateTime?            @map("declined_at") @db.Timestamptz(6)
  revokedAt            DateTime?            @map("revoked_at") @db.Timestamptz(6)
  /// Optional agreement intent. It is disclosed on the invitation but only
  /// materialized and queued after membership is accepted, so e-signature
  /// availability never gates access to the crew workspace.
  agreementTitle       String?              @map("agreement_title") @db.VarChar(180)
  agreementSignerName  String?              @map("agreement_signer_name") @db.VarChar(128)
  agreementSignerEmail String?              @map("agreement_signer_email") @db.VarChar(320)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew      Crew           @relation(fields: [crewId], references: [id], onDelete: Cascade)
  agreement CrewAgreement?

  @@index([crewId, status, createdAt(sort: Desc), id(sort: Desc)], map: "crew_invitations_crew_status_created_idx")
  @@index([inviteeUserId, status, createdAt(sort: Desc), id(sort: Desc)], map: "crew_invitations_invitee_status_created_idx")
  @@map("crew_invitations")
}

/// A shareable "anyone with the link" way into a crew — the counterpart to
/// CrewInvitation's one-row-per-invitee model. The link is a bearer secret:
/// only `sha256(token)` is stored, and the raw token is returned exactly once
/// at creation. Access granted on redemption is fixed when the link is minted,
/// so a link can never widen someone's permissions after the fact.
model CrewInviteLink {
  /// Task links admit one member and claim this exact reviewed task version.
  taskId          String?            @map("task_id") @db.Uuid
  taskVersion     Int?               @map("task_version")
  task            CrewTask?          @relation(fields: [taskId, crewId], references: [id, crewId], onDelete: NoAction)
  id              String             @id @default(uuid(7)) @db.Uuid
  crewId          String             @map("crew_id")
  /// Member links enter the private workspace; community links enter only the
  /// public community channel. The bearer token decides one immutable destination.
  kind            CrewInviteLinkKind @default(member)
  tokenHash       String             @unique(map: "crew_invite_links_token_hash_unique") @map("token_hash") @db.VarChar(128)
  /// Additive policies every joiner receives. Empty = plain member.
  policyKeys      String[]           @default([]) @map("policy_keys")
  createdByUserId String             @map("created_by_user_id") @db.VarChar(64)
  /// Null means unlimited. Checked against `useCount` under a row lock.
  maxUses         Int?               @map("max_uses")
  useCount        Int                @default(0) @map("use_count")
  /// Null means it never expires. Expiry is lazy — nothing sweeps these.
  expiresAt       DateTime?          @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?            @map("revoked_by_user_id") @db.VarChar(64)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew        Crew                       @relation(fields: [crewId], references: [id], onDelete: Cascade)
  redemptions CrewInviteLinkRedemption[]

  @@index([taskId], map: "crew_invite_links_task_idx")
  @@index([crewId, kind, createdAt(sort: Desc)], map: "crew_invite_links_crew_kind_created_idx")
  @@map("crew_invite_links")
}

enum CrewInviteLinkKind {
  member
  community

  @@map("crew_invite_link_kind")
}

/// One row per account that arrived through a link. The unique pair is what
/// makes accept idempotent: a second click finds its own redemption instead of
/// burning another use, and the crew can see who came in through which link.
model CrewInviteLinkRedemption {
  id         String   @id @default(uuid(7)) @db.Uuid
  linkId     String   @map("link_id") @db.Uuid
  userId     String   @map("user_id") @db.VarChar(64)
  memberId   String?  @map("member_id")
  redeemedAt DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  link CrewInviteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, userId], map: "crew_invite_link_redemptions_link_user_unique")
  @@map("crew_invite_link_redemptions")
}

/// GitHub-Issue-like production unit. Its project/document are the editable
/// task canvas; submissions point to immutable document versions and assets.
model CrewTask {
  contractFiles CrewTaskContractFile[]
  draftDisputeAttachments CrewDisputeAttachment[]
  inviteLinks          CrewInviteLink[]
  computeRequests CrewComputeRequest[]
  disputes CrewTaskDispute[]
  extensionRequests CrewTaskExtensionRequest[]
  recruitmentPositions CrewPosition[]
  feedback CrewTaskFeedback[]
  deliveryTemplate    CrewTaskDeliveryTemplate?
  id                  String                    @id @default(uuid(7)) @db.Uuid
  crewId              String                    @map("crew_id")
  deletedAt           DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId     String?                   @map("deleted_by_user_id") @db.VarChar(64)
  parentId            String?                   @map("parent_id") @db.Uuid
  /// Stable human-facing sequence within a crew (for example TASK-42).
  number              Int
  title               String                    @db.VarChar(180)
  description         String                    @default("") @db.Text
  /// Product-configurable board column and the only task lifecycle source.
  /// Its semantic drives submission, review and settlement rules; multiple
  /// workflow states may intentionally share one semantic.
  workflowStateId     String                    @map("workflow_state_id") @db.Uuid
  priority            CrewTaskPriority          @default(normal)
  startAt             DateTime?                 @map("start_at") @db.Timestamptz(6)
  dueAt               DateTime?                 @map("due_at") @db.Timestamptz(6)
  estimatePoints      Int?                      @map("estimate_points")
  computeBudgetPoints Int?                      @map("compute_budget_points")
  /// Optional production agreement: how many revision requests are included.
  /// `null` means unlimited; the used counter advances only on a reviewer's
  /// explicit request for another version.
  revisionLimit       Int?                      @map("revision_limit")
  revisionRoundsUsed  Int                       @default(0) @map("revision_rounds_used")
  cycleId             String?                   @map("cycle_id") @db.Uuid
  episodeId           String?                   @map("episode_id") @db.Uuid
  /// One shared sparse ordering key. Reordering within a board/list group
  /// uses exact decimal midpoints and periodically rebalances under a lock.
  rank                Decimal                   @default(1024) @db.Decimal(36, 18)
  /// Optimistic concurrency token. Every mutable task-field/assignee write
  /// increments it; clients send the version they edited.
  version             Int                       @default(1)
  taskKind            CrewTaskKind?             @map("task_kind")
  /// Optional focused Studio branch. Ordinary issues stay lightweight and
  /// acquire a branch only when somebody explicitly starts canvas work.
  canvasProjectId     String?                   @unique(map: "crew_tasks_canvas_project_unique") @map("canvas_project_id") @db.Uuid
  canvasDocumentId    String?                   @unique(map: "crew_tasks_canvas_document_unique") @map("canvas_document_id") @db.Uuid
  createdByUserId     String                    @map("created_by_user_id") @db.VarChar(64)
  approvedByUserId    String?                   @map("approved_by_user_id") @db.VarChar(64)
  submittedAt         DateTime?                 @map("submitted_at") @db.Timestamptz(6)
  approvedAt          DateTime?                 @map("approved_at") @db.Timestamptz(6)
  cancelledAt         DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  metadata            Json?                     @map("metadata") @db.JsonB
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew                  Crew                      @relation(fields: [crewId], references: [id], onDelete: Cascade)
  parent                CrewTask?                 @relation("CrewTaskHierarchy", fields: [parentId, crewId], references: [id, crewId], onDelete: Restrict)
  children              CrewTask[]                @relation("CrewTaskHierarchy")
  cycle                 CrewTaskCycle?            @relation(fields: [cycleId, crewId], references: [id, crewId], onDelete: Restrict)
  episode               CrewEpisode?              @relation(fields: [episodeId, crewId], references: [id, crewId], onDelete: Restrict)
  workflowState         CrewTaskWorkflowState     @relation(fields: [workflowStateId, crewId], references: [id, crewId], onDelete: Restrict)
  canvasProject         PlatformProject?          @relation("CrewTaskCanvasProject", fields: [canvasProjectId], references: [id], onDelete: Restrict)
  canvasDocument        StudioDocument?           @relation("CrewTaskCanvasDocument", fields: [canvasDocumentId], references: [id], onDelete: Restrict)
  assignees             CrewTaskAssignee[]
  labels                CrewTaskLabelAssignment[]
  deliveryFolder        CrewTaskDeliveryFolder?
  submissions           CrewTaskSubmission[]
  earningEntries        CrewEarningEntry[]
  commitments           CrewTaskCommitment[]
  timelineItems         CrewTaskTimelineItem[]
  dependenciesAsBlocker CrewTaskDependency[]      @relation("CrewTaskDependencyBlocker")
  dependenciesAsBlocked CrewTaskDependency[]      @relation("CrewTaskDependencyBlocked")
  customFieldValues     CrewTaskFieldValue[]

  @@unique([id, crewId], name: "uniq_crew_task_id_crew", map: "crew_tasks_id_crew_unique")
  @@unique([crewId, number], map: "crew_tasks_crew_number_unique")
  @@index([crewId, rank, id], map: "crew_tasks_crew_rank_idx")
  @@index([crewId, parentId, rank, id], map: "crew_tasks_crew_parent_rank_idx")
  @@index([crewId, cycleId, rank, id], map: "crew_tasks_crew_cycle_rank_idx")
  @@index([crewId, episodeId, rank, id], map: "crew_tasks_crew_episode_rank_idx")
  @@index([crewId, workflowStateId, rank, id], map: "crew_tasks_crew_workflow_state_rank_idx")
  @@index([crewId, priority, rank, id], map: "crew_tasks_crew_priority_rank_idx")
  @@index([crewId, updatedAt(sort: Desc), id(sort: Desc)], map: "crew_tasks_crew_updated_idx")
  @@index([crewId, dueAt], map: "crew_tasks_crew_due_idx")
  @@index([crewId, taskKind], map: "crew_tasks_crew_kind_idx")
  @@map("crew_tasks")
}

/// Crew-owned assignment templates. System kinds stay in code; these are extras.
model CrewTaskKindTemplate {
  id              String       @id @default(uuid(7)) @db.Uuid
  crewId          String       @map("crew_id")
  kind            CrewTaskKind
  name            String       @db.VarChar(80)
  title           String       @db.VarChar(180)
  description     String       @default("") @db.Text
  createdByUserId String       @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@index([crewId, kind], map: "crew_task_kind_templates_crew_kind_idx")
  @@map("crew_task_kind_templates")
}

/// The crew's editable production home. `document` is the canonical Tiptap
/// JSON tree; episode, task, and delivery state remains normalized in its own
/// tables and is referenced by atomic editor nodes rather than copied here.
model CrewProductionPage {
  crewId                String                        @id @map("crew_id")
  document              Json                          @db.JsonB
  version               Int                           @default(1)
  status                CrewProductionStatus          @default(backlog)
  priority              CrewTaskPriority?
  leadMemberId          String?                       @map("lead_member_id")
  startDate             DateTime?                     @map("start_date") @db.Date
  startDateGranularity  CrewProductionDateGranularity @default(day) @map("start_date_granularity")
  targetDate            DateTime?                     @map("target_date") @db.Date
  targetDateGranularity CrewProductionDateGranularity @default(day) @map("target_date_granularity")
  metadataVersion       Int                           @default(1) @map("metadata_version")
  createdByUserId       String                        @map("created_by_user_id") @db.VarChar(64)
  updatedByUserId       String                        @map("updated_by_user_id") @db.VarChar(64)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew          Crew                            @relation(fields: [crewId], references: [id], onDelete: Cascade)
  leadMember    CrewMember?                     @relation("CrewProductionLead", fields: [leadMemberId, crewId], references: [id, crewId], onDelete: Restrict)
  projectLabels CrewProductionLabelAssignment[]

  @@map("crew_production_pages")
}

/// Project-level references used by the crew while planning production.
/// A resource is either an external HTTP(S) link or an existing crew asset;
/// the database check constraint enforces the exclusive shape.
model CrewProductionResource {
  id              String                     @id @default(uuid(7)) @db.Uuid
  crewId          String                     @map("crew_id")
  kind            CrewProductionResourceKind
  title           String                     @db.VarChar(180)
  url             String?                    @db.VarChar(2048)
  assetNodeId     String?                    @map("asset_node_id") @db.Uuid
  createdByUserId String                     @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew      Crew           @relation(fields: [crewId], references: [id], onDelete: Cascade)
  assetNode CrewAssetNode? @relation(fields: [assetNodeId, crewId], references: [id, crewId], onDelete: Restrict)

  @@index([crewId, createdAt, id], map: "crew_production_resources_crew_idx")
  @@index([assetNodeId], map: "crew_production_resources_asset_idx")
  @@map("crew_production_resources")
}

/// Canonical append-only project stream. Updates, comments, and metadata
/// changes share one cursor and ordering contract; task-local events stay on
/// each issue timeline instead of polluting the project activity view.
model CrewProductionActivity {
  id              String                      @id @default(uuid(7)) @db.Uuid
  crewId          String                      @map("crew_id")
  kind            CrewProductionActivityKind
  health          CrewProductionUpdateHealth?
  content         Json?                       @db.JsonB
  plainText       String                      @default("") @map("plain_text") @db.Text
  progress        Int?
  payload         Json                        @default("{}") @db.JsonB
  createdByUserId String                      @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@index([crewId, createdAt(sort: Desc), id(sort: Desc)], map: "crew_production_activity_recent_idx")
  @@map("crew_production_activity")
}

/// A crew-owned episode in the actual production plan. It is deliberately
/// independent from public IP publishing and from Studio projects.
model CrewEpisode {
  id               String            @id @default(uuid(7)) @db.Uuid
  crewId           String            @map("crew_id")
  number           Int
  title            String            @db.VarChar(180)
  synopsis         String            @default("") @db.Text
  status           CrewEpisodeStatus @default(planned)
  durationSeconds  Int?              @map("duration_seconds")
  plannedReleaseAt DateTime?         @map("planned_release_at") @db.Timestamptz(6)
  rank             Decimal           @default(1024) @db.Decimal(36, 18)
  version          Int               @default(1)
  createdByUserId  String            @map("created_by_user_id") @db.VarChar(64)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew       Crew                  @relation(fields: [crewId], references: [id], onDelete: Cascade)
  tasks      CrewTask[]
  deliveries CrewEpisodeDelivery[]

  @@unique([id, crewId], name: "uniq_crew_episode_id_crew", map: "crew_episodes_id_crew_unique")
  @@unique([crewId, number], map: "crew_episodes_crew_number_unique")
  @@index([crewId, rank, id], map: "crew_episodes_crew_rank_idx")
  @@index([crewId, status, updatedAt(sort: Desc)], map: "crew_episodes_crew_status_idx")
  @@map("crew_episodes")
}

/// Immutable submitted masters for one episode. Review changes only the
/// status and audit fields; a replacement is always a new version.
model CrewEpisodeDelivery {
  id                String                    @id @default(uuid(7)) @db.Uuid
  crewId            String                    @map("crew_id")
  episodeId         String                    @map("episode_id") @db.Uuid
  versionNumber     Int                       @map("version_number")
  assetNodeId       String                    @map("asset_node_id") @db.Uuid
  status            CrewEpisodeDeliveryStatus @default(submitted)
  note              String                    @default("") @db.Text
  reviewNote        String                    @default("") @map("review_note") @db.Text
  submittedByUserId String                    @map("submitted_by_user_id") @db.VarChar(64)
  reviewedByUserId  String?                   @map("reviewed_by_user_id") @db.VarChar(64)
  reviewedAt        DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  episode   CrewEpisode   @relation(fields: [episodeId, crewId], references: [id, crewId], onDelete: Cascade)
  assetNode CrewAssetNode @relation(fields: [assetNodeId, crewId], references: [id, crewId], onDelete: Restrict)

  @@unique([episodeId, versionNumber], map: "crew_episode_deliveries_episode_version_unique")
  @@index([crewId, status, createdAt(sort: Desc)], map: "crew_episode_deliveries_crew_status_idx")
  @@index([assetNodeId], map: "crew_episode_deliveries_asset_idx")
  @@map("crew_episode_deliveries")
}

/// Crew-owned workflow configuration. Names, colors and ordering are product
/// data; `semantic` preserves stable automation rules. `systemKey` identifies
/// the six canonical automation destinations and remains stable when renamed.
model CrewTaskWorkflowState {
  id              String         @id @default(uuid(7)) @db.Uuid
  crewId          String         @map("crew_id")
  name            String         @db.VarChar(80)
  color           String         @db.VarChar(16)
  semantic        CrewTaskStatus
  systemKey       String?        @map("system_key") @db.VarChar(32)
  position        Int            @default(0)
  archived        Boolean        @default(false)
  version         Int            @default(1)
  createdByUserId String         @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew  Crew       @relation(fields: [crewId], references: [id], onDelete: Cascade)
  tasks CrewTask[]

  @@unique([id, crewId], name: "uniq_crew_task_workflow_state_id_crew", map: "crew_task_workflow_states_id_crew_unique")
  @@unique([crewId, systemKey], map: "crew_task_workflow_states_crew_system_key_unique")
  @@index([crewId, archived, position, createdAt], map: "crew_task_workflow_states_crew_order_idx")
  @@map("crew_task_workflow_states")
}

/// A persisted GitHub-Projects/Notion-style view over one crew's work items.
/// Filters/sorts/field visibility are data, so every member sees the same
/// planning surface rather than a hard-coded client-only tab.
model CrewTaskView {
  id              String                @id @default(uuid(7)) @db.Uuid
  crewId          String                @map("crew_id")
  name            String                @db.VarChar(80)
  layout          CrewTaskViewLayout    @default(list)
  groupBy         String?               @map("group_by") @db.VarChar(32)
  filters         Json                  @default("{}") @db.JsonB
  sorts           Json                  @default("[]") @db.JsonB
  visibleFields   Json                  @default("[]") @map("visible_fields") @db.JsonB
  completedMode   CrewTaskCompletedMode @default(all) @map("completed_mode")
  showSubIssues   Boolean               @default(true) @map("show_sub_issues")
  showEmptyGroups Boolean               @default(false) @map("show_empty_groups")
  position        Int                   @default(0)
  isSystem        Boolean               @default(false) @map("is_system")
  createdByUserId String                @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@unique([crewId, name], map: "crew_task_views_crew_name_unique")
  @@index([crewId, position, createdAt], map: "crew_task_views_crew_position_idx")
  @@map("crew_task_views")
}

/// A production iteration/cycle. Tasks without a cycle remain in Backlog.
model CrewTaskCycle {
  id              String              @id @default(uuid(7)) @db.Uuid
  crewId          String              @map("crew_id")
  number          Int
  name            String              @db.VarChar(100)
  goal            String              @default("") @db.Text
  status          CrewTaskCycleStatus @default(planned)
  startAt         DateTime            @map("start_at") @db.Timestamptz(6)
  endAt           DateTime            @map("end_at") @db.Timestamptz(6)
  createdByUserId String              @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew  Crew       @relation(fields: [crewId], references: [id], onDelete: Cascade)
  tasks CrewTask[]

  @@unique([crewId, number], map: "crew_task_cycles_crew_number_unique")
  @@unique([id, crewId], name: "uniq_crew_task_cycle_id_crew", map: "crew_task_cycles_id_crew_unique")
  @@index([crewId, status, startAt, endAt], map: "crew_task_cycles_crew_status_idx")
  @@map("crew_task_cycles")
}

model CrewTaskLabel {
  id              String   @id @default(uuid(7)) @db.Uuid
  crewId          String   @map("crew_id")
  name            String   @db.VarChar(64)
  color           String   @db.VarChar(16)
  description     String   @default("") @db.VarChar(240)
  createdByUserId String   @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew               Crew                            @relation(fields: [crewId], references: [id], onDelete: Cascade)
  tasks              CrewTaskLabelAssignment[]
  productionProjects CrewProductionLabelAssignment[]

  @@unique([crewId, name], map: "crew_task_labels_crew_name_unique")
  @@unique([id, crewId], name: "uniq_crew_task_label_id_crew", map: "crew_task_labels_id_crew_unique")
  @@index([crewId, createdAt], map: "crew_task_labels_crew_created_idx")
  @@map("crew_task_labels")
}

/// Project-level label selection reuses the same crew-scoped taxonomy as
/// issues. The assignment is normalized so labels remain searchable and
/// automatable instead of being copied into the Tiptap document.
model CrewProductionLabelAssignment {
  crewId    String   @map("crew_id")
  labelId   String   @map("label_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  page  CrewProductionPage @relation(fields: [crewId], references: [crewId], onDelete: Cascade)
  label CrewTaskLabel      @relation(fields: [labelId, crewId], references: [id, crewId], onDelete: Cascade)

  @@id([crewId, labelId])
  @@index([labelId, crewId], map: "crew_production_label_assignments_label_idx")
  @@map("crew_production_label_assignments")
}

model CrewTaskLabelAssignment {
  crewId  String @map("crew_id")
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  CrewTask      @relation(fields: [taskId, crewId], references: [id, crewId], onDelete: Cascade)
  label CrewTaskLabel @relation(fields: [labelId, crewId], references: [id, crewId], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId, taskId], map: "crew_task_label_assignments_label_idx")
  @@map("crew_task_label_assignments")
}

/// Directed edge: blockingTask must be completed before blockedTask can move
/// to review. The service rejects cycles; composite FKs guarantee one crew.
model CrewTaskDependency {
  crewId          String   @map("crew_id")
  blockingTaskId  String   @map("blocking_task_id") @db.Uuid
  blockedTaskId   String   @map("blocked_task_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blockingTask CrewTask @relation("CrewTaskDependencyBlocker", fields: [blockingTaskId, crewId], references: [id, crewId], onDelete: Cascade)
  blockedTask  CrewTask @relation("CrewTaskDependencyBlocked", fields: [blockedTaskId, crewId], references: [id, crewId], onDelete: Cascade)

  @@id([blockingTaskId, blockedTaskId])
  @@index([crewId, blockedTaskId, createdAt], map: "crew_task_dependencies_blocked_idx")
  @@index([crewId, blockingTaskId, createdAt], map: "crew_task_dependencies_blocker_idx")
  @@map("crew_task_dependencies")
}

/// One configurable project column. Select options are stable objects shaped
/// as { id, label, color? }; renaming a label never rewrites every task value.
model CrewTaskFieldDefinition {
  id              String            @id @default(uuid(7)) @db.Uuid
  crewId          String            @map("crew_id")
  name            String            @db.VarChar(80)
  description     String            @default("") @db.VarChar(240)
  type            CrewTaskFieldType
  options         Json              @default("[]") @db.JsonB
  position        Int               @default(0)
  required        Boolean           @default(false)
  createdByUserId String            @map("created_by_user_id") @db.VarChar(64)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew   Crew                 @relation(fields: [crewId], references: [id], onDelete: Cascade)
  values CrewTaskFieldValue[]

  @@unique([id, crewId], name: "uniq_crew_task_field_id_crew", map: "crew_task_fields_id_crew_unique")
  @@unique([crewId, name], map: "crew_task_fields_crew_name_unique")
  @@index([crewId, position, createdAt], map: "crew_task_fields_crew_position_idx")
  @@map("crew_task_fields")
}

/// Sparse typed value. Missing row means unset; JSON null is never persisted.
model CrewTaskFieldValue {
  crewId          String   @map("crew_id")
  taskId          String   @map("task_id") @db.Uuid
  fieldId         String   @map("field_id") @db.Uuid
  value           Json     @db.JsonB
  updatedByUserId String   @map("updated_by_user_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  task  CrewTask                @relation(fields: [taskId, crewId], references: [id, crewId], onDelete: Cascade)
  field CrewTaskFieldDefinition @relation(fields: [fieldId, crewId], references: [id, crewId], onDelete: Cascade)

  @@id([taskId, fieldId])
  @@index([crewId, fieldId, updatedAt(sort: Desc)], map: "crew_task_field_values_lookup_idx")
  @@map("crew_task_field_values")
}

/// One ordered Issue-style timeline for both human comments and immutable
/// system activity. A single table gives comments and events one stable cursor
/// and total order, matching the way GitHub renders an issue conversation.
model CrewTaskTimelineItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  /// "comment", "task.created", "task.updated", "task.submitted", …
  kind        String    @db.VarChar(64)
  actorUserId String?   @map("actor_user_id") @db.VarChar(64)
  body        String?   @db.Text
  mentions    Json      @default("[]") @db.JsonB
  payload     Json      @default("{}") @db.JsonB
  /// Stable per-client mutation key. Combined with task + actor it makes
  /// comment retries idempotent without constraining immutable activities.
  clientKey   String?   @map("client_key") @db.VarChar(64)
  replyToId   String?   @map("reply_to_id") @db.Uuid
  version     Int       @default(1)
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  task        CrewTask                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  replyTo     CrewTaskTimelineItem?   @relation("CrewTaskTimelineReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     CrewTaskTimelineItem[]  @relation("CrewTaskTimelineReplies")
  attachments CrewTaskTimelineAsset[]

  @@unique([taskId, actorUserId, clientKey], map: "crew_task_timeline_client_key_unique")
  @@index([taskId, createdAt(sort: Desc), id(sort: Desc)], map: "crew_task_timeline_recent_idx")
  @@index([replyToId], map: "crew_task_timeline_reply_idx")
  @@map("crew_task_timeline_items")
}

model CrewTaskTimelineAsset {
  id          String @id @default(uuid(7)) @db.Uuid
  timelineId  String @map("timeline_id") @db.Uuid
  assetNodeId String @map("asset_node_id") @db.Uuid
  position    Int    @default(0)

  timeline  CrewTaskTimelineItem @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  assetNode CrewAssetNode        @relation(fields: [assetNodeId], references: [id], onDelete: Restrict)

  @@unique([timelineId, assetNodeId], map: "crew_task_timeline_assets_unique")
  @@unique([timelineId, position], map: "crew_task_timeline_assets_position_unique")
  @@index([assetNodeId], map: "crew_task_timeline_assets_node_idx")
  @@map("crew_task_timeline_assets")
}

model CrewTaskAssignee {
  /// Required CNY/USD currency; amounts are integer minor units.
  currency          String   @db.VarChar(3)
  id                String   @id @default(uuid(7)) @db.Uuid
  crewId            String   @map("crew_id")
  taskId            String   @map("task_id") @db.Uuid
  crewMemberId      String   @map("crew_member_id")
  userId            String   @map("user_id") @db.VarChar(64)
  /// Compensation in the stated currency, in cents/fen.
  rewardAmountMinor BigInt?  @map("reward_amount_minor")
  assignedAt        DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  task       CrewTask   @relation(fields: [taskId, crewId], references: [id, crewId], onDelete: Cascade)
  crewMember CrewMember @relation(fields: [crewMemberId, crewId, userId], references: [id, crewId, userId], onDelete: Restrict)

  @@unique([taskId, userId], map: "crew_task_assignees_task_user_unique")
  @@index([userId, assignedAt(sort: Desc)], map: "crew_task_assignees_user_idx")
  @@map("crew_task_assignees")
}

model CrewTaskSubmission {
  feedback CrewTaskFeedback[]
  professionalDelivery Json?                   @map("professional_delivery") @db.JsonB
  trustEntries         CrewCreatorTrustEntry[]
  trustCorrections     CrewTrustCorrection[]
  timelinessResult     Json?                   @map("timeliness_result") @db.JsonB
  timelinessEvidence   Json?                   @map("timeliness_evidence") @db.JsonB
  id                   String                  @id @default(uuid(7)) @db.Uuid
  taskId               String                  @map("task_id") @db.Uuid
  versionNumber        Int                     @map("version_number")
  submittedByUserId    String                  @map("submitted_by_user_id") @db.VarChar(64)
  note                 String                  @default("") @db.Text
  canvasVersionId      String?                 @map("canvas_version_id") @db.Uuid
  /// Immutable version created on the crew's main production canvas by an
  /// approved CRDT merge. Null until this submission is approved.
  productionVersionId  String?                 @unique(map: "crew_task_submissions_production_version_unique") @map("production_version_id") @db.Uuid
  reviewNote           String?                 @map("review_note") @db.Text
  reviewedByUserId     String?                 @map("reviewed_by_user_id") @db.VarChar(64)
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  mergedAt             DateTime?               @map("merged_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  task              CrewTask                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  canvasVersion     StudioDocumentVersion?    @relation("CrewTaskSubmissionCanvasVersion", fields: [canvasVersionId], references: [id], onDelete: Restrict)
  productionVersion StudioDocumentVersion?    @relation("CrewTaskSubmissionProductionVersion", fields: [productionVersionId], references: [id], onDelete: Restrict)
  assets            CrewTaskSubmissionAsset[]

  @@unique([taskId, versionNumber], map: "crew_task_submissions_task_version_unique")
  @@index([taskId, createdAt(sort: Desc)], map: "crew_task_submissions_recent_idx")
  @@index([productionVersionId], map: "crew_task_submissions_production_version_idx")
  @@map("crew_task_submissions")
}

model CrewTaskSubmissionAsset {
  id           String @id @default(uuid(7)) @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  assetNodeId  String @map("asset_node_id") @db.Uuid

  submission CrewTaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assetNode  CrewAssetNode      @relation(fields: [assetNodeId], references: [id], onDelete: Restrict)

  @@unique([submissionId, assetNodeId], map: "crew_task_submission_assets_unique")
  @@index([assetNodeId], map: "crew_task_submission_assets_node_idx")
  @@map("crew_task_submission_assets")
}

/// Immutable Crew compensation ledger, separate from compute and wallet credits.
/// CNY/USD amounts are integer minor units. CrewPayout records settlement evidence.
model CrewEarningEntry {
  revenueDistributionId String? @map("revenue_distribution_id") @db.Uuid
  revenueDistribution CrewRevenueDistribution? @relation(fields: [revenueDistributionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([revenueDistributionId, userId], map: "crew_revenue_beneficiary_unique")
  amendmentId String? @unique(map: "crew_earning_amendment_unique") @map("amendment_id") @db.Uuid
  /// Required CNY/USD currency; amounts are integer minor units.
  currency         String                @db.VarChar(3)
  id               String                @id @default(uuid(7)) @db.Uuid
  crewId           String                @map("crew_id")
  crewMemberId     String                @map("crew_member_id")
  userId           String                @map("user_id") @db.VarChar(64)
  sourceType       CrewEarningSourceType @map("source_type")
  taskId           String?               @map("task_id") @db.Uuid
  agreementId      String?               @map("agreement_id") @db.Uuid
  title            String                @db.VarChar(180)
  description      String?               @db.Text
  amountMinor      BigInt                @map("amount_minor")
  status           CrewEarningStatus     @default(pending)
  idempotencyKey   String                @unique(map: "crew_earning_entries_idempotency_unique") @map("idempotency_key") @db.VarChar(160)
  createdByUserId  String                @map("created_by_user_id") @db.VarChar(64)
  approvedByUserId String?               @map("approved_by_user_id") @db.VarChar(64)
  rejectedByUserId String?               @map("rejected_by_user_id") @db.VarChar(64)
  reversedByUserId String?               @map("reversed_by_user_id") @db.VarChar(64)
  postedAt         DateTime?             @map("posted_at") @db.Timestamptz(6)
  rejectedAt       DateTime?             @map("rejected_at") @db.Timestamptz(6)
  reversedAt       DateTime?             @map("reversed_at") @db.Timestamptz(6)
  rejectionReason  String?               @map("rejection_reason") @db.Text
  reversalReason   String?               @map("reversal_reason") @db.Text
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew              Crew                   @relation(fields: [crewId], references: [id], onDelete: Restrict)
  task              CrewTask?              @relation(fields: [taskId, crewId], references: [id, crewId], onDelete: Restrict)
  agreement         CrewAgreement?         @relation(fields: [agreementId, crewId], references: [id, crewId], onDelete: Restrict)
  crewMember        CrewMember             @relation(fields: [crewMemberId, crewId, userId], references: [id, crewId, userId], onDelete: Restrict)
  events            CrewEarningEvent[]
  payoutAllocations CrewPayoutAllocation[]

  @@unique([id, crewId], name: "uniq_crew_earning_id_crew", map: "crew_earning_entries_id_crew_unique")
  // Original earnings retain a partial unique index in SQL; amendment entries use amendmentId.
  @@index([taskId, userId, sourceType], map: "crew_earning_entries_task_user_source_idx")
  @@index([crewId, status, createdAt(sort: Desc), id(sort: Desc)], map: "crew_earning_entries_crew_status_created_idx")
  @@index([crewId, sourceType, createdAt(sort: Desc), id(sort: Desc)], map: "crew_earning_entries_crew_source_created_idx")
  @@index([userId, status, createdAt(sort: Desc), id(sort: Desc)], map: "crew_earning_entries_user_status_created_idx")
  @@index([crewMemberId, createdAt(sort: Desc)], map: "crew_earning_entries_member_created_idx")
  @@index([agreementId], map: "crew_earning_entries_agreement_idx")
  @@index([crewId, currency, status, postedAt], map: "crew_earning_entries_crew_posted_trend_idx")
  @@index([userId, currency, status, postedAt], map: "crew_earning_entries_user_posted_trend_idx")
  @@map("crew_earning_entries")
}

/// One disbursement in a single ledger currency for one Crew member.
/// Finance may record statutory withholding; paid allocations remain the
/// anti-double-pay boundary.
model CrewPayout {
  platformWithdrawalId   String?            @map("platform_withdrawal_id") @db.Uuid
  platformWithdrawal     CreatorWithdrawal? @relation(fields: [platformWithdrawalId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// Required CNY/USD currency; amounts are integer minor units.
  currency               String            @db.VarChar(3)
  id                     String            @id @default(uuid(7)) @db.Uuid
  crewId                 String            @map("crew_id")
  crewMemberId           String            @map("crew_member_id")
  userId                 String            @map("user_id") @db.VarChar(64)
  amountMinor            BigInt            @map("amount_minor")
  withholdingAmountMinor BigInt            @default(0) @map("withholding_amount_minor")
  netAmountMinor         BigInt            @map("net_amount_minor")
  status                 CrewPayoutStatus  @default(pending)
  paymentMethod          CrewPayoutMethod? @map("payment_method")
  paymentReference       String?           @map("payment_reference") @db.VarChar(180)
  paymentProofUrl        String?           @map("payment_proof_url") @db.VarChar(1024)
  note                   String?           @db.Text
  voidReason             String?           @map("void_reason") @db.Text
  idempotencyKey         String            @unique(map: "crew_payouts_idempotency_unique") @map("idempotency_key") @db.VarChar(160)
  createdByUserId        String            @map("created_by_user_id") @db.VarChar(64)
  paidByUserId           String?           @map("paid_by_user_id") @db.VarChar(64)
  voidedByUserId         String?           @map("voided_by_user_id") @db.VarChar(64)
  paidAt                 DateTime?         @map("paid_at") @db.Timestamptz(6)
  voidedAt               DateTime?         @map("voided_at") @db.Timestamptz(6)
  version                Int               @default(1)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  crew        Crew                   @relation(fields: [crewId], references: [id], onDelete: Restrict)
