/// One explicit, user-triggered request to generate media for a persisted
/// Story production target. The logical AssetSpec / StoryboardClip never owns
/// generated URLs; this row is the durable correlation authority between the
/// target snapshot, the generic AiJob and the creative media version(s).
model StoryProductionGeneration {
  id                      String                              @id @default(uuid(7)) @db.Uuid
  storyProjectId          String                              @map("story_project_id") @db.Uuid
  storyChapterId          String                              @map("story_chapter_id") @db.Uuid
  targetKind              StoryProductionGenerationTargetKind @map("target_kind")
  generationKind          StoryProductionGenerationKind       @map("generation_kind")
  purpose                 StoryAssetGenerationPurpose         @default(primary)
  assetSpecId             String?                             @map("asset_spec_id") @db.Uuid
  storyboardClipId        String?                             @map("storyboard_clip_id") @db.Uuid
  aiJobId                 String                              @unique(map: "story_production_generations_ai_job_unique") @map("ai_job_id") @db.Uuid
  actorUserId             String                              @map("actor_user_id") @db.VarChar(64)
  idempotencyKey          String                              @map("idempotency_key") @db.VarChar(160)
  requestFingerprint      String                              @map("request_fingerprint") @db.VarChar(64)
  targetVersion           Int                                 @map("target_version")
  targetSourceFingerprint String                              @map("target_source_fingerprint") @db.VarChar(64)
  promptSnapshot          Json                                @map("prompt_snapshot") @db.JsonB
  submissionSnapshot      Json                                @map("submission_snapshot") @db.JsonB
  retryOfGenerationId     String?                             @map("retry_of_generation_id") @db.Uuid
  materializedAt          DateTime?                           @map("materialized_at") @db.Timestamptz(6)
  materializationError    Json?                               @map("materialization_error") @db.JsonB
  reconcileAttempts       Int                                 @default(0) @map("reconcile_attempts")
  lastReconciledAt        DateTime?                           @map("last_reconciled_at") @db.Timestamptz(6)
  nextReconcileAt         DateTime?                           @map("next_reconcile_at") @db.Timestamptz(6)
  createdAt               DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project                 StoryProject                      @relation(fields: [storyProjectId], references: [id], onDelete: Cascade, map: "story_production_generations_project_fkey")
  chapter                 StoryChapter                      @relation(fields: [storyChapterId, storyProjectId], references: [id, storyProjectId], onDelete: Cascade, map: "story_production_generations_chapter_scope_fkey")
  assetSpec               StoryAssetSpec?                   @relation(fields: [assetSpecId, storyChapterId, storyProjectId], references: [id, storyChapterId, storyProjectId], onDelete: Cascade, map: "story_production_generations_asset_scope_fkey")
  storyboardClip          StoryStoryboardClip?              @relation(fields: [storyboardClipId, storyChapterId, storyProjectId], references: [id, storyChapterId, storyProjectId], onDelete: Cascade, map: "story_production_generations_clip_scope_fkey")
  aiJob                   AiJob                             @relation(fields: [aiJobId], references: [id], onDelete: Restrict, map: "story_production_generations_ai_job_fkey")
  retryOfGeneration       StoryProductionGeneration?        @relation("StoryProductionGenerationRetry", fields: [retryOfGenerationId], references: [id], onDelete: Cascade, map: "story_production_generations_retry_fkey")
  retries                 StoryProductionGeneration[]       @relation("StoryProductionGenerationRetry")
  batchItem               StoryGenerationBatchItem?
  assetMediaVersions      StoryAssetMediaVersion[]          @relation("StoryAssetMediaVersionGeneration")
  storyboardMediaVersions StoryStoryboardClipMediaVersion[] @relation("StoryStoryboardMediaVersionGeneration")

  @@unique([id, aiJobId], map: "story_production_generations_id_job_unique")
  @@unique([storyChapterId, actorUserId, idempotencyKey], map: "story_production_generations_actor_key_unique")
  @@index([storyProjectId, storyChapterId, targetKind, assetSpecId, storyboardClipId, createdAt(sort: Desc)], map: "story_production_generations_target_recent_idx")
  @@index([assetSpecId, purpose, createdAt(sort: Desc)], map: "story_production_generations_asset_purpose_recent_idx")
  @@index([materializedAt, nextReconcileAt, createdAt], map: "story_production_generations_reconcile_idx")
  @@index([retryOfGenerationId], map: "story_production_generations_retry_idx")
  @@map("story_production_generations")
}

/// A priced, creator-confirmed group of Story media generations. Quote and
/// execution share this row so confirmation cannot drift to a different model,
/// target version, or price. Items enter the generic AI queue gradually through
/// the fair dispatcher instead of flooding it at confirmation time.
model StoryGenerationBatch {
  id                       String                     @id @default(uuid(7)) @db.Uuid
  workspaceId              String                     @map("workspace_id") @db.Uuid
  storyProjectId           String                     @map("story_project_id") @db.Uuid
  storyChapterId           String                     @map("story_chapter_id") @db.Uuid
  actorUserId              String                     @map("actor_user_id") @db.VarChar(64)
  /// Payer frozen when the quote is created; confirmation and delayed dispatch
  /// must charge the same account even if the project policy changes later.
  billingSubjectType       BillingSubjectType         @map("billing_subject_type")
  billingSubjectId         String                     @map("billing_subject_id") @db.VarChar(64)
  status                   StoryGenerationBatchStatus @default(awaiting_confirmation)
  blockedAt                DateTime?                  @map("blocked_at") @db.Timestamptz(6)
  blockReason              Json?                      @map("block_reason") @db.JsonB
  sourceSurface            String                     @default("story-studio-batch") @map("source_surface") @db.VarChar(64)
  /// H5 auto-production admits exactly one provider job at a time. Desktop
  /// batches retain fair parallel admission across dispatcher sweeps.
  dispatchMode             String                     @default("parallel") @map("dispatch_mode") @db.VarChar(16)
  idempotencyKey           String                     @map("idempotency_key") @db.VarChar(180)
  requestFingerprint       String                     @map("request_fingerprint") @db.VarChar(64)
  quoteSnapshot            Json                       @map("quote_snapshot") @db.JsonB
  totalPoints              Int                        @map("total_points")
  itemCount                Int                        @map("item_count")
  version                  Int                        @default(0)
  quoteExpiresAt           DateTime                   @map("quote_expires_at") @db.Timestamptz(6)
  confirmedAt              DateTime?                  @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt              DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  completedAt              DateTime?                  @map("completed_at") @db.Timestamptz(6)
  handoffResultDeliveredAt DateTime?                  @map("handoff_result_delivered_at") @db.Timestamptz(6)
  /// Set when continuation delivery can never succeed (e.g. the source
  /// Agent OS run reached a terminal status before the batch settled).
  /// Durable poison-pill marker so the continuation worker stops
  /// re-queuing the batch every sweep; reason keeps the journal error code.
  handoffAbandonedAt        DateTime?                  @map("handoff_abandoned_at") @db.Timestamptz(6)
  handoffAbandonReason      Json?                      @map("handoff_abandon_reason") @db.JsonB
  lastDispatchedAt         DateTime?                  @map("last_dispatched_at") @db.Timestamptz(6)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project                     StoryProject                        @relation(fields: [storyProjectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "story_generation_batches_project_fkey")
  chapter                     StoryChapter                        @relation(fields: [storyChapterId, storyProjectId], references: [id, storyProjectId], onDelete: Cascade)
  items                       StoryGenerationBatchItem[]
  externalHandoffRegistration AgentOsExternalHandoffRegistration?

  @@unique([storyChapterId, actorUserId, idempotencyKey], map: "story_generation_batches_actor_key_unique")
  @@index([actorUserId, status, lastDispatchedAt, createdAt], map: "story_generation_batches_fairness_idx")
  @@index([billingSubjectType, billingSubjectId, createdAt(sort: Desc)], map: "story_generation_batches_billing_subject_idx")
