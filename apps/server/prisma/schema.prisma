// ─────────────────────────────────────────────────────────────
// Certificate domain (src/certificates/)
// ─────────────────────────────────────────────────────────────
//
// User-facing completion certificates issued after training.
// Current operational flow is deliberately simple:
//   1. Ops provides `userId` + final certificate image files.
//   2. We upload those images to object storage.
//   3. A manual import inserts one MediaAsset + UserCertificate row per image.
//
// No certificate template table is needed for this phase. If future
// admin-side template rendering becomes real, add template tables then;
// this single issued-cert table remains the public/profile source.
//
// Certificate No. format:
//   FD-{CODE}-{YYMM}-{RANDOM}
// Example:
//   FD-OPC-2605-8K3Q7P

model UserCertificate {
  id             String     @id @default(uuid(7)) @db.Uuid
  /// External auth user id. FK not enforced — orphaned rows
  /// just render as "Unknown user" client-side, matching the crew /
  /// services convention.
  userId         String     @map("user_id") @db.VarChar(64)
  /// Human-readable cert number generated by import code. RANDOM is
  /// URL-safe uppercase A-Z/0-9 and must not encode user id / DB id /
  /// name / level.
  certNo         String     @unique @map("cert_no") @db.VarChar(32)
  /// Explicit admin-reviewed qualification; generic and training certificates confer no Crew access.
  credentialType String     @default("general") @map("credential_type") @db.VarChar(64)
  title          String     @db.VarChar(128)
  issuer         String     @default("FizzDragon") @db.VarChar(128)
  /// Final certificate image asset. UserCertificate owns the business
  /// fact; MediaAsset owns storage identity and URL materialization.
  imageAssetId   String     @map("image_asset_id") @db.Uuid
  imageAsset     MediaAsset @relation("UserCertificateImage", fields: [imageAssetId], references: [id], onDelete: Restrict)
  issuedAt       DateTime   @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(6)
  revokedReason  String?    @map("revoked_reason") @db.VarChar(255)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Profile cert wall: per-user, hide revoked, newest issued first.
  @@index([userId, revokedAt, issuedAt(sort: Desc)], map: "user_certificates_profile_idx")
  @@index([imageAssetId], map: "user_certificates_image_asset_idx")
  /// Global issue history — newest first.
  @@index([issuedAt(sort: Desc)], map: "user_certificates_issued_idx")
  @@map("user_certificates")
}

// ─── Referral / invite-reward program ──────────────────────────────────
// The "邀请奖励" surface. Self-contained on the Nest side: attribution is
// CLAIMED by the invited user after signup (POST /aurora/referrals/claim),
// so it needs no Java signup hook. External auth user ids ride as
// VarChar(64) with FK not enforced (crew/services/cert convention). Money
// is BigInt minor units (1/100 = 1 cent) to match the wallet ledger.

enum ReferralAttributionStatus {
  pending // claimed; awaiting the referee's qualifying action
  qualified // referee completed the qualifying action
  reversed // undone (refund / clawback)
  voided // admin-cancelled / fraud
}

enum ReferralRewardKind {
  referral // referrer earns per qualified referee
  milestone // referrer hit an invitee-count tier
  invitee // the invited user's welcome perk (earner = referee)
  commission // referrer earns a % of a referee's order (消费返佣, per order)
}

enum ReferralRewardStatus {
  pending // created, referee not yet qualified
  qualified // qualifying action done, reward firming up
  accrued // credited, inside the hold window
  reversed // clawed back
  voided // admin-cancelled
  paid_out // settled / granted (membership/points credited or cash paid)
}

/// What a reward pays out — cash, points (compute/community), or membership
/// days (compute/community/both). Drives the grant path at settlement.
enum ReferralPayoutType {
  cash
  points_compute
  points_community
  membership_compute
  membership_community
  membership_both
}

/// Admin-managed program config (one row per key — CheckInConfig style).
/// Milestone tiers live in the child table.
model ReferralProgram {
  id                          String   @id @default(uuid(7)) @db.Uuid
  key                         String   @unique @default("default")
  enabled                     Boolean  @default(false)
  currency                    String   @default("USD") @db.VarChar(3)
  /// Referrer reward per qualified referee, minor units.
  rewardPerReferralMinor      BigInt   @default(0) @map("reward_per_referral_minor")
  /// Days an accrued reward is held before it becomes payable.
  holdDays                    Int      @default(0) @map("hold_days")
  /// Cap on rewarded referees per referrer (0 = unlimited).
  maxRewardedReferees         Int      @default(0) @map("max_rewarded_referees")
  /// Consumption-commission (消费返佣) default rate in basis points of a
  /// referee order's actual-paid amount (0 = off; per-user rows override).
  commissionBps               Int      @default(0) @map("commission_bps")
  /// Anti-fraud: only attribute referees whose account is younger than this
  /// many hours (0 = no limit).
  refereeMaxAccountAgeHours   Int      @default(0) @map("referee_max_account_age_hours")
  /// Welcome perk shown to the invited user.
  inviteeBenefitTitle         String?  @map("invitee_benefit_title") @db.VarChar(120)
  inviteeBenefitDetail        String?  @map("invitee_benefit_detail") @db.VarChar(400)
  inviteeBenefitMinor         BigInt   @default(0) @map("invitee_benefit_minor")
  inviteeBenefitExpiresInDays Int?     @map("invitee_benefit_expires_in_days")
  createdById                 String?  @map("created_by_id") @db.VarChar(64)
  updatedById                 String?  @map("updated_by_id") @db.VarChar(64)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  milestones          ReferralMilestoneConfig[]
  inviteeBenefitItems ReferralInviteeBenefitItem[]

  @@map("referral_programs")
}

/// The invitee (被邀请人) welcome-perk BUNDLE — one row per payout the referred
/// user receives on qualifying (社区/算力积分, 社区/算力会员, or cash). Mirrors
/// ReferralRewardTierItem; a "both memberships" perk is two items. The legacy
/// inviteeBenefit* columns on ReferralProgram mirror items[0] (primary) so the
/// old single-cash clients keep working. Empty = no welcome perk.
model ReferralInviteeBenefitItem {
  id          String             @id @default(uuid(7)) @db.Uuid
  programId   String             @map("program_id") @db.Uuid
  program     ReferralProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  payoutType  ReferralPayoutType @map("payout_type")
  amountMinor BigInt             @default(0) @map("amount_minor")
  days        Int                @default(0)
  rank        Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([programId, rank], map: "referral_invitee_benefit_item_program_idx")
  @@map("referral_invitee_benefit_items")
}

/// Admin-editable milestone tiers: invite N referees → bonus reward.
model ReferralMilestoneConfig {
  id               String             @id @default(uuid(7)) @db.Uuid
  programId        String             @map("program_id") @db.Uuid
  program          ReferralProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  inviteeThreshold Int                @map("invitee_threshold")
  payoutType       ReferralPayoutType @default(cash) @map("payout_type")
  /// Cash minor units OR point count (per payoutType); 0 for membership tiers.
  rewardMinor      BigInt             @map("reward_minor")
  /// Membership reward duration in days; 0 for cash/points tiers.
  payoutDays       Int                @default(0) @map("payout_days")
  title            String             @db.VarChar(120)
  detail           String             @db.VarChar(400)
  rank             Int                @default(0)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Reward bundle for this tier (one tier → many items). The legacy
  /// payoutType/rewardMinor/payoutDays columns above mirror items[0] (the
  /// "primary" item) so older clients keep rendering a single reward.
  items ReferralRewardTierItem[]

  // DB-level PARTIAL unique on (program_id, invitee_threshold) WHERE
  // archived_at IS NULL (migration 20260704150000) — active tiers can't share
  // a threshold, but archived ones don't block re-creating it. Prisma can't
  // express partial uniques, so it is intentionally NOT declared here.
  @@index([programId, rank], map: "referral_milestone_program_rank_idx")
  @@map("referral_milestone_configs")
}

/// Who referred whom — one attribution per referee, lifetime.
model ReferralAttribution {
  id             String                    @id @default(uuid(7)) @db.Uuid
  programKey     String                    @default("default") @map("program_key") @db.VarChar(64)
  referrerUserId String                    @map("referrer_user_id") @db.VarChar(64)
  /// A user can be referred at most once, ever.
  refereeUserId  String                    @unique @map("referee_user_id") @db.VarChar(64)
  /// The referrer's Java recommendation_code that attributed this referee.
  inviteCode     String                    @map("invite_code") @db.VarChar(50)
  status         ReferralAttributionStatus @default(pending)
  qualifiedAt    DateTime?                 @map("qualified_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([referrerUserId, status], map: "referral_attribution_referrer_idx")
  @@map("referral_attributions")
}

/// A reward owed to a user (referrer per-referral / milestone, or referee perk).
model ReferralReward {
  id                String               @id @default(uuid(7)) @db.Uuid
  programKey        String               @default("default") @map("program_key") @db.VarChar(64)
  userId            String               @map("user_id") @db.VarChar(64)
  kind              ReferralRewardKind
  payoutType        ReferralPayoutType   @default(cash) @map("payout_type")
  status            ReferralRewardStatus @default(pending)
  /// Cash minor units OR point count (per payoutType); 0 for membership.
  amountMinor       BigInt               @map("amount_minor")
  /// Membership reward duration in days; 0 for cash/points.
  days              Int                  @default(0)
  /// Cash currency (null for points / membership rewards).
  currency          String?              @db.VarChar(3)
  title             String               @db.VarChar(120)
  subtitle          String?              @db.VarChar(200)
  /// Source attribution (null for milestone rewards) — also the per-referral
  /// idempotency key: at most one referral reward per attribution.
  attributionId     String?              @unique @map("attribution_id") @db.Uuid
  /// Source milestone config (null for per-referral / invitee rewards).
  milestoneId       String?              @map("milestone_id") @db.Uuid
  /// Source BillingOrder for commission rewards — with `kind` the per-order
  /// idempotency key (one commission per order). Null for other kinds.
  orderId           String?              @map("order_id") @db.Uuid
  /// Commission audit snapshot: the applied rate + the order's actual-paid
  /// amount the rate was computed from. Null for non-commission rewards.
  commissionBps     Int?                 @map("commission_bps")
  sourceAmountMinor BigInt?              @map("source_amount_minor")
  /// When an accrued reward becomes payable (after the hold window).
  availableAt       DateTime?            @map("available_at") @db.Timestamptz(6)
  paidOutAt         DateTime?            @map("paid_out_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Snapshot of the reward bundle at accrual (one reward → many items). The
  /// legacy payoutType/amountMinor/days/currency columns above mirror items[0]
  /// (primary) so the already-submitted mobile app keeps rendering w/o crashing.
  items ReferralRewardItem[]

  @@unique([userId, milestoneId], map: "referral_reward_user_milestone_unique")
  @@unique([orderId, kind], map: "referral_reward_order_kind_unique")
  @@index([userId, status, createdAt(sort: Desc)], map: "referral_reward_user_idx")
  @@map("referral_rewards")
}

/// Per-referrer consumption-commission rate (消费返佣白名单 — KOL rates).
/// Absence of a row means the program's default commissionBps applies; a row
/// overrides it (0 = explicitly disabled for that user). Rates applied to a
/// reward are SNAPSHOTTED onto it, so editing/removing a row only affects
/// future orders. External Java user ids ride as VarChar(64), no FK.
model ReferralCommissionRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  programKey    String   @default("default") @map("program_key") @db.VarChar(64)
  userId        String   @map("user_id") @db.VarChar(64)
  commissionBps Int      @map("commission_bps")
  /// Admin note — who this is / why this rate (e.g. "KOL 张三 抖音").
  note          String?  @db.VarChar(200)
  createdById   String?  @map("created_by_id") @db.VarChar(64)
  updatedById   String?  @map("updated_by_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([programKey, userId], map: "referral_commission_rate_program_user_unique")
  @@map("referral_commission_rates")
}

/// One reward in a milestone TIER's bundle (admin-edited). A tier grants ALL of
/// its items. `payoutType` here is always a SINGLE kind — never membership_both;
/// a "both" tier is two items (membership_compute + membership_community). The
/// legacy payoutType/rewardMinor/payoutDays on ReferralMilestoneConfig mirror
/// items[0] (primary) so single-reward clients keep working.
model ReferralRewardTierItem {
  id          String                  @id @default(uuid(7)) @db.Uuid
  milestoneId String                  @map("milestone_id") @db.Uuid
  milestone   ReferralMilestoneConfig @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  payoutType  ReferralPayoutType      @map("payout_type")
  /// Cash minor units OR point count (per payoutType); 0 for membership.
  amountMinor BigInt                  @default(0) @map("amount_minor")
  /// Membership duration in days; 0 for cash/points.
  days        Int                     @default(0)
  rank        Int                     @default(0)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([milestoneId, rank], map: "referral_reward_tier_item_milestone_idx")
  @@map("referral_reward_tier_items")
}

/// Snapshot of one granted thing inside a ReferralReward bundle, frozen at
/// accrual (never reads live tier config). One reward → many items. The legacy
/// payoutType/amountMinor/days/currency on ReferralReward mirror items[0]
/// (primary) for the already-shipped mobile app. `grantedAt` gives per-item
/// idempotency so a multi-item claim is re-claim-safe.
model ReferralRewardItem {
  withdrawalAllocations ReferralWithdrawalAllocation[]
  id          String             @id @default(uuid(7)) @db.Uuid
  rewardId    String             @map("reward_id") @db.Uuid
  reward      ReferralReward     @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  payoutType  ReferralPayoutType @map("payout_type")
  amountMinor BigInt             @default(0) @map("amount_minor")
  days        Int                @default(0)
  currency    String?            @db.VarChar(3)
  rank        Int                @default(0)
  /// Set when this item has been granted at claim (per-item idempotency).
  grantedAt   DateTime?          @map("granted_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([rewardId, rank], map: "referral_reward_item_reward_idx")
  @@map("referral_reward_items")
}

// ─────────────────────────────────────────────────────────────
// Story Studio product plane (docs/story-studio-architecture-v3.md)
// ─────────────────────────────────────────────────────────────
// StoryProject is independent from PlatformProject. Workspace is the only
// shared ownership/billing boundary. Drafts are mutable CAS heads; revisions,
// releases, reviews and approvals are append-only/immutable in migration SQL.

enum StoryProjectStatus {
  active
  archived
}

/// Project-wide picture contract. It is selectable during setup, then becomes
/// immutable once a video is selected or a build exists. Every selected or
/// generated video must match it.
enum StoryFrameProfile {
  landscape_16_9
  portrait_9_16
}

/// Editorial duration target for one interactive-film project. The ranges are
/// part of the stored contract rather than UI copy so an Agent run can replay
/// the exact creative direction it authored against.
enum StoryDurationPreset {
  short_5_15
  medium_15_30
  long_30_60
}

enum StoryVisibility {
  private
  unlisted
  public
}

enum StoryProjectMemberRole {
  owner
  producer
  editor
  reviewer
  viewer
}

enum StoryProjectMemberStatus {
  active
  removed
}

enum StoryProjectInviteStatus {
  pending
  accepted
  revoked
  expired
}

enum StoryRevisionSource {
  creator
  import
}

enum StoryAgentRunKind {
  apply
  undo
}

enum StoryAgentRunStatus {
  authoring
  authoring_failed
  proposed
  applying
  succeeded
  failed
  cancelled
  stale
}

/// Server-selected authoring admission route. Models and browsers never set it.
enum StoryAgentAuthoringMode {
  screenplay_required
  downstream_reconcile
  noop
}

enum StoryAgentProposalDecision {
  approve
  reject
}

enum StoryBuildStatus {
  queued
  validating
  compiling
  ready
  failed
  cancelled
}

enum StoryBuildKind {
  preview
  production
}

/// Durable state of a publication request sent to the Java player authority.
/// `uncertain` means the request may have been accepted and therefore must not
/// be treated as a rejection until authority reconciliation proves identity.
enum StoryExperiencePublicationStatus {
  pending
  confirmed
  uncertain
  rejected
}

/// Durable lifecycle for a creator-uploaded Story clip. The browser may write
/// only to `stagingObjectKey`; a server worker verifies the bytes and promotes
/// them to a server-chosen immutable final key before the MediaAsset is ready.
enum StoryAssetRole {
  video
  audio
  subtitle
  poster
  cover
  runtime
  other
}

enum StoryReviewDecision {
  approve
  reject
  request_changes
}

enum StoryReferenceKind {
  character
  location
  prop
  graphic
  style
  join_frame
  first_frame
  last_frame
}

enum StoryReferenceSource {
  upload
  ai_job
  import
}

enum StoryReferenceVersionStatus {
  pending
  processing
  ready
  failed
}

/// Lifecycle of an editable chapter-scoped production record. Source changes
/// never invalidate creator work; records leave the live surface only when
/// explicitly or structurally archived.
enum StoryProductionSpecStatus {
  current
  archived
}

/// A durable logical asset can exist before any image or video is generated.
/// Creative outputs live in StoryAssetMediaVersion; MediaAssetVariant remains
/// the technical rendition layer (thumbnail, poster, HLS, transcode, ...).
enum StoryAssetSpecKind {
  character
  location
  prop
}

enum StoryStoryboardClipKind {
  image
  video
}

/// Explicit media kind requested by one Story production generation command.
/// Audio is intentionally excluded until Story production owns an audio spec.
enum StoryProductionGenerationKind {
  image
  video
}

enum StoryProductionGenerationTargetKind {
  asset_spec
  storyboard_clip
}

/// Distinguishes a character's canonical image from its model-reference
/// turnaround board. Storyboard generations always use `primary`.
enum StoryAssetGenerationPurpose {
  primary
  turnaround
}

enum StoryGenerationBatchStatus {
  awaiting_confirmation
  blocked
  queued
  running
  cancelling
  completed
  partial_failed
  cancelled
  failed
  expired
}

enum StoryGenerationBatchItemStatus {
  awaiting_confirmation
  ready
  dispatching
  submitted
  completed
  failed
  cancelled
}

enum StoryStoryboardBindingMode {
  follow_selected
  pinned
}

enum StoryStoryboardCueKind {
  decision
  interaction
  dialogue
  audio
  overlay
}

enum WorldModelWorldStatus {
  generating
  ready
  failed
}

enum WorldModelSessionStatus {
  active
  closed
  expired
}

enum WorldModelTravelStatus {
  init
  pending
  running
  failed
  completed
}

model StoryProject {
  gameAssociations           IpGameAssociationRevision[]
  id                         String                      @id @default(uuid(7)) @db.Uuid
  workspaceId                String                      @map("workspace_id") @db.Uuid
  frameProfile               StoryFrameProfile           @map("frame_profile")
  durationPreset             StoryDurationPreset?        @map("duration_preset")
  /// Stable catalog slug shown to creators and carried over the wire.
  visualStyle                String?                     @map("visual_style") @db.VarChar(128)
  /// Immutable Skill identity pinned when the creative profile is confirmed.
  visualStyleSkillId         String?                     @map("visual_style_skill_id") @db.Uuid
  visualStyleSkillVersionId  String?                     @map("visual_style_skill_version_id") @db.Uuid
  creativeProfileConfirmedAt DateTime?                   @map("creative_profile_confirmed_at") @db.Timestamptz(6)
  status                     StoryProjectStatus          @default(active)
  visibility                 StoryVisibility             @default(private)
  title                      String                      @db.VarChar(160)
  summary                    String?                     @db.Text
  defaultLocale              String                      @default("en-US") @map("default_locale") @db.VarChar(16)
  coverAssetId               String?                     @map("cover_asset_id") @db.Uuid
  tags                       Json                        @default("[]") @db.JsonB
  /// Publication introduction draft. Review candidates freeze this together
  /// with title, locale and cover identity; public reads never consume it.
  storeListing               Json?                       @map("store_listing") @db.JsonB
  /// Creator-authored player styling; frozen into each Runtime Manifest at Build.
  appearance                 Json?                       @db.JsonB
  sourceIpId                 String?                     @map("source_ip_id") @db.Uuid
  nextBuildNumber            Int                         @default(1) @map("next_build_number")
  version                    Int                         @default(0)
  createdByUserId            String                      @map("created_by_user_id") @db.VarChar(64)
  archivedAt                 DateTime?                   @map("archived_at") @db.Timestamptz(6)
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace               Workspace                         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  linkedCrewAssetNodes    CrewAssetNode[]                   @relation("CrewAssetLinkedStoryProject")
  cover                   MediaAsset?                       @relation("StoryProjectCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  members                 StoryProjectMember[]
  invites                 StoryProjectInvite[]
  draft                   StoryDraft?
  studioDocuments         StudioDocument[]
  chapters                StoryChapter[]
  canvasLayouts           StoryCanvasLayout[]
  writeState              StoryProjectWriteState?
  agentRuns               StoryAgentRun[]
  revisions               StoryRevision[]
  builds                  StoryBuild[]
  experiencePublications  StoryExperiencePublication[]
  experienceDraftReleases StoryExperienceDraftRelease[]
  experienceGameReleases  StoryExperienceGameRelease[]
  referenceSlots          StoryReferenceSlot[]
  referenceVersions       StoryReferenceVersion[]
  videoBuildClips         StoryVideoBuildClip[]
  storyBuildAssets        StoryBuildAsset[]
  candidateAssets         StoryCandidateAsset[]
  assetSpecs              StoryAssetSpec[]
  assetMediaVersions      StoryAssetMediaVersion[]
  storyboardSequences     StoryStoryboardSequence[]
  storyboardClips         StoryStoryboardClip[]
  storyboardBindings      StoryStoryboardClipAssetBinding[]
  storyboardMediaVersions StoryStoryboardClipMediaVersion[]
  storyboardCues          StoryStoryboardCue[]
  productionGenerations   StoryProductionGeneration[]
  generationBatches       StoryGenerationBatch[]
  productionMutations     StoryProductionMutationReceipt[]
  productionPlanSnapshots StoryProductionPlanSnapshot[]
  chapterGraphRepairs     StoryChapterGraphRepair[]
  agentOsAttachments      AgentOsAttachment[]
  aiJobs                  AiJob[]
  skillState              ProjectSkillState?
  skillInstallations      ProjectSkillInstallation[]
  skillAudits             ProjectSkillAudit[]
  skillCatalogItems       SkillCatalogItem[]                @relation("SkillCatalogStoryProject")
  worldModelWorlds        WorldModelWorld[]
  worldModelSessions      WorldModelSession[]
  worldModelTravels       WorldModelTravel[]

  @@unique([id, workspaceId], map: "story_projects_id_workspace_unique")
  @@index([workspaceId, status, updatedAt(sort: Desc)], map: "story_projects_workspace_recent_idx")
  @@index([createdByUserId, status, updatedAt(sort: Desc)], map: "story_projects_creator_recent_idx")
  @@map("story_projects")
}

/// Durable provider-neutral world. Provider identifiers remain server-side;
/// clients address this row by its local UUID and receive only short-lived
/// connection material when entering a session.
model WorldModelWorld {
  id                 String                @id @default(uuid(7)) @db.Uuid
  workspaceId        String                @map("workspace_id") @db.Uuid
  storyProjectId     String                @map("story_project_id") @db.Uuid
  providerKey        String                @map("provider_key") @db.VarChar(128)
  providerWorldId    String                @map("provider_world_id") @db.VarChar(2048)
  /// Server-hashed identity for one logical paid create intent. Replaying the
  /// same client key returns this row and never calls the provider again.
  submissionKey      String?               @unique(map: "world_model_worlds_submission_key_unique") @map("submission_key") @db.VarChar(64)
  /// Canonical request hash prevents one idempotency key from being reused for
  /// different world definitions.
  requestFingerprint String?               @map("request_fingerprint") @db.VarChar(64)
  mode               String                @db.VarChar(32)
  status             WorldModelWorldStatus @default(generating)
  name               String?               @db.VarChar(160)
  prompt             String                @db.Text
  firstFrameUrl      String?               @map("first_frame_url") @db.VarChar(2048)
  request            Json                  @db.JsonB
  providerData       Json                  @default("{}") @map("provider_data") @db.JsonB
  errorCode          String?               @map("error_code") @db.VarChar(128)
  errorMessage       String?               @map("error_message") @db.Text
  createdByUserId    String                @map("created_by_user_id") @db.VarChar(64)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   StoryProject        @relation(fields: [storyProjectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sessions  WorldModelSession[]
  travels   WorldModelTravel[]

  @@unique([providerKey, providerWorldId], map: "world_model_worlds_provider_identity_unique")
  @@unique([id, storyProjectId, workspaceId], map: "world_model_worlds_project_identity_unique")
  @@index([storyProjectId, createdAt(sort: Desc)], map: "world_model_worlds_project_recent_idx")
  @@index([workspaceId, createdAt(sort: Desc)], map: "world_model_worlds_workspace_recent_idx")
  @@map("world_model_worlds")
}

model WorldModelSession {
  id                       String                  @id @default(uuid(7)) @db.Uuid
  workspaceId              String                  @map("workspace_id") @db.Uuid
  storyProjectId           String                  @map("story_project_id") @db.Uuid
  worldId                  String                  @map("world_id") @db.Uuid
  providerSessionId        String                  @unique @map("provider_session_id") @db.VarChar(2048)
  status                   WorldModelSessionStatus @default(active)
  heartbeatIntervalSeconds Float                   @map("heartbeat_interval_seconds")
  sessionTimeoutSeconds    Float                   @map("session_timeout_seconds")
  lastHeartbeatAt          DateTime                @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  expiresAt                DateTime                @map("expires_at") @db.Timestamptz(6)
  createdByUserId          String                  @map("created_by_user_id") @db.VarChar(64)
  closedAt                 DateTime?               @map("closed_at") @db.Timestamptz(6)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   StoryProject      @relation(fields: [storyProjectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  world     WorldModelWorld   @relation(fields: [worldId, storyProjectId, workspaceId], references: [id, storyProjectId, workspaceId], onDelete: Cascade)
  travel    WorldModelTravel?

  @@index([storyProjectId, status, createdAt(sort: Desc)], map: "world_model_sessions_project_status_idx")
  @@index([status, expiresAt], map: "world_model_sessions_expiry_idx")
  @@map("world_model_sessions")
}

model WorldModelTravel {
  id                String                 @id @default(uuid(7)) @db.Uuid
  workspaceId       String                 @map("workspace_id") @db.Uuid
  storyProjectId    String                 @map("story_project_id") @db.Uuid
  worldId           String                 @map("world_id") @db.Uuid
  sessionId         String                 @unique @map("session_id") @db.Uuid
  providerTravelId  String                 @unique @map("provider_travel_id") @db.VarChar(2048)
  status            WorldModelTravelStatus @default(init)
  rtcStatus         String?                @map("rtc_status") @db.VarChar(64)
  providerUpdatedAt DateTime?              @map("provider_updated_at") @db.Timestamptz(6)
  providerData      Json                   @default("{}") @map("provider_data") @db.JsonB
  artifactData      Json                   @default("{}") @map("artifact_data") @db.JsonB
  startedAt         DateTime?              @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?              @map("ended_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   StoryProject      @relation(fields: [storyProjectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  world     WorldModelWorld   @relation(fields: [worldId, storyProjectId, workspaceId], references: [id, storyProjectId, workspaceId], onDelete: Cascade)
  session   WorldModelSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([storyProjectId, status, createdAt(sort: Desc)], map: "world_model_travels_project_status_idx")
  @@index([worldId, createdAt(sort: Desc)], map: "world_model_travels_world_recent_idx")
  @@map("world_model_travels")
}

/// The single, durable serialization point for every human-authored project
/// write. The row is created with the project and never removed independently.
/// Agent execution claims it with a fencing token; human writes lock and inspect
/// this row inside the same transaction as their mutation.
model StoryProjectWriteState {
  storyProjectId   String    @id @map("story_project_id") @db.Uuid
  activeAgentRunId String?   @unique @map("active_agent_run_id") @db.Uuid
  fencingToken     BigInt    @default(0) @map("fencing_token")
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz(6)
  lockExpiresAt    DateTime? @map("lock_expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project        StoryProject   @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)
  activeAgentRun StoryAgentRun? @relation("StoryProjectActiveAgentRun", fields: [activeAgentRunId, storyProjectId], references: [id, storyProjectId], onDelete: Restrict)

  @@unique([activeAgentRunId, storyProjectId], map: "story_project_write_states_active_run_project_unique")
  @@index([lockExpiresAt], map: "story_project_write_states_expiry_idx")
  @@map("story_project_write_states")
}

/// Durable, project-shared record of one proposed or executed Story Agent
/// change. Conversation messages remain user-private; the validated proposal,
/// lifecycle, exact base/result revisions and undo material live here.
model StoryAgentRun {
  id                                 String                      @id @default(uuid(7)) @db.Uuid
  storyProjectId                     String                      @map("story_project_id") @db.Uuid
  storyChapterId                     String                      @map("story_chapter_id") @db.Uuid
  workspaceId                        String                      @map("workspace_id") @db.Uuid
  kind                               StoryAgentRunKind           @default(apply)
  status                             StoryAgentRunStatus         @default(proposed)
  initiatedByUserId                  String                      @map("initiated_by_user_id") @db.VarChar(64)
  initiatedBySessionId               String?                     @map("initiated_by_session_id") @db.VarChar(64)
  conversationId                     String?                     @map("conversation_id") @db.VarChar(180)
  /// Versioned decision contract. Existing rows are migrated to v1 and every
  /// newly-created run uses v2; only Agent-origin v2 rows participate in the
  /// durable approval continuation below.
  decisionContractVersion            Int                         @default(2) @map("decision_contract_version")
  /// Durable origin for an Agent OS external-job handoff. The migration
  /// enforces these five source fields as an all-or-none tuple.
  sourceAgentRunId                   String?                     @map("source_agent_run_id") @db.Uuid
  sourceAgentTurnId                  String?                     @map("source_agent_turn_id") @db.Uuid
  sourceAgentToolCallId              String?                     @map("source_agent_tool_call_id") @db.VarChar(256)
  sourceStartedMessage               String?                     @map("source_started_message") @db.Text
  sourceCompletionMessage            String?                     @map("source_completion_message") @db.Text
  sourceProposalReadyDeliveredAt     DateTime?                   @map("source_proposal_ready_delivered_at") @db.Timestamptz(6)
  /// Server-owned H5 authorization marker. The creator's prior Plot Continue
  /// permits this derived Asset proposal to apply without a second approval.
  sourceAutoAppliedAt                DateTime?                   @map("source_auto_applied_at") @db.Timestamptz(6)
  sourceTerminalDeliveredAt          DateTime?                   @map("source_terminal_delivered_at") @db.Timestamptz(6)
  sourceApprovalId                   String?                     @map("source_approval_id") @db.Uuid
  sourceApprovalResponseId           String?                     @map("source_approval_response_id") @db.Uuid
  sourceApprovalResponseText         String?                     @map("source_approval_response_text") @db.VarChar(300)
  sourceApprovalLocale               String?                     @map("source_approval_locale") @db.VarChar(16)
  sourceApprovalDecisionTurnId       String?                     @map("source_approval_decision_turn_id") @db.Uuid
  sourceApprovalDecision             StoryAgentProposalDecision? @map("source_approval_decision")
  sourceApprovalDecidedAt            DateTime?                   @map("source_approval_decided_at") @db.Timestamptz(6)
  sourceApprovalDecidedByUserId      String?                     @map("source_approval_decided_by_user_id") @db.VarChar(64)
  /// Legacy v1 terminal-delivery marker. V2 uses the proposal-ready and
  /// terminal markers independently so an approval pause is never terminal.
  sourceResultDeliveredAt            DateTime?                   @map("source_result_delivered_at") @db.Timestamptz(6)
  /// Cross-pod delivery claim for the Story -> Agent OS continuation outbox.
  /// All retry scheduling uses PostgreSQL time; a crashed pod simply loses this
  /// lease and another pod resumes the same deterministic continuation.
  sourceResultDeliveryAttempts       Int                         @default(0) @map("source_result_delivery_attempts")
  sourceResultDeliveryNextAttemptAt  DateTime?                   @map("source_result_delivery_next_attempt_at") @db.Timestamptz(6)
  sourceResultDeliveryLeaseOwner     String?                     @map("source_result_delivery_lease_owner") @db.VarChar(160)
  sourceResultDeliveryLeaseExpiresAt DateTime?                   @map("source_result_delivery_lease_expires_at") @db.Timestamptz(6)
  sourceResultDeliveryLastError      String?                     @map("source_result_delivery_last_error") @db.Text
  confirmedByUserId                  String?                     @map("confirmed_by_user_id") @db.VarChar(64)
  cancelledByUserId                  String?                     @map("cancelled_by_user_id") @db.VarChar(64)

  baseDraftRevision    Int  @map("base_draft_revision")
  baseLayoutRevision   Int  @map("base_layout_revision")
  resultDraftRevision  Int? @map("result_draft_revision")
  resultLayoutRevision Int? @map("result_layout_revision")

  proposal             Json    @db.JsonB
  beforeDraftSnapshot  Json?   @map("before_draft_snapshot") @db.JsonB
  beforeDraftHash      String? @map("before_draft_hash") @db.VarChar(64)
  afterDraftSnapshot   Json?   @map("after_draft_snapshot") @db.JsonB
  afterDraftHash       String? @map("after_draft_hash") @db.VarChar(64)
  beforeLayoutSnapshot Json?   @map("before_layout_snapshot") @db.JsonB
  beforeLayoutHash     String? @map("before_layout_hash") @db.VarChar(64)
  afterLayoutSnapshot  Json?   @map("after_layout_snapshot") @db.JsonB
  afterLayoutHash      String? @map("after_layout_hash") @db.VarChar(64)
  affectedNodeIds      Json    @default("[]") @map("affected_node_ids") @db.JsonB
  createdNodeIds       Json    @default("[]") @map("created_node_ids") @db.JsonB

  summary            String?                  @db.Text
  authoringAttempts  Int                      @default(0) @map("authoring_attempts")
  // Per-baton pipeline progress while status=authoring: an ordered array of
  // {key,status} the run-card renders as a stage checklist. Null outside the
  // authoring window. Intermediate stage products are NOT persisted — a lease
  // reclaim reruns the whole (bounded) pipeline.
  authoringStages    Json?                    @map("authoring_stages") @db.JsonB
  authoringMode      StoryAgentAuthoringMode? @map("authoring_mode")
  errorCode          String?                  @map("error_code") @db.VarChar(96)
  errorDetail        String?                  @map("error_detail") @db.Text
  idempotencyKey     String                   @unique @map("idempotency_key") @db.VarChar(240)
  requestFingerprint String                   @map("request_fingerprint") @db.VarChar(64)
  revertsRunId       String?                  @map("reverts_run_id") @db.Uuid

  fencingToken    BigInt?   @map("fencing_token")
  leaseOwner      String?   @map("lease_owner") @db.VarChar(160)
  leaseAcquiredAt DateTime? @map("lease_acquired_at") @db.Timestamptz(6)
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)

  proposedAt      DateTime  @default(now()) @map("proposed_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  applyingAt      DateTime? @map("applying_at") @db.Timestamptz(6)
  revealStartedAt DateTime? @map("reveal_started_at") @db.Timestamptz(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project                     StoryProject                        @relation(fields: [storyProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "story_agent_runs_project_scope_fkey")
  chapter                     StoryChapter                        @relation(fields: [storyChapterId, storyProjectId], references: [id, storyProjectId], onDelete: Restrict)
  activeWriteState            StoryProjectWriteState?             @relation("StoryProjectActiveAgentRun")
  revertsRun                  StoryAgentRun?                      @relation("StoryAgentRunUndo", fields: [revertsRunId], references: [id], onDelete: Restrict)
  undoRuns                    StoryAgentRun[]                     @relation("StoryAgentRunUndo")
  externalHandoffRegistration AgentOsExternalHandoffRegistration?

  @@unique([id, storyProjectId], map: "story_agent_runs_id_project_unique")
  @@unique([sourceApprovalResponseId], map: "story_agent_runs_source_approval_response_unique")
  @@unique([sourceAgentRunId, sourceApprovalId], map: "story_agent_runs_source_approval_unique")
  @@index([storyChapterId, status, createdAt(sort: Desc)], map: "story_agent_runs_chapter_status_recent_idx")
  @@index([storyProjectId, status, createdAt(sort: Desc)], map: "story_agent_runs_project_status_recent_idx")
  @@index([storyProjectId, kind, status, resultDraftRevision, resultLayoutRevision, completedAt(sort: Desc), id(sort: Desc)], map: "story_agent_runs_undo_head_idx")
  @@index([status, expiresAt, id], map: "story_agent_runs_proposal_expiry_idx")
  @@index([initiatedByUserId, createdAt(sort: Desc)], map: "story_agent_runs_initiator_recent_idx")
  @@index([revertsRunId], map: "story_agent_runs_reverts_idx")
  @@map("story_agent_runs")
}

model StoryChapter {
  id                          String    @id @default(uuid(7)) @db.Uuid
  storyProjectId              String    @map("story_project_id") @db.Uuid
  title                       String    @db.VarChar(160)
  rank                        Int
  nodeIds                     Json      @default("[]") @map("node_ids") @db.JsonB
  entryNodeId                 String?   @map("entry_node_id") @db.VarChar(120)
  /// Exact approved Script head from which this chapter's current graph was derived.
  /// Null is reserved for chapters that have not approved a screenplay yet.
  sourceScriptDocumentId      String?   @map("source_script_document_id") @db.Uuid
  sourceScriptVersionId       String?   @map("source_script_version_id") @db.Uuid
  sourceScriptSequence        Int?      @map("source_script_sequence")
  sourceScriptHash            String?   @map("source_script_hash") @db.VarChar(64)
  /// Exact approved Asset plan, including an intentionally empty plan. Null
  /// means the Asset Specs stage has not been approved for the current Script.
  approvedAssetPlanSnapshotId String?   @map("approved_asset_plan_snapshot_id") @db.Uuid
  createdByUserId             String    @map("created_by_user_id") @db.VarChar(64)
  archivedAt                  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project                   StoryProject                      @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)
  canvasLayout              StoryCanvasLayout?
  agentRuns                 StoryAgentRun[]
  documents                 StudioDocument[]
  sourceScriptDocument      StudioDocument?                   @relation("StoryChapterSourceScriptDocument", fields: [sourceScriptDocumentId], references: [id], onDelete: Restrict)
  sourceScriptVersion       StudioDocumentVersion?            @relation("StoryChapterSourceScriptVersion", fields: [sourceScriptVersionId, sourceScriptDocumentId], references: [id, documentId], onDelete: Restrict)
  approvedAssetPlanSnapshot StoryProductionPlanSnapshot?      @relation("StoryChapterApprovedAssetPlan", fields: [approvedAssetPlanSnapshotId, id, storyProjectId], references: [id, storyChapterId, storyProjectId], onDelete: NoAction)
  assetSpecs                StoryAssetSpec[]
  assetMediaVersions        StoryAssetMediaVersion[]
  storyboardSequences       StoryStoryboardSequence[]
  storyboardClips           StoryStoryboardClip[]
  storyboardBindings        StoryStoryboardClipAssetBinding[]
  storyboardMedia           StoryStoryboardClipMediaVersion[]
  storyboardCues            StoryStoryboardCue[]
  productionGenerations     StoryProductionGeneration[]
  generationBatches         StoryGenerationBatch[]
  productionMutations       StoryProductionMutationReceipt[]
  productionPlanSnapshots   StoryProductionPlanSnapshot[]

  @@unique([id, storyProjectId], map: "story_chapters_id_project_unique")
  @@index([storyProjectId, rank], map: "story_chapters_project_rank_idx")
  @@map("story_chapters")
}

model StoryCanvasLayout {
  storyChapterId     String   @id @map("story_chapter_id") @db.Uuid
  storyProjectId     String   @map("story_project_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  schemaVersion      String   @default("story-canvas-layout-v3") @map("schema_version") @db.VarChar(64)
  nodePositions      Json     @default("{}") @map("node_positions") @db.JsonB
  revision           Int      @default(0)
  updatedByUserId    String   @map("updated_by_user_id") @db.VarChar(64)
  updatedBySessionId String?  @map("updated_by_session_id") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  chapter StoryChapter @relation(fields: [storyChapterId, storyProjectId], references: [id, storyProjectId], onDelete: Cascade, map: "story_canvas_layouts_chapter_project_fkey")
  project StoryProject @relation(fields: [storyProjectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([storyChapterId, storyProjectId], map: "story_canvas_layouts_chapter_project_unique")
  @@index([storyProjectId, updatedAt(sort: Desc)], map: "story_canvas_layouts_project_recent_idx")
  @@index([workspaceId, updatedAt(sort: Desc)], map: "story_canvas_layouts_workspace_recent_idx")
  @@map("story_canvas_layouts")
}

model StoryProjectMember {
  id              String                   @id @default(uuid(7)) @db.Uuid
  storyProjectId  String                   @map("story_project_id") @db.Uuid
  userId          String                   @map("user_id") @db.VarChar(64)
  role            StoryProjectMemberRole
  status          StoryProjectMemberStatus @default(active)
  grantedByUserId String                   @map("granted_by_user_id") @db.VarChar(64)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt       DateTime?                @map("removed_at") @db.Timestamptz(6)

  project StoryProject @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)

  @@unique([storyProjectId, userId], map: "story_project_members_project_user_unique")
  @@index([userId, status], map: "story_project_members_user_status_idx")
  @@index([storyProjectId, status, role], map: "story_project_members_project_status_role_idx")
  @@map("story_project_members")
}

/// Shareable invite link for one Story project. Same bearer-token model as
/// ProjectInvite (only the sha256 is stored, multi-use until revoke/expiry),
/// but grants a StoryProjectMemberRole. Accepting also enrolls the recipient in
/// the owning workspace, which `story_project_member_workspace_guard` requires.
model StoryProjectInvite {
  id              String                   @id @default(uuid(7)) @db.Uuid
  storyProjectId  String                   @map("story_project_id") @db.Uuid
  role            StoryProjectMemberRole
  tokenHash       String                   @map("token_hash") @db.VarChar(128)
  status          StoryProjectInviteStatus @default(pending)
  invitedByUserId String                   @map("invited_by_user_id") @db.VarChar(64)
  acceptedAt      DateTime?                @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?                @map("revoked_at") @db.Timestamptz(6)
  expiresAt       DateTime?                @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  project StoryProject @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "story_project_invites_token_hash_unique")
  @@index([storyProjectId, status, createdAt(sort: Desc)], map: "story_project_invites_by_project_idx")
  @@map("story_project_invites")
}

model StoryDraft {
  id                 String   @id @default(uuid(7)) @db.Uuid
  storyProjectId     String   @unique @map("story_project_id") @db.Uuid
  schemaVersion      String   @map("schema_version") @db.VarChar(64)
  content            Json     @db.JsonB
  contentHash        String   @map("content_hash") @db.VarChar(64)
  revision           Int      @default(0)
  updatedByUserId    String   @map("updated_by_user_id") @db.VarChar(64)
  updatedBySessionId String?  @map("updated_by_session_id") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project StoryProject @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)

  @@map("story_drafts")
}

/// Immutable evidence for an automatic StoryDraft ↔ StoryChapter projection
/// repair. The before snapshot makes every ownership decision recoverable;
/// graph nodes and edges are never deleted or fabricated by the repair.
model StoryChapterGraphRepair {
  id                  String   @id @default(uuid(7)) @db.Uuid
  storyProjectId      String   @map("story_project_id") @db.Uuid
  trigger             String   @db.VarChar(64)
  repairFingerprint   String   @unique @map("repair_fingerprint") @db.VarChar(64)
  draftRevisionBefore Int      @map("draft_revision_before")
  draftRevisionAfter  Int      @map("draft_revision_after")
  beforeDraft         Json     @map("before_draft") @db.JsonB
  repairedDraft       Json     @map("repaired_draft") @db.JsonB
  beforeChapters      Json     @map("before_chapters") @db.JsonB
  repairedChapters    Json     @map("repaired_chapters") @db.JsonB
  issues              Json     @db.JsonB
  decisions           Json     @db.JsonB
  actorUserId         String?  @map("actor_user_id") @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project StoryProject @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)

  @@index([storyProjectId, createdAt(sort: Desc)], map: "story_chapter_graph_repairs_project_recent_idx")
  @@map("story_chapter_graph_repairs")
}

/// Project-level curation of durable media produced on the Story content
/// creation canvas. Membership is independent from canvas layout and groups;
/// Story nodes bind the durable mediaAssetId, never a canvas node id.
model StoryCandidateAsset {
  storyProjectId String   @map("story_project_id") @db.Uuid
  mediaAssetId   String   @map("media_asset_id") @db.Uuid
  addedByUserId  String   @map("added_by_user_id") @db.VarChar(64)
  addedAt        DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  project StoryProject @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)
  asset   MediaAsset   @relation("StoryCandidateAssetMedia", fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([storyProjectId, mediaAssetId])
  @@index([storyProjectId, addedAt(sort: Desc)], map: "story_candidate_assets_project_recent_idx")
  @@index([mediaAssetId], map: "story_candidate_assets_media_idx")
  @@map("story_candidate_assets")
}

/// Immutable record of an approved Asset plan used as the durable completion
/// marker, including the intentionally-empty plan case.
model StoryProductionPlanSnapshot {
  id                String   @id @default(uuid(7)) @db.Uuid
  storyProjectId    String   @map("story_project_id") @db.Uuid
  storyChapterId    String   @map("story_chapter_id") @db.Uuid
  sourceFingerprint String   @map("source_fingerprint") @db.VarChar(64)
  planFingerprint   String   @map("plan_fingerprint") @db.VarChar(64)
  productionPlan    Json     @map("production_plan") @db.JsonB
  createdByUserId   String   @map("created_by_user_id") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project                   StoryProject   @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)
  chapter                   StoryChapter   @relation(fields: [storyChapterId, storyProjectId], references: [id, storyProjectId], onDelete: Cascade)
  approvedAssetPlanChapters StoryChapter[] @relation("StoryChapterApprovedAssetPlan")

  @@unique([storyChapterId, planFingerprint], map: "story_production_plan_snapshots_chapter_fingerprint_unique")
  @@unique([id, storyChapterId, storyProjectId], map: "story_production_plan_snapshots_scope_unique")
  @@index([storyProjectId, storyChapterId, createdAt(sort: Desc)], map: "story_production_plan_snapshots_chapter_recent_idx")
  @@map("story_production_plan_snapshots")
}

/// Chapter-owned logical asset definition. This row is deliberately useful
/// while `selectedMediaVersionId` is null, which is what makes an empty asset
/// a stable @ reference for Storyboard clips.
model StoryAssetSpec {
  id                     String                    @id @default(uuid(7)) @db.Uuid
  storyProjectId         String                    @map("story_project_id") @db.Uuid
  storyChapterId         String                    @map("story_chapter_id") @db.Uuid
  stableKey              String                    @map("stable_key") @db.VarChar(120)
  kind                   StoryAssetSpecKind
  sourceCharacterId      String?                   @map("source_character_id") @db.VarChar(120)
  /// Optional relevance hints into the Script snapshot. These ids help the
  /// planner but never restrict where the asset may be used.
  sourceNodeIds          Json                      @map("source_node_ids") @db.JsonB
  name                   String                    @db.VarChar(240)
  description            String?                   @db.Text
  imagePrompt            String                    @map("image_prompt") @db.Text
  videoPrompt            String?                   @map("video_prompt") @db.Text
  negativePrompt         String?                   @map("negative_prompt") @db.Text
  generationConfig       Json                      @default("{}") @map("generation_config") @db.JsonB
  sourceFingerprint      String                    @map("source_fingerprint") @db.VarChar(64)
  status                 StoryProductionSpecStatus @default(current)
  version                Int                       @default(0)
  selectedMediaVersionId String?                   @map("selected_media_version_id") @db.Uuid
  userModifiedAt         DateTime?                 @map("user_modified_at") @db.Timestamptz(6)
  userModifiedByUserId   String?                   @map("user_modified_by_user_id") @db.VarChar(64)
  createdByUserId        String                    @map("created_by_user_id") @db.VarChar(64)
  lastPlannedAt          DateTime                  @default(now()) @map("last_planned_at") @db.Timestamptz(6)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project              StoryProject                      @relation(fields: [storyProjectId], references: [id], onDelete: Cascade)
  chapter              StoryChapter                      @relation(fields: [storyChapterId, storyProjectId], references: [id, storyProjectId], onDelete: Cascade)
  mediaVersions        StoryAssetMediaVersion[]          @relation("StoryAssetSpecMediaVersions")
  selectedMediaVersion StoryAssetMediaVersion?           @relation("StoryAssetSpecSelectedMediaVersion", fields: [selectedMediaVersionId, id, storyChapterId, storyProjectId], references: [id, assetSpecId, storyChapterId, storyProjectId], onDelete: NoAction)
  storyboardBindings   StoryStoryboardClipAssetBinding[]
  generations          StoryProductionGeneration[]

  @@unique([storyChapterId, stableKey], map: "story_asset_specs_chapter_key_unique")
  @@unique([id, storyChapterId, storyProjectId], map: "story_asset_specs_scope_unique")
  @@unique([selectedMediaVersionId, id, storyChapterId, storyProjectId], map: "story_asset_specs_selected_version_scope_unique")
  @@index([storyProjectId, storyChapterId, kind, status], map: "story_asset_specs_chapter_kind_status_idx")
  @@map("story_asset_specs")
}

/// One creative output for a StoryAssetSpec. The optional technical variant
