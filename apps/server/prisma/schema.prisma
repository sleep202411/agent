/// Pool-weight ledger for the community-membership creator-revenue pool. One
/// weighted row per member per episode per settlement month (dedup via unique).
/// Decoupled from access: a member is granted access once, but their monthly
/// views drive that month's pool share. Immutable settlement input (snapshot
/// fields, no FK) so re-settlement is reproducible.
model MemberViewEvent {
  id               String   @id @default(uuid(7)) @db.Uuid
  /// Viewer (community member) platform user id.
  userId           String   @map("user_id") @db.VarChar(64)
  ipId             String   @map("ip_id") @db.Uuid
  /// A view is always of an episode (FizzDragon IP content lives in episodes).
  episodeId        String   @map("episode_id") @db.Uuid
  /// IP owner snapshot — the pool beneficiary for this view.
  ownerUserId      String   @map("owner_user_id") @db.VarChar(64)
  /// The member_free_grant entitlement that authorized this view (audit).
  entitlementId    String?  @map("entitlement_id") @db.Uuid
  /// Settlement month snapshot, 'YYYY-MM', stamped at write time.
  settlementPeriod String   @map("settlement_period") @db.VarChar(7)
  /// NULL until the period is settled; set to the batch id on settlement.
  settledBatchId   String?  @map("settled_batch_id") @db.Uuid
  metadata         Json     @default("{}") @db.JsonB
  viewedAt         DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  @@unique([userId, episodeId, settlementPeriod], map: "member_view_events_user_episode_period_unique")
  @@index([settlementPeriod, settledBatchId], map: "member_view_events_period_settled_idx")
  @@index([ownerUserId, settlementPeriod], map: "member_view_events_owner_period_idx")
  @@map("member_view_events")
}

/// Audit envelope for one monthly community-membership pool settlement run.
/// The pool amount is supplied per run (admin/cron); distribution credits land
/// in IpRevenueLedgerEntry rows with sourceType=member_pool + settlementBatchId.
model MemberPoolSettlementBatch {
  id               String                @id @default(uuid(7)) @db.Uuid
  /// Settlement month 'YYYY-MM'.
  period           String                @map("period") @db.VarChar(7)
  /// Subscription-revenue pool for the month, in community-point minor units.
  poolAmount       BigInt                @map("pool_amount")
  /// Sum of qualifying view weights distributed across beneficiaries.
  totalWeight      BigInt                @default(0) @map("total_weight")
  beneficiaryCount Int                   @default(0) @map("beneficiary_count")
  status           MemberPoolBatchStatus @default(computing)
  metadata         Json                  @default("{}") @db.JsonB
  startedAt        DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  postedAt         DateTime?             @map("posted_at") @db.Timestamptz(6)

  @@unique([period], map: "member_pool_settlement_batches_period_unique")
  @@index([status, startedAt(sort: Desc)], map: "member_pool_settlement_batches_status_idx")
  @@map("member_pool_settlement_batches")
}

