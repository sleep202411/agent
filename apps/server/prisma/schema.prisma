enum AppPlatform {
  ios
  android
}

/// Mobile app version manifest — one row per release announcement, scoped to
/// this deployment's region (the CN cell announces the CN build). The newest
/// `active` row per platform wins. Managed from the admin-ui 应用发布 module.
model AppRelease {
  id               String      @id @default(uuid(7)) @db.Uuid
  platform         AppPlatform
  versionName      String      @map("version_name") @db.VarChar(32)
  versionCode      Int         @map("version_code")
  /// Where "update now" sends the user: direct APK URL or store page.
  downloadUrl      String      @map("download_url") @db.VarChar(1024)
  releaseNotes     String?     @map("release_notes") @db.VarChar(2000)
  /// Builds older than this code get a forced (non-dismissable) prompt.
  minSupportedCode Int?        @map("min_supported_code")
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // One row per (platform, versionCode) — a re-announce must edit the existing
  // row, not create a duplicate; keeps `latest()` deterministic.
  @@unique([platform, versionCode], map: "app_releases_platform_version_uq")
  @@index([platform, active, versionCode], map: "app_releases_platform_latest_idx")
  @@map("app_releases")
}

// ─────────────────────────────────────────────────────────────
// Copilot canonical conversation store (src/copilot/)
// ─────────────────────────────────────────────────────────────

enum CopilotConversationStatus {
  ready
  streaming
  failed
  aborted
  limit_exceeded
}

enum CopilotConversationMode {
  canvas
  story_canvas @map("story-canvas")
}

enum CopilotMessageRole {
  user
  assistant
}

enum CopilotTurnKind {
  user
  tool_continuation
}

enum CopilotQuotaChargeStatus {
  consume_pending
  charged
  refund_pending
  refunded
  settle_pending
  settled
}

/// Durable, server-authoritative metadata for one user's fixed project
/// conversation. PostgreSQL is the sole authority for both the transcript and
/// the short-lived fenced cross-pod admission lease.
model CopilotConversation {
  id                        String                    @id @default(uuid(7)) @db.Uuid
  userId                    String                    @map("user_id") @db.VarChar(64)
  conversationId            String                    @map("conversation_id") @db.VarChar(180)
  projectId                 String                    @map("project_id") @db.Uuid
  mode                      CopilotConversationMode
  selectedSkillKeys         Json                      @default("[]") @map("selected_skill_keys") @db.JsonB
  sessionId                 String                    @default(uuid(7)) @map("session_id") @db.Uuid
  billingOperationId        String                    @map("billing_operation_id") @db.Uuid
  billingChargeAttemptId    String                    @map("billing_charge_attempt_id") @db.Uuid
  revision                  Int                       @default(0)
  status                    CopilotConversationStatus @default(ready)
  messageCount              Int                       @default(0) @map("message_count")
  messageBytes              Int                       @default(0) @map("message_bytes")
  activeTurnId              String?                   @map("active_turn_id") @db.Uuid
  activeTurnKind            CopilotTurnKind?          @map("active_turn_kind")
  activeClaimToken          String?                   @map("active_claim_token") @db.Uuid
  activeRevision            Int?                      @map("active_revision")
  activeUserMessageId       String?                   @map("active_user_message_id") @db.VarChar(128)
  activeAdmissionToken      String?                   @map("active_admission_token") @db.Uuid
  activeAdmissionRevision   Int?                      @map("active_admission_revision")
  activeStartedAt           DateTime?                 @map("active_started_at") @db.Timestamptz(6)
  activeExpiresAt           DateTime?                 @map("active_expires_at") @db.Timestamptz(6)
  turnProposalUserMessageId String?                   @map("turn_proposal_user_message_id") @db.VarChar(128)
  turnProposal              Json?                     @map("turn_proposal") @db.JsonB
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages             CopilotMessage[]
  billingChargeAttempt CopilotQuotaChargeAttempt @relation(fields: [billingChargeAttemptId, billingOperationId, userId, conversationId, sessionId], references: [id, billingOperationId, userId, conversationId, sessionId], onDelete: Restrict)

  @@unique([userId, conversationId], map: "copilot_conversations_user_conversation_unique")
  @@unique([sessionId], map: "copilot_conversations_session_unique")
  @@unique([billingChargeAttemptId, billingOperationId, userId, conversationId, sessionId], map: "copilot_conversations_charge_attempt_scope_unique")
  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)], map: "copilot_conversations_user_updated_idx")
  @@map("copilot_conversations")
}

/// Durable quota transaction coordinator for one physical charge attempt.
/// A logical billing operation may have several generations after explicit
/// failed-attempt refunds. Redis idempotency is scoped to this row id, so a
/// late refund can never reverse a newer retry's charge.
model CopilotQuotaChargeAttempt {
  id                  String                   @id @db.Uuid
  billingOperationId  String                   @map("billing_operation_id") @db.Uuid
  generation          Int
  userId              String                   @map("user_id") @db.VarChar(64)
  conversationId      String                   @map("conversation_id") @db.VarChar(180)
  sessionId           String                   @map("session_id") @db.Uuid
  ownerTurnId         String                   @map("owner_turn_id") @db.Uuid
  /// Exact UTC counter windows used by the Redis debit. Refunds must target
  /// these persisted buckets instead of whatever day/month the worker runs in.
  dayBucket           String                   @map("day_bucket") @db.VarChar(10)
  monthBucket         String                   @map("month_bucket") @db.VarChar(7)
  tier                String?                  @db.VarChar(64)
  status              CopilotQuotaChargeStatus @default(consume_pending)
  refundReason        String?                  @map("refund_reason") @db.VarChar(16)
  clientToolExpiresAt DateTime?                @map("client_tool_expires_at") @db.Timestamptz(6)
  redisFinalizedAt    DateTime?                @map("redis_finalized_at") @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentConversation CopilotConversation?

  @@unique([billingOperationId, generation], map: "copilot_quota_charge_attempts_operation_generation_unique")
  @@unique([id, billingOperationId, userId, conversationId, sessionId], map: "copilot_quota_charge_attempts_canonical_identity_unique")
  @@index([status, updatedAt, id], map: "copilot_quota_charge_attempts_reconcile_idx")
  @@index([status, clientToolExpiresAt, id], map: "copilot_quota_charge_attempts_client_tool_expiry_idx")
  @@map("copilot_quota_charge_attempts")
}

/// Canonical UI messages. User rows are immutable; only the current assistant
/// tail may be monotonically completed/replaced by a fenced client-tool
/// continuation. Ordinal and message identity stay stable, and reset cascades.
model CopilotMessage {
  id             String             @id @default(uuid(7)) @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  ordinal        Int
  messageId      String             @map("message_id") @db.VarChar(128)
  role           CopilotMessageRole
  payload        Json               @db.JsonB
  byteSize       Int                @map("byte_size")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, ordinal], map: "copilot_messages_conversation_ordinal_unique")
  @@unique([conversationId, messageId], map: "copilot_messages_conversation_message_unique")
  @@map("copilot_messages")
}

/// One extracted document (script/outline) uploaded into a Copilot
/// conversation. Append-only: the text is extracted exactly once at upload and
/// referenced by message parts and authoring runs; rows are never mutated.
model CopilotDocument {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.VarChar(64)
  conversationId String   @map("conversation_id") @db.VarChar(180)
  name           String   @db.VarChar(255)
  mediaType      String   @map("media_type") @db.VarChar(128)
  sizeBytes      Int      @map("size_bytes")
  charCount      Int      @map("char_count")
  text           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "copilot_documents_user_conversation_idx")
  @@map("copilot_documents")
}

/// PostgreSQL-authoritative one-paid-stream-per-user lease. A released row is
/// retained so fencingRevision never moves backwards for that user.
model CopilotUserStreamState {
  userId          String    @id @map("user_id") @db.VarChar(64)
  claimToken      String?   @map("claim_token") @db.Uuid
  conversationId  String?   @map("conversation_id") @db.VarChar(180)
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  fencingRevision Int       @default(0) @map("fencing_revision")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("copilot_user_stream_states")
}

model CrewUploadReservation {
  cleanedAt  DateTime? @map("cleaned_at") @db.Timestamptz
  storageKey String    @id @map("storage_key")
  crewId     String    @map("crew_id")
  userId     String    @map("user_id") @db.VarChar(64)
  sizeBytes  BigInt    @map("size_bytes")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  state      String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  crew       Crew      @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@index([crewId, state, expiresAt], map: "crew_upload_reservations_capacity_idx")
  @@map("crew_upload_reservations")
}

/// A commitment belongs to one assignment incarnation; removing/readding a user
/// must never erase or reuse an earlier promise. Assignment ID is deliberately
/// not a foreign key because reassignment deletes CrewTaskAssignee rows.
model CrewTaskCommitment {
  id            String    @id @default(uuid(7)) @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  assignmentId  String    @unique @map("assignment_id") @db.Uuid
  userId        String    @map("user_id") @db.VarChar(64)
  status        String    @db.VarChar(20)
  promisedDueAt DateTime? @map("promised_due_at") @db.Timestamptz(6)
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(6)
  reason        String    @default("") @db.Text
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(6)
  handoverNote  String?   @map("handover_note") @db.Text
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  task          CrewTask  @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, acceptedAt])
  @@index([userId, acceptedAt])
  @@map("crew_task_commitments")
}

/// Project exit requests and completion recognition are retained even when
/// membership is removed. Completion rewards reference the existing wallet ledger.
model CrewParticipationRecord {
  id               String    @id @default(uuid(7)) @db.Uuid
  crewId           String    @map("crew_id")
  userId           String    @map("user_id") @db.VarChar(64)
  withdrawalAt     DateTime? @map("withdrawal_at") @db.Timestamptz(6)
  withdrawalReason String?   @map("withdrawal_reason") @db.Text
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId String?   @map("resolved_by_user_id") @db.VarChar(64)
  resolution       String?   @db.Text
  communityPoints  Int       @default(0) @map("community_points")
  awardedAt        DateTime? @map("awarded_at") @db.Timestamptz(6)
  awardedByUserId  String?   @map("awarded_by_user_id") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  crew             Crew      @relation(fields: [crewId], references: [id], onDelete: Restrict)

  @@unique([crewId, userId])
  @@index([userId, createdAt])
  @@map("crew_participation_records")
}

model CrewPeerFeedback {
  id            String    @id @default(uuid(7)) @db.Uuid
  crewId        String    @map("crew_id")
  authorUserId  String    @map("author_user_id") @db.VarChar(64)
  subjectUserId String    @map("subject_user_id") @db.VarChar(64)
  rating        Int
  comment       String    @db.Text
  response      String?   @db.Text
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  crew          Crew      @relation(fields: [crewId], references: [id], onDelete: Restrict)

  @@unique([crewId, authorUserId, subjectUserId])
  @@index([subjectUserId, createdAt])
  @@map("crew_peer_feedback")
}

/// Selected task delivery destination; accepted files are published here on review.
model CrewTaskDeliveryFolder {
