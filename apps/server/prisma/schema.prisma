  mobileImageAsset MediaAsset? @relation("IpDiscoveryMobileImageAsset", fields: [mobileImageAssetId], references: [id], onDelete: SetNull)
  trailerAsset     MediaAsset? @relation("IpDiscoveryTrailerMediaAsset", fields: [trailerAssetId], references: [id], onDelete: SetNull)

  localizations IpDiscoveryRecommendationLocalization[]

  @@index([placementKey, status, startsAt, sortOrder], map: "ip_discovery_recs_lookup_idx")
  @@index([ipId], map: "ip_discovery_recs_ip_idx")
  @@index([status, updatedAt(sort: Desc)], map: "ip_discovery_recs_status_recent_idx")
  @@map("ip_discovery_recommendations")
}

model IpDiscoveryRecommendationLocalization {
  id               String   @id @default(uuid(7)) @db.Uuid
  recommendationId String   @map("recommendation_id") @db.Uuid
  locale           String   @db.VarChar(16)
  eyebrow          String?  @db.VarChar(80)
  title            String?  @db.VarChar(160)
  description      String?  @db.VarChar(500)
  ctaLabel         String?  @map("cta_label") @db.VarChar(80)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  recommendation IpDiscoveryRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
