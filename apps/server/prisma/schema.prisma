model BillingLedgerJournal {
  id               String                     @id @default(uuid(7)) @db.Uuid
  /// Human-readable journal number. The idempotency key is the real duplicate
  /// guard for posting.
  journalNo        String                     @map("journal_no") @db.VarChar(64)
  journalType      BillingLedgerJournalType   @map("journal_type")
  status           BillingLedgerJournalStatus @default(posted)
  sourceType       String                     @map("source_type") @db.VarChar(80)
  sourceId         String?                    @map("source_id") @db.VarChar(128)
  /// Immutable posting idempotency key. All retries for the same business event
  /// must reuse this key.
  idempotencyKey   String                     @map("idempotency_key") @db.VarChar(180)
  provider         PaymentProvider?
  currency         String                     @db.Char(3)
  orderId          String?                    @map("order_id") @db.Uuid
  paymentIntentId  String?                    @map("payment_intent_id") @db.Uuid
  refundId         String?                    @map("refund_id") @db.Uuid
  providerEventId  String?                    @map("provider_event_id") @db.Uuid
  settlementId     String?                    @map("settlement_id") @db.Uuid
  /// Reversal target. Do not delete or mutate the original posted journal.
  reversalOfId     String?                    @map("reversal_of_id") @db.Uuid
  /// Debits and credits must always be equal.
  totalDebitMinor  BigInt                     @map("total_debit_minor")
  totalCreditMinor BigInt                     @map("total_credit_minor")
  description      String?                    @db.VarChar(255)
  metadata         Json                       @default("{}") @db.JsonB
  postedAt         DateTime                   @default(now()) @map("posted_at") @db.Timestamptz(6)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  order         BillingOrder?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentIntent BillingPaymentIntent?        @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  refund        BillingRefund?               @relation(fields: [refundId], references: [id], onDelete: SetNull)
  providerEvent BillingPaymentProviderEvent? @relation(fields: [providerEventId], references: [id], onDelete: SetNull)
  settlement    BillingSettlement?           @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  reversalOf    BillingLedgerJournal?        @relation("BillingLedgerReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals     BillingLedgerJournal[]       @relation("BillingLedgerReversal")
  entries       BillingLedgerEntry[]

  @@unique([journalNo], map: "billing_ledger_journals_no_unique")
  @@unique([idempotencyKey], map: "billing_ledger_journals_idempotency_unique")
  @@index([journalType, postedAt(sort: Desc)], map: "billing_ledger_journals_type_recent_idx")
  @@index([sourceType, sourceId], map: "billing_ledger_journals_source_idx")
  @@index([orderId, postedAt(sort: Desc)], map: "billing_ledger_journals_order_recent_idx")
  @@index([refundId, postedAt(sort: Desc)], map: "billing_ledger_journals_refund_recent_idx")
  @@index([provider, postedAt(sort: Desc)], map: "billing_ledger_journals_provider_recent_idx")
  @@index([settlementId], map: "billing_ledger_journals_settlement_idx")
  @@map("billing_ledger_journals")
}

