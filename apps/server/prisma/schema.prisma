// ─────────────────────────────────────────────────────────────
// Admin domain (src/admin-auth/)
// ─────────────────────────────────────────────────────────────
//
// Internal operators are not consumer users. Admin access is isolated to
// Nest + Postgres with explicit roles, permissions, httpOnly sessions,
// and audit events. The admin UI may point at either production cell,
// but each cell owns its own admin users and permissions.

model AdminUser {
  id                String          @id @default(uuid(7)) @db.Uuid
  email             String          @unique @db.VarChar(320)
  displayName       String          @map("display_name") @db.VarChar(120)
  avatarUrl         String?         @map("avatar_url") @db.VarChar(512)
  passwordHash      String?         @map("password_hash") @db.VarChar(255)
  status            AdminUserStatus @default(invited)
  siteScope         AdminSiteScope  @default(all) @map("site_scope")
  requireMfa        Boolean         @default(false) @map("require_mfa")
  mfaSecretHash     String?         @map("mfa_secret_hash") @db.VarChar(255)
  mfaEnabledAt      DateTime?       @map("mfa_enabled_at") @db.Timestamptz(6)
  failedLoginCount  Int             @default(0) @map("failed_login_count")
  lockedUntil       DateTime?       @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?       @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?       @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt        DateTime?       @map("disabled_at") @db.Timestamptz(6)

  roles           AdminUserRole[]
  sessions        AdminSession[]
  passwordHistory AdminPasswordHistory[]
  mfaChallenges   AdminMfaChallenge[]
  loginAttempts   AdminLoginAttempt[]
  auditLogs       AdminAuditLog[]        @relation("AdminAuditActor")

  @@index([status, updatedAt(sort: Desc)], map: "admin_users_status_recent_idx")
  @@index([siteScope, status], map: "admin_users_site_scope_idx")
  @@index([lockedUntil], map: "admin_users_locked_until_idx")
  @@map("admin_users")
}

model AdminRole {
  id          String         @id @default(uuid(7)) @db.Uuid
  key         String         @unique @db.VarChar(80)
  name        String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  siteScope   AdminSiteScope @default(all) @map("site_scope")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       AdminUserRole[]
  permissions AdminRolePermission[]

  @@index([siteScope], map: "admin_roles_site_scope_idx")
  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminUserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "admin_user_roles_role_idx")
  @@map("admin_user_roles")
}

model AdminRolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "admin_role_permissions_permission_idx")
  @@map("admin_role_permissions")
}

model AdminSession {
  id         String             @id @default(uuid(7)) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  tokenHash  String             @unique @map("token_hash") @db.VarChar(128)
  status     AdminSessionStatus @default(active)
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime           @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime?          @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?            @map("ip_address") @db.VarChar(64)
  userAgent  String?            @map("user_agent") @db.VarChar(512)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user      AdminUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AdminAuditLog[]

  @@index([userId, status, expiresAt], map: "admin_sessions_user_status_idx")
  @@index([expiresAt, status], map: "admin_sessions_expiry_idx")
  @@map("admin_sessions")
}

model AdminPasswordHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "admin_password_history_user_recent_idx")
  @@map("admin_password_history")
}

model AdminMfaChallenge {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(128)
  purpose         String    @db.VarChar(32)
  secretEncrypted String?   @map("secret_encrypted") @db.VarChar(255)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipAddress       String?   @map("ip_address") @db.VarChar(64)
  userAgent       String?   @map("user_agent") @db.VarChar(512)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt], map: "admin_mfa_challenges_user_idx")
  @@index([expiresAt, consumedAt], map: "admin_mfa_challenges_expiry_idx")
  @@map("admin_mfa_challenges")
}

model AdminLoginAttempt {
  id        String                   @id @default(uuid(7)) @db.Uuid
  email     String                   @db.VarChar(320)
  userId    String?                  @map("user_id") @db.Uuid
  outcome   AdminLoginAttemptOutcome
  reason    String?                  @db.VarChar(255)
  ipAddress String?                  @map("ip_address") @db.VarChar(64)
  userAgent String?                  @map("user_agent") @db.VarChar(512)
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, outcome, createdAt(sort: Desc)], map: "admin_login_attempts_email_idx")
  @@index([ipAddress, outcome, createdAt(sort: Desc)], map: "admin_login_attempts_ip_idx")
  @@index([userId, createdAt(sort: Desc)], map: "admin_login_attempts_user_idx")
  @@map("admin_login_attempts")
}

model AdminAuditLog {
  id             String            @id @default(uuid(7)) @db.Uuid
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  actorSessionId String?           @map("actor_session_id") @db.Uuid
  siteScope      AdminSiteScope    @default(all) @map("site_scope")
  action         String            @db.VarChar(120)
  resourceType   String            @map("resource_type") @db.VarChar(80)
  resourceId     String?           @map("resource_id") @db.VarChar(128)
  outcome        AdminAuditOutcome @default(success)
  reason         String?           @db.VarChar(1000)
  ipAddress      String?           @map("ip_address") @db.VarChar(64)
  userAgent      String?           @map("user_agent") @db.VarChar(512)
  before         Json?             @db.JsonB
  after          Json?             @db.JsonB
  metadata       Json              @default("{}") @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  actor   AdminUser?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  session AdminSession? @relation(fields: [actorSessionId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)], map: "admin_audit_actor_recent_idx")
  @@index([action, createdAt(sort: Desc)], map: "admin_audit_action_recent_idx")
  @@index([resourceType, resourceId, createdAt(sort: Desc)], map: "admin_audit_resource_recent_idx")
  @@index([outcome, createdAt(sort: Desc)], map: "admin_audit_outcome_recent_idx")
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────────────────────────
// IP Commerce domain (src/ip-commerce/)
// ─────────────────────────────────────────────────────────────
//
// New source of truth for IP as a creator-owned production nucleus:
// profile, localization, media assets, episode commerce, community-point
// purchases, presale campaigns, referral attribution, review, rights
// declarations, reports, and moderation. It is deliberately not tied to
// workspace, project, crew, gig, or legacy Java tables. Future studio
// projects, crews, and gigs should attach through explicit integration/link
// tables rather than polluting the IP root.
//
// Money movement invariant:
//   IpPurchaseOrder -> WalletTransaction -> IpContentEntitlement
//
// No service is allowed to unlock content by directly mutating an IP
// row. Unlock state is always derived from entitlements and wallet
// ledger history.

model SupportedLocale {
  code         String                @id @db.VarChar(16)
  status       SupportedLocaleStatus @default(active)
  displayName  String                @map("display_name") @db.VarChar(80)
  nativeName   String                @map("native_name") @db.VarChar(80)
  displayOrder Int                   @default(0) @map("display_order")
  metadata     Json                  @default("{}") @db.JsonB
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ipsAsSource                          Ip[]                                    @relation("IpSourceLocale")
  taxonomyTermLocalizations            IpTaxonomyTermLocalization[]            @relation("IpTaxonomyTermLocalizationLocale")
  ipLocalizations                      IpLocalization[]                        @relation("IpLocalizationLocale")
  ipLocalizationsTranslatedFrom        IpLocalization[]                        @relation("IpLocalizationTranslatedFromLocale")
  episodeLocalizations                 IpEpisodeLocalization[]                 @relation("IpEpisodeLocalizationLocale")
  episodeLocalizationsTranslatedFrom   IpEpisodeLocalization[]                 @relation("IpEpisodeLocalizationTranslatedFromLocale")
  campaignLocalizations                IpCampaignLocalization[]                @relation("IpCampaignLocalizationLocale")
  campaignLocalizationsTranslatedFrom  IpCampaignLocalization[]                @relation("IpCampaignLocalizationTranslatedFromLocale")
  discoveryRecommendationLocalizations IpDiscoveryRecommendationLocalization[] @relation("IpDiscoveryRecommendationLocalizationLocale")
  translationJobsAsSource              IpTranslationJob[]                      @relation("IpTranslationJobSourceLocale")
  translationJobsAsTarget              IpTranslationJob[]                      @relation("IpTranslationJobTargetLocale")

  @@index([status, displayOrder], map: "supported_locales_status_order_idx")
  @@map("supported_locales")
}

model Ip {
  id                     String              @id @default(uuid(7)) @db.Uuid
  status                 IpPublicationStatus @default(draft)
  listingVisibility      IpListingVisibility @default(private) @map("listing_visibility")
  ageRating              IpAgeRating         @default(general) @map("age_rating")
  sourceLocale           String              @default("zh-CN") @map("source_locale") @db.VarChar(16)
  copyrightOwner         String?             @map("copyright_owner") @db.VarChar(160)
  rightsSummary          Json                @default("{}") @map("rights_summary") @db.JsonB
  aiDisclosure           Json                @default("{}") @map("ai_disclosure") @db.JsonB
  coverAssetId           String?             @map("cover_asset_id") @db.Uuid
  trailerAssetId         String?             @map("trailer_asset_id") @db.Uuid
  createdById            String              @map("created_by_id") @db.VarChar(64)
  updatedById            String?             @map("updated_by_id") @db.VarChar(64)
  /// Per-IP override of the platform-vs-creator revenue split, in basis points
  /// (0..10000) of each sale that goes to the creator pool. NULL inherits the
  /// global default (ip_commerce_settings key `ip.creator_revenue_share_bps`).
  creatorRevenueShareBps Int?                @map("creator_revenue_share_bps")
  version                Int                 @default(0)
  scheduledAt            DateTime?           @map("scheduled_at") @db.Timestamptz(6)
  publishedAt            DateTime?           @map("published_at") @db.Timestamptz(6)
  suspendedAt            DateTime?           @map("suspended_at") @db.Timestamptz(6)
  archivedAt             DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz(6)

  coverAsset      MediaAsset?     @relation("IpCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  trailerAsset    MediaAsset?     @relation("IpTrailerAsset", fields: [trailerAssetId], references: [id], onDelete: SetNull)
  sourceLocaleRef SupportedLocale @relation("IpSourceLocale", fields: [sourceLocale], references: [code], onDelete: Restrict)

  localizations            IpLocalization[]
  taxonomyAssignments      IpTaxonomyAssignment[]
  episodes                 IpEpisode[]
  assets                   IpAsset[]
  discoveryRecommendations IpDiscoveryRecommendation[]
  campaigns                IpCampaign[]
  priceRules               IpPriceRule[]
  purchaseOrders           IpPurchaseOrder[]
  entitlements             IpContentEntitlement[]
  collectionItems          IpCollectionItem[]
  contributors             IpContributor[]
  referralLinks            IpReferralLink[]
  referralAttributions     IpReferralAttribution[]
  revenueLedgerEntries     IpRevenueLedgerEntry[]
  reviewSubmissions        IpReviewSubmission[]
  rightsDeclarations       IpRightsDeclaration[]
  reports                  IpContentReport[]
  userBlocks               IpUserContentBlock[]

  /// Public slug uniqueness is locale-aware and enforced on
  /// IpLocalization by partial unique SQL.
  @@index([createdById, status, updatedAt(sort: Desc)], map: "ips_creator_recent_idx")
  @@index([status, listingVisibility, publishedAt(sort: Desc)], map: "ips_public_feed_idx")
  @@map("ips")
}

model IpTaxonomyTerm {
  id           String               @id @default(uuid(7)) @db.Uuid
  type         IpTaxonomyTermType
  code         String               @db.VarChar(80)
  status       IpTaxonomyTermStatus @default(active)
  displayOrder Int                  @default(0) @map("display_order")
  metadata     Json                 @default("{}") @db.JsonB
  createdById  String?              @map("created_by_id") @db.VarChar(64)
  updatedById  String?              @map("updated_by_id") @db.VarChar(64)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime?            @map("archived_at") @db.Timestamptz(6)

  localizations IpTaxonomyTermLocalization[]
  assignments   IpTaxonomyAssignment[]

  @@unique([type, code], map: "ip_taxonomy_terms_type_code_unique")
  @@index([type, status, displayOrder], map: "ip_taxonomy_terms_type_status_order_idx")
  @@map("ip_taxonomy_terms")
}

model IpTaxonomyTermLocalization {
  id          String   @id @default(uuid(7)) @db.Uuid
  termId      String   @map("term_id") @db.Uuid
  locale      String   @db.VarChar(16)
  label       String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  aliases     String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  term      IpTaxonomyTerm  @relation(fields: [termId], references: [id], onDelete: Cascade)
  localeRef SupportedLocale @relation("IpTaxonomyTermLocalizationLocale", fields: [locale], references: [code], onDelete: Restrict)

  @@unique([termId, locale], map: "ip_taxonomy_term_l10n_term_locale_unique")
  @@index([locale, label], map: "ip_taxonomy_term_l10n_locale_label_idx")
  @@map("ip_taxonomy_term_localizations")
}

model IpTaxonomyAssignment {
  id           String                     @id @default(uuid(7)) @db.Uuid
  ipId         String                     @map("ip_id") @db.Uuid
  termId       String                     @map("term_id") @db.Uuid
  source       IpTaxonomyAssignmentSource @default(creator)
  displayOrder Int                        @default(0) @map("display_order")
  metadata     Json                       @default("{}") @db.JsonB
  createdById  String?                    @map("created_by_id") @db.VarChar(64)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  ip   Ip             @relation(fields: [ipId], references: [id], onDelete: Cascade)
  term IpTaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([ipId, termId], map: "ip_taxonomy_assignments_ip_term_unique")
  @@index([ipId, displayOrder], map: "ip_taxonomy_assignments_ip_order_idx")
  @@index([termId, ipId], map: "ip_taxonomy_assignments_term_ip_idx")
  @@map("ip_taxonomy_assignments")
}

model IpAsset {
  id           String         @id @default(uuid(7)) @db.Uuid
  ipId         String         @map("ip_id") @db.Uuid
  mediaAssetId String         @map("media_asset_id") @db.Uuid
  purpose      IpAssetPurpose @default(source_material)
  title        String?        @db.VarChar(160)
  description  String?        @db.Text
  displayOrder Int            @default(0) @map("display_order")
  createdById  String         @map("created_by_id") @db.VarChar(64)
  updatedById  String?        @map("updated_by_id") @db.VarChar(64)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  removedAt    DateTime?      @map("removed_at") @db.Timestamptz(6)

  ip         Ip         @relation(fields: [ipId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation("IpLibraryMediaAsset", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([ipId, mediaAssetId], map: "ip_assets_ip_media_unique")
  @@index([ipId, purpose, createdAt(sort: Desc)], map: "ip_assets_ip_purpose_recent_idx")
  @@index([mediaAssetId], map: "ip_assets_media_idx")
  @@map("ip_assets")
}

model IpDiscoveryRecommendation {
  id                 String                          @id @default(uuid(7)) @db.Uuid
  placementKey       IpDiscoveryPlacementKey         @map("placement_key")
  ipId               String                          @map("ip_id") @db.Uuid
