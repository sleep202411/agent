  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  task            CrewTask                @relation(fields: [taskId, crewId], references: [id, crewId], onDelete: Cascade, map: "crew_task_delivery_folder_task_fk")
  folder          CrewAssetNode           @relation(fields: [folderId, crewId], references: [id, crewId], onDelete: Restrict, map: "crew_task_delivery_folder_node_fk")
  assets          CrewTaskDeliveryAsset[]

  @@unique([taskId, crewId], map: "crew_task_delivery_folders_task_crew_unique")
  @@index([folderId], map: "crew_task_delivery_folders_node_idx")
  @@map("crew_task_delivery_folders")
}

model CrewTaskDeliveryAsset {
  taskId      String                 @map("task_id") @db.Uuid
  crewId      String                 @map("crew_id")
  assetNodeId String                 @map("asset_node_id") @db.Uuid
