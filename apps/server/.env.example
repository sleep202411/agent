# ============ Java Backend ============
JAVA_STUDIO_URL=http://120.26.152.164:8090
JAVA_CONTENT_URL=http://120.26.152.164:8091
# Shared-secret guard on /user/query/user. Get value from the Java team.
JAVA_USER_QUERY_PWD=

# ============ AI ============
ALIBABA_API_KEY=sk-xxx
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ Agent User Runner ============
# Off by default. Turn on only after agent personas/policies are configured.
AGENT_USER_RUNNER_ENABLED=false
# AGENT_USER_RUNNER_MODEL=qwen3.6-plus
# AGENT_USER_RUNNER_INTERVAL_MS=300000
# AGENT_USER_RUNNER_MIN_RUN_SPACING_MINUTES=60
# AGENT_USER_RUNNER_MAX_AGENTS_PER_TICK=3
# AGENT_USER_RUNNER_MAX_ACTIONS_PER_RUN=3
# AGENT_USER_RUNNER_CANDIDATE_LIMIT=12
# AGENT_USER_RUNNER_RUN_ON_BOOT=false

# Provider: fal.ai. Local dev keys still consume real fal credits.
FAL_ENABLED=false
FAL_API_KEY=

# Provider: BytePlus ModelArk. Keep real API keys in deployment secrets or
# local .env; never commit them.
BYTEPLUS_MODELARK_ENABLED=false
BYTEPLUS_MODELARK_API_KEY=
# BYTEPLUS_MODELARK_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# BYTEPLUS_MODELARK_REQUEST_TIMEOUT_MS=300000
# BYTEPLUS_MODELARK_CATALOG_REFRESH_MS=900000

# ---- Characters (角色库) ----
# CHARACTERS_ENABLED is an operational kill switch (default on). The
# real-person likeness track stays OFF until the ModelArk assets plane
# below is fully configured — the server refuses to boot with the flag on
# and any required key missing (required-env-fails-loud).
# CHARACTERS_ENABLED=true
CHARACTERS_REAL_PERSON_ENABLED=false
# AIGC digital-human registration for VIRTUAL characters — eager-registers
# each virtual character image as a ModelArk AIGC asset so its reference
# passes Seedance's real-person risk control. Needs the same assets plane
# (AK/SK + ACR expiry) as real_person, but NOT the enrollment token.
CHARACTERS_AIGC_REGISTRATION_ENABLED=false
# Canvas MediaAsset image registration — registers generated/uploaded canvas
# images directly as ModelArk AIGC assets without a Character wrapper. Needs
# the same assets plane (AK/SK + ACR expiry).
MEDIA_ASSET_AIGC_REGISTRATION_ENABLED=false
# ModelArk ASSETS plane (asset groups / liveness verification) — signed
# Action API with its OWN AK/SK, separate from the Bearer inference key.
BYTEPLUS_ASSETS_AK=
BYTEPLUS_ASSETS_SK=
# BYTEPLUS_ASSETS_PROJECT=default
# BYTEPLUS_ASSETS_ENDPOINT=https://ark.ap-southeast-1.byteplusapi.com
# BYTEPLUS_ASSETS_REGION=ap-southeast-1
# CreateAsset content pre-filter strategy. Skip reduces upstream false-positive
# asset rejections; set Default to restore stricter provider pre-review.
BYTEPLUS_ASSETS_MODERATION_STRATEGY=Skip
# ACR subscription expiry (ISO date) — monitored config, REQUIRED when
# real_person is enabled (no upstream API exposes it; §6.1 lifecycle).
BYTEPLUS_ACR_EXPIRES_AT=
# base64 32-byte AES-256-GCM key for enrollment vendor tokens
# (openssl rand -base64 32).
CHARACTER_ENROLLMENT_TOKEN_KEY=

# Server alerting: Feishu custom bot. Keep the real webhook/secret in
# deployment secrets or local .env; never commit them.
FEISHU_ALERT_ENABLED=true
FEISHU_ALERT_WEBHOOK_URL=
# FEISHU_ALERT_SECRET=
# FEISHU_ALERT_ENV=production
# FEISHU_ALERT_DEDUP_TTL_SECONDS=300
# FEISHU_ALERT_TIMEOUT_MS=5000

# Provider: Alibaba Cloud Model Studio / Bailian. Singapore uses a
# workspace endpoint; set BAILIAN_WORKSPACE_ID or override BAILIAN_API_BASE_URL.
BAILIAN_ENABLED=false
BAILIAN_REGION=ap-southeast-1
BAILIAN_WORKSPACE_ID=
DASHSCOPE_API_KEY=
# BAILIAN_API_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/api/v1
# Optional comma-separated endpoint ids, e.g. qwen-image-plus,wan2.7-r2v.
# BAILIAN_MODEL_ALLOWLIST=
# Optional JSON array overriding the built-in provider catalog.
# BAILIAN_MODEL_CONFIGS=[{"endpointId":"wan2.7-r2v","service":"video-synthesis","type":"video"}]
# BAILIAN_IMAGE_GLOBAL_CONCURRENCY=12
# BAILIAN_VIDEO_GLOBAL_CONCURRENCY=4
# BAILIAN_PER_USER_IMAGE_RUNNING=2
# BAILIAN_PER_USER_VIDEO_RUNNING=1
# BAILIAN_PER_USER_QUEUED_TOTAL=10
# BAILIAN_POLL_DELAY_MS=6000
# BAILIAN_CATALOG_REFRESH_MS=900000

# Reference-image SSRF allowlist (comma-separated hostname suffixes).
# Adapters fetching user-supplied reference URLs (e.g. Foundry images.edit)
# only allow hosts whose name ends with one of these suffixes. Defaults to
# our Aliyun OSS + Azure Blob CDN if unset. Localhost is always permitted
# when NODE_ENV != production.
# REFERENCE_FETCH_ALLOWED_HOSTS=.aliyuncs.com,.blob.core.windows.net,.azureedge.net

# ============ Auth ============
# Set to "true" to skip auth in local dev (Java user/info API unreachable)
AUTH_DISABLED=true

# ============ Studio Copilot ============
# Hours a paid assistant response may wait for browser-executed tool results.
# Defaults to 24; when set, it must be a whole number from 1 to 168.
# COPILOT_CLIENT_TOOL_WAIT_TTL_HOURS=24
# Chat model for the copilot conversation (default qwen3.6-plus).
# COPILOT_MODEL=qwen3.6-plus
# Model for the Story Patch author (structured-output authoring of canvas
# proposals). MUST support non-streaming structured output on the configured
# ALIBABA_BASE_URL endpoint — qwen reasoning models (qwen3.6-plus) reject it.
# Default: qwen3-max.
# STORY_AGENT_AUTHOR_MODEL=qwen3-max

# ============ Azure Web PubSub (realtime push) ============
# Resource: fizzdragon-realtime. Hubs: entity / chat (Java) / assets (Nest).
AZURE_WEB_PUBSUB_CONNECTION_STRING=

# ============ Azure Blob Storage (output persistence + intl uploads) ============
# Container must already exist. For public URL flow, set the container's
# anonymous access level to "Blob (anonymous read)" — otherwise use the
# SAS upgrade path (see AzureBlobStorageService).
#
# DIRECT-TO-STORAGE UPLOADS (intl cell = com/global): the Nest server
# mints a write-scoped SAS (BlobSASPermissions 'cw') and the browser PUTs
# bytes straight to this container. The connection string's account key is
# the SAS signing credential — no extra env var needed. The container MUST
# have CORS allowing PUT with headers `x-ms-blob-type` + `content-type`
# from the web origin(s); failing CORS is a deploy-config bug, caught in
# the staging smoke test.
AZURE_BLOB_CONNECTION_STRING=
# Public-read container for media. Public assets are served as direct
# (cacheable) URLs; a moderation takedown makes a blocked object unreachable at
# the storage layer (move to quarantine) plus a CDN purge.
AZURE_BLOB_CONTAINER=
# Optional — Azure account region, persisted to MediaAsset.region for audit.
# Azure read URLs derive the region from the account host, so this is
# informational only and may be left blank.
# AZURE_BLOB_REGION=eastus2
# Private container blocked objects are moved into on takedown (Azure has no
# per-blob ACL). Defaults to `${AZURE_BLOB_CONTAINER}-quarantine`, created on
# demand. MUST NOT allow public read.
# AZURE_BLOB_QUARANTINE_CONTAINER=foundry-outputs-quarantine
# Optional CDN / custom domain for direct public read URLs.
# AZURE_BLOB_PUBLIC_BASE_URL=https://cdn.fizzdragon.com

# ============ Alibaba OSS (CN cell uploads + output persistence) ============
# Used only when the deployment cell is `cn` (NEXT_PUBLIC_SITE_REGION=cn).
# The Nest server mints a V4 presigned PUT (signatureUrlV4) and the browser
# PUTs bytes straight to the bucket. The bucket MUST have CORS allowing PUT
# with header `content-type` from the web origin(s).
#
# OSS_REGION: full prefix form (e.g. oss-cn-hangzhou). The server strips
# the `oss-` prefix internally before persisting MediaAsset.region so the
# read resolver re-builds the host correctly.
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# ---- IMM (Alibaba Intelligent Media Management) — CN video → ABR HLS ----
# On the CN cell, uploaded videos are auto-transcoded to ABR HLS via IMM
# (CreateMediaConvertTask). Leave unset on .com/local — non-aliyun_oss video
# assets are never enqueued, so this stays dormant there.
# IMM_PROJECT_NAME=fizzdragon-cn
# IMM_REGION=cn-hangzhou
# IMM_ENDPOINT=https://imm.cn-hangzhou.aliyuncs.com
# Credentials fall back to OSS_ACCESS_KEY_ID/SECRET (same account) when unset.
# IMM_ACCESS_KEY_ID=
# IMM_ACCESS_KEY_SECRET=
# Poll cadence + ceiling for the async MediaConvert task (worker re-queues
# itself between polls without burning a retry attempt).
# IMM_POLL_INTERVAL_MS=20000
# IMM_MAX_MINUTES=30
# Set "false" to skip the post-transcode Cache-Control pass on HLS objects.
# IMM_SET_HLS_CACHE_CONTROL=true

# ============ Persistence ============
# Postgres (business records). Local dev: `npm run db:up` starts a
# Postgres at :5433 via docker-compose.dev.yml.
DATABASE_URL=postgres://fizzdragon:fizzdragon@localhost:5433/fizzdragon
# Redis (required; BullMQ queues, idempotency SET NX, rate limit). Local dev:
# same `npm run db:up` starts a Redis at :6380.
REDIS_URL=redis://localhost:6380

# ============ AppLovin (Axon) Conversions API ============
# Server-to-server purchase reporting for AppLovin web-ad optimisation / ROAS
# (intl .com cell only — AppLovin has no China presence). The companion browser
# pixel is the web NEXT_PUBLIC_AXON_PIXEL_KEY; this is the ad-blocker-proof S2S
# counterpart that posts community purchases (membership + community-point
# recharge) to AppLovin's Event API. Get the access token from the Axon
# dashboard → Account → General → Keys. Leave unset to keep the integration a
# no-op (it ships inert until a token is provisioned).
# AXON_CAPI_ACCESS_TOKEN=
# Pixel id (falls back to NEXT_PUBLIC_AXON_PIXEL_KEY when unset).
# AXON_PIXEL_ID=
# Override only if AppLovin moves the endpoint (defaults to https://b.applovin.com).
# AXON_API_BASE_URL=

# ============ Server ============
PORT=3001
# Set "true" to boot a worker-only process (no HTTP listener), used
# by dedicated worker pods in production. Leave unset for combined
# API + worker in dev.
# WORKER_ONLY=true

# ============ Studio Agent control plane ============
# Enable only after the Temporal/runtime credentials below are configured
# (the runtime worker reads the same set — see apps/studio-agent-runtime/
# .env.example). Each root turn snapshots the budget/admission limits; env
# changes apply only to new turns.
STUDIO_AGENT_ENABLED=false
#
# --- Required when STUDIO_AGENT_ENABLED=true (server refuses to boot otherwise) ---
# Temporal connection. For local dev run `temporal server start-dev` and use
# TLS_MODE=disabled (no certs). In prod use mtls + the TLS material below.
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TLS_MODE=disabled
# Shared secret between this server (guard) and the runtime worker (gateway
# client). Must be >=32 chars and identical on both sides.
# STUDIO_AGENT_RUNTIME_TOKEN=
# Studio Agent DELIVERY. The conversation reaches the browser over Ably
# (@ably/ai-transport); there is no second path and no "disabled" mode, so the
# server refuses to boot without this. Must be a COMPLETE key
# ("<appId>.<keyId>:<secret>") — a key name or a token is rejected at boot
# rather than at the first mint.
#
# This is a ROOT key. One infrastructure owner uses it only to sign scoped,
# short-lived credentials locally: legacy Studio receives TokenRequests and
# Agent Platform receives Ably JWTs. The server opens no Ably connection and
# publishes nothing — publishing belongs to the Temporal workers, which need
# the SAME key in their own environments. The root key never reaches a browser.
#
# DEPLOY PREREQUISITE, not code: both the legacy namespace "studio-agent" and
# the Agent Platform namespace "agent" (channels `agent:v1:conversation:*`)
# must have `mutableMessages: true` while both runtimes coexist. Without the
# matching rule, token streaming dies on the first append with error 93002.
#
# Uncommented because the config schema makes it REQUIRED at boot: a fresh
# clone that copies this file verbatim must get a server that names the missing
# value, not one that refuses to start for a reason it does not print.
ABLY_API_KEY=replace-with-a-complete-ably-api-key
# New Agent Platform Product Gateway. The browser never receives this signing
# key: the Nest API re-authorizes the current product user and signs a
# short-lived, scope-bound Ed25519 JWT for the internal Agent API.
# Production must explicitly choose true or false. When false, neither the
# browser-facing gateway nor the Agent-only domain command surface is mounted.
AGENT_PLATFORM_ENABLED=false
AGENT_PLATFORM_URL=http://127.0.0.1:4111
AGENT_PLATFORM_JWT_PRIVATE_KEY_B64=replace-with-base64-pkcs8-ed25519-private-key
AGENT_PLATFORM_JWT_KEY_ID=agent-platform-local-1
# Vertex AI project for the model provider. Required by
# apps/agent-platform/scripts/start-local-stack.ts, which reads both from this
# file and forwards them to the Worker; keep them equal to agentPlatform.model
# in deploy/helm/fizzdragon/values.yaml. The Worker authenticates through
# Application Default Credentials, so `gcloud auth application-default login`
# must be current — an expired ADC fails at the first model call, not at boot.
GOOGLE_CLOUD_PROJECT=replace-with-vertex-project-id
GOOGLE_CLOUD_LOCATION=global
AGENT_PLATFORM_JWT_ISSUER=https://api.fizzdragon.test/agent-platform
AGENT_PLATFORM_JWT_AUDIENCE=fizzdragon-agent-platform
# Durable document analysis dispatches to the Agent Platform Temporal
# deployment. The worker derives the isolated "<base>-document" lane from this
# base queue; do not put interactive and document work on one Activity lane.
# MUST equal agentPlatform.temporal.taskQueue in the Helm values — both sides
# append their own lane suffixes, so a mismatch is silent: the gateway marks
# jobs dispatched onto a queue no worker polls and they hang in `processing`
# forever. deploy/helm/fizzdragon/tests/agent-platform-render.sh pins the two
# renders to one value; keep this file on that same name.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
AGENT_PLATFORM_TEMPORAL_TASK_QUEUE=fizzdragon-agent-platform-v1
# Two bounds that exist so held admission capacity is always released. Both
# have defaults, so leaving them unset is safe; state them when tuning.
# An attempt that keeps failing dead-letters after this many tries instead of
# redelivering forever while its reservation stays held (1-20, default 10).
AGENT_INVOCATION_DISPATCH_MAX_ATTEMPTS=10
# `waiting_for_approval` holds capacity and the session Workflow suspends
# without a deadline, so the product owns the clock. Must stay below the
# lifecycle projector's 7-day execution timeout (60s-24h, default 1h).
AGENT_APPROVAL_WAIT_TIMEOUT_MS=3600000
# Distributed run admission. These are required whenever Agent Platform is
# enabled: missing capacity is a boot error, never an accidental unlimited
# deployment. One root run reserves its full worst-case token/cost envelope;
# continuations reuse that reservation because they belong to the same run.
AGENT_ADMISSION_PROVIDER_LANE=gemini
AGENT_ADMISSION_RETRY_AFTER_SECONDS=5
AGENT_ADMISSION_RESERVED_TOKEN_UNITS_PER_RUN=131072
AGENT_ADMISSION_RESERVED_COST_MICROUSD_PER_RUN=500000
AGENT_ADMISSION_MAX_ACTIVE_GLOBAL=64
AGENT_ADMISSION_MAX_ACTIVE_PER_WORKSPACE=8
AGENT_ADMISSION_MAX_ACTIVE_PER_ACTOR=2
AGENT_ADMISSION_MAX_ACTIVE_PER_PROVIDER_LANE=32
AGENT_ADMISSION_MAX_RESERVED_TOKEN_UNITS_GLOBAL=8388608
AGENT_ADMISSION_MAX_RESERVED_TOKEN_UNITS_PER_WORKSPACE=1048576
AGENT_ADMISSION_MAX_RESERVED_TOKEN_UNITS_PER_ACTOR=262144
AGENT_ADMISSION_MAX_RESERVED_TOKEN_UNITS_PER_PROVIDER_LANE=4194304
AGENT_ADMISSION_MAX_RESERVED_COST_MICROUSD_GLOBAL=32000000
AGENT_ADMISSION_MAX_RESERVED_COST_MICROUSD_PER_WORKSPACE=4000000
AGENT_ADMISSION_MAX_RESERVED_COST_MICROUSD_PER_ACTOR=1000000
AGENT_ADMISSION_MAX_RESERVED_COST_MICROUSD_PER_PROVIDER_LANE=16000000
# Domain Gateway verifies short-lived, request-bound JWTs signed by the Agent
# Worker. This JWKS contains public keys only; its matching private key belongs
# exclusively in Agent Platform's DOMAIN_GATEWAY_JWT_PRIVATE_KEY_B64.
#
# Every JWK MUST carry `fizzdragon_capability`, either "readiness" or "runtime".
# It is required, has no default, and a JWKS missing it is rejected at boot.
# The capability — not the kid, not the issuer — is what stops a compromised
# API replica from executing business mutations: the guard only admits
# `runtime` on anything other than a readiness route. So the API's key MUST be
# "readiness" and only the Worker's key may be "runtime". Marking both keys
# "runtime" boots cleanly and silently restores full tool-execution authority
# to the API, which is exactly the privilege boundary this claim exists to
# enforce. Decoded shape:
#   {"keys":[
#     {"kty":"OKP","crv":"Ed25519","kid":"agent-platform-api-domain-v1",
#      "x":"<base64url>","alg":"EdDSA","use":"sig",
#      "fizzdragon_capability":"readiness"},
#     {"kty":"OKP","crv":"Ed25519","kid":"agent-platform-worker-domain-v1",
#      "x":"<base64url>","alg":"EdDSA","use":"sig",
#      "fizzdragon_capability":"runtime"}]}
AGENT_DOMAIN_JWKS_B64=replace-with-base64-public-jwks-json
AGENT_DOMAIN_JWT_ISSUER=fizzdragon-agent-platform
AGENT_DOMAIN_JWT_AUDIENCE=fizzdragon-domain-gateway
# Operational tuning only. Security TTLs are capped at 15 minutes by code.
# AGENT_PLATFORM_TOKEN_TTL_SECONDS=300
# AGENT_PLATFORM_ABLY_TOKEN_TTL_SECONDS=300
# AGENT_PLATFORM_REQUEST_TIMEOUT_MS=5000
# AGENT_INVOCATION_DISPATCH_INTERVAL_MS=500
# AGENT_INVOCATION_DISPATCH_LEASE_MS=45000
# AGENT_INVOCATION_DISPATCH_CONCURRENCY=8
# Complete download + extraction + normalization + indexing happens in a
# bounded worker thread. The DB lease must exceed the ingest timeout by at
# least 10 seconds so a healthy worker cannot be reclaimed mid-finalization.
# AGENT_ATTACHMENT_PARSER_TIMEOUT_MS=30000
# AGENT_ATTACHMENT_INGEST_TIMEOUT_MS=120000
# AGENT_ATTACHMENT_INGEST_INTERVAL_MS=500
# AGENT_ATTACHMENT_INGEST_BATCH_SIZE=4
# AGENT_ATTACHMENT_PROCESSING_LEASE_MS=180000
# AGENT_ATTACHMENT_PROCESSING_MAX_ATTEMPTS=3
# AGENT_ATTACHMENT_PARSER_CONCURRENCY=2
# AGENT_ATTACHMENT_PARSER_MAX_OLD_MB=192
# AGENT_ATTACHMENT_PARSER_MAX_YOUNG_MB=32
# AGENT_ATTACHMENT_PARSER_CODE_RANGE_MB=32
# AGENT_ATTACHMENT_PARSER_STACK_MB=4
# The durable document dispatcher owns Temporal start retries and dead letters.
# AGENT_DOCUMENT_ANALYSIS_DISPATCH_INTERVAL_MS=500
# AGENT_DOCUMENT_ANALYSIS_DISPATCH_LEASE_MS=45000
# AGENT_DOCUMENT_ANALYSIS_DISPATCH_CONCURRENCY=4
# AGENT_DOCUMENT_ANALYSIS_DISPATCH_MAX_ATTEMPTS=10
# Lifetime of those browser tokens, and therefore the worst case for how long a
# revoked grant keeps receiving the conversation. Default 120000 (two minutes).
# STUDIO_AGENT_ABLY_TOKEN_TTL_MS=120000
# Build/rollout identifier used for Temporal worker versioning.
# STUDIO_AGENT_RELEASE=local
#
# --- Required only when TEMPORAL_TLS_MODE=mtls ---
# TEMPORAL_SERVER_NAME=
# TEMPORAL_TLS_CA=
# TEMPORAL_TLS_CERT=
# TEMPORAL_TLS_KEY=
# STUDIO_AGENT_BUDGET_MAX_CHILD_DEPTH=4
# STUDIO_AGENT_BUDGET_MAX_CHILD_RUNS=24
# STUDIO_AGENT_BUDGET_MAX_CONCURRENT_CHILD_RUNS=8
# STUDIO_AGENT_BUDGET_MAX_MODEL_STEPS_PER_RUN=32
# STUDIO_AGENT_BUDGET_MAX_MODEL_STEPS_PER_ROOT=128
# Rejected capability inputs one turn tree may accumulate before the turn is
# stopped with the last rejection's own schema issues. Each rejection is a
# `failed` action the model reads and corrects on its next step.
# STUDIO_AGENT_BUDGET_MAX_CAPABILITY_INPUT_REJECTIONS_PER_ROOT=3
# STUDIO_AGENT_BUDGET_MAX_TOTAL_TOKEN_UNITS=1000000
# STUDIO_AGENT_BUDGET_MAX_CONTEXT_BYTES_PER_STEP=2000000
# STUDIO_AGENT_BUDGET_IMAGE_TOKEN_RESERVE_UNITS=8192
# STUDIO_AGENT_BUDGET_MIN_OUTPUT_TOKEN_UNITS_PER_STEP=256
# STUDIO_AGENT_BUDGET_WALL_TIME_MS=3600000
# Admission is enforced across every server replica. Token reservations are
# released at the root terminal transaction; stale pre-run reservations are
# reconciled after the lease.
# STUDIO_AGENT_ADMISSION_LEASE_MS=120000
# STUDIO_AGENT_ADMISSION_RECONCILE_INTERVAL_MS=5000
# STUDIO_AGENT_ADMISSION_RECONCILE_BATCH_SIZE=50
# STUDIO_AGENT_ADMISSION_MAX_ACTIVE_ROOT_RUNS_GLOBAL=512
# STUDIO_AGENT_ADMISSION_MAX_ACTIVE_ROOT_RUNS_PER_WORKSPACE=64
# STUDIO_AGENT_ADMISSION_MAX_ACTIVE_ROOT_RUNS_PER_USER=4
# STUDIO_AGENT_ADMISSION_MAX_RESERVED_TOKEN_UNITS_GLOBAL=512000000
# STUDIO_AGENT_ADMISSION_MAX_RESERVED_TOKEN_UNITS_PER_WORKSPACE=64000000
# STUDIO_AGENT_ADMISSION_MAX_RESERVED_TOKEN_UNITS_PER_USER=4000000
