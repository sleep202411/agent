# Nest Admin API — server-only (admin-ui reads these, not NEXT_PUBLIC_*)
# Local: http://localhost:4399/admin
# Prod global: https://fizzdragon.com/aurora/admin  (not api.fizzdragon.com — that host times out)
ADMIN_API_BASE_URL=https://fizzdragon.com/aurora/admin
ADMIN_GLOBAL_API_BASE_URL=https://fizzdragon.com/aurora/admin
ADMIN_CN_API_BASE_URL=https://fizzdragon.fizzspace.cn/aurora/admin

TEXT_GAME_API_BASE_URL=https://java.fizzdragon.com/studio
NEWS_API_BASE_URL=https://java.fizzdragon.com/content
# Course cover relative keys (course/cover/...) — baked at build for client preview.
NEXT_PUBLIC_BANNER_BASE_URL=https://fizzdragon-banner-sg.oss-ap-southeast-1.aliyuncs.com
JAVA_ADMIN_API_TOKEN=replace-with-java-admin-api-token
# JAVA_ADMIN_API_TOKEN_HEADER=X-Admin-Api-Token
