{
  "name": "agent-platform",
  "version": "0.1.0",
  "description": "FizzDragon's unified, durable agent platform.",
  "private": true,
  "scripts": {
    "build": "npm run memory:schema:verify && npm run build:server && npm run build:worker && npm run build:migrator",
    "build:migrator": "node dist/scripts/build-memory-migrator-artifact.js",
    "build:server": "MASTRA_TELEMETRY_DISABLED=1 mastra build && node scripts/finalize-server-artifact.mjs",
    "build:worker": "npm run compile:worker && node dist/scripts/build-worker-artifact.js",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "concurrently --kill-others-on-fail --names api,worker --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "MASTRA_TELEMETRY_DISABLED=1 mastra dev",
    "dev:stack": "exec node --import tsx scripts/start-local-stack.ts",
    "dev:worker": "npm run compile:worker && node --env-file-if-exists=.env dist/src/runtime/worker.js",
    "compile:worker": "node scripts/clean-worker-build.mjs && tsc -p tsconfig.build.json && node dist/scripts/bundle-workflows.js",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.json\" \"*.md\" \"docs/**/*.md\" \"deploy/**/*.md\"",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "local:token": "node --env-file-if-exists=.env --import tsx scripts/create-local-token.ts",
    "memory:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-memory.ts",
    "memory:schema:verify": "node --import tsx scripts/verify-memory-schema.ts",
    "start": "MASTRA_TELEMETRY_DISABLED=1 mastra start",
    "start:worker": "node dist/src/runtime/worker.js",
    "test": "vitest run",
    "test:artifacts": "node dist/scripts/verify-artifacts.js",
    "test:build-smoke": "npm run test:artifacts && node dist/scripts/smoke-built-server.js && node dist/scripts/smoke-worker-artifact.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "npm audit --prefix .mastra/output --omit=dev --audit-level=high && npm audit --prefix .temporal/worker --omit=dev --audit-level=high && npm audit --prefix .migrations/agent-memory --omit=dev --audit-level=high",
    "test:watch": "vitest"
  },
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": "11.16.0"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  },
  "dependencies": {
    "@ably/ai-transport": "0.6.0",
    "@ai-sdk/google-vertex": "4.0.174",
    "@mastra/ai-sdk": "1.7.0",
    "@mastra/core": "1.55.0",
    "@mastra/memory": "1.24.0",
    "@mastra/observability": "1.16.3",
    "@mastra/otel-exporter": "1.3.6",
    "@mastra/pg": "1.18.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.218.0",
    "@temporalio/activity": "1.21.1",
    "@temporalio/client": "1.21.1",
    "@temporalio/common": "1.21.1",
    "@temporalio/envconfig": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "ably": "2.26.0",
    "ai": "6.0.238",
    "google-auth-library": "10.9.1",
    "hono": "4.12.32",
    "jose": "6.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@temporalio/testing": "1.21.1",
    "@types/node": "24.13.3",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "mastra": "1.21.0",
    "prettier": "3.8.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.10"
  }
}
