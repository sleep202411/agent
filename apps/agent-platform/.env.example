# Process
NODE_ENV=development
PORT=4111
AGENT_RELEASE=local-dev
MASTRA_TELEMETRY_DISABLED=1

# Google Vertex AI inference. The Worker authenticates exclusively through
# Application Default Credentials (ADC); API keys are rejected at boot.
# Local: gcloud auth application-default login
# Production outside Google Cloud: GOOGLE_APPLICATION_CREDENTIALS must point to
# a Workload Identity Federation external-account configuration, never a
# service-account private-key file.
GOOGLE_CLOUD_PROJECT=glass-proxy-501907-d2
GOOGLE_CLOUD_LOCATION=global
# Low-latency supervisor for greetings, focused edits and ordinary tool use.
AGENT_INTERACTIVE_MODEL_ID=gemini-2.5-flash
# Deliberate deep path for long source material and comprehensive analysis.
AGENT_REASONING_MODEL_ID=gemini-2.5-pro
AGENT_MEMORY_OBSERVER_MODEL_ID=gemini-2.5-flash

# Product gateway authentication. Production must use jwks.
AGENT_AUTH_MODE=local
AGENT_LOCAL_JWT_SECRET=
# AGENT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AGENT_JWT_ISSUER=https://identity.example.com
# AGENT_JWT_AUDIENCE=fizzdragon-agent-platform

# Co-located/internal OpenTelemetry Collector. ClickHouse credentials belong to
# the Collector deployment and must never be present in this process.
OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_COLLECTOR_HEALTH_URL=http://127.0.0.1:13133/

# Temporal. TEMPORAL_API_KEY and TEMPORAL_TLS are understood by the official
# Temporal envconfig loader when connecting to Temporal Cloud.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=fizzdragon-agent
TEMPORAL_WORKER_DEPLOYMENT_NAME=fizzdragon-agent-platform
AGENT_WORKER_HEALTH_HOST=0.0.0.0
AGENT_WORKER_HEALTH_PORT=3010
AGENT_WORKER_METRICS_BIND_ADDRESS=0.0.0.0:9464
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=true

# Ably AI Transport server credential. The Ably "agent" channel namespace
# (channels `agent:v1:conversation:*`) must enable “Message annotations,
# updates, deletes, and appends” (`mutableMessages: true`) in every environment.
# This rule persists namespace messages and is required for token appends.
ABLY_API_KEY=

# Mastra framework state and Agent long-term memory. Production uses a
# dedicated DML-only runtime role for the agent_memory schema. Schema changes
# and runtime grants use the separate AGENT_MEMORY_MIGRATION_DATABASE_URL.
AGENT_MEMORY_DATABASE_URL=postgres://fizzdragon:fizzdragon@127.0.0.1:5433/fizzdragon
AGENT_MEMORY_DATABASE_ROLE=fizzdragon
AGENT_MEMORY_MIGRATION_DATABASE_URL=postgres://fizzdragon:fizzdragon@127.0.0.1:5433/fizzdragon
# The API role is SELECT-only. The Worker role receives table DML and sequence
# usage. Production requires distinct roles; local development may use one.
AGENT_MEMORY_API_DATABASE_ROLE=fizzdragon
AGENT_MEMORY_WORKER_DATABASE_ROLE=fizzdragon
# Production CSI mounts may set this instead of projecting the credential into
# the pod environment. Never set both forms.
# AGENT_MEMORY_MIGRATION_DATABASE_URL_FILE=/mnt/agent-memory-migration/agent-memory-migration-database-url

# Trusted internal business-command boundary
DOMAIN_GATEWAY_URL=http://127.0.0.1:4399
DOMAIN_GATEWAY_JWT_PRIVATE_KEY_B64=
DOMAIN_GATEWAY_JWT_KEY_ID=agent-domain-local-1
DOMAIN_GATEWAY_JWT_ISSUER=fizzdragon-agent-platform
DOMAIN_GATEWAY_JWT_AUDIENCE=fizzdragon-domain-gateway
# DOMAIN_GATEWAY_JWT_TTL_SECONDS=30

# Operational limits
AGENT_MAX_MODEL_STEPS=48
DOMAIN_GATEWAY_TIMEOUT_MS=15000
TEMPORAL_MAX_CONCURRENT_WORKFLOWS=128
TEMPORAL_MAX_CONCURRENT_CONTROL_ACTIVITIES=16
TEMPORAL_MAX_CONCURRENT_INFERENCE_ACTIVITIES=16
TEMPORAL_MAX_CONCURRENT_TOOL_ACTIVITIES=32
TEMPORAL_MAX_CONCURRENT_LIFECYCLE_ACTIVITIES=8
TEMPORAL_MAX_CONCURRENT_CLEANUP_ACTIVITIES=8
TEMPORAL_MAX_CONCURRENT_DOCUMENT_ACTIVITIES=4
TEMPORAL_MAX_CONCURRENT_DOCUMENT_WORKFLOWS=16
# AGENT_MEMORY_POOL_MAX=20
# AGENT_MEMORY_POOL_IDLE_TIMEOUT_MS=30000
