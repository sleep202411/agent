# Separate from Agent OS. Use a locally authorized Bailian/LiteLLM credential.
GAME_AGENT_MODEL=
# Complete provider path, e.g. https://dashscope.aliyuncs.com/compatible-mode/v1
GAME_AGENT_OPENAI_BASE_URL=
GAME_AGENT_OPENAI_API_KEY=
GAME_AGENT_THINKING=false
GAME_AGENT_MAX_TOKENS=8192

GAME_AGENT_PORT=4396
GAME_AGENT_BIND_ADDRESS=127.0.0.1
# Generate a unique service token; share it only between Server and this worker.
GAME_AGENT_INTERNAL_TOKEN=
# Absolute private directory. Mount a persistent ReadWriteOnce volume here in production;
# one worker replica owns it. Never use an ephemeral container directory in production.
GAME_AGENT_WORKSPACE_ROOT=
