# Local development defaults.
FD_APP_REGION=global
APP_VARIANT=development

# Expo app identity. Real production package names will be supplied later.
# Leave these empty for local development; app.config.js uses non-production
# placeholder identifiers for development/preview builds.
FD_GLOBAL_IOS_BUNDLE_IDENTIFIER=
FD_GLOBAL_ANDROID_PACKAGE=
FD_CN_IOS_BUNDLE_IDENTIFIER=
FD_CN_ANDROID_PACKAGE=

# Optional display/config overrides.
FD_APP_DISPLAY_NAME=FizzDragon
FD_APP_SCHEME=
FD_EXPO_SLUG=fizzdragon-mobile

# Public runtime config overrides. These are baked into the JS bundle, so never
# put secrets here. Leave blank to use the region defaults from app.config.js.
EXPO_PUBLIC_API_CONTENT_BASE_URL=
EXPO_PUBLIC_API_STUDIO_BASE_URL=
EXPO_PUBLIC_API_AURORA_BASE_URL=
EXPO_PUBLIC_OSS_BASE_URL=
EXPO_PUBLIC_USER_BASE_URL=
EXPO_PUBLIC_BANNER_BASE_URL=
EXPO_PUBLIC_STATIC_BASE_URL=

# Paywall (public SDK keys only — never put RevenueCat secret / WeChat merchant certs here).
# Apple IAP (RevenueCat public SDK keys, appl_…). Region-specific values win.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY_CN=
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY_GLOBAL=
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
# Google Play IAP (RevenueCat public SDK key, goog_…)
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
# WeChat Open Platform mobile app id (wx…) for CN Android APP支付
EXPO_PUBLIC_WECHAT_APP_ID=
# CN iOS Universal Link (must match 微信开放平台 + web AASA).
# Example: https://fizzdragon.fizzspace.cn/app/
EXPO_PUBLIC_WECHAT_UNIVERSAL_LINK=

# Region defaults:
# global content proxy: https://fizzdragon.com/content
# global studio proxy:  https://fizzdragon.com/studio
# global aurora proxy:  https://fizzdragon.com/aurora
# cn content proxy:     https://fizzdragon.fizzspace.cn/content
# cn studio proxy:      https://fizzdragon.fizzspace.cn/studio
# cn aurora proxy:      https://fizzdragon.fizzspace.cn/aurora

# Optional hosted discovery maps. Publish public/discovery-map on an HTTPS origin
# approved for the provider key before enabling. No secret security code here.
FD_DISCOVERY_MAP_ENABLED=false
FD_DISCOVERY_MAP_DOCUMENT_URL=
FD_DISCOVERY_MAP_GOOGLE_KEY=
FD_DISCOVERY_MAP_GOOGLE_MAP_ID=
FD_DISCOVERY_MAP_GAODE_KEY=
FD_DISCOVERY_MAP_GAODE_PROXY_PATH=
