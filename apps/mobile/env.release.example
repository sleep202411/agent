# Copy to `env.release.local` (gitignored) and fill in. Consumed by
# scripts/build-release.sh. Signing materials live OUTSIDE the repo
# (never git-tracked); see app/signing/README.md for paths/passwords.

# Output + toolchain
FD_OUT_DIR="$HOME/Desktop/FizzDragon-builds"
FD_ANDROID_SDK="$HOME/Library/Android/sdk"

# Android — Global (Google Play AAB + Transsion PalmStore APK share this key)
FD_GP_KEYSTORE="/ABSOLUTE/PATH/app/signing/android-global-googleplay/upload-keystore.jks"
FD_GP_STORE_PASS="REPLACE_ME"
FD_GP_KEY_ALIAS="upload"
FD_GP_KEY_PASS="REPLACE_ME"

# Android — CN (华为 + 小米 share this 沸腾繁星 key)
FD_CN_KEYSTORE="/ABSOLUTE/PATH/app/signing/android-cn/fizzdragon-release.jks"
FD_CN_STORE_PASS="REPLACE_ME"
FD_CN_KEY_ALIAS="your-alias"
FD_CN_KEY_PASS="REPLACE_ME"

# iOS (global = manual sign with the profile; CN = automatic via Xcode account)
FD_IOS_GLOBAL_TEAM="273BAZ5UTL"
FD_IOS_GLOBAL_PROFILE="FizzDragon App Store Distribution"
FD_IOS_CN_TEAM="H5FAJB56F4"

# Bundle IDs / packages (must match eas.json + store registrations)
FD_GLOBAL_IOS_BUNDLE_IDENTIFIER="com.fizzdragon.app"
FD_GLOBAL_ANDROID_PACKAGE="com.fizzdragon"
FD_CN_IOS_BUNDLE_IDENTIFIER="cn.fizzspaceapp"
FD_CN_ANDROID_PACKAGE="cn.feiteng.fizzspace"

# Paywall public keys only (baked into extra.paywall). Never put RevenueCat
# secret keys or WeChat merchant certs here.
# Global Apple IAP (RevenueCat). CN iOS uses StoreKit via react-native-iap — leave empty.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=""
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=""
# WeChat Open Platform AppID (wx…). Required for CN Android WeChat Pay.
EXPO_PUBLIC_WECHAT_APP_ID=""
# CN iOS Universal Link — must match 微信开放平台 + web AASA.
# Example: https://fizzdragon.fizzspace.cn/app/
EXPO_PUBLIC_WECHAT_UNIVERSAL_LINK=""
