# Agent OS live model (OpenAI-compatible). Do not commit real keys.
#
# Qwen MaaS (Alibaba) example:
# AGENT_OS_OPENAI_BASE_URL=https://<endpoint>.maas.aliyuncs.com/compatible-mode/v1
# AGENT_OS_OPENAI_API_KEY=sk-...

AGENT_OS_OPENAI_BASE_URL=
AGENT_OS_OPENAI_API_KEY=

# TV viewing assistance requires an explicitly selected existing model profile.
# Missing configuration returns unavailable; no production project/tools are used.
# AGENT_OS_VIEWER_MODEL_PROFILE=<configured-profile-id>

# Optional aliases (same meaning as OPENAI_* above)
# AGENT_OS_LITELLM_BASE_URL=
# AGENT_OS_LITELLM_API_KEY=

AGENT_OS_PORT=4301

# Nest domain (real platform project characters/shots writes).
# REQUIRED: the worker refuses to boot without both, rather than silently
# falling back to a throwaway in-memory store and reporting writes that never
# happened. In-memory domain implementations are available only inside tests.
# The token must match server AGENT_OS_INTERNAL_TOKEN — it is checked in BOTH
# directions, so it is also what stops anyone who can reach this port from
# starting runs as another user.
AGENT_OS_DOMAIN_URL=http://127.0.0.1:4399
AGENT_OS_INTERNAL_TOKEN=dev-only-change-me-16+

# Loopback by default. A deployment whose gateway lives in another pod must set
# 0.0.0.0 explicitly (the container image does) and pair it with a network policy.
# AGENT_OS_BIND_ADDRESS=127.0.0.1

# LangGraph checkpoints. Outside NODE_ENV=test this explicit DSN is required
# and MUST address the same PostgreSQL database as Nest `agent_os_runs`, so
# checkpoint writes and execution epochs share one transaction authority.
# AGENT_OS_CHECKPOINT_DATABASE_URL=postgresql://...
# AGENT_OS_CHECKPOINT_SCHEMA=agent_os
# AGENT_OS_CHECKPOINT_POOL_MAX=10
# AGENT_OS_CHECKPOINT_LOCK_POOL_MAX=20

# The picker's models. One key and one compatible-mode endpoint serve Qwen,
# DeepSeek, GLM and Kimi alike, so adding one is naming it — no new provider.
# Omit to use the shipped list; set it to replace that list wholesale.
# Model qualification must run through the durable Gateway/Worker HITL path;
# direct in-process approval probes are intentionally unsupported.
# AGENT_OS_MODEL_PROFILES=[{"id":"deepseek-v4-pro","model":"deepseek-v4-pro","label":"DeepSeek V4 Pro","hint":"Dense reasoning","temperature":0.3,"maxTokens":8192}]

# Ably root key. Agent OS publishes live events;
# browser gets a short-lived TokenRequest from Nest. Optional: without it
# the UI falls back to Nest poll (~120ms).
# ABLY_API_KEY=appId.keyId:secret

# Skills: system skills are built into @repo/agent-skills. Project Skills arrive
# as bounded, immutable snapshots resolved by the Nest control plane.
# Per-request: projectKind + workbenchMode + optional system skillIds.
